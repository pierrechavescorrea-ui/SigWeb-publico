#77592=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos GEB-U113-CT101850-L000-DIS6012 (H1\X2\2013\X0\H30 y H53\X2\2013\X0\H63): viga, delta, cuerpo com\X2\00FA\X0\n tramos 1\X2\2013\X0\8 y cuerpo AAE1, extensiones y cuerpos AAE2\X2\2013\X0\AAE3.'),$);
