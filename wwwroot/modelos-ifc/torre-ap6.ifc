#25575=IFCPROPERTYSINGLEVALUE('Validacion06',$,IFCTEXT('H20 \X2\00B7\X0\ Cuerpo AP6: altura por longitud de cara vs por ancho de montantes: plano 2990 mm / modelo 2991 mm'),$);
#25576=IFCPROPERTYSINGLEVALUE('Validacion07',$,IFCTEXT('H7/H9 \X2\00B7\X0\ ancho de montantes en la junta Extensi\X2\00F3\X0\n AP1 / Extensi\X2\00F3\X0\n AP3: plano 3584 mm / modelo 3586 mm'),$);
#25577=IFCPROPERTYSINGLEVALUE('Validacion08',$,IFCTEXT('H9/H12 \X2\00B7\X0\ ancho de montantes en la junta Extensi\X2\00F3\X0\n AP3 / Extensi\X2\00F3\X0\n y cuerpo AP4: plano 5235 mm / modelo 5240 mm'),$);
#25578=IFCPROPERTYSINGLEVALUE('Validacion09',$,IFCTEXT('H15/H18 \X2\00B7\X0\ ancho de montantes en la junta Extensi\X2\00F3\X0\n AP5 / Extensi\X2\00F3\X0\n AP6: plano 7712 mm / modelo 7715 mm'),$);
#25579=IFCPROPERTYSINGLEVALUE('Validacion10',$,IFCTEXT('H18/H20 \X2\00B7\X0\ ancho de montantes en la junta Extensi\X2\00F3\X0\n AP6 / Cuerpo AP6: plano 8951 mm / modelo 8957 mm'),$);
#25580=IFCPROPERTYSINGLEVALUE('Validacion11',$,IFCTEXT('H7 \X2\00B7\X0\ lado del corte CORTEH-H vs amarre de la cara: plano 2912 mm / modelo 2912 mm'),$);
#25581=IFCPROPERTYSINGLEVALUE('Validacion12',$,IFCTEXT('H11 \X2\00B7\X0\ lado del corte CORTEI-I vs amarre de la cara: plano 4112 mm / modelo 4131 mm'),$);
