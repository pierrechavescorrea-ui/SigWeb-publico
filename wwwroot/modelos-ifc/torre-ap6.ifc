#25548=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos DIS6049 H01\X2\2013\X0\H37 y listado de materiales torre AP rev. A14 (hoja RESUMEN para la composici\X2\00F3\X0\n).'),$);
#25549=IFCPROPERTYSINGLEVALUE('AltoTotal_mm',$,IFCTEXT('53627'),$);
#25550=IFCPROPERTYSINGLEVALUE('AnchoBase_mm',$,IFCTEXT('13360'),$);
#25551=IFCPROPERTYSINGLEVALUE('Miembros',$,IFCTEXT('797'),$);
#25552=IFCPROPERTYSINGLEVALUE('MiembrosConPerfil',$,IFCTEXT('587'),$);
#25553=IFCPROPERTYSINGLEVALUE('PesoPerfilesLeidos_kg',$,IFCTEXT('5133.4'),$);
#25554=IFCPROPERTYSINGLEVALUE('Supuesto01',$,IFCTEXT('Geometr\X2\00ED\X0\a de las vistas de cara (verdadero tama\X2\00F1\X0\o, mm); las 4 caras se asumen iguales y la planta cuadrada.'),$);
#25555=IFCPROPERTYSINGLEVALUE('Supuesto02',$,IFCTEXT('Cota Y=0 en el pie de las patas (terreno); los stubs quedan bajo el terreno. Las alturas relativas salen del ancho de los montantes (tronco \X2\00FA\X0\nico, pendiente 0,1375757 por vertical) y coincide con la longitud de cara de cada m\X2\00F3\X0\dulo (ver validaci\X2\00F3\X0\n).'),$);
#25556=IFCPROPERTYSINGLEVALUE('Supuesto03',$,IFCTEXT('Composici\X2\00F3\X0\n y pesos seg\X2\00FA\X0\n la hoja RESUMEN del listado de materiales rev. A14; cada marca del plano se asocia a su conjunto y solo entra si el conjunto pertenece a la torre (p. ej. el cierre ''cuerpo AP1'' solo en AP1).'),$);
#25557=IFCPROPERTYSINGLEVALUE('Supuesto04',$,IFCTEXT('AP5\X2\2013\X0\AP7: la extensi\X2\00F3\X0\n AP4 es la parte superior de la hoja H12 hasta el amarre K-K; la extensi\X2\00F3\X0\n AP5 se acopla en ese nivel (ver ''desajuste_kk_mm'').'),$);
#25558=IFCPROPERTYSINGLEVALUE('Supuesto05',$,IFCTEXT('Patas: se modela la pata de 12,0 m (la de la silueta) en las 4 esquinas; la cara dibujada en H33 se coloca en las dos caras de cada esquina. Las dem\X2\00E1\X0\s patas (1,5\X2\2013\X0\10,5 m) y las parrillas solo se listan en ''opciones_pie''.'),$);
#25559=IFCPROPERTYSINGLEVALUE('Supuesto06',$,IFCTEXT('Pata: el cord\X2\00F3\X0\n interior se coloca con su proyecci\X2\00F3\X0\n sobre la cara (H33); el panel de cierre (H34) se coloca entre los cordones de las dos caras de cada esquina, por interpolaci\X2\00F3\X0\n a lo largo del cord\X2\00F3\X0\n (aproximado).'),$);
#25560=IFCPROPERTYSINGLEVALUE('Supuesto07',$,IFCTEXT('Stub: pieza m\X2\00E1\X0\s larga del conjunto STUB, colocada en la prolongaci\X2\00F3\X0\n del montante bajo la pata.'),$);
#25561=IFCPROPERTYSINGLEVALUE('Supuesto08',$,IFCTEXT('Barras de base (amarre de montaje ~490 mm bajo el extremo del montante) se ubican donde las dibuja la vista de cara.'),$);
#25562=IFCPROPERTYSINGLEVALUE('Supuesto09',$,IFCTEXT('Cabeza (H1, H3\X2\2013\X0\H6): cada vista es una cara a verdadero tama\X2\00F1\X0\o llevada a 3D con su plano: frontal de deltas z = 1554 \X2\2212\X0\ 0,05356\X2\00B7\X0\(Y\X2\2212\X0\Ytope AP1); caras exterior/interior por la direcci\X2\00F3\X0\n de sus montantes; viga con caras verticales a \X2\00B1\X0\797 mm y cord\X2\00F3\X0\n superior seg\X2\00FA\X0\n la frontal; brazos con la cara frontal interpolada entre los cordones de los planos superior e inferior (aproximado).'),$);
#25563=IFCPROPERTYSINGLEVALUE('Supuesto10',$,IFCTEXT('Cabeza: m\X2\00E9\X0\nsula y p\X2\00E9\X0\ndulo (H2) no modelados (sus piezas s\X2\00ED\X0\ est\X2\00E1\X0\n en la lista); los miembros que aparecen en dos vistas se dejan una sola vez.'),$);
#25564=IFCPROPERTYSINGLEVALUE('Supuesto11',$,IFCTEXT('Cortes en planta: solo los de contorno cuadrado, en el amarre horizontal cuya longitud coincide con el lado (tolerancia 4 %).'),$);
#25565=IFCPROPERTYSINGLEVALUE('Supuesto12',$,IFCTEXT('Marcas: asignadas si la longitud de pieza coincide con el eje (\X2\2264\X0\8 %) y la marca est\X2\00E1\X0\ a \X2\2264\X0\1300 mm; si no, el miembro queda sin v\X2\00ED\X0\nculo.'),$);
#25566=IFCPROPERTYSINGLEVALUE('Supuesto13',$,IFCTEXT('El perfil de cada pieza sale de su marca le\X2\00ED\X0\da en el plano y de la lista de materiales; las piezas sin marca vinculada se dibujan como tubo \X2\00D8\X0\40 mm (PerfilLeido = No).'),$);
#25567=IFCPROPERTYSINGLEVALUE('Supuesto14',$,IFCTEXT('La orientaci\X2\00F3\X0\n de las alas de los \X2\00E1\X0\ngulos no se lee de los planos procesados: se usa la convenci\X2\00F3\X0\n de montaje (montantes con alas hacia el interior; diagonales con un ala en el plano de la cara y la otra hacia el interior).'),$);
#25568=IFCPROPERTYSINGLEVALUE('Supuesto15',$,IFCTEXT('El tal\X2\00F3\X0\n del \X2\00E1\X0\ngulo se ubica sobre la l\X2\00ED\X0\nea de trabajo del plano (sin gramil ni excentricidad de conexi\X2\00F3\X0\n).'),$);
#25569=IFCPROPERTYSINGLEVALUE('Supuesto16',$,IFCTEXT('No se modelan placas, tornillos ni cartelas.'),$);
#25570=IFCPROPERTYSINGLEVALUE('Validacion01',$,IFCTEXT('H7 \X2\00B7\X0\ Extensi\X2\00F3\X0\n AP1: altura por longitud de cara vs por ancho de montantes: plano 1735 mm / modelo 1735 mm'),$);
#25571=IFCPROPERTYSINGLEVALUE('Validacion02',$,IFCTEXT('H9 \X2\00B7\X0\ Extensi\X2\00F3\X0\n AP3: altura por longitud de cara vs por ancho de montantes: plano 5990 mm / modelo 5992 mm'),$);
#25572=IFCPROPERTYSINGLEVALUE('Validacion03',$,IFCTEXT('H12 \X2\00B7\X0\ Extensi\X2\00F3\X0\n y cuerpo AP4: altura por longitud de cara vs por ancho de montantes: plano 7490 mm / modelo 7492 mm'),$);
#25573=IFCPROPERTYSINGLEVALUE('Validacion04',$,IFCTEXT('H15 \X2\00B7\X0\ Extensi\X2\00F3\X0\n AP5: altura por longitud de cara vs por ancho de montantes: plano 4490 mm / modelo 4491 mm'),$);
