#19063=IFCMATERIAL('A572-50',$,'Acero');
#19064=IFCRELASSOCIATESMATERIAL('1vk1JuGyz8PRD5ntjZYRXS',#5,$,$,(#1659,#1695,#1731,#1767,#1803,#1839,#1875,#1911,#1950,#1986,#2022,#2058,#2094,#2130,#2166,#2202,#2241,#2277,#2313,#2349,#2385,#2421,#2457,#2493,#2679,#2715,#2751,#2787,#2823,#2859,#2895,#2931,#2967,#3003,#3039,#3075,#3111,#3147,#3183,#3219,#3255,#3291,#3327,#3363,#3533,#3569,#3605,#3641,#3736,#3772,#3864,#3900,#3992,#4028,#4120,#4156,#4192,#4228,#4264,#4300,#4336,#4372,#4408,#4444,#4480,#4516,#4552,#4588,#4624,#4660,#4696,#4732,#4768,#4804,#4840,#4876,#5083,#5119,#5211,#5247,#5339,#5375,#5414,#5450,#5486,#5522,#5558,#5594,#5630,#5666,#5702,#5738,#5774,#5810,#6238,#6274,#6478,#6514,#7782,#7818,#7913,#7949,#11372,#11408,#11444,#11480,#15526,#15562,#16539),#19063);
#19065=IFCMATERIAL('A36',$,'Acero');
#19066=IFCRELASSOCIATESMATERIAL('2AE5WI$Ij43Q$TxLPNSLWm',#5,$,$,(#2532,#2568,#2604,#2640,#3402,#3438,#8156,#8192,#8676,#8712,#8748,#8784,#8820,#8856,#8892,#8928,#14975,#15039,#16472,#18059,#18095,#18635,#18671),#19065);
#19067=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos DIS6052 (silueta BP6); cuerpo BP2 = tronco cortado a z = 30 m de esa silueta (ancho de la cara en la base del cuerpo en el plano H11: 6419 mm; modelo: 6418 mm).'),$);
#19068=IFCPROPERTYSINGLEVALUE('AltoTotal_mm',$,IFCTEXT('40000'),$);
#19069=IFCPROPERTYSINGLEVALUE('AnchoBase_mm',$,IFCTEXT('9848'),$);
#19070=IFCPROPERTYSINGLEVALUE('Miembros',$,IFCTEXT('638'),$);
#19071=IFCPROPERTYSINGLEVALUE('MiembrosConPerfil',$,IFCTEXT('132'),$);
#19072=IFCPROPERTYSINGLEVALUE('PesoPerfilesLeidos_kg',$,IFCTEXT('2785.1'),$);
#19073=IFCPROPERTYSINGLEVALUE('Supuesto01',$,IFCTEXT('BP2 = misma silueta que BP6 sin los 18 m inferiores del tronco: el ancho del plano H11 en la base del cuerpo coincide con el de la silueta a z = 30 m; cada cuerpo menor est\X2\00E1\X0\ 4.5 m m\X2\00E1\X0\s arriba que el anterior.'),$);
#19074=IFCPROPERTYSINGLEVALUE('Supuesto02',$,IFCTEXT('La pata de 12 m (H27) se estrecha en planta para empalmar con la base del cuerpo BP2; su despiece real puede diferir. Sus piezas no llevan marca vinculada.'),$);
#19075=IFCPROPERTYSINGLEVALUE('Supuesto03',$,IFCTEXT('Geometr\X2\00ED\X0\a = ejes de las piezas de las siluetas de los planos (cara transversal); las caras longitudinales se proyectan con la silueta BP6-LONG del plano H8.'),$);
#19076=IFCPROPERTYSINGLEVALUE('Supuesto04',$,IFCTEXT('Las dos caras de cada vista se suponen id\X2\00E9\X0\nticas (simetr\X2\00ED\X0\a), y la profundidad sigue el contorno de la silueta longitudinal.'),$);
#19077=IFCPROPERTYSINGLEVALUE('Supuesto05',$,IFCTEXT('Cada pieza se relaciona con la hoja que detalla su zona (capa FOR de la silueta de cada plano); en zonas compartidas se elige la hoja de zona m\X2\00E1\X0\s espec\X2\00ED\X0\fica.'),$);
#19078=IFCPROPERTYSINGLEVALUE('Supuesto06',$,IFCTEXT('Marcas: solo aparecen en los miembros donde la burbuja del plano, su leader y el eje de la vista coinciden con un miembro del modelo (\X2\2264\X0\ 40 mm); los miembros sin marca no tienen v\X2\00ED\X0\nculo verificado, aunque su marca exista en la lista de materiales.'),$);
#19079=IFCPROPERTYSINGLEVALUE('Supuesto07',$,IFCTEXT('Las marcas y hojas de los paneles compartidos son las del modelo de origen (los paneles son iguales en todos los cuerpos).'),$);
#19080=IFCPROPERTYSINGLEVALUE('Supuesto08',$,IFCTEXT('El perfil de cada pieza sale de su marca le\X2\00ED\X0\da en el plano y de la lista de materiales; las piezas sin marca vinculada se dibujan como tubo \X2\00D8\X0\40 mm (PerfilLeido = No).'),$);
#19081=IFCPROPERTYSINGLEVALUE('Supuesto09',$,IFCTEXT('La orientaci\X2\00F3\X0\n de las alas de los \X2\00E1\X0\ngulos no se lee de los planos procesados: se usa la convenci\X2\00F3\X0\n de montaje (montantes con alas hacia el interior; diagonales con un ala en el plano de la cara y la otra hacia el interior).'),$);
#19082=IFCPROPERTYSINGLEVALUE('Supuesto10',$,IFCTEXT('El tal\X2\00F3\X0\n del \X2\00E1\X0\ngulo se ubica sobre la l\X2\00ED\X0\nea de trabajo del plano (sin gramil ni excentricidad de conexi\X2\00F3\X0\n).'),$);
#19083=IFCPROPERTYSINGLEVALUE('Supuesto11',$,IFCTEXT('No se modelan placas, tornillos ni cartelas.'),$);
