#25325=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos EEB-U113-CT100501-L000-DIS6052-H1\X2\2026\X0\H31: siluetas BP5 (cara transversal) y BP6-LONG (cara longitudinal)'),$);
#25326=IFCPROPERTYSINGLEVALUE('AltoTotal_mm',$,IFCTEXT('53500'),$);
#25327=IFCPROPERTYSINGLEVALUE('AnchoBase_mm',$,IFCTEXT('13728'),$);
#25328=IFCPROPERTYSINGLEVALUE('Miembros',$,IFCTEXT('856'),$);
#25329=IFCPROPERTYSINGLEVALUE('MiembrosConPerfil',$,IFCTEXT('152'),$);
#25330=IFCPROPERTYSINGLEVALUE('PesoPerfilesLeidos_kg',$,IFCTEXT('3434.4'),$);
#25331=IFCPROPERTYSINGLEVALUE('Supuesto01',$,IFCTEXT('Geometr\X2\00ED\X0\a = ejes de las piezas de las siluetas de los planos (cara transversal); las caras longitudinales se proyectan con la silueta BP6-LONG del plano H8.'),$);
#25332=IFCPROPERTYSINGLEVALUE('Supuesto02',$,IFCTEXT('Las dos caras de cada vista se suponen id\X2\00E9\X0\nticas (simetr\X2\00ED\X0\a), y la profundidad sigue el contorno de la silueta longitudinal.'),$);
#25333=IFCPROPERTYSINGLEVALUE('Supuesto03',$,IFCTEXT('La base corresponde a la pata de 12 m (cota 0 del plano); las patas de 1,5 a 10,5 m (H21\X2\2013\X0\H25) acortan la base y no se modelan como variante.'),$);
#25334=IFCPROPERTYSINGLEVALUE('Supuesto04',$,IFCTEXT('Cada pieza se relaciona con la hoja que detalla su zona (capa FOR de la silueta de cada plano); en zonas compartidas se elige la hoja de zona m\X2\00E1\X0\s espec\X2\00ED\X0\fica.'),$);
#25335=IFCPROPERTYSINGLEVALUE('Supuesto05',$,IFCTEXT('La cara longitudinal de BP5 se deriv\X2\00F3\X0\ de la silueta BP6-LONG reescalada en altura (no hay silueta longitudinal BP5 en los planos).'),$);
#25336=IFCPROPERTYSINGLEVALUE('Supuesto06',$,IFCTEXT('Marcas: solo aparecen en los miembros donde la burbuja del plano, su leader y el eje de la vista coinciden con un miembro del modelo (\X2\2264\X0\ 40 mm); los miembros sin marca no tienen v\X2\00ED\X0\nculo verificado, aunque su marca exista en la lista de materiales.'),$);
#25337=IFCPROPERTYSINGLEVALUE('Supuesto07',$,IFCTEXT('El perfil de cada pieza sale de su marca le\X2\00ED\X0\da en el plano y de la lista de materiales; las piezas sin marca vinculada se dibujan como tubo \X2\00D8\X0\40 mm (PerfilLeido = No).'),$);
#25338=IFCPROPERTYSINGLEVALUE('Supuesto08',$,IFCTEXT('La orientaci\X2\00F3\X0\n de las alas de los \X2\00E1\X0\ngulos no se lee de los planos procesados: se usa la convenci\X2\00F3\X0\n de montaje (montantes con alas hacia el interior; diagonales con un ala en el plano de la cara y la otra hacia el interior).'),$);
#25339=IFCPROPERTYSINGLEVALUE('Supuesto09',$,IFCTEXT('El tal\X2\00F3\X0\n del \X2\00E1\X0\ngulo se ubica sobre la l\X2\00ED\X0\nea de trabajo del plano (sin gramil ni excentricidad de conexi\X2\00F3\X0\n).'),$);
#25340=IFCPROPERTYSINGLEVALUE('Supuesto10',$,IFCTEXT('No se modelan placas, tornillos ni cartelas.'),$);
