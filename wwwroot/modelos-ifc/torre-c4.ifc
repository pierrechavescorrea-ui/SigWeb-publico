#35886=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos DIS6022 H01\X2\2013\X0\H36 y listado de materiales torre C rev. A8 (hoja RESUMEN para la composici\X2\00F3\X0\n).'),$);
#35887=IFCPROPERTYSINGLEVALUE('AltoTotal_mm',$,IFCTEXT('45226'),$);
#35888=IFCPROPERTYSINGLEVALUE('AnchoBase_mm',$,IFCTEXT('13660'),$);
