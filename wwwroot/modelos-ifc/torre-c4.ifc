#35890=IFCPROPERTYSINGLEVALUE('MiembrosConPerfil',$,IFCTEXT('351'),$);
#35891=IFCPROPERTYSINGLEVALUE('PesoPerfilesLeidos_kg',$,IFCTEXT('10147.8'),$);
#35892=IFCPROPERTYSINGLEVALUE('Supuesto01',$,IFCTEXT('Y=0 en el pie de las patas (terreno; los stubs quedan bajo el terreno). Las cotas relativas salen del tronco de pir\X2\00E1\X0\mide (bloque ''func'': 0,13636486 por vertical, 0,13511439 en cara) con Y=0 de trabajo en el tope del cuerpo (ancho 6000).'),$);
#35893=IFCPROPERTYSINGLEVALUE('Supuesto02',$,IFCTEXT('Cada vista de cara se ubica con su amarre superior y el ancho H= del plano; los montantes de los dibujos sobresalen \X2\2248\X0\ 590 mm del nudo (empalme) y no se usan para la cota.'),$);
#35894=IFCPROPERTYSINGLEVALUE('Supuesto03',$,IFCTEXT('Planta cuadrada en el cuerpo; las extensiones C1-C3-C5 y C2-C4-C6 tienen vistas separadas de cara transversal y longitudinal (H10, H16/H17), las dem\X2\00E1\X0\s se replican en las 4 caras. Las vistas de media cara (H11, H13, H19) se espejan respecto al eje.'),$);
#35895=IFCPROPERTYSINGLEVALUE('Supuesto04',$,IFCTEXT('Cabeza: vistas frontales de los deltas (H7, H5) en X-Y a verdadero tama\X2\00F1\X0\o con la inclinaci\X2\00F3\X0\n de la cara (factor 0,9908); la profundidad sale de los anchos de las caras laterales (H8: 6000 \X2\2192\X0\ 4071; H6: 4308 \X2\2192\X0\ 2086; viga 2087) interpolada linealmente con la altura. Las caras laterales (H8, H6) se colocan interpolando entre sus montantes. Viga (H2/H3) con caras a \X2\00B1\X0\1043 mm; brazos (H4) con cara frontal que se cierra hacia la punta (aproximado).'),$);
#35896=IFCPROPERTYSINGLEVALUE('Supuesto05',$,IFCTEXT('Delta tramo 1 (H5): el dibujo junta los dos m\X2\00E1\X0\stiles; cada uno se ubica por su montante interior (X = \X2\00B1\X0\4983, tope del montante interior del tramo 2) y se verifica con el montante exterior, que coincide con la prolongaci\X2\00F3\X0\n del exterior del tramo 2.'),$);
#35897=IFCPROPERTYSINGLEVALUE('Supuesto06',$,IFCTEXT('Patas: se modela la de 12,0 m (H33, cara a verdadero tama\X2\00F1\X0\o colocada en las dos caras de cada esquina; H34, vista interna entre los dos cordones de la esquina, interpolada) en las 4 esquinas; stub (H35) en la prolongaci\X2\00F3\X0\n del montante. Las patas de 1,5\X2\2013\X0\10,5 m y las parrillas solo se listan en ''opciones_pie''.'),$);
#35898=IFCPROPERTYSINGLEVALUE('Supuesto07',$,IFCTEXT('Composici\X2\00F3\X0\n y pesos: hoja RESUMEN del listado rev. A8; cada marca del plano se asocia a su conjunto del listado y solo entra si el conjunto pertenece a la torre. Subconjuntos sin fila propia en el RESUMEN (CONJUNTO AA01, CORTE H-H, CONJUNTO CUERPO AA7) toman la composici\X2\00F3\X0\n del conjunto anterior del mismo plano.'),$);
#35899=IFCPROPERTYSINGLEVALUE('Supuesto08',$,IFCTEXT('No modelados: brazo de guarda (H1, vistas giradas) y cortes de la cabeza (H2 G-G/F-F/F1-F1/Z-Z); sus piezas s\X2\00ED\X0\ est\X2\00E1\X0\n en la lista de materiales.'),$);
#35900=IFCPROPERTYSINGLEVALUE('Supuesto09',$,IFCTEXT('Cortes en planta: solo los de contorno cuadrado; se colocan en el nudo del m\X2\00F3\X0\dulo cuyo ancho coincide con el del corte (tolerancia 2,5 %).'),$);
#35901=IFCPROPERTYSINGLEVALUE('Supuesto10',$,IFCTEXT('Marcas: solo las que tienen burbuja + leader a \X2\2264\X0\130 mm del eje del plano; ''coherencia'' compara la longitud de pieza de la lista con el eje del modelo.'),$);
#35902=IFCPROPERTYSINGLEVALUE('Supuesto11',$,IFCTEXT('El perfil de cada pieza sale de su marca le\X2\00ED\X0\da en el plano y de la lista de materiales; las piezas sin marca vinculada se dibujan como tubo \X2\00D8\X0\40 mm (PerfilLeido = No).'),$);
#35903=IFCPROPERTYSINGLEVALUE('Supuesto12',$,IFCTEXT('La orientaci\X2\00F3\X0\n de las alas de los \X2\00E1\X0\ngulos no se lee de los planos procesados: se usa la convenci\X2\00F3\X0\n de montaje (montantes con alas hacia el interior; diagonales con un ala en el plano de la cara y la otra hacia el interior).'),$);
#35904=IFCPROPERTYSINGLEVALUE('Supuesto13',$,IFCTEXT('El tal\X2\00F3\X0\n del \X2\00E1\X0\ngulo se ubica sobre la l\X2\00ED\X0\nea de trabajo del plano (sin gramil ni excentricidad de conexi\X2\00F3\X0\n).'),$);
#35905=IFCPROPERTYSINGLEVALUE('Supuesto14',$,IFCTEXT('No se modelan placas, tornillos ni cartelas.'),$);
#35906=IFCPROPERTYSINGLEVALUE('Validacion01',$,IFCTEXT('H16 \X2\00B7\X0\ Extensi\X2\00F3\X0\n C2-C4-C6 (T): altura por la cara vs por los anchos H=: plano 7000 mm / modelo 7000 mm'),$);
#35907=IFCPROPERTYSINGLEVALUE('Validacion02',$,IFCTEXT('H17 \X2\00B7\X0\ Extensi\X2\00F3\X0\n C2-C4-C6 (L): altura por la cara vs por los anchos H=: plano 7000 mm / modelo 7000 mm'),$);
#35908=IFCPROPERTYSINGLEVALUE('Validacion03',$,IFCTEXT('H19 \X2\00B7\X0\ Extensi\X2\00F3\X0\n C4-C6 (TL): altura por la cara vs por los anchos H=: plano 6000 mm / modelo 6000 mm'),$);
#35909=IFCPROPERTYSINGLEVALUE('Validacion04',$,IFCTEXT('H20 \X2\00B7\X0\ Cuerpo C4-C6 (TL): altura por la cara vs por los anchos H=: plano 3000 mm / modelo 3000 mm'),$);
#35910=IFCPROPERTYSINGLEVALUE('Validacion05',$,IFCTEXT('H9 \X2\00B7\X0\ lado de la secci\X2\00F3\X0\n en planta vs ancho del m\X2\00F3\X0\dulo: plano 6045 mm / modelo 6000 mm'),$);
#35911=IFCPROPERTYSINGLEVALUE('Validacion06',$,IFCTEXT('H18 \X2\00B7\X0\ lado de la secci\X2\00F3\X0\n en planta vs ancho del m\X2\00F3\X0\dulo: plano 7497 mm / modelo 7500 mm'),$);
