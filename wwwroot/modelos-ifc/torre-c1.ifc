#26950=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos DIS6022 H01\X2\2013\X0\H36 y listado de materiales torre C rev. A8 (hoja RESUMEN para la composici\X2\00F3\X0\n).'),$);
#26951=IFCPROPERTYSINGLEVALUE('AltoTotal_mm',$,IFCTEXT('31726'),$);
#26952=IFCPROPERTYSINGLEVALUE('AnchoBase_mm',$,IFCTEXT('9978'),$);
