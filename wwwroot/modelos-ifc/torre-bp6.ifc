#26369=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos EEB-U113-CT100501-L000-DIS6052-H1\X2\2026\X0\H31: siluetas BP6 (cara transversal) y BP6-LONG (cara longitudinal)'),$);
#26370=IFCPROPERTYSINGLEVALUE('AltoTotal_mm',$,IFCTEXT('58000'),$);
#26371=IFCPROPERTYSINGLEVALUE('AnchoBase_mm',$,IFCTEXT('14992'),$);
#26372=IFCPROPERTYSINGLEVALUE('Miembros',$,IFCTEXT('890'),$);
#26373=IFCPROPERTYSINGLEVALUE('MiembrosConPerfil',$,IFCTEXT('162'),$);
#26374=IFCPROPERTYSINGLEVALUE('PesoPerfilesLeidos_kg',$,IFCTEXT('3973.1'),$);
#26375=IFCPROPERTYSINGLEVALUE('Supuesto01',$,IFCTEXT('Geometr\X2\00ED\X0\a = ejes de las piezas de las siluetas de los planos (cara transversal); las caras longitudinales se proyectan con la silueta BP6-LONG del plano H8.'),$);
#26376=IFCPROPERTYSINGLEVALUE('Supuesto02',$,IFCTEXT('Las dos caras de cada vista se suponen id\X2\00E9\X0\nticas (simetr\X2\00ED\X0\a), y la profundidad sigue el contorno de la silueta longitudinal.'),$);
#26377=IFCPROPERTYSINGLEVALUE('Supuesto03',$,IFCTEXT('La base corresponde a la pata de 12 m (cota 0 del plano); las patas de 1,5 a 10,5 m (H21\X2\2013\X0\H25) acortan la base y no se modelan como variante.'),$);
#26378=IFCPROPERTYSINGLEVALUE('Supuesto04',$,IFCTEXT('Cada pieza se relaciona con la hoja que detalla su zona (capa FOR de la silueta de cada plano); en zonas compartidas se elige la hoja de zona m\X2\00E1\X0\s espec\X2\00ED\X0\fica.'),$);
#26379=IFCPROPERTYSINGLEVALUE('Supuesto05',$,IFCTEXT('Marcas: solo aparecen en los miembros donde la burbuja del plano, su leader y el eje de la vista coinciden con un miembro del modelo (\X2\2264\X0\ 40 mm); los miembros sin marca no tienen v\X2\00ED\X0\nculo verificado, aunque su marca exista en la lista de materiales.'),$);
#26380=IFCPROPERTYSINGLEVALUE('Supuesto06',$,IFCTEXT('El perfil de cada pieza sale de su marca le\X2\00ED\X0\da en el plano y de la lista de materiales; las piezas sin marca vinculada se dibujan como tubo \X2\00D8\X0\40 mm (PerfilLeido = No).'),$);
#26381=IFCPROPERTYSINGLEVALUE('Supuesto07',$,IFCTEXT('La orientaci\X2\00F3\X0\n de las alas de los \X2\00E1\X0\ngulos no se lee de los planos procesados: se usa la convenci\X2\00F3\X0\n de montaje (montantes con alas hacia el interior; diagonales con un ala en el plano de la cara y la otra hacia el interior).'),$);
#26382=IFCPROPERTYSINGLEVALUE('Supuesto08',$,IFCTEXT('El tal\X2\00F3\X0\n del \X2\00E1\X0\ngulo se ubica sobre la l\X2\00ED\X0\nea de trabajo del plano (sin gramil ni excentricidad de conexi\X2\00F3\X0\n).'),$);
#26383=IFCPROPERTYSINGLEVALUE('Supuesto09',$,IFCTEXT('No se modelan placas, tornillos ni cartelas.'),$);
#26384=IFCPROPERTYSINGLEVALUE('Validacion01',$,IFCTEXT('H11 \X2\00B7\X0\ Altura total de la silueta: plano 58000.0 mm / modelo 58000.0 mm'),$);
#26385=IFCPROPERTYSINGLEVALUE('Validacion02',$,IFCTEXT('H2 \X2\00B7\X0\ Ancho total de brazos: plano 20736.0 mm / modelo 20736.0 mm'),$);
