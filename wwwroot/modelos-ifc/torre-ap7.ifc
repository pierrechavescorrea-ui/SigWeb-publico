#26952=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos DIS6049 H01\X2\2013\X0\H37 y listado de materiales torre AP rev. A14 (hoja RESUMEN para la composici\X2\00F3\X0\n).'),$);
