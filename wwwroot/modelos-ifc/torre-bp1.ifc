#16195=IFCRELASSOCIATESMATERIAL('05lbTh96z7AOjKzH_ikRMf',#5,$,$,(#4952,#4988,#5024,#5060,#5822,#5858,#9312,#9348,#9832,#9868,#9904,#9940,#9976,#10012,#10048,#10084),#16194);
#16196=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos DIS6052 (silueta BP5); cuerpo BP1 = tronco cortado a z = 30 m de esa silueta (ancho de la cara en la base del cuerpo en el plano H9: 5133 mm; modelo: 5146 mm).'),$);
#16197=IFCPROPERTYSINGLEVALUE('AltoTotal_mm',$,IFCTEXT('35500'),$);
#16198=IFCPROPERTYSINGLEVALUE('AnchoBase_mm',$,IFCTEXT('8576'),$);
#16199=IFCPROPERTYSINGLEVALUE('Miembros',$,IFCTEXT('540'),$);
#16200=IFCPROPERTYSINGLEVALUE('MiembrosConPerfil',$,IFCTEXT('118'),$);
#16201=IFCPROPERTYSINGLEVALUE('PesoPerfilesLeidos_kg',$,IFCTEXT('2495.4'),$);
#16202=IFCPROPERTYSINGLEVALUE('Supuesto01',$,IFCTEXT('BP1 = misma silueta que BP5 sin los 18 m inferiores del tronco: el ancho del plano H9 en la base del cuerpo coincide con el de la silueta a z = 30 m; cada cuerpo menor est\X2\00E1\X0\ 4.5 m m\X2\00E1\X0\s arriba que el anterior.'),$);
#16203=IFCPROPERTYSINGLEVALUE('Supuesto02',$,IFCTEXT('La pata de 12 m (H27) se estrecha en planta para empalmar con la base del cuerpo BP1; su despiece real puede diferir. Sus piezas no llevan marca vinculada.'),$);
#16204=IFCPROPERTYSINGLEVALUE('Supuesto03',$,IFCTEXT('Geometr\X2\00ED\X0\a = ejes de las piezas de las siluetas de los planos (cara transversal); las caras longitudinales se proyectan con la silueta BP6-LONG del plano H8.'),$);
#16205=IFCPROPERTYSINGLEVALUE('Supuesto04',$,IFCTEXT('Las dos caras de cada vista se suponen id\X2\00E9\X0\nticas (simetr\X2\00ED\X0\a), y la profundidad sigue el contorno de la silueta longitudinal.'),$);
#16206=IFCPROPERTYSINGLEVALUE('Supuesto05',$,IFCTEXT('Cada pieza se relaciona con la hoja que detalla su zona (capa FOR de la silueta de cada plano); en zonas compartidas se elige la hoja de zona m\X2\00E1\X0\s espec\X2\00ED\X0\fica.'),$);
#16207=IFCPROPERTYSINGLEVALUE('Supuesto06',$,IFCTEXT('La cara longitudinal de BP5 se deriv\X2\00F3\X0\ de la silueta BP6-LONG reescalada en altura (no hay silueta longitudinal BP5 en los planos).'),$);
#16208=IFCPROPERTYSINGLEVALUE('Supuesto07',$,IFCTEXT('Marcas: solo aparecen en los miembros donde la burbuja del plano, su leader y el eje de la vista coinciden con un miembro del modelo (\X2\2264\X0\ 40 mm); los miembros sin marca no tienen v\X2\00ED\X0\nculo verificado, aunque su marca exista en la lista de materiales.'),$);
#16209=IFCPROPERTYSINGLEVALUE('Supuesto08',$,IFCTEXT('Las marcas y hojas de los paneles compartidos son las del modelo de origen (los paneles son iguales en todos los cuerpos).'),$);
#16210=IFCPROPERTYSINGLEVALUE('Supuesto09',$,IFCTEXT('El perfil de cada pieza sale de su marca le\X2\00ED\X0\da en el plano y de la lista de materiales; las piezas sin marca vinculada se dibujan como tubo \X2\00D8\X0\40 mm (PerfilLeido = No).'),$);
#16211=IFCPROPERTYSINGLEVALUE('Supuesto10',$,IFCTEXT('La orientaci\X2\00F3\X0\n de las alas de los \X2\00E1\X0\ngulos no se lee de los planos procesados: se usa la convenci\X2\00F3\X0\n de montaje (montantes con alas hacia el interior; diagonales con un ala en el plano de la cara y la otra hacia el interior).'),$);
#16212=IFCPROPERTYSINGLEVALUE('Supuesto11',$,IFCTEXT('El tal\X2\00F3\X0\n del \X2\00E1\X0\ngulo se ubica sobre la l\X2\00ED\X0\nea de trabajo del plano (sin gramil ni excentricidad de conexi\X2\00F3\X0\n).'),$);
#16213=IFCPROPERTYSINGLEVALUE('Supuesto12',$,IFCTEXT('No se modelan placas, tornillos ni cartelas.'),$);
#16214=IFCPROPERTYSINGLEVALUE('Validacion01',$,IFCTEXT('H9 \X2\00B7\X0\ ancho de la cara en la base del cuerpo BP1: plano 5133 mm / modelo 5146 mm'),$);
