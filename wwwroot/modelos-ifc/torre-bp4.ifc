#23008=IFCRELASSOCIATESMATERIAL('2I_c2AuVj49erZf4JEVa5x',#5,$,$,(#2958,#2994,#3030,#3066,#3102,#3138,#3174,#3210,#3249,#3285,#3321,#3357,#3393,#3429,#3465,#3501,#3540,#3576,#3612,#3648,#3684,#3720,#3756,#3792,#3978,#4014,#4050,#4086,#4122,#4158,#4194,#4230,#4266,#4302,#4338,#4374,#4410,#4446,#4482,#4518,#4554,#4590,#4626,#4662,#4829,#4865,#4901,#4937,#5032,#5068,#5160,#5196,#5288,#5324,#5416,#5452,#5488,#5524,#5560,#5596,#5632,#5668,#5704,#5740,#5776,#5812,#5848,#5884,#5920,#5956,#5992,#6028,#6064,#6100,#6136,#6172,#6379,#6415,#6507,#6543,#6635,#6671,#6710,#6746,#6782,#6818,#6854,#6890,#6926,#6962,#6998,#7034,#7070,#7106,#7534,#7570,#7774,#7810,#8017,#8053,#8145,#8181,#8404,#8440,#9932,#9968,#10063,#10099,#13522,#13558,#13594,#13630,#19468,#19504,#20481),#23007);
#23009=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos DIS6052 (silueta BP6); cuerpo BP4 = tronco cortado a z = 21 m de esa silueta (ancho de la cara en la base del cuerpo en el plano H16: 8991 mm; modelo: 8992 mm).'),$);
#23010=IFCPROPERTYSINGLEVALUE('AltoTotal_mm',$,IFCTEXT('49000'),$);
#23011=IFCPROPERTYSINGLEVALUE('AnchoBase_mm',$,IFCTEXT('12420'),$);
#23012=IFCPROPERTYSINGLEVALUE('Miembros',$,IFCTEXT('774'),$);
#23013=IFCPROPERTYSINGLEVALUE('MiembrosConPerfil',$,IFCTEXT('148'),$);
#23014=IFCPROPERTYSINGLEVALUE('PesoPerfilesLeidos_kg',$,IFCTEXT('3370.6'),$);
#23015=IFCPROPERTYSINGLEVALUE('Supuesto01',$,IFCTEXT('BP4 = misma silueta que BP6 sin los 9 m inferiores del tronco: el ancho del plano H16 en la base del cuerpo coincide con el de la silueta a z = 21 m; cada cuerpo menor est\X2\00E1\X0\ 4.5 m m\X2\00E1\X0\s arriba que el anterior.'),$);
#23016=IFCPROPERTYSINGLEVALUE('Supuesto02',$,IFCTEXT('La pata de 12 m (H27) se estrecha en planta para empalmar con la base del cuerpo BP4; su despiece real puede diferir. Sus piezas no llevan marca vinculada.'),$);
#23017=IFCPROPERTYSINGLEVALUE('Supuesto03',$,IFCTEXT('Geometr\X2\00ED\X0\a = ejes de las piezas de las siluetas de los planos (cara transversal); las caras longitudinales se proyectan con la silueta BP6-LONG del plano H8.'),$);
#23018=IFCPROPERTYSINGLEVALUE('Supuesto04',$,IFCTEXT('Las dos caras de cada vista se suponen id\X2\00E9\X0\nticas (simetr\X2\00ED\X0\a), y la profundidad sigue el contorno de la silueta longitudinal.'),$);
#23019=IFCPROPERTYSINGLEVALUE('Supuesto05',$,IFCTEXT('Cada pieza se relaciona con la hoja que detalla su zona (capa FOR de la silueta de cada plano); en zonas compartidas se elige la hoja de zona m\X2\00E1\X0\s espec\X2\00ED\X0\fica.'),$);
#23020=IFCPROPERTYSINGLEVALUE('Supuesto06',$,IFCTEXT('Marcas: solo aparecen en los miembros donde la burbuja del plano, su leader y el eje de la vista coinciden con un miembro del modelo (\X2\2264\X0\ 40 mm); los miembros sin marca no tienen v\X2\00ED\X0\nculo verificado, aunque su marca exista en la lista de materiales.'),$);
#23021=IFCPROPERTYSINGLEVALUE('Supuesto07',$,IFCTEXT('Las marcas y hojas de los paneles compartidos son las del modelo de origen (los paneles son iguales en todos los cuerpos).'),$);
#23022=IFCPROPERTYSINGLEVALUE('Supuesto08',$,IFCTEXT('El perfil de cada pieza sale de su marca le\X2\00ED\X0\da en el plano y de la lista de materiales; las piezas sin marca vinculada se dibujan como tubo \X2\00D8\X0\40 mm (PerfilLeido = No).'),$);
#23023=IFCPROPERTYSINGLEVALUE('Supuesto09',$,IFCTEXT('La orientaci\X2\00F3\X0\n de las alas de los \X2\00E1\X0\ngulos no se lee de los planos procesados: se usa la convenci\X2\00F3\X0\n de montaje (montantes con alas hacia el interior; diagonales con un ala en el plano de la cara y la otra hacia el interior).'),$);
#23024=IFCPROPERTYSINGLEVALUE('Supuesto10',$,IFCTEXT('El tal\X2\00F3\X0\n del \X2\00E1\X0\ngulo se ubica sobre la l\X2\00ED\X0\nea de trabajo del plano (sin gramil ni excentricidad de conexi\X2\00F3\X0\n).'),$);
#23025=IFCPROPERTYSINGLEVALUE('Supuesto11',$,IFCTEXT('No se modelan placas, tornillos ni cartelas.'),$);
#23026=IFCPROPERTYSINGLEVALUE('Validacion01',$,IFCTEXT('H16 \X2\00B7\X0\ ancho de la cara en la base del cuerpo BP4: plano 8991 mm / modelo 8992 mm'),$);
#23027=IFCPROPERTYSET('3IQeeA8C96S9u2r2L_G0T1',#5,'SigWeb_Torre',$,(#23009,#23010,#23011,#23012,#23013,#23014,#23015,#23016,#23017,#23018,#23019,#23020,#23021,#23022,#23023,#23024,#23025,#23026));
#23028=IFCRELDEFINESBYPROPERTIES('0wU4RwtQ5CUAW8dFAkLV2m',#5,$,$,(#25),#23027);
