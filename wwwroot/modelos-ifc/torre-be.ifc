2430,#52519,#52553,#52587,#52621,#52655,#52689,#52810,#52844,#52907,#52941,#53111,#53200,#53260,#53294,#53357,#53391,#53587,#53621,#53684,#53718,#53752,#53786,#53820,#53854,#53975,#54009,#54072,#54106,#54224,#54258,#54318,#54352,#54415,#54449,#54645,#54679,#54843,#54955,#55044,#55078,#55112,#55146,#55261,#55295,#55329,#55363,#55501,#55564,#55598,#55632,#55666,#55700,#55896,#55930,#56120,#56154,#56188,#56410,#56444,#56608,#56694,#56783,#56817,#56851,#56885,#57000,#57034,#57068,#57102,#57240,#57303,#57337,#57371,#57405,#57439,#57583,#57617,#57755,#57789,#57823,#58045,#58079,#58113,#58199,#58389,#58423,#58457,#58491,#58525,#58559,#58671,#58705,#58739,#58880,#58914,#58948,#59008,#59042,#59154,#59240,#59274,#59360,#59472,#59506,#59540,#59600,#60100,#60134,#60168,#60254,#60392,#60426,#60460,#60494,#60528,#60562,#60674,#60708,#60742,#60883,#60917,#60951,#61011,#61045,#61157,#61191,#61225,#61311,#61371,#61405,#61439,#61499,#61999,#62033,#62093,#62234,#62297,#62331,#62365,#62399,#62459,#62493,#62527,#62642,#62676,#62710,#62744,#62778,#62812,#62846,#62958,#62992,#63026,#63089,#63123,#63287,#63321,#63355,#63389,#63423,#63483,#63595,#63655,#63689,#63723,#63757,#63817,#63851,#63885,#64000,#64034,#64068,#64102,#64136,#64170,#64204,#64264,#64298,#64332,#64395,#64429,#64593,#64627,#64661),#73231);
#73233=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos DIS6054-H1\X2\2026\X0\H47 (sin H31). Geometr\X2\00ED\X0\a global: esquema a escala de la hoja 19 (capa TORN); marcas y perfiles: burbujas y listas de materiales de cada hoja.'),$);
#73234=IFCPROPERTYSINGLEVALUE('AltoTotal_mm',$,IFCTEXT('106315'),$);
#73235=IFCPROPERTYSINGLEVALUE('AnchoBase_mm',$,IFCTEXT('29525'),$);
#73236=IFCPROPERTYSINGLEVALUE('Miembros',$,IFCTEXT('2508'),$);
#73237=IFCPROPERTYSINGLEVALUE('MiembrosConPerfil',$,IFCTEXT('825'),$);
#73238=IFCPROPERTYSINGLEVALUE('PesoPerfilesLeidos_kg',$,IFCTEXT('48121.6'),$);
#73239=IFCPROPERTYSINGLEVALUE('Supuesto01',$,IFCTEXT('Tramo 44,5\X2\2013\X0\47,0 m: el esquema no trae miembros; se a\X2\00F1\X0\adieron 46 piezas de la silueta del plano DIS6044 (paneles que cruzan ese tramo). Sin marcas.'),$);
#73240=IFCPROPERTYSINGLEVALUE('Supuesto02',$,IFCTEXT('Cuello, cabeza, viga y brazos (z > 85 m) reconstruidos con la silueta del plano DIS6044 (vistas transversal y longitudinal), reescalada para empalmar con el cuerpo (x1.081 en planta, x1.015 en altura). Sustituye 356 miembros anteriores de esa zona, incluidas sus marcas.'),$);
#73241=IFCPROPERTYSINGLEVALUE('Supuesto03',$,IFCTEXT('Geometr\X2\00ED\X0\a global tomada de la silueta a escala de la hoja 19, extruida con planta cuadrada y simetr\X2\00ED\X0\a de 4 caras (el esquema solo da una vista de elevaci\X2\00F3\X0\n). Corresponde a la variante de mayor altura (alto 107,3 m).'),$);
#73242=IFCPROPERTYSINGLEVALUE('Supuesto04',$,IFCTEXT('Marcas: solo aparecen en los miembros donde la burbuja del plano, su leader y el eje coinciden geom\X2\00E9\X0\tricamente con un miembro del esquema (tolerancia \X2\2248\X0\ 27 mm). Los miembros sin marca NO tienen v\X2\00ED\X0\nculo verificado, aunque su marca exista en la lista de materiales.'),$);
#73243=IFCPROPERTYSINGLEVALUE('Supuesto05',$,IFCTEXT('La marca se verific\X2\00F3\X0\ en la cara A del plano; en las caras B, C y D se asigna por simetr\X2\00ED\X0\a (el plano indica caras transversal y longitudinal distintas, as\X2\00ED\X0\ que puede diferir).'),$);
#73244=IFCPROPERTYSINGLEVALUE('Supuesto06',$,IFCTEXT('Caras: el plano H10 rotula cada marca de diagonal como ''cara transversal'' (802D, 803D\X2\2026\X0\) o ''cara longitudinal'' (810D, 811D\X2\2026\X0\); el visor asigna A y C como transversales y B y D como longitudinales (convenci\X2\00F3\X0\n del visor, por confirmar). Donde el plano no rotula la cara, la marca se muestra en las cuatro.'),$);
#73245=IFCPROPERTYSINGLEVALUE('Supuesto07',$,IFCTEXT('Ejes con marca que el esquema no trae se agregaron con la geometr\X2\00ED\X0\a del propio plano (fuente indicada en cada miembro).'),$);
#73246=IFCPROPERTYSINGLEVALUE('Supuesto08',$,IFCTEXT('Cabeza y brazos: marcos planos en las caras A y C, sin profundidad real.'),$);
#73247=IFCPROPERTYSINGLEVALUE('Supuesto09',$,IFCTEXT('Secciones en planta (JJ\X2\2026\X0\PP, hojas 11, 14, 17, 20, 23, 26, 29): modeladas a la altura que da su ancho (planta cuadrada). Las hojas dibujan media planta y se espeja respecto al eje de simetr\X2\00ED\X0\a; la orientaci\X2\00F3\X0\n de la planta respecto a las caras A\X2\2013\X0\D es una convenci\X2\00F3\X0\n del visor.'),$);
#73248=IFCPROPERTYSINGLEVALUE('Supuesto10',$,IFCTEXT('Hojas 1\X2\2013\X0\9 (cabeza, brazos, viga, delta): solo se colocaron las vistas que coinciden estad\X2\00ED\X0\sticamente con el esquema (\X2\2265\X0\ 6 nodos a 27 mm); las dem\X2\00E1\X0\s vistas de esas hojas siguen sin ubicar. Patas y stubs (H32\X2\2013\X0\H40) tampoco est\X2\00E1\X0\n ubicados; su lista de materiales s\X2\00ED\X0\ est\X2\00E1\X0\ disponible.'),$);
#73249=IFCPROPERTYSINGLEVALUE('Supuesto11',$,IFCTEXT('Secciones de barra con espesor esquem\X2\00E1\X0\tico; el perfil real es el de la lista de materiales. Longitudes de modelo = distancia entre nodos del eje; la longitud de pieza (lista) es la de despiece y difiere por cortes y holguras.'),$);
#73250=IFCPROPERTYSINGLEVALUE('Supuesto12',$,IFCTEXT('El esquema tiene un corte de vista a \X2\2248\X0\ 56 m de altura (entre T4 y T5), que aparece como vac\X2\00ED\X0\o.'),$);
#73251=IFCPROPERTYSINGLEVALUE('Supuesto13',$,IFCTEXT('Nombres de tramo (T1\X2\2026\X0\T10) y de cara (A\X2\2013\X0\D) son convenciones del visor, no marcas del plano. La hoja 31 (nueva) y las hojas 30 y 33\X2\2013\X0\37 son detalles de plataforma sin lista de materiales ni ejes: no se ubican en el modelo (las plataformas siguen esquem\X2\00E1\X0\ticas).'),$);
#73252=IFCPROPERTYSINGLEVALUE('Supuesto14',$,IFCTEXT('Hojas 41\X2\2013\X0\47 (H41\X2\2013\X0\H43 con revisi\X2\00F3\X0\n nueva) (acceso, plataformas, barandas, escaleras, guardas y soportes de escalera): sus piezas est\X2\00E1\X0\n en la lista de materiales, pero NO est\X2\00E1\X0\n ubicadas en el 3D (las hojas no fijan la cota de cada plataforma).'),$);
#73253=IFCPROPERTYSINGLEVALUE('Supuesto15',$,IFCTEXT('Plataformas esquem\X2\00E1\X0\ticas (amarillo): marco perimetral + travesa\X2\00F1\X0\os cada ~800 mm en los niveles KK, MM, NN y OO (los que tienen hoja ''PLATAFORMA PARA CORTE I-I''), inset 1200 mm de las patas. No hay plano de ubicaci\X2\00F3\X0\n: posici\X2\00F3\X0\n y trama son supuestos, no medidas. Escaleras, barandas y m\X2\00F3\X0\dulos reales (H41\X2\2013\X0\H47) siguen sin ubicar.'),$);
#73254=IFCPROPERTYSINGLEVALUE('Supuesto16',$,IFCTEXT('Revisi\X2\00F3\X0\n nueva de las hojas DIS6054-H1\X2\2026\X0\H20 (A3\X2\2013\X0\A9): la geometr\X2\00ED\X0\a de las hojas (esquema TORN y ejes) es id\X2\00E9\X0\ntica a la revisi\X2\00F3\X0\n anterior; se actualizaron la lista de materiales, los perfiles/longitudes de las marcas y la coherencia con el eje del modelo.'),$);
#73255=IFCPROPERTYSINGLEVALUE('Supuesto17',$,IFCTEXT('Revisi\X2\00F3\X0\n nueva de las hojas DIS6054-H21\X2\2026\X0\H40: la geometr\X2\00ED\X0\a de las hojas (esquema TORN y ejes) es id\X2\00E9\X0\ntica a la revisi\X2\00F3\X0\n anterior; se actualizaron la lista de materiales, los perfiles/longitudes de las marcas y la coherencia con el eje del modelo.'),$);
#73256=IFCPROPERTYSINGLEVALUE('Supuesto18',$,IFCTEXT('Revisi\X2\00F3\X0\n nueva de las hojas DIS6054-H41\X2\2026\X0\H43: la geometr\X2\00ED\X0\a de las hojas (esquema TORN y ejes) es id\X2\00E9\X0\ntica a la revisi\X2\00F3\X0\n anterior; se actualizaron la lista de materiales, los perfiles/longitudes de las marcas y la coherencia con el eje del modelo.'),$);
#73257=IFCPROPERTYSINGLEVALUE('Supuesto19',$,IFCTEXT('El perfil de cada pieza sale de su marca le\X2\00ED\X0\da en el plano y de la lista de materiales; las piezas sin marca vinculada se dibujan como tubo \X2\00D8\X0\40 mm (PerfilLeido = No).'),$);
#73258=IFCPROPERTYSINGLEVALUE('Supuesto20',$,IFCTEXT('La orientaci\X2\00F3\X0\n de las alas de los \X2\00E1\X0\ngulos no se lee de los planos procesados: se usa la convenci\X2\00F3\X0\n de montaje (montantes con alas hacia el interior; diagonales con un ala en el plano de la cara y la otra hacia el interior).'),$);
#73259=IFCPROPERTYSINGLEVALUE('Supuesto21',$,IFCTEXT('El tal\X2\00F3\X0\n del \X2\00E1\X0\ngulo se ubica sobre la l\X2\00ED\X0\nea de trabajo del plano (sin gramil ni excentricidad de conexi\X2\00F3\X0\n).'),$);
#73260=IFCPROPERTYSINGLEVALUE('Supuesto22',$,IFCTEXT('No se modelan placas, tornillos ni cartelas.'),$);
