    private IEnumerable<CampoTabla> ColumnasTorres => motor?.Visibles ?? Enumerable.Empty<CampoTabla>();

    private IEnumerable<ColumnaNativa> ColumnasNativasTorres()
    {
        ElementoTrazado? E(int id) => elementos.FirstOrDefault(x => x.Id == id);
        return new[]
        {
            new ColumnaNativa("Codigo", "Código", TipoCampoTabla.Texto, id => E(id)?.Codigo),
            new ColumnaNativa("Capa", "Capa", TipoCampoTabla.Texto, id => E(id) is { } e ? NombreCapaDe(e) : null),
            new ColumnaNativa("Latitud", "Latitud", TipoCampoTabla.Numero, id => E(id)?.Latitud),
            new ColumnaNativa("Longitud", "Longitud", TipoCampoTabla.Numero, id => E(id)?.Longitud),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                motor = await MotorTabla.CargarAsync(Db, "trazado-torres", ColumnasNativasTorres(), elementos.Select(e => (e.Id, e.Codigo)));
                StateHasChanged();
            }
            catch { motor = null; }
            referencia = DotNetObjectReference.Create(this);
            await DibujarMapa();
            // ?torre=Id (buscador rápido Ctrl + K): abre esa torre.
            torreAplicada = TorreQ;
            if (TorreQ is int tq && elementos.FirstOrDefault(e => e.Id == tq) is { } torreQ)
            {
                await IrATorre(torreQ);
                if (HdvQ == true && componentesDeLaTorre.FirstOrDefault(c => c.EsHojaDeVida) is { } hv) AbrirFichaComponente(hv);
                StateHasChanged();
            }
        }
    }

    // Solo se listan las capas que todavía tienen al menos una torre activa
    // en el mapa. Una capa cuyas torres fueron todas eliminadas o migradas
    // hacia otra queda vacía y ya no aporta nada en este panel — mostrarla
    // solo sería ruido (sus datos, si los tuviera, siguen en la Papelera).
    private void CargarCapas()
    {
        conteoTorresPorCapa = Db.ElementosTrazado.AsNoTracking()
            .Where(e => !e.Eliminado && e.CapaTrazadoId != null)
            .GroupBy(e => e.CapaTrazadoId!.Value)
            .ToDictionary(g => g.Key, g => g.Count());

        capas = Db.Capas.AsNoTracking()
            .OrderByDescending(c => c.FechaCarga)
            .ToList()
            .Where(c => conteoTorresPorCapa.ContainsKey(c.Id))
            .ToList();
    }

    // Una torre solo se dibuja/lista si no está eliminada Y (no tiene capa,
    // caso raro, o su capa está marcada como visible).
    private void CargarElementos()
    {
        var capasVisibles = capas.Where(c => c.Visible).Select(c => c.Id).ToHashSet();
        elementos = Db.ElementosTrazado.AsNoTracking()
            .Where(e => !e.Eliminado)
            .ToList()
            .Where(e => e.CapaTrazadoId == null || capasVisibles.Contains(e.CapaTrazadoId.Value))
            .OrderBy(e => e.Codigo)
            .ToList();
    }

    private string? NombreCapaDe(ElementoTrazado torre)
    {
        if (torre.CapaTrazadoId is null) return null;
        return capas.FirstOrDefault(c => c.Id == torre.CapaTrazadoId)?.Nombre;
    }

    // ---------- Gestión de capas: apagar, renombrar, eliminar del mapa ----------
    private async Task AlternarVisibilidadCapa(CapaTrazado c, bool visible)
    {
        var entidad = await Db.Capas.FindAsync(c.Id);
        if (entidad is not null)
        {
            entidad.Visible = visible;
            await Db.SaveChangesAsync();
        }
        Db.ChangeTracker.Clear();

        CargarCapas();
        CargarElementos();
        await DibujarMapa();
    }

