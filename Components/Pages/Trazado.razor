    // ---------- Resultados de ensayos (módulo Ensayos), sólo lectura ----------
    private void CargarResultadosEnsayoDelComponente()
    {
        resultadosEnsayoComponente = new();
        camposPorTipoEnsayo = new();
        archivosPorInformePata = new();
        archivosListaPorInformePata = new();
        if (componenteSeleccionado is null) return;

        var resultadoIds = Db.ResultadosEnsayoComponente.AsNoTracking()
            .Where(rc => rc.ComponenteId == componenteSeleccionado.Id)
            .Select(rc => rc.ResultadoEnsayoId)
            .Distinct()
            .ToList();
        if (resultadoIds.Count == 0) return;

        var resultados = Db.ResultadosEnsayo.AsNoTracking()
            .Where(r => resultadoIds.Contains(r.Id) && !r.Eliminado)
            .ToList();
        if (resultados.Count == 0) return;

        var tipoIds = resultados.Select(r => r.TipoEnsayoId).Distinct().ToList();
        var tipos = Db.TiposEnsayo.AsNoTracking().Where(t => tipoIds.Contains(t.Id)).ToDictionary(t => t.Id, t => t);

        var camposTodos = Db.CamposEnsayo.AsNoTracking()
            .Where(c => tipoIds.Contains(c.TipoEnsayoId) && c.Activo)
            .OrderBy(c => c.Orden).ThenBy(c => c.Etiqueta)
            .ToList();
        foreach (var c in camposTodos)
        {
            if (!camposPorTipoEnsayo.TryGetValue(c.TipoEnsayoId, out var lista))
            {
                lista = new();
                camposPorTipoEnsayo[c.TipoEnsayoId] = lista;
            }
            lista.Add(c);
        }
        var camposPorId = camposTodos.ToDictionary(c => c.Id, c => c.Clave);

        var idsResultado = resultados.Select(r => r.Id).ToList();
        var valoresPorResultado = new Dictionary<int, Dictionary<string, string>>();
        foreach (var v in Db.ValoresCampoEnsayo.AsNoTracking().Where(v => idsResultado.Contains(v.ResultadoEnsayoId)))
        {
            if (!camposPorId.TryGetValue(v.CampoEnsayoId, out var clave)) continue;
            if (!valoresPorResultado.TryGetValue(v.ResultadoEnsayoId, out var dict))
            {
                dict = new();
                valoresPorResultado[v.ResultadoEnsayoId] = dict;
            }
            dict[clave] = v.Valor;
        }

        var informeIds = resultados.Where(r => r.InformeId != null).Select(r => r.InformeId!.Value).Distinct().ToList();
        var informes = Db.Informes.AsNoTracking().Where(i => informeIds.Contains(i.Id)).ToDictionary(i => i.Id, i => i.Numero);

        archivosPorInformePata = Db.ArchivosInforme.AsNoTracking().Where(a => informeIds.Contains(a.InformeId))
            .GroupBy(a => a.InformeId)
            .ToDictionary(g => g.Key, g => g.Count());
        foreach (var g in Db.ArchivosInforme.AsNoTracking().Where(a => informeIds.Contains(a.InformeId)).OrderBy(a => a.Id).ToList().GroupBy(a => a.InformeId))
            archivosListaPorInformePata[g.Key] = g.ToList();

        resultadosEnsayoComponente = resultados
            .GroupBy(r => r.TipoEnsayoId)
            .Where(g => tipos.ContainsKey(g.Key))
            .Select(g => (
                Tipo: tipos[g.Key],
                Resultados: g.Select(r => new ResultadoEnsayoVista
                {
                    Id = r.Id,
                    SubElemento = r.SubElemento,
                    InformeId = r.InformeId,
                    InformeNumero = r.InformeId != null && informes.TryGetValue(r.InformeId.Value, out var n) ? n : "",
                    Valores = valoresPorResultado.TryGetValue(r.Id, out var vv) ? vv : new()
                }).ToList()
            ))
            .ToList();
    }

    // ---------- Ensayos de esta torre (sección "Archivos y ensayos" de la
    // Hoja de vida) ----------
    // A diferencia de CargarResultadosEnsayoDelComponente (un solo
    // elemento), esto junta TODOS los resultados de la torre —
    // ElementoTrazadoId es el dato real de "a qué torre pertenece" en
    // ResultadoEnsayo, independiente de si además quedó asociado a una
    // pata puntual — y los clasifica por Grupo de Ensayo (Concretos,
    // Suelos...) y luego por Tipo, para mostrarlos como listado (no como
    // tablas de datos crudos — esas ya se ven en la ficha de cada pata).
    // Un resultado sin pata asociada (ej. un ensayo que aplica a la torre
    // completa, no a una pata en particular) se agrupa bajo "Toda la
    // torre" en vez de perderse.
    private const string EtiquetaEnsayoTorreCompleta = "Toda la torre";

    // ---------- Materiales de esta torre (Hoja de vida › Archivos y ensayos) ----------
    // Los ligados a la torre, a uno de sus elementos o a su tiro (UbicacionMaterial), con sus adjuntos.
    private sealed record MaterialTorre(int UbicacionId, int MaterialId, string Titulo, string Lugar, List<AdjuntoMaterial> Adjuntos);
    private List<MaterialTorre> materialesTorre = new();
    private List<(int Id, string Titulo)> materialesDisponibles = new();
    private List<Componente> elementosTorreMaterial = new();
    private bool mostrarRelacionarMaterial;
    private string filtroMaterialTorre = "";
    private int lugarMaterialTorre;   // 0 = la torre; si no, Id del elemento

    private void CargarMaterialesTorre()
    {
        materialesTorre = new();
        if (componenteSeleccionado is not { } hv) return;
        try
        {
            var torreId = hv.ElementoTrazadoId;
            var compId = hv.Id;
            var tiroId = Db.ElementosTrazado.AsNoTracking().Where(t => t.Id == torreId).Select(t => t.TiroId).FirstOrDefault();
            // Hoja de vida: lo de la torre, sus elementos y su tiro. Un elemento (pata…): solo lo suyo.
            var ubic = (hv.EsHojaDeVida
                    ? Db.UbicacionesMaterial.AsNoTracking().Where(u => u.ElementoTrazadoId == torreId || (tiroId != null && u.TiroId == tiroId))
                    : Db.UbicacionesMaterial.AsNoTracking().Where(u => u.ComponenteId == compId))
                .OrderBy(u => u.Id).ToList();
            if (ubic.Count == 0) return;
            var lugares = SigWeb.Data.ListadoMateriales.LugaresMaterial.Cargar(Db);
            var ids = ubic.Select(u => u.MaterialId).Distinct().ToList();
            var mats = Db.Materiales.AsNoTracking().Where(m => ids.Contains(m.Id) && !m.Eliminado).ToDictionary(m => m.Id);
            var adj = Db.AdjuntosMaterial.AsNoTracking().Where(a => ids.Contains(a.MaterialId)).ToList()
                .GroupBy(a => a.MaterialId).ToDictionary(g => g.Key, g => g.OrderBy(a => Array.IndexOf(AdjuntoMaterial.Clases, a.Clase)).ThenByDescending(a => a.FechaCarga).ToList());
            materialesTorre = ubic.Where(u => mats.ContainsKey(u.MaterialId))
                .Select(u => new MaterialTorre(u.Id, u.MaterialId, TituloMaterial(mats[u.MaterialId]), lugares.Etiqueta(u), adj.TryGetValue(u.MaterialId, out var l) ? l : new()))
                .OrderBy(m => m.Titulo).ToList();
        }
        catch (Exception ex) { Console.Error.WriteLine("Hoja de vida: no se pudieron cargar materiales: " + ex.Message); }
    }

    private static string TituloMaterial(Material m) => string.IsNullOrWhiteSpace(m.NombreMaterial) ? $"Material #{m.Id}" : m.NombreMaterial;

    private void AbrirRelacionarMaterial()
    {
        if (componenteSeleccionado is not { } hv) return;
        mostrarRelacionarMaterial = true; filtroMaterialTorre = ""; lugarMaterialTorre = hv.EsHojaDeVida ? 0 : hv.Id;
        materialesDisponibles = Db.Materiales.AsNoTracking().Where(m => !m.Eliminado).OrderBy(m => m.NombreMaterial).ToList()
            .Select(m => (m.Id, $"{TituloMaterial(m)} · #{m.Id}")).ToList();
        elementosTorreMaterial = Db.Componentes.AsNoTracking().Where(c => c.ElementoTrazadoId == hv.ElementoTrazadoId && !c.EsHojaDeVida && (hv.EsHojaDeVida || c.Id == hv.Id))
            .OrderBy(c => c.Orden).ThenBy(c => c.Nombre).ToList();
    }

    private void CerrarRelacionarMaterial() { mostrarRelacionarMaterial = false; filtroMaterialTorre = ""; }

    private async Task RelacionarMaterialTorre(int materialId)
    {
        if (componenteSeleccionado is not { } hv) return;
        int? comp = !hv.EsHojaDeVida ? hv.Id : lugarMaterialTorre == 0 ? null : lugarMaterialTorre;
        if (!await Db.UbicacionesMaterial.AnyAsync(u => u.MaterialId == materialId && u.ElementoTrazadoId == hv.ElementoTrazadoId && u.ComponenteId == comp && u.TiroId == null))
        {
            Db.UbicacionesMaterial.Add(new UbicacionMaterial { MaterialId = materialId, ElementoTrazadoId = hv.ElementoTrazadoId, ComponenteId = comp });
            await Db.SaveChangesAsync();
        }
        Db.ChangeTracker.Clear();
        filtroMaterialTorre = "";
        CargarMaterialesTorre();
    }

