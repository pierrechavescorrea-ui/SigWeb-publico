        var entidad = await Db.ElementosTrazado.FindAsync(elementoSeleccionado.Id);
        if (entidad is null) return;
        entidad.IconoMapa = icono;
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        CargarElementos();
        elementoSeleccionado = elementos.FirstOrDefault(e => e.Id == entidad.Id);
        await DibujarMapa();
    }

