    // Se llama desde mapaTrazado.js cuando el usuario cambia la capa base
    // (Calle/Satélite/Híbrido/Terreno) desde el propio selector del mapa,
    // para que la próxima vez que abra el Trazado recuerde su elección.
    [JSInvokable]
    public async Task GuardarCapaBaseMapa(string capa)
    {
        if (configCapaBase == capa) return;
        configCapaBase = capa;

        var config = await Db.Configuracion.FindAsync(1);
        if (config is null)
        {
            config = new ConfiguracionEmpresa { Id = 1 };
            Db.Configuracion.Add(config);
        }
        config.CapaBaseMapa = capa;
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
    }

