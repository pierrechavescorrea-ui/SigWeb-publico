                                            <span class="flex-grow-1">@a.Descripcion</span>
                                            <span class="text-muted">@string.Join(", ", SelectorMultiple.Leer(a.Responsable))</span>
                                            <span class="text-muted">@a.Fecha.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        @if (exp && p.Productos.TryGetValue(a.Id, out var prods) && prods.Count > 0)
                                        {
                                            <div class="pa-producto small">
                                                @foreach (var (prod, axs) in prods)
                                                {
                                                    <div class="pildora-fila mb-1">
                                                        <span class="text-muted">Producto:</span> <span>@(string.IsNullOrWhiteSpace(prod) ? "—" : prod)</span>
                                                        @foreach (var x in axs) { <PildoraArchivo Url="@x.RutaArchivo" Nombre="@x.NombreOriginal" /> }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                    @if (exp)
                                    {
                                        <div class="d-flex justify-content-end mt-1">
                                            <a class="small" href="@($"planes-accion/{p.Plan.Id}?volver=atras")">Editar plan ▸</a>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (mostrarTabHallazgos)
            {
                <div class="border rounded p-2 mb-2">
