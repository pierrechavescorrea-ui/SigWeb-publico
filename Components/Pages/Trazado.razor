                    </div>
                    @if (hallazgosTorre.Count == 0)
                    {
                        <p class="text-muted small mb-0"><em>Sin riesgos materializados.</em></p>
                    }
                    else
                    {
                        <div class="tabla-scroll">
                            <table class="table table-sm table-hover tabla-compacta mb-0 align-middle tabla-pin">
                                <thead>
                                    <tr>
                                        <th style="width:95px;">Fecha</th>
                                        <th style="width:85px;">Riesgo</th>
                                        <th>Descripción</th>
                                        <th style="width:160px;">Dónde</th>
                                        <th>Acción</th>
                                        <th style="width:120px;">Estado</th>
                                        <th style="width:90px;">Revisión</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in hallazgosTorre)
                                    {
                                        var abierto = hallazgoAbierto == h.Hallazgo.Id;
                                        <tr role="button" class="@(abierto ? "table-active" : "")" title="Ver detalle" @onclick="() => hallazgoAbierto = abierto ? null : h.Hallazgo.Id">
                                            <td>@h.FechaSeguimiento.ToString("dd/MM/yyyy")</td>
                                            <td class="fw-bold">@h.CodigoRiesgo</td>
                                            <td class="small">
                                                <div class="fw-semibold">@h.DescripcionRiesgo</div>
                                                @if (!string.IsNullOrWhiteSpace(h.Hallazgo.Descripcion))
                                                {
                                                    <div class="text-muted">@h.Hallazgo.Descripcion</div>
                                                }
                                            </td>
                                            <td class="small">@h.DondeTexto</td>
                                            <td class="small">@(string.IsNullOrWhiteSpace(h.Hallazgo.Accion) ? "—" : h.Hallazgo.Accion)</td>
                                            <td><ValorCatalogo Tipo="@SigWeb.Data.Riesgos.SembradorCatalogosRiesgo.EstadoHallazgo" Valor="@NombreEstadoHallazgo(h.Hallazgo.Estado)" FondoDef="@ColorEstadoHallazgo(h.Hallazgo.Estado)" TextoDef="#fff" /></td>
                                            <td class="small text-muted">@h.VersionCodigo</td>
                                        </tr>
                                        @if (abierto)
                                        {
                                            <tr class="rg-hallazgo-detalle">
                                                <td colspan="7">
                                                    <div class="rg-hd">
                                                        <div class="rg-hd-col">
                                                            <div class="rg-hd-tit">Riesgo</div>
                                                            <div><strong>@h.CodigoRiesgo</strong> · @h.DescripcionRiesgo</div>
                                                            <div class="d-flex gap-1 mt-1 flex-wrap">
                                                                @{ var nv = EscalaRiesgo.Nivel(h.Probabilidad, h.Impacto); }
                                                                <span class="rg-pill" style="background:@EscalaRiesgo.Color(nv);color:@EscalaRiesgo.ColorTexto(nv)">@EscalaRiesgo.Nombre(nv)</span>
                                                                <span class="small text-muted">@EscalaRiesgo.Nombre(h.Probabilidad) × @EscalaRiesgo.Nombre(h.Impacto) · @h.VersionCodigo</span>
                                                            </div>
                                                            <a class="small" href="@($"riesgos/{h.RiesgoId}")">Abrir en la matriz ▸</a>
                                                        </div>
                                                        <div class="rg-hd-col">
                                                            <div class="rg-hd-tit">Seguimiento @h.FechaSeguimiento.ToString("dd/MM/yyyy")</div>
                                                            <ValorCatalogo Tipo="@SigWeb.Data.Riesgos.SembradorCatalogosRiesgo.ResultadoSeguimiento" Valor="@NombreResultadoSeg(h.Resultado)" FondoDef="@ColorResultadoSeg(h.Resultado)" TextoDef="#fff" />
                                                            <div class="small mt-1">@string.Join(", ", SelectorMultiple.Leer(h.ResponsableSeguimiento))</div>
                                                            @if (!string.IsNullOrWhiteSpace(h.ObservacionSeguimiento)) { <div class="small rg-multi mt-1">@h.ObservacionSeguimiento</div> }
                                                        </div>
                                                        <div class="rg-hd-col">
                                                            <div class="rg-hd-tit">Soportes</div>
                                                            @if (h.Archivos.Count == 0) { <div class="small text-muted">—</div> }
                                                            <div class="d-flex flex-wrap gap-1">
                                                                @foreach (var x in h.Archivos)
                                                                {
                                                                    <PildoraArchivo Url="@x.RutaArchivo" Nombre="@x.NombreOriginal" />
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="rg-hd-col">
                                                            <div class="rg-hd-tit">Planes de acción</div>
                                                            @if (h.Planes.Count == 0) { <div class="small text-muted">—</div> }
                                                            @foreach (var (pl, ep) in h.Planes)
                                                            {
                                                                <button type="button" class="rg-plan-res mb-1" title="Abrir plan" @onclick:stopPropagation="true" @onclick='() => Nav.NavigateTo($"planes-accion/{pl.Id}?volver=atras")'>
                                                                    <strong>@pl.Codigo</strong><span class="rg-plan-res-txt">@pl.DescripcionHallazgo</span><EstadoAccion Estado="ep" />
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
                        else if (actividadTabSeleccionada is int idActividadTab && TipoEnsayoParaActividad(idActividadTab) is { } grupoEnsayo)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="small">@grupoEnsayo.Tipo.Nombre</strong>
                        <a class="small" href="@($"ensayos/{grupoEnsayo.Tipo.Id}")">Ver todos ▸</a>
                    </div>
                    @{ var mostrarColumnaParte = grupoEnsayo.Resultados.Any(r => r.SubElemento != SubElementoResultado.Ninguno); }
                    <div class="table-responsive">
                        <table class="table table-sm tabla-compacta mb-0">
                            <thead>
                                <tr>
                                    @if (mostrarColumnaParte)
                                    {
                                        <th>Parte (pedestal/zapata)</th>
                                    }
                                    @foreach (var campo in CamposDeTipo(grupoEnsayo.Tipo.Id))
                                    {
                                        <th>@campo.Etiqueta@(string.IsNullOrEmpty(campo.Unidad) ? "" : $" ({campo.Unidad})")</th>
                                    }
                                    <th>Informe</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in grupoEnsayo.Resultados)
                                {
                                    <tr>
                                        @if (mostrarColumnaParte)
                                        {
                                            <td>@EtiquetaSubElementoTrazado(r.SubElemento)</td>
                                        }
                                        @foreach (var campo in CamposDeTipo(grupoEnsayo.Tipo.Id))
                                        {
                                            <td>@(r.Valores.TryGetValue(campo.Clave, out var v) ? v : "")</td>
                                        }
                                        <td>
                                            @if (r.InformeId is int idInformeFila)
                                            {
                                                <span>@r.InformeNumero</span>
                                                @foreach (var arch in ArchivosDeInforme(idInformeFila))
                                                {
                                                    <PildoraArchivo Url="@arch.RutaArchivo" Nombre="@arch.NombreOriginal" />
                                                }
                                                <button type="button" class="btn btn-sm btn-link p-0 ms-1 text-decoration-none" title="Subir o gestionar documentos del informe"
                                                        @onclick="() => AbrirArchivosInformePata(idInformeFila)"><Ico Nombre="agregar" /></button>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (parametrosDeActividad.Count == 0)
            {
                <p class="text-muted small"><em>Esta actividad no tiene parámetros activos. Agrégalos desde el módulo Actividades.</em></p>
            }
            else
            {
                <div class="ficha-params-grid">
                @foreach (var p in parametrosDeActividad)
                {
                    var registro = registrosEditables[p.Id];
                    var enEdicion = parametrosEnEdicion.Contains(p.Id);
                    <div class="ficha-bloque @(registro.Completado ? "ficha-aplica" : "ficha-no-aplica") @(enEdicion ? "ficha-bloque-edicion" : "")">
                        <div class="ficha-bloque-titulo justify-content-between">
                            <span class="d-flex align-items-center gap-2">
                                <input type="checkbox" class="form-check-input mt-0" title="Aplica / completado" disabled="@(!enEdicion)" checked="@registro.Completado"
                                       @onchange="@(e => { registro.Completado = (bool)e.Value!; if (!registro.Completado) registro.EstadoParametroId = null; })" />
                                <span>@(string.IsNullOrEmpty(p.Codigo) ? "" : $"{p.Codigo} — ")@p.Nombre</span>
                            </span>
                            <span class="d-flex align-items-center gap-1">
                                @if (enEdicion)
                                {
                                    <select class="form-select form-select-sm py-0" style="width:auto;" title="Estado (Matriz PIE)"
                                            value="@(registro.EstadoParametroId?.ToString() ?? "")"
                                            @onchange="@(e => CambiarEstadoRegistro(registro, e.Value?.ToString()))">
                                        <option value="">Sin estado</option>
                                        @foreach (var es in estadosParametro)
                                        {
                                            <option value="@es.Id">@es.Nombre</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    var est = estadosParametro.FirstOrDefault(x => x.Id == registro.EstadoParametroId);
                                    if (registro.Completado && est is not null)
                                    {
                                        <span class="badge" style="background:@est.Color;" title="Estado (Matriz PIE)">@est.Nombre</span>
                                    }
                                    <button type="button" class="ens-mini" title="Editar" @onclick="() => IniciarEdicionParametro(p.Id)"><Ico Nombre="editar" /></button>
                                }
                            </span>
