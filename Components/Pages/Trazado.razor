    public async ValueTask DisposeAsync()
    {
        referencia?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("destruirMapaTrazado");
        }
        catch (Exception)
        {
            // Si al momento de limpiar el mapa la página ya se está cerrando o
            // navegando a otra parte, el circuito de Blazor puede lanzar distintos
            // tipos de excepción según el momento exacto. No hay nada que limpiar
            // si el navegador ya no está ahí, así que se ignora.
        }
    }
