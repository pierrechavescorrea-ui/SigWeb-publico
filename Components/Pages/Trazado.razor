                        {
                            <ul class="small list-unstyled mt-1 mb-1 pildora-lista">
                                @foreach (var archivo in archivos)
                                {
                                    <li>
                                        <PildoraArchivo Url="@archivo.RutaArchivo" Nombre="@archivo.NombreOriginal" />
                                        @if (enEdicion)
                                        {
                                            <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1"
                                                    @onclick="() => PedirEliminarArchivoParametro(archivo, p.Id)" title="Quitar">✕</button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        @if (enEdicion)
                        {
                            <div class="d-flex justify-content-end align-items-center gap-2 mt-1">
                                @if (mensajesGuardado.TryGetValue(p.Id, out var msj))
                                {
                                    <span class="text-success small">@msj</span>
                                }
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CancelarEdicionParametro(p.Id)" title="Cancelar"><Ico Nombre="cancelar" /></button>
