                }
                </div>
            }

            @if (registrosVinculadosComponente.Count > 0)
            {
                <hr />
                <h6>Otros módulos vinculados aquí</h6>
                @foreach (var grupo in registrosVinculadosComponente.GroupBy(r => r.Modulo))
                {
                    <div class="small mb-1"><strong>@grupo.Key:</strong></div>
                    <ul class="small ps-3">
                        @foreach (var r in grupo)
                        {
                            <li><strong>@r.Titulo</strong> — <span class="text-muted">@r.Detalle</span></li>
