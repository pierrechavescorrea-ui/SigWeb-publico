    }

    private async Task GuardarEdicionCapa(CapaTrazado c)
    {
        var nombre = nombreEdicionCapa.Trim();
        if (string.IsNullOrWhiteSpace(nombre)) return;

        var entidad = await Db.Capas.FindAsync(c.Id);
        if (entidad is not null)
        {
