                            <span class="ficha-bloque-etiqueta">Observación</span>
                            @if (enEdicion)
                            {
                                <input class="form-control form-control-sm" @bind="registro.Observaciones" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrWhiteSpace(registro.Observaciones) ? "—" : registro.Observaciones)</span>
                            }
                        </div>
