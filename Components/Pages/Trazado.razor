    // ---------- Renombrar la torre seleccionada ----------
    private void IniciarEdicionTorre()
    {
        if (elementoSeleccionado is null) return;
        codigoEdicionTorre = elementoSeleccionado.Codigo;
        errorEdicionTorre = "";
        editandoNombreTorre = true;
    }

    private async Task GuardarEdicionTorre()
    {
        if (elementoSeleccionado is null) return;
        var nuevoCodigo = codigoEdicionTorre.Trim();
        if (string.IsNullOrWhiteSpace(nuevoCodigo))
        {
            errorEdicionTorre = "El nombre no puede quedar vacío.";
            return;
        }

        var choque = Db.ElementosTrazado.AsNoTracking()
            .FirstOrDefault(x => x.Codigo == nuevoCodigo && x.Id != elementoSeleccionado.Id);
        if (choque is not null)
        {
            errorEdicionTorre = $"Ya existe otra torre con el nombre \"{nuevoCodigo}\".";
            return;
        }

        var entidad = await Db.ElementosTrazado.FindAsync(elementoSeleccionado.Id);
        if (entidad is not null)
        {
            entidad.Codigo = nuevoCodigo;
            entidad.Nombre = nuevoCodigo;
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            SincronizadorCatalogoLocalizacion.Sincronizar(Db, entidad);
        }
        Db.ChangeTracker.Clear();

        editandoNombreTorre = false;
        errorEdicionTorre = "";
        CargarElementos();
        elementoSeleccionado = elementos.FirstOrDefault(e => e.Id == elementoSeleccionado.Id);
        await DibujarMapa();
    }

    private async Task AlternarPantallaCompleta()
    {
        pantallaCompleta = !pantallaCompleta;
        StateHasChanged();
        await Task.Delay(60);
        await JS.InvokeVoidAsync("redimensionarMapaTrazado");
    }

    // ---------- Vista del espacio principal: mapa o tabla ----------
    private async Task CambiarVista(string vista)
    {
        if (vistaPrincipal == vista) return;
        vistaPrincipal = vista;
        StateHasChanged();

        if (vista == "mapa")
        {
            // El mapa estuvo con display:none; Leaflet necesita que se le
            // avise para recalcular su tamaño, si no queda con el tile a medias.
            await Task.Delay(60);
            await JS.InvokeVoidAsync("redimensionarMapaTrazado");
        }
    }

    private async Task VerTorreEnMapa(ElementoTrazado e)
