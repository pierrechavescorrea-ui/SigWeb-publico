    // Pestaña Riesgos: fila abierta (detalle) y nombres/colores por defecto
    // (el formato de cada estado se cambia en Catálogos).
    private int? hallazgoAbierto;
    private int? planAbierto;
    private static string NombreEstadoHallazgo(EstadoHallazgo e) => e switch { EstadoHallazgo.Abierto => "Abierto", EstadoHallazgo.EnTratamiento => "En tratamiento", _ => "Cerrado" };
    private static string ColorEstadoHallazgo(EstadoHallazgo e) => e switch { EstadoHallazgo.Abierto => "#dc3545", EstadoHallazgo.EnTratamiento => "#fd7e14", _ => "#198754" };
    private static string NombreResultadoSeg(ResultadoSeguimiento r) => r switch { ResultadoSeguimiento.Materializado => "Materializado", ResultadoSeguimiento.EnObservacion => "En observación", _ => "No materializado" };
    private static string ColorResultadoSeg(ResultadoSeguimiento r) => r switch { ResultadoSeguimiento.Materializado => "#c0392b", ResultadoSeguimiento.EnObservacion => "#d9822b", _ => "#198754" };

    private async Task CargarHallazgosTorre()
    {
        // Corre en segundo plano (sin await desde AbrirFichaComponente): los
        // servicios usan su propio DbContext para no chocar con el de la
        // página, y si el usuario ya abrió otra torre el resultado se descarta.
        var torreId = componenteSeleccionado?.ElementoTrazadoId ?? 0;
        try
        {
            var h = torreId == 0 ? new() : await ServicioRiesgos.HallazgosDeTorreAsync(torreId);
            var p = torreId == 0 ? new() : await ServicioPlanes.PlanesDeTorreAsync(torreId);
            if ((componenteSeleccionado?.ElementoTrazadoId ?? 0) != torreId) return;
            hallazgosTorre = h;
            planesTorre = p;
        }
        catch (Exception ex)
        {
            hallazgosTorre = new(); planesTorre = new();
            Console.Error.WriteLine("Hoja de vida: no se pudieron cargar riesgos/planes: " + ex.Message);
        }
        await InvokeAsync(StateHasChanged);
    }

