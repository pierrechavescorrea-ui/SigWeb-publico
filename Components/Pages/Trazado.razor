    // ---------- Tabla completa de torres cargadas ----------
    private string columnaOrdenTorresTabla = "Codigo";
    private bool ordenAscendenteTorresTabla = true;

    private List<ElementoTrazado> TorresTablaFiltradas()
    {
        IEnumerable<ElementoTrazado> query = elementos;
        if (!string.IsNullOrWhiteSpace(filtroTablaTorres))
        {
            query = query.Where(e => e.Codigo.Contains(filtroTablaTorres, StringComparison.OrdinalIgnoreCase)
                                     || (motor is not null && motor.TextoBusqueda(e.Id).Contains(filtroTablaTorres, StringComparison.OrdinalIgnoreCase)));
        }

        query = columnaOrdenTorresTabla switch
        {
            "Codigo" => ordenAscendenteTorresTabla ? query.OrderBy(e => e.Codigo) : query.OrderByDescending(e => e.Codigo),
            "Capa" => ordenAscendenteTorresTabla ? query.OrderBy(e => NombreCapaDe(e)) : query.OrderByDescending(e => NombreCapaDe(e)),
            "Latitud" => ordenAscendenteTorresTabla ? query.OrderBy(e => e.Latitud) : query.OrderByDescending(e => e.Latitud),
            "Longitud" => ordenAscendenteTorresTabla ? query.OrderBy(e => e.Longitud) : query.OrderByDescending(e => e.Longitud),
            _ => motor is null ? query : motor.Ordenar(query, e => e.Id, columnaOrdenTorresTabla, ordenAscendenteTorresTabla)
        };

        return query.ToList();
    }

    private void OrdenarTorresTablaPor(string columna)
    {
        if (columnaOrdenTorresTabla == columna) ordenAscendenteTorresTabla = !ordenAscendenteTorresTabla;
        else { columnaOrdenTorresTabla = columna; ordenAscendenteTorresTabla = true; }
    }

    private string FlechaTorresTabla(string columna) => columnaOrdenTorresTabla != columna ? "" : (ordenAscendenteTorresTabla ? " ▲" : " ▼");

    private string columnaOrdenDatosExtraTorre = "Clave";
    private bool ordenAscendenteDatosExtraTorre = true;

    private List<CampoExtraTorre> CamposExtraTorreFiltrados()
    {
        IEnumerable<CampoExtraTorre> query = camposExtraTorre;
        if (!string.IsNullOrWhiteSpace(filtroDatosExtraTorre))
        {
            query = query.Where(c => c.Clave.Contains(filtroDatosExtraTorre, StringComparison.OrdinalIgnoreCase)
                                   || c.Valor.Contains(filtroDatosExtraTorre, StringComparison.OrdinalIgnoreCase));
        }

        query = columnaOrdenDatosExtraTorre switch
        {
            "Clave" => ordenAscendenteDatosExtraTorre ? query.OrderBy(c => c.Clave) : query.OrderByDescending(c => c.Clave),
            "Valor" => ordenAscendenteDatosExtraTorre ? query.OrderBy(c => c.Valor) : query.OrderByDescending(c => c.Valor),
            _ => query
        };

        return query.ToList();
    }

    private void OrdenarDatosExtraTorrePor(string columna)
    {
        if (columnaOrdenDatosExtraTorre == columna) ordenAscendenteDatosExtraTorre = !ordenAscendenteDatosExtraTorre;
        else { columnaOrdenDatosExtraTorre = columna; ordenAscendenteDatosExtraTorre = true; }
    }

    private string FlechaDatosExtraTorre(string columna) => columnaOrdenDatosExtraTorre != columna ? "" : (ordenAscendenteDatosExtraTorre ? " ▲" : " ▼");

    // Misma búsqueda de CamposExtraTorreFiltrados(), pero por pata/elemento:
    // cada tarjeta solo muestra sus campos que calzan con lo buscado, y una
    // pata sin campos (o sin coincidencias) directamente no aparece.
    private List<(Componente Componente, List<CampoExtraComponente> Campos)> CamposExtraPorComponenteFiltrados()
    {
        IEnumerable<(Componente Componente, List<CampoExtraComponente> Campos)> query = camposExtraPorComponente;
        if (!string.IsNullOrWhiteSpace(filtroDatosExtraTorre))
        {
            query = query.Select(x => (x.Componente, Campos: x.Campos.Where(c =>
                c.Clave.Contains(filtroDatosExtraTorre, StringComparison.OrdinalIgnoreCase)
                || c.Valor.Contains(filtroDatosExtraTorre, StringComparison.OrdinalIgnoreCase)).ToList()));
        }
        return query.Where(x => x.Campos.Count > 0).ToList();
    }

