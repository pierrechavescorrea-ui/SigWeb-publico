    private void CargarResultadosEnsayoTorre()
    {
        resultadosEnsayoTorre = new();
        if (elementoSeleccionado is null) return;

        var resultados = Db.ResultadosEnsayo.AsNoTracking()
            .Where(r => r.ElementoTrazadoId == elementoSeleccionado.Id && !r.Eliminado)
            .ToList();
        if (resultados.Count == 0) return;

        var resultadoIds = resultados.Select(r => r.Id).ToList();
        var vinculosPorResultado = Db.ResultadosEnsayoComponente.AsNoTracking()
            .Where(rc => resultadoIds.Contains(rc.ResultadoEnsayoId))
            .ToList()
            .GroupBy(rc => rc.ResultadoEnsayoId)
            .ToDictionary(g => g.Key, g => g.Select(rc => rc.ComponenteId).ToList());

        var componentesPorId = componentesDeLaTorre
            .Where(c => !c.EsHojaDeVida)
            .ToDictionary(c => c.Id, c => c.Nombre);

        var tipoIds = resultados.Select(r => r.TipoEnsayoId).Distinct().ToList();
        var tipos = Db.TiposEnsayo.AsNoTracking().Where(t => tipoIds.Contains(t.Id)).ToDictionary(t => t.Id, t => t);

        var grupoIds = tipos.Values.Select(t => t.GrupoEnsayoId).Distinct().ToList();
        var nombresGrupo = Db.GruposEnsayo.AsNoTracking().Where(g => grupoIds.Contains(g.Id))
            .ToDictionary(g => g.Id, g => g.Nombre);

        var informeIds = resultados.Where(r => r.InformeId != null).Select(r => r.InformeId!.Value).Distinct().ToList();
        // Reutiliza el mismo diccionario de conteos que la ficha por pata
        // (las claves son Id de Informe, globales — no hay choque posible).
        foreach (var grupoArchivos in Db.ArchivosInforme.AsNoTracking().Where(a => informeIds.Contains(a.InformeId)).GroupBy(a => a.InformeId))
        {
            archivosPorInformePata[grupoArchivos.Key] = grupoArchivos.Count();
            archivosListaPorInformePata[grupoArchivos.Key] = grupoArchivos.OrderBy(a => a.Id).ToList();
        }

        foreach (var r in resultados)
        {
            if (!tipos.TryGetValue(r.TipoEnsayoId, out var tipo)) continue;
            var nombreGrupo = nombresGrupo.TryGetValue(tipo.GrupoEnsayoId, out var ng) ? ng : "Otros";

            var idsComponente = vinculosPorResultado.TryGetValue(r.Id, out var lista) ? lista : new List<int>();
            var nombresPata = idsComponente
                .Select(id => componentesPorId.TryGetValue(id, out var nombre) ? nombre : null)
                .Where(n => n is not null)
                .ToList();

            if (nombresPata.Count == 0)
            {
                // Sin pata asociada: o un elemento especial ya eliminado,
                // o (el caso que nos interesa) un ensayo que aplica a toda
                // la torre, nunca se asoció a una pata en particular.
                resultadosEnsayoTorre.Add(new ResultadoEnsayoTorreVista
                {
                    Grupo = nombreGrupo,
                    Tipo = tipo,
                    Pata = EtiquetaEnsayoTorreCompleta,
                    InformeId = r.InformeId
                });
            }
            else
            {
                foreach (var nombrePata in nombresPata)
                {
                    resultadosEnsayoTorre.Add(new ResultadoEnsayoTorreVista
                    {
                        Grupo = nombreGrupo,
                        Tipo = tipo,
                        Pata = nombrePata!,
                        InformeId = r.InformeId
                    });
                }
            }
        }
    }

    // "Ensayos de resistencia a la compresión" (Actividad, ámbito Pata) ↔
    // "Resistencia a la compresión" (TipoEnsayo, módulo Ensayos): mismo
    // ensayo, nombrado un poco distinto en cada catálogo. Quita el prefijo
    // "Ensayos de " para poder emparejarlos por nombre.
    private static string? NombreTipoEnsayoDesdeActividad(string nombreActividad)
    {
        const string prefijo = "Ensayos de ";
        return nombreActividad.StartsWith(prefijo, StringComparison.OrdinalIgnoreCase)
            ? nombreActividad[prefijo.Length..].Trim()
            : null;
    }

    // El emparejamiento entre el catálogo de Actividades ("Ensayos de peso
    // unitario o densidades") y el de Tipos de Ensayo (donde el usuario
    // puede haber llamado al suyo simplemente "Densidades") no siempre es
    // exacto — por eso no se compara con igualdad estricta, sino que
    // basta con que uno contenga al otro (en cualquier sentido).
    private static bool CoincideNombreTipoEnsayo(string nombreTipoEnsayo, string nombreStrippedDeActividad)
    {
        if (string.IsNullOrWhiteSpace(nombreTipoEnsayo) || string.IsNullOrWhiteSpace(nombreStrippedDeActividad)) return false;
        return nombreTipoEnsayo.Contains(nombreStrippedDeActividad, StringComparison.OrdinalIgnoreCase)
            || nombreStrippedDeActividad.Contains(nombreTipoEnsayo, StringComparison.OrdinalIgnoreCase);
    }

    private (TipoEnsayo Tipo, List<ResultadoEnsayoVista> Resultados)? TipoEnsayoParaActividad(int actividadId)
    {
        var actividad = actividadesDelComponente.FirstOrDefault(a => a.Id == actividadId);
        if (actividad is null) return null;

        // El enlace real (TipoEnsayoId) manda; solo para actividades sin
        // enlazar se recurre al viejo respaldo por coincidencia de nombre.
        if (actividad.TipoEnsayoId is int idTipo)
        {
            foreach (var grupo in resultadosEnsayoComponente)
            {
                if (grupo.Tipo.Id == idTipo)
                    return grupo;
            }
            return null;
        }

        var nombreTipo = NombreTipoEnsayoDesdeActividad(actividad.Nombre);
        if (nombreTipo is null) return null;

        foreach (var grupo in resultadosEnsayoComponente)
        {
            if (CoincideNombreTipoEnsayo(grupo.Tipo.Nombre, nombreTipo))
                return grupo;
        }
        return null;
    }

