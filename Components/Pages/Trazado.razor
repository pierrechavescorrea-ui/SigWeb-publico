@page "/trazado"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using SigWeb.Data
@using SigWeb.Data.Trazado
@using SigWeb.Data.Ubicacion
@using SigWeb.Models
@using SigWeb.Data.Tablas
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject SigWeb.Data.Impacto.AnalizadorImpacto Analizador
@inject SigWeb.Data.Riesgos.MatrizRiesgosServicio ServicioRiesgos
@inject SigWeb.Data.Planes.PlanesAccionServicio ServicioPlanes
@inject IJSRuntime JS
@inject IServiceScopeFactory Scopes
@inject IEnumerable<IProveedorUbicacion> ProveedoresUbicacion
@implements IAsyncDisposable

<EncabezadoPagina Titulo="Trazado del proyecto" Icono="trazado" Atras="@AtrasLinea3D">
    <Acciones>
        <button type="button" class="pg-btn @(vistaPrincipal == "mapa" ? "activo" : "")" title="Mapa" aria-label="Mapa"
                @onclick="@(() => CambiarVista("mapa"))"><Ico Nombre="mapa" /></button>
        <button type="button" class="pg-btn @(vistaPrincipal == "tabla" ? "activo" : "")" title="Tabla" aria-label="Tabla"
                @onclick="@(() => CambiarVista("tabla"))"><Ico Nombre="listado" /></button>
        <span class="pg-sep"></span>
        <button type="button" class="pg-btn @(mostrarCapas ? "activo" : "")" title="Base de datos (@capas.Count capa(s))" aria-label="Base de datos"
                @onclick="@(() => mostrarCapas = !mostrarCapas)"><Ico Nombre="capas" /></button>
        <button type="button" class="pg-btn" title="Unificar torres duplicadas" aria-label="Unificar torres duplicadas"
                @onclick="@(() => mostrarUnificarTorres = true)"><Ico Nombre="unificar" /></button>
        <button type="button" class="pg-btn" title="Tabla de torres" aria-label="Tabla de torres"
                @onclick='@(() => Nav.NavigateTo("/trazado/tabla-torres"))'><Ico Nombre="tabla" /></button>
        <button type="button" class="pg-btn" title="Inspeccionar DWG/DXF" aria-label="Inspeccionar DWG/DXF"
                @onclick="@(() => mostrarInspeccionarCad = true)"><Ico Nombre="inspeccionar-cad" /></button>
        <span class="pg-sep"></span>
        @if (vistaPrincipal == "tabla")
        {
            <BotonCampos Activo="verCampos" Deshabilitado="motor is null" OnClick="() => verCampos = true" />
        }
        <button type="button" class="pg-btn @(mostrarOpcionesCarga ? "activo" : "")" title="Importar datos" aria-label="Importar datos"
                @onclick="@(() => mostrarOpcionesCarga = !mostrarOpcionesCarga)"><Ico Nombre="importar" /></button>
        <button type="button" class="pg-btn" title="Importar desde DWG/DXF" aria-label="Importar desde DWG/DXF"
                @onclick="@(() => mostrarImportarCad = true)"><Ico Nombre="importar-cad" /></button>
        @if (vistaPrincipal == "tabla")
        {
            <BotonExportar Titulo="Torres del trazado" Selector="table.tabla-torres-trazado" />
        }
    </Acciones>
</EncabezadoPagina>

@if (verCampos && motor is not null)
{
    <PanelCampos Motor="motor" OnCerrar="() => verCampos = false" OnCambio="StateHasChanged" />
}

@if (!mostrarOpcionesCarga)
{
    if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(error ? "alert-danger" : "alert-success") py-1 mb-2">@mensaje</div>
    }
}
else
{
    <div class="card panel-formulario mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Cargar datos — elige qué vas a subir</span>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="@(() => mostrarOpcionesCarga = false)"></button>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label mb-1">Trazado nuevo — KMZ</label>
                    <InputFile OnChange="CargarKmz" accept=".kmz" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label mb-1">Trazado nuevo — Excel de coordenadas</label>
                    <InputFile OnChange="CargarExcel" accept=".xlsx" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label mb-1">Datos adicionales — Tabla de torres</label>
                    <button class="btn btn-outline-secondary form-control" @onclick="@(() => { mostrarOpcionesCarga = false; Nav.NavigateTo("/trazado/datos-adicionales"); })">
                        📑 Elegir archivo...
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @(error ? "alert-danger" : "alert-success") py-1 mt-2 mb-0">@mensaje</div>
            }
        </div>
    </div>
}

@if (mostrarConfigExcel)
{
    <div class="card panel-formulario mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Confirma el sistema de coordenadas del Excel (@filasExcelCrudas.Count fila(s))</span>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CancelarExcel"></button>
        </div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="small text-muted">Sistema de coordenadas</label>
                    <InputSelect class="form-select form-select-sm" @bind-Value="sistemaExcelSeleccionado">
                        <option value="@SistemaCoordenadas.Geograficas">Geográficas (Lat/Lon, grados decimales)</option>
                        <option value="@SistemaCoordenadas.MagnaBogota">MAGNA-SIRGAS — Origen Bogotá (planas)</option>
                        <option value="@SistemaCoordenadas.Utm17N">UTM zona 17N</option>
                        <option value="@SistemaCoordenadas.Utm18N">UTM zona 18N</option>
                        <option value="@SistemaCoordenadas.Utm19N">UTM zona 19N</option>
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary btn-sm" @onclick="ConvertirCoordenadasExcel">Convertir y continuar</button>
                </div>
            </div>
            @if (filasExcelCrudas.Count > 0)
            {
                var muestra = filasExcelCrudas[0];
                var (latMuestra, lonMuestra) = ConversorCoordenadas.Convertir(muestra.X, muestra.Y, sistemaExcelSeleccionado);
                <p class="small text-muted mt-2 mb-0">
                    Ejemplo — <strong>@muestra.Torre</strong>: X=@muestra.X, Y=@muestra.Y →
                    lat @latMuestra.ToString("F6"), lon @lonMuestra.ToString("F6")
                    @if (latMuestra is < -4.5 or > 13.5 || lonMuestra is < -82 or > -66)
                    {
                        <span class="text-danger"> (fuera del rango de Colombia — revisa el sistema elegido)</span>
                    }
                </p>
            }
        </div>
    </div>
}

@if (mostrarSeleccionImportacion)
{
    <div class="card panel-formulario mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Elige cuáles puntos son torres (@codigosSeleccionados.Count de @puntosPendientes.Count seleccionados)</span>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CancelarImportacion"></button>
        </div>
        <div class="card-body">
            <div class="row g-2 mb-2 align-items-end">
                <div class="col-md-5">
                    <label class="small text-muted">Filtrar por nombre</label>
                    <input class="form-control form-control-sm" placeholder="Ej: T-"
                           @bind="filtroImportacion" @bind:event="oninput" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-sm btn-outline-primary" @onclick="SeleccionarTodosFiltrados">Seleccionar filtrados</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="QuitarTodosFiltrados">Quitar filtrados</button>
                </div>
                <div class="col-md-3">
                    <label class="small text-muted">Referencia de esta carga (opcional)</label>
                    <input class="form-control form-control-sm" placeholder="Ej: A29-9" @bind="versionImportacionActual" />
                </div>
            </div>

            <div style="max-height: 320px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.4rem;">
                <table class="table table-sm tabla-compacta mb-0">
                    <thead>
                        <tr><th style="width:40px"></th><th>Nombre</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in PuntosFiltrados())
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" checked="@codigosSeleccionados.Contains(p.Codigo)"
                                           @onchange="@(e => AlternarSeleccion(p.Codigo, (bool)e.Value!))" />
                                </td>
                                <td>@p.Codigo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <button class="btn btn-primary btn-sm mt-3" @onclick="PrepararConfirmacion">
                Importar @codigosSeleccionados.Count torre(s) seleccionada(s)
            </button>
        </div>
    </div>
}

@if (mostrarConflictosNombre)
{
    <div class="card panel-formulario mb-3">
        <div class="card-header">
            @conflictosNombre.Count torre(s) con nombre parecido a una que ya existe — revisa antes de continuar
        </div>
        <div class="card-body">
            <p class="small text-muted">
                Estos códigos no coinciden exactamente con ninguna torre existente, pero se parecen mucho a
                una que ya tienes cargada (por ejemplo <strong>102</strong> vs <strong>102N</strong>). Decide
                para cada uno si son en realidad la misma torre (y entonces se migran hacia ella todos sus
                componentes, checklist y materiales ya cargados) o si son torres distintas y deben quedar las
                dos.
            </p>
            @foreach (var c in conflictosNombre)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="mb-1">
                        <strong>@c.CodigoNuevo</strong> <span class="text-muted small">(en el archivo)</span>
                        se parece a
                        <strong>@c.CodigoExistente</strong> <span class="text-muted small">(ya existe, con sus datos)</span>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" name="@("conflicto-" + c.CodigoNuevo)"
                               checked="@(decisionesConflicto[c.CodigoNuevo] == "ambas")"
                               @onchange="@(() => ElegirDecisionConflicto(c.CodigoNuevo, "ambas"))" />
                        <label class="form-check-label small">Son torres distintas — conservar ambas</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" name="@("conflicto-" + c.CodigoNuevo)"
                               checked="@(decisionesConflicto[c.CodigoNuevo] == "migrar")"
                               @onchange="@(() => ElegirDecisionConflicto(c.CodigoNuevo, "migrar"))" />
                        <label class="form-check-label small">
                            Es la misma torre — migrar todo lo de <strong>@c.CodigoExistente</strong> hacia <strong>@c.CodigoNuevo</strong>
                            @if (c.EliminadaEnMapa)
                            {
                                <span class="text-muted">(actualmente en la Papelera)</span>
                            }
                        </label>
                    </div>
                </div>
            }
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-primary btn-sm" @onclick="ContinuarDesdeConflictos">Continuar</button>
                <button class="btn btn-link btn-sm text-muted" @onclick="CancelarImportacion">Cancelar todo</button>
            </div>
        </div>
    </div>
}

@if (mostrarVinculacionPatas)
{
    <div class="card panel-formulario mb-3">
        <div class="card-header">
            Se encontraron @candidatasPatas.Count punto(s) cerca de las torres seleccionadas — ¿son sus patas?
        </div>
        <div class="card-body">
            <p class="small text-muted">
                Estos puntos del archivo no quedaron marcados como torre, pero están a menos de
                @RadioPatasMetros m de una torre seleccionada — normalmente eso significa que son sus
                patas (P1/P2/P3/P4 o A/B/C/D). Marca los que sí correspondan: quedarán con su
                <strong>ubicación real</strong> tomada del archivo, en vez de la posición aproximada por
                defecto. Los que dejes sin marcar (o que la torre ya tuviera) no se tocan.
            </p>
            @foreach (var grupo in candidatasPatas.GroupBy(c => c.CodigoTorreCercana))
            {
                <div class="mb-2">
                    <strong>Torre @grupo.Key</strong>
                    <ul class="list-unstyled ps-3 mb-1">
                        @foreach (var c in grupo)
                        {
                            <li>
                                <input type="checkbox" checked="@codigosPatasSeleccionadas.Contains(c.Codigo)"
                                       @onchange="@(e => AlternarSeleccionPata(c.Codigo, (bool)e.Value!))" />
                                @c.Codigo <span class="text-muted small">(a @c.DistanciaMetros.ToString("F0") m)</span>
                            </li>
                        }
                    </ul>
                </div>
            }
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-primary btn-sm" @onclick="EjecutarImportacionTrazado">
                    Confirmar importación (@codigosPatasSeleccionadas.Count pata(s) vinculada(s))
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="@(async () => { codigosPatasSeleccionadas = new(); await EjecutarImportacionTrazado(); })">
                    Importar sin vincular patas
                </button>
                <button class="btn btn-link btn-sm text-muted" @onclick="CancelarImportacion">Cancelar todo</button>
            </div>
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-md-8" style="position: sticky; top: 0.75rem; align-self: flex-start;">
        @if (mostrarCapas)
        {
            <div class="card panel-formulario mb-2">
                <div class="card-body py-2">
                    <p class="small text-muted mb-2">
                        Cada carga de KMZ o Excel crea una capa. Apágala para dejar de verla en el mapa sin
                        borrar nada, o elimínala para enviar sus torres a la Papelera — lo ya cargado en
                        ellas (componentes, checklist, materiales) se conserva y se recupera solo si luego
                        cargas un KMZ o Excel con el mismo código o uno parecido.
                    </p>
                    @if (capas.Count == 0)
                    {
                        <p class="text-muted small mb-0">Aún no has cargado ningún KMZ o Excel.</p>
                    }
                    else
                    {
                        <table class="table table-sm tabla-compacta mb-0">
                            <thead>
                                <tr>
                                    <th style="width:36px">Ver</th>
                                    <th>Capa</th>
                                    <th style="width:70px">Torres</th>
                                    <th style="width:150px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in capas)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" checked="@c.Visible" title="Mostrar/ocultar en el mapa"
                                                   @onchange="@(e => AlternarVisibilidadCapa(c, (bool)e.Value!))" />
                                        </td>
                                        <td>
                                            @if (capaEnEdicionId == c.Id)
                                            {
                                                <input class="form-control form-control-sm" @bind="nombreEdicionCapa" />
                                            }
                                            else
                                            {
                                                <span>@c.Nombre</span>
                                                <span class="text-muted small"> — @c.FechaCarga.ToString("dd/MM/yyyy HH:mm")</span>
                                            }
                                        </td>
                                        <td>@(conteoTorresPorCapa.TryGetValue(c.Id, out var n) ? n : 0)</td>
                                        <td class="text-end">
                                            @if (capaEnEdicionId == c.Id)
                                            {
                                                <button class="btn btn-sm btn-primary" @onclick="() => GuardarEdicionCapa(c)" title="Guardar"><Ico Nombre="guardar" /></button>
                                                <button class="btn btn-sm btn-secondary" @onclick="CancelarEdicionCapa" title="Cancelar"><Ico Nombre="cancelar" /></button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => IniciarEdicionCapa(c)" title="Renombrar"><Ico Nombre="editar" /></button>
                                                <button class="btn btn-sm btn-danger" @onclick="() => PedirEliminarCapa(c)" title="Eliminar del mapa"><Ico Nombre="eliminar" /></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }

        @* "150px" es lo que realmente ocupa arriba: la barra superior de la app
           + el encabezado "Trazado del proyecto" (que ya lleva los íconos de
           acciones). Antes eran 192px porque había una barra de íconos encima
           del mapa (~42px). Bajarlo de más hace que la tarjeta de la derecha
           quede más alta de lo que cabe y aparezca scroll de toda la página. *@
        @{ var estiloEspacio = "height: calc(100vh - 150px); height: calc(100dvh - 150px); min-height: 380px; border-radius: 0.5rem; border: 1px solid #dee2e6; overflow: hidden;"; }

        @* El mapa se oculta con CSS en vez de dejar de renderizarse: si Blazor
           quitara el <div id="mapaTrazado"> del DOM, Leaflet perdería la
           referencia al contenedor y no se podría volver a dibujar sin
           recrear todo el mapa (y perder zoom/posición). *@
        <div class="@(pantallaCompleta ? "mapa-pantalla-completa" : "")"
             style="position: relative; @estiloEspacio display: @(vistaPrincipal == "mapa" ? "block" : "none");">
            <div id="mapaTrazado" style="height: 100%; width: 100%;"></div>

            <button type="button" class="btn-mapa-pantalla-completa" title="@(pantallaCompleta ? "Salir de pantalla completa" : "Pantalla completa")"
                    @onclick="AlternarPantallaCompleta">
                @(pantallaCompleta ? "⤫" : "⛶")
            </button>

            <div class="buscador-torres">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>🔍 Torres (@elementos.Count)</strong>
                    <button type="button" class="btn-close btn-sm" style="font-size:0.65rem" aria-label="Ocultar"
                            @onclick="@(() => mostrarListaTorres = !mostrarListaTorres)"></button>
                </div>
                @if (mostrarListaTorres)
                {
                    <input placeholder="Buscar por nombre..." class="mt-1" @bind="filtroBuscadorTorres" @bind:event="oninput" autofocus />
                    <div class="buscador-torres-lista">
                        @foreach (var e in TorresFiltradas().Take(50))
                        {
                            <div class="buscador-torres-item @(elementoSeleccionado?.Id == e.Id ? "buscador-torres-item-activo" : "")"
                                 @onclick="() => IrATorre(e)">
                                @e.Codigo
                            </div>
                        }
                        @if (TorresFiltradas().Count == 0)
                        {
                            <div class="text-muted small px-1">Sin resultados</div>
                        }
                        @if (elementos.Count == 0)
                        {
                            <div class="text-muted small px-1">Aún no hay torres cargadas.</div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (vistaPrincipal == "tabla")
        {
            <div style="@estiloEspacio display: flex; flex-direction: column;">
                <div class="d-flex justify-content-between align-items-center p-2 border-bottom" style="background:#f8f9fa">
                    <strong>Torres cargadas (@elementos.Count)</strong>
                    <input class="form-control form-control-sm" style="width: 220px" placeholder="Buscar por nombre..."
                           @bind="filtroTablaTorres" @bind:event="oninput" />
                </div>
                <div style="overflow-y: auto; flex: 1 1 auto;">
                    <table class="table table-sm tabla-compacta mb-0 tabla-torres-trazado">
                        <thead style="position: sticky; top: 0; background: #fff;">
                            <tr>
                                @foreach (var c in ColumnasTorres)
                                {
                                    <th class="th-ordenable" @onclick="() => OrdenarTorresTablaPor(c.Clave)">@c.Nombre@(FlechaTorresTabla(c.Clave))</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in TorresTablaFiltradas())
                            {
                                <tr class="@(elementoSeleccionado?.Id == e.Id ? "table-active" : "")" style="cursor: pointer"
                                    @onclick="() => VerTorreEnMapa(e)">
                                    @foreach (var c in ColumnasTorres)
                                    {
                                        <CeldaCampo Motor="motor!" Campo="c" Fila="e.Id" OnCambio="StateHasChanged" />
                                    }
                                </tr>
                            }
                            @if (elementos.Count == 0)
                            {
                                <tr><td colspan="@Math.Max(1, ColumnasTorres.Count())" class="text-muted small text-center py-2">Aún no has cargado ningún KMZ o Excel.</td></tr>
                            }
                            else if (TorresTablaFiltradas().Count == 0)
                            {
                                <tr><td colspan="@Math.Max(1, ColumnasTorres.Count())" class="text-muted small text-center py-2">Sin resultados para "@filtroTablaTorres".</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
    <div class="col-md-4 @(pantallaCompleta ? "d-none" : "")">
        <div class="card panel-formulario" style="@estiloEspacio display: flex; flex-direction: column;">
            <div class="card-header" style="flex: 0 0 auto;">
                @if (elementoSeleccionado is null)
                {
                    <span>Selecciona una torre</span>
                }
                else if (editandoNombreTorre)
                {
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Torre</span>
                        <input class="form-control" @bind="codigoEdicionTorre" />
                        <button class="btn btn-primary" @onclick="GuardarEdicionTorre" title="Guardar"><Ico Nombre="guardar" /></button>
                        <button class="btn btn-secondary" @onclick="@(() => editandoNombreTorre = false)" title="Cancelar"><Ico Nombre="cancelar" /></button>
                    </div>
                    @if (!string.IsNullOrEmpty(errorEdicionTorre))
                    {
                        <div class="text-danger small mt-1">@errorEdicionTorre</div>
                    }
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <span>
                            Torre @elementoSeleccionado.Codigo
                            @{ var nombreCapaTorre = NombreCapaDe(elementoSeleccionado); }
                            @if (!string.IsNullOrEmpty(nombreCapaTorre))
                            {
                                <span class="text-muted small d-block">Capa: @nombreCapaTorre</span>
                            }
                        </span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="IniciarEdicionTorre" title="Cambiar nombre de la torre">
                            ✎ Renombrar
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-1 mt-1" title="Apariencia de esta torre en el mapa">
                        <span class="text-muted small">🗺</span>
                        <select class="select-icono-mapa"
                                @onchange="@(e => CambiarIconoTorre(e.Value!.ToString()!))">
                            @foreach (var opcion in OpcionesIconoMapa)
                            {
                                <option value="@opcion.Valor" selected="@(opcion.Valor == (elementoSeleccionado.IconoMapa ?? configIconoTorre))">@opcion.Etiqueta</option>
                            }
                        </select>
                        <input type="color" class="color-swatch-mapa" title="Color en el mapa"
                               value="@(elementoSeleccionado.ColorMapa ?? configColorTorre)"
                               @onchange="@(e => CambiarColorTorre(e.Value!.ToString()!))" />
                    </div>
                }
            </div>
            <div class="card-body" style="flex: 1 1 auto; overflow-y: auto;">
                @if (elementoSeleccionado is null)
                {
                    <p class="text-muted small">Selecciona una torre en el mapa.</p>
                }
                else
                {
                    <ul class="list-group mb-3">
                        @foreach (var c in componentesDeLaTorre)
                        {
                            <li class="list-group-item @(c.EsHojaDeVida ? "list-group-item-light" : "") @(arrComp == c.Id ? "arr-origen" : "") @(!c.EsHojaDeVida && arrComp is not null && sobreComp == c.Id && arrComp != c.Id ? "arr-sobre" : "")"
                                @ondragover:preventDefault="@(!c.EsHojaDeVida)" @ondragenter="() => { if (!c.EsHojaDeVida) sobreComp = c.Id; }" @ondrop="() => SoltarComponente(c)">
                                @if (idComponenteEnEdicion == c.Id)
                                {
                                    <div class="input-group input-group-sm">
                                        <input class="form-control" @bind="nombreEdicionComponente" />
                                        <button class="btn btn-primary" @onclick="() => GuardarEdicionComponente(c)" title="Guardar"><Ico Nombre="guardar" /></button>
                                        <button class="btn btn-secondary" @onclick="CancelarEdicionComponente" title="Cancelar"><Ico Nombre="cancelar" /></button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="d-flex align-items-center gap-1">
                                            @if (c.EsHojaDeVida)
                                            {
                                                <span class="me-1 text-secondary" title="Hoja de vida de la torre (fija: no se renombra ni se elimina)"><Ico Nombre="documento" /></span>
                                            }
                                            else
                                            {
                                                <span class="arr-asa me-1" draggable="true" data-arrastre title="Arrastrar para reordenar"
                                                      @ondragstart="() => arrComp = c.Id" @ondragend="FinArrastreComp">⠿</span>
                                            }
                                            @if (c.EsHojaDeVida)
                                            {
                                                <button type="button" class="btn btn-link p-0 border-0 fw-bold text-decoration-none" title="Abrir ficha"
                                                        @onclick="() => AbrirFichaComponente(c)">@c.Nombre</button>
                                                <span class="pie-pct" title="@($"Cumplimiento PIE ({pctPie.Aplican} de {pctPie.Total} aplican)")">@SigWeb.Data.Pie.CumplimientoPie.Formato(pctPie.Pct)</span>
                                            }
                                            else
                                            {
                                                <span>@c.Nombre</span>
                                            }
                                        </span>
                                        <span class="d-flex align-items-center gap-1">
                                            @if (!c.EsHojaDeVida)
                                            {
                                                @if (c.Latitud is not null || !string.IsNullOrEmpty(c.GeometriaJson))
                                                {
                                                    <input type="checkbox" class="form-check-input flex-shrink-0" title="Ver en el mapa"
                                                           checked="@c.MostrarEnMapa"
                                                           @onchange="@(e => CambiarVisibilidadMapaComponente(c, (bool)e.Value!))" />
                                                }
                                                <div class="menu-fila-componente-contenedor">
                                                    <button class="btn btn-sm btn-icono-fila btn-outline-secondary" title="Más opciones"
                                                            @onclick="() => AlternarMenuComponente(c.Id)">⋮</button>
                                                    @if (idMenuComponenteAbierto == c.Id)
                                                    {
                                                        <div class="menu-fila-componente">
                                                            <button type="button" class="dropdown-item-sig" @onclick="() => { CerrarMenuComponente(); AbrirFichaComponente(c); }">ℹ️ Ver ficha</button>
                                                            <button type="button" class="dropdown-item-sig" @onclick="() => { CerrarMenuComponente(); IniciarEdicionComponente(c); }">✏️ Renombrar</button>
                                                            @if (c.Latitud is not null)
                                                            {
                                                                <div class="dropdown-item-sig d-flex align-items-center gap-1">
                                                                    <select class="select-icono-mapa" title="Ícono en el mapa"
                                                                            @onchange="@(e => CambiarIconoComponente(c, e.Value!.ToString()!))">
                                                                        <option value="pedestal" selected="@((c.IconoMapa ?? configIconoPata) == "pedestal")">Pedestal (concreto + stub)</option>
                                                                        @foreach (var opcion in OpcionesIconoMapa)
                                                                        {
                                                                            <option value="@opcion.Valor" selected="@(opcion.Valor == (c.IconoMapa ?? configIconoPata))">@opcion.Etiqueta</option>
                                                                        }
                                                                    </select>
                                                                    <input type="color" class="color-swatch-mapa flex-shrink-0" title="Color en el mapa"
                                                                           value="@(c.ColorMapa ?? configColorPata)"
                                                                           @onchange="@(e => CambiarColorComponente(c, e.Value!.ToString()!))" />
                                                                </div>
                                                            }
                                                            else if (!string.IsNullOrEmpty(c.GeometriaJson))
                                                            {
                                                                <div class="dropdown-item-sig d-flex align-items-center gap-1">
                                                                    <span class="text-muted">Color:</span>
                                                                    <input type="color" class="color-swatch-mapa flex-shrink-0" title="Color en el mapa"
                                                                           value="@(c.ColorMapa ?? "#8e44ad")"
                                                                           @onchange="@(e => CambiarColorComponente(c, e.Value!.ToString()!))" />
                                                                </div>
                                                            }
                                                            <button type="button" class="dropdown-item-sig text-danger" @onclick="() => { CerrarMenuComponente(); PedirEliminarComponente(c); }">🗑️ Eliminar</button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </span>
                                    </div>
                                }
                            </li>
                        }
                    </ul>

                    @if (!mostrarFormNuevoComponente)
                    {
                        <button class="btn btn-sm btn-outline-secondary" title="Agregar elemento (trincho, cuneta, gavión...)" @onclick="() => mostrarFormNuevoComponente = true"><Ico Nombre="agregar" /></button>
                    }
                    else
                    {
                        <div class="input-group input-group-sm">
                            <input class="form-control" placeholder="Nombre del elemento" @bind="nuevoNombreComponente" />
                            <button class="btn btn-primary" title="Agregar" @onclick="AgregarComponente"><Ico Nombre="agregar" /></button>
                            <button class="btn btn-secondary" @onclick="@(() => { mostrarFormNuevoComponente = false; nuevoNombreComponente = ""; })" title="Cancelar"><Ico Nombre="cancelar" /></button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@if (mostrarModalEliminarComponente)
{
    <div class="modal-backdrop-custom">
        <div class="modal-box-custom">
            <h5>¿Eliminar "@nombreComponentePendienteEliminar"?</h5>
            <p>
                Se moverá a la <em>Papelera de reciclaje</em>, donde podrás restaurarlo dentro de los
                próximos 30 días junto con todo su checklist de actividades. Pasado ese plazo se
                eliminará definitivamente.
            </p>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-secondary btn-sm" @onclick="CancelarEliminarComponente" title="Cancelar"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" disabled="@BloqueadoPorImpacto" @onclick="ConfirmarEliminarComponente">Sí, eliminar</button>
            </div>
        </div>
    </div>
}

@if (mostrarModalEliminarCapa)
{
    <div class="modal-backdrop-custom">
        <div class="modal-box-custom">
            <h5>¿Eliminar la capa "@nombreCapaPendienteEliminar" del mapa?</h5>
            <p>
                Sus torres dejarán de verse en el mapa y quedarán en la <em>Papelera de reciclaje</em>
                (recuperables durante 30 días). <strong>No se borra nada de lo ya cargado</strong> en ellas:
                sus componentes, checklist y materiales permanecen guardados. Si más adelante cargas un KMZ
                o Excel con el mismo código (o uno parecido), esos datos se recuperan automáticamente sobre
                la nueva referencia.
            </p>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-secondary btn-sm" @onclick="CancelarEliminarCapa" title="Cancelar"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" disabled="@BloqueadoPorImpacto" @onclick="ConfirmarEliminarCapa">Sí, eliminar del mapa</button>
            </div>
        </div>
    </div>
}

@if (mostrarModalComponente && componenteSeleccionado is not null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-box-custom modal-box-ficha-componente">
            <div class="pg-cab" style="margin-bottom:10px; padding:8px 12px;">
                <div class="pg-titulo">
                    <button type="button" class="pg-atras border-0" title="@(AtrasLinea3D is null ? "Volver al mapa" : "Volver a Línea 3D")" aria-label="Volver" @onclick="CerrarModalComponente">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
                    </button>
                    <div class="pg-textos">
                        <h4 class="mb-0 fs-5">@elementoSeleccionado?.Codigo — @componenteSeleccionado.Nombre</h4>
                    </div>
                </div>
                @if (componenteSeleccionado.EsHojaDeVida)
                {
                    <div class="pg-acciones">
                        <span class="pie-pct pie-pct-cab" title="@($"Cumplimiento PIE ({pctPie.Aplican} de {pctPie.Total} aplican)")">@SigWeb.Data.Pie.CumplimientoPie.Formato(pctPie.Pct)</span>
                    </div>
                }
            </div>

            @if (camposExtraComponente.Count > 0)
            {
                <div class="border rounded p-2 mb-2 small">
                    <strong class="d-block mb-1">Datos adicionales</strong>
                    <div class="row g-1">
                        @foreach (var campo in camposExtraComponente)
                        {
                            <div class="col-md-6"><span class="text-muted">@campo.Clave:</span> @campo.Valor</div>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(componenteSeleccionado.GeometriaJson))
            {
                <div class="border rounded p-2 mb-2 small d-flex gap-2">
                    @if (!string.IsNullOrEmpty(componenteSeleccionado.MiniaturaDwg))
                    {
                        <img src="@componenteSeleccionado.MiniaturaDwg" style="max-width:120px; max-height:120px;" class="border rounded" alt="Miniatura del plano" />
                    }
                    <div>
                        <strong class="d-block mb-1">Importado de DWG/DXF</strong>
                        @if (!string.IsNullOrEmpty(componenteSeleccionado.InformacionAdicional))
                        {
                            <div style="white-space: pre-line;">@componenteSeleccionado.InformacionAdicional</div>
                        }
                        @if (!string.IsNullOrEmpty(componenteSeleccionado.OrigenArchivoDwg))
                        {
                            <PildoraArchivo Url="@componenteSeleccionado.OrigenArchivoDwg" Nombre="Plano original" />
                        }
                    </div>
                </div>
            }

            <div class="d-flex flex-wrap gap-1 align-items-center mb-1">
                @* Pestañas en el orden guardado (arrastrar una sobre otra; vale para todas las torres). *@
                @foreach (var clave in PestanasFicha())
                {
                    var k = clave;
                    var claseArr = $"hv-tab {(arrPestana == k ? "arr-origen" : "")} {(arrPestana is not null && sobrePestana == k && arrPestana != k ? "hv-tab-sobre" : "")}";
                    if (k == "archivos")
                    {
                        <button class="btn btn-sm hv-tab-ico @claseArr @(mostrarTabPlanos ? "btn-primary" : "btn-outline-primary")"
                                title="@(componenteSeleccionado.EsHojaDeVida ? "Archivos y ensayos" : "Archivos")" @onclick="MostrarTabPlanos"
                                draggable="true" data-arrastre @ondragstart="() => arrPestana = k" @ondragend="FinArrastrePestana"
                                @ondragover:preventDefault="true" @ondragenter="() => sobrePestana = k" @ondrop="() => SoltarPestana(k)">
                            <Ico Nombre="carpeta" />
                        </button>
                    }
                    else if (k == "informacion")
                    {
                        <button class="btn btn-sm hv-tab-ico @claseArr @(mostrarTabInformacion ? "btn-primary" : "btn-outline-primary")"
                                title="Información" @onclick="MostrarTabInformacion"
                                draggable="true" data-arrastre @ondragstart="() => arrPestana = k" @ondragend="FinArrastrePestana"
                                @ondragover:preventDefault="true" @ondragenter="() => sobrePestana = k" @ondrop="() => SoltarPestana(k)">
                            <Ico Nombre="informacion" />
                        </button>
                    }
                    else if (k == "riesgos")
                    {
                        <button class="btn btn-sm hv-tab-ico @claseArr @(mostrarTabHallazgos ? "btn-primary" : "btn-outline-primary")"
                                title="Riesgos@(hallazgosTorre.Count > 0 ? $" ({hallazgosTorre.Count})" : "")" @onclick="MostrarTabHallazgos"
                                draggable="true" data-arrastre @ondragstart="() => arrPestana = k" @ondragend="FinArrastrePestana"
                                @ondragover:preventDefault="true" @ondragenter="() => sobrePestana = k" @ondrop="() => SoltarPestana(k)">
                            <Ico Nombre="riesgos" />@if (hallazgosTorre.Count > 0) { <span class="hv-cuenta">@hallazgosTorre.Count</span> }
                        </button>
                    }
                    else if (k == "planes")
                    {
                        <button class="btn btn-sm hv-tab-ico @claseArr @(mostrarTabPlanesAccion ? "btn-primary" : "btn-outline-primary")"
                                title="Planes de acción@(planesTorre.Count > 0 ? $" ({planesTorre.Count})" : "")" @onclick="MostrarTabPlanesAccion"
                                draggable="true" data-arrastre @ondragstart="() => arrPestana = k" @ondragend="FinArrastrePestana"
                                @ondragover:preventDefault="true" @ondragenter="() => sobrePestana = k" @ondrop="() => SoltarPestana(k)">
                            <Ico Nombre="plan-accion" />@if (planesTorre.Count > 0) { <span class="hv-cuenta">@planesTorre.Count</span> }
                        </button>
                    }
                    else if (actividadesDelComponente.FirstOrDefault(x => "a" + x.Id == k) is { } actTab)
                    {
                        <button class="btn btn-sm @claseArr @(!mostrarTabPlanos && !mostrarTabInformacion && actividadTabSeleccionada == actTab.Id ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => SeleccionarActividadTab(actTab.Id)"
                                draggable="true" data-arrastre @ondragstart="() => arrPestana = k" @ondragend="FinArrastrePestana"
                                @ondragover:preventDefault="true" @ondragenter="() => sobrePestana = k" @ondrop="() => SoltarPestana(k)">
                            @actTab.Nombre
                        </button>
                    }
                }
                @if (!componenteSeleccionado.EsHojaDeVida)
                {
                    <button class="btn btn-sm btn-link text-muted" title="Elegir qué actividades ver en este elemento"
                            @onclick="@(() => mostrarConfigActividadesComponente = !mostrarConfigActividadesComponente)">
                        ⚙ Actividades de este elemento
                    </button>
                }
            </div>

            @if (mostrarConfigActividadesComponente && !componenteSeleccionado.EsHojaDeVida)
            {
                <div class="border rounded p-2 mb-2 small">
                    <div class="text-muted mb-1">
                        Marca solo las actividades que aplican a este elemento. Si no marcas ninguna, no se muestra
                        ninguna (algunas patas simplemente no las tienen). Las de "Ensayos de..." igual se muestran
                        — y aparecen marcadas aquí — si esta pata ya tiene resultados cargados desde el módulo
                        Ensayos, para no esconder datos ya importados.
                    </div>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var a in ActividadesActivasPata)
                        {
                            var marcadaExplicita = actividadesPermitidasIds.Contains(a.Id);
                            var visiblePorDatos = !marcadaExplicita && actividadesDelComponente.Any(x => x.Id == a.Id);
                            <label class="d-flex align-items-center gap-1 mb-0">
                                <input type="checkbox" checked="@(marcadaExplicita || visiblePorDatos)"
                                       @onchange="@(e => AlternarActividadPermitida(a.Id, e.Value is bool b && b))" />
                                @a.Nombre
                                @if (visiblePorDatos)
                                {
                                    <span class="text-muted" style="font-size: 0.7rem;">(auto, ya tiene datos)</span>
                                }
                            </label>
                        }
                    </div>
                </div>
            }

            @* Contenido de la pestaña activa (Archivos y ensayos, Información, o
               cada actividad): un solo bloque que crece para llenar el espacio
               que quede del diálogo (ver .modal-area-flexible) y se desplaza
               internamente si no cabe — así, al agrandar la ventana a mano, lo
               de adentro aprovecha el espacio nuevo en vez de quedarse con su
               alto original. *@
            <div class="modal-area-flexible">
            @if (mostrarTabPlanos)
            {
                <div class="ficha-params-grid">
                    <div class="ficha-bloque">
                        <div class="ficha-bloque-titulo"><span>Archivos de @(componenteSeleccionado.EsHojaDeVida ? "la torre" : "este elemento")</span></div>
                        <InputFile class="form-control form-control-sm" multiple
                                   OnChange="CargarArchivosComponente" accept=".pdf,image/*,.dwg,.xlsx,.xls,.csv,.doc,.docx,.zip" />
                        @if (archivosDelComponente.Count > 0)
                        {
                            <ul class="small list-unstyled mt-1 mb-0 pildora-lista">
                                @foreach (var archivo in archivosDelComponente)
                                {
                                    <li>
                                        <PildoraArchivo Url="@archivo.RutaArchivo" Nombre="@archivo.NombreOriginal" />
                                        <button type="button" class="hv-quitar" @onclick="() => PedirEliminarArchivoComponente(archivo)" title="Quitar">✕</button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="ficha-bloque">
                        <div class="ficha-bloque-titulo"><span>Planos del listado maestro</span></div>
                        @if (planosVinculadosDelComponente.Count > 0)
                        {
                            <ul class="small list-unstyled mb-1 pildora-lista">
                                @foreach (var (vinculo, archivo, plano) in planosVinculadosDelComponente)
                                {
                                    <li class="hv-plano">
                                        <div class="hv-plano-info">
                                            <PildoraArchivo Url="@archivo.RutaArchivo" Nombre="@archivo.NombreOriginal" />
                                            <span class="hv-plano-cod" title="@plano.Codigo">@plano.Codigo@(string.IsNullOrEmpty(plano.RevisionVigente) ? "" : $" · Rev. {plano.RevisionVigente}")</span>
                                        </div>
                                        <button type="button" class="hv-quitar" @onclick="() => QuitarVinculoPlano(vinculo.Id)" title="Quitar vínculo">✕</button>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted small mb-1"><em>Sin planos vinculados todavía.</em></p>
                        }

                        @if (mostrarVincularPlano)
                        {
                            <div class="d-flex gap-1 align-items-start">
                                <div class="flex-grow-1">
                                    <input class="form-control form-control-sm" placeholder="Buscar por código o título del listado maestro..."
                                           value="@filtroVincularPlano" @oninput="BuscarPlanosParaVincular" />
                                    @if (!string.IsNullOrWhiteSpace(filtroVincularPlano))
                                    {
                                        @if (archivosDisponiblesVincular.Count > 0)
                                        {
                                            <ul class="list-group list-group-flush small mt-1" style="max-height: 180px; overflow-y: auto;">
                                                @foreach (var (archivoDisp, planoDisp) in archivosDisponiblesVincular)
                                                {
                                                    <li class="list-group-item list-group-item-action py-1" style="cursor:pointer;"
                                                        @onclick="() => VincularPlano(archivoDisp.Id)">
                                                        <strong>@planoDisp.Codigo</strong> — @archivoDisp.NombreOriginal
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <div class="form-text">Sin coincidencias en el listado maestro.</div>
                                        }
                                    }
                                </div>
                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="@(() => { mostrarVincularPlano = false; filtroVincularPlano = ""; archivosDisponiblesVincular = new(); })">Cerrar</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Vincular plano del listado maestro" @onclick="@(() => mostrarVincularPlano = true)"><Ico Nombre="agregar" /></button>
                        }
                    </div>

                        <div class="ficha-bloque">
                            <div class="ficha-bloque-titulo justify-content-between">
                                <span>Materiales @(materialesTorre.Count > 0 ? $"({materialesTorre.Select(m => m.MaterialId).Distinct().Count()})" : "")</span>
                                <a class="small fw-normal" href="materiales">Ver listado ▸</a>
                            </div>
                            @if (materialesTorre.Count == 0)
                            {
                                <p class="text-muted small mb-1"><em>Sin materiales relacionados.</em></p>
                            }
                            else
                            {
                                <ul class="small list-unstyled mb-1 hv-materiales">
                                    @foreach (var mt in materialesTorre)
                                    {
                                        var fila = mt;
                                        <li>
                                            <div class="hv-mat-cab">
                                                <span class="hv-mat-tit"><strong>@fila.Titulo</strong> <span class="text-muted">· @fila.Lugar</span></span>
                                                <button type="button" class="hv-quitar" title="Quitar relación" @onclick="() => QuitarMaterialTorre(fila.UbicacionId)">✕</button>
                                            </div>
                                            @if (fila.Adjuntos.Count == 0)
                                            {
                                                <div class="text-muted"><em>Sin adjuntos.</em></div>
                                            }
                                            @foreach (var grupo in fila.Adjuntos.GroupBy(x => x.Clase))
                                            {
                                                <div class="mat-adj-grupo">
                                                    <span class="text-muted">@grupo.Key:</span>
                                                    @foreach (var adj in grupo)
                                                    {
                                                        <PildoraArchivo Url="@adj.RutaArchivo" Nombre="@adj.NombreOriginal" Titulo="@($"{adj.Clase} · {adj.FechaCarga:dd/MM/yyyy}")" />
                                                    }
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            @if (mostrarRelacionarMaterial)
                            {
                                <div class="d-flex gap-1 align-items-start flex-wrap">
                                    <select class="form-select form-select-sm" style="max-width:170px;" title="Dónde" @bind="lugarMaterialTorre" disabled="@(!componenteSeleccionado.EsHojaDeVida)">
                                        <option value="0">Torre @elementoSeleccionado?.Codigo</option>
                                        @foreach (var el in elementosTorreMaterial) { <option value="@el.Id">@el.Nombre</option> }
                                    </select>
                                    <div class="flex-grow-1">
                                        <input class="form-control form-control-sm" placeholder="Buscar material..." @bind="filtroMaterialTorre" @bind:event="oninput" />
                                        @if (!string.IsNullOrWhiteSpace(filtroMaterialTorre))
                                        {
                                            var opciones = materialesDisponibles.Where(m => m.Titulo.Contains(filtroMaterialTorre.Trim(), StringComparison.OrdinalIgnoreCase)).Take(30).ToList();
                                            if (opciones.Count > 0)
                                            {
                                                <ul class="list-group list-group-flush small mt-1" style="max-height: 180px; overflow-y: auto;">
                                                    @foreach (var op in opciones)
                                                    {
                                                        var mid = op.Id;
                                                        <li class="list-group-item list-group-item-action py-1" style="cursor:pointer;" @onclick="() => RelacionarMaterialTorre(mid)">@op.Titulo</li>
