                        {
                            <div class="ficha-bloque-fila">
                                <span class="ficha-bloque-etiqueta">Archivos</span>
                                <InputFile class="form-control form-control-sm" multiple
                                           OnChange="@(e => CargarArchivosParametro(e, p.Id))" accept=".pdf,image/*" />
                            </div>
                        }
                        else if (!(archivosPorParametro.TryGetValue(p.Id, out var archivosVista) && archivosVista.Count > 0))
                        {
                            <div class="ficha-bloque-fila">
                                <span class="ficha-bloque-etiqueta">Archivos</span>
                                <span>—</span>
                            </div>
                        }
