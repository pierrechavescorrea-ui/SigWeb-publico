        await CambiarVista("mapa");
        await IrATorre(e);
    }

    [JSInvokable]
    public void SeleccionarElemento(int id)
    {
        elementoSeleccionado = elementos.FirstOrDefault(e => e.Id == id);
        mostrarFormNuevoComponente = false;
        nuevoNombreComponente = "";
        idComponenteEnEdicion = null;
        componentesDeLaTorre = elementoSeleccionado is null
            ? new()
            : Db.Componentes.AsNoTracking().Where(c => c.ElementoTrazadoId == id && !c.Eliminado)
                .OrderByDescending(c => c.EsHojaDeVida).ThenBy(c => c.Orden).ThenBy(c => c.Nombre).ToList();
        pctPie = elementoSeleccionado is null ? new(null, 0, 0) : SigWeb.Data.Pie.CumplimientoPie.DeTorre(Db, id);
        camposExtraTorre = elementoSeleccionado is null
            ? new()
            : FiltrarPorClavesActivas(
                Db.CamposExtraTorre.AsNoTracking().Where(c => c.ElementoTrazadoId == id && !c.Eliminado)
                    .OrderBy(c => c.Clave).ToList());
        // Lo mismo, pero por pata/elemento (no la "Hoja de vida", que no es
        // una pata): se muestra junto a los datos de la torre en el popup
        // "Información" y en la pestaña del mismo nombre de cada ficha.
        camposExtraPorComponente = elementoSeleccionado is null
            ? new()
            : componentesDeLaTorre.Where(c => !c.EsHojaDeVida)
                .Select(c => (c, Db.CamposExtraComponente.AsNoTracking()
                    .Where(x => x.ComponenteId == c.Id && !x.Eliminado)
                    .OrderBy(x => x.Clave).ToList()))
                .ToList();
        StateHasChanged();
    }

    // Una columna "desactivada" desde 📊 Tabla de torres no se borra — solo
    // deja de mostrarse aquí y en la pestaña Información de la Hoja de vida.
    private List<CampoExtraTorre> FiltrarPorClavesActivas(List<CampoExtraTorre> lista)
    {
        if (lista.Count == 0) return lista;
        var claves = lista.Select(c => c.Clave).Distinct().ToList();
        var inactivas = Db.ConfiguracionesCampoExtraTorre.AsNoTracking()
            .Where(cfg => claves.Contains(cfg.Clave) && !cfg.Activo)
            .Select(cfg => cfg.Clave)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        return inactivas.Count == 0 ? lista : lista.Where(c => !inactivas.Contains(c.Clave)).ToList();
    }

    // ---------- Cargar KMZ y elegir torres ----------
    private async Task CargarKmz(InputFileChangeEventArgs e)
    {
        mensaje = "";
        error = false;
        var archivo = e.File;

        if (!archivo.Name.EndsWith(".kmz", StringComparison.OrdinalIgnoreCase))
        {
            mensaje = "El archivo debe ser un .kmz.";
            error = true;
            return;
        }

        try
        {
            const long maxBytes = 20 * 1024 * 1024;
            using var ms = new MemoryStream();
            await using (var stream = archivo.OpenReadStream(maxBytes))
            {
                await stream.CopyToAsync(ms);
            }
            ms.Position = 0;

            puntosPendientes = LectorKmz.Leer(ms);
            codigosSeleccionados = new();
            // Pre-selecciona los que ya existen como torres, para facilitar una recarga.
            var codigosExistentes = Db.ElementosTrazado.AsNoTracking().Select(t => t.Codigo).ToHashSet();
            foreach (var p in puntosPendientes)
            {
                if (codigosExistentes.Contains(p.Codigo)) codigosSeleccionados.Add(p.Codigo);
            }

            if (puntosPendientes.Count == 0)
            {
                mensaje = "No se encontraron puntos dentro del KMZ.";
                error = true;
                return;
            }

            origenImportacionActual = "Kmz";
            mostrarSeleccionImportacion = true;
            mostrarOpcionesCarga = false;
            mensaje = $"Se encontraron {puntosPendientes.Count} puntos. Elige cuáles son torres y confirma la importación.";
            error = false;
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo leer el KMZ: {ex.Message}";
            error = true;
        }
    }

    // ---------- Cargar Excel de coordenadas (Torre, X, Y) ----------
    private async Task CargarExcel(InputFileChangeEventArgs e)
    {
        mensaje = "";
        error = false;
        var archivo = e.File;

        if (!archivo.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            mensaje = "El archivo debe ser un Excel (.xlsx).";
            error = true;
            return;
        }

        try
        {
            const long maxBytes = 10 * 1024 * 1024;
            using var ms = new MemoryStream();
            await using (var stream = archivo.OpenReadStream(maxBytes))
            {
                await stream.CopyToAsync(ms);
            }
            ms.Position = 0;

            filasExcelCrudas = LectorExcelCoordenadas.Leer(ms, out var errores);

            if (errores.Count > 0)
            {
                mensaje = string.Join(" ", errores);
                error = true;
                filasExcelCrudas = new();
                return;
            }
            if (filasExcelCrudas.Count == 0)
            {
                mensaje = "No se encontraron filas válidas en el Excel.";
                error = true;
                return;
            }

            sistemaExcelSeleccionado = ConversorCoordenadas.Detectar(filasExcelCrudas[0].X, filasExcelCrudas[0].Y);
            mostrarConfigExcel = true;
            mostrarOpcionesCarga = false;
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo leer el Excel: {ex.Message}";
            error = true;
        }
    }

    private void CancelarExcel()
    {
        mostrarConfigExcel = false;
        filasExcelCrudas = new();
    }

    private void ConvertirCoordenadasExcel()
    {
        puntosPendientes = filasExcelCrudas.Select(f =>
        {
            var (lat, lon) = ConversorCoordenadas.Convertir(f.X, f.Y, sistemaExcelSeleccionado);
            return new PuntoImportado { Codigo = f.Torre, Nombre = f.Torre, Latitud = lat, Longitud = lon };
        }).ToList();

        codigosSeleccionados = new();
        var codigosExistentes = Db.ElementosTrazado.AsNoTracking().Select(t => t.Codigo).ToHashSet();
        foreach (var p in puntosPendientes)
        {
            if (codigosExistentes.Contains(p.Codigo)) codigosSeleccionados.Add(p.Codigo);
        }

        origenImportacionActual = "Excel";
        mostrarConfigExcel = false;
        filasExcelCrudas = new();
        mostrarSeleccionImportacion = true;
        mensaje = $"Se convirtieron {puntosPendientes.Count} puntos. Elige cuáles son torres y confirma la importación.";
        error = false;
    }

    private List<PuntoImportado> PuntosFiltrados()
    {
        if (string.IsNullOrWhiteSpace(filtroImportacion)) return puntosPendientes;
        return puntosPendientes
            .Where(p => p.Codigo.Contains(filtroImportacion, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void AlternarSeleccion(string codigo, bool marcado)
    {
        if (marcado) codigosSeleccionados.Add(codigo);
        else codigosSeleccionados.Remove(codigo);
    }

    private void SeleccionarTodosFiltrados()
    {
        foreach (var p in PuntosFiltrados()) codigosSeleccionados.Add(p.Codigo);
    }

    private void QuitarTodosFiltrados()
    {
        foreach (var p in PuntosFiltrados()) codigosSeleccionados.Remove(p.Codigo);
    }

    private void CancelarImportacion()
    {
        mostrarSeleccionImportacion = false;
        mostrarVinculacionPatas = false;
        mostrarConflictosNombre = false;
        puntosPendientes = new();
        codigosSeleccionados = new();
        candidatasPatas = new();
        codigosPatasSeleccionadas = new();
        conflictosNombre = new();
        decisionesConflicto = new();
        filtroImportacion = "";
        versionImportacionActual = "";
        mensaje = "";
    }

    // Primer clic en "Importar": antes de escribir nada en la base, revisa
    // si algún código nuevo se parece a una torre que ya existe (paso 1) y
    // si hay puntos sin marcar cerca de las torres seleccionadas que
    // podrían ser sus patas (paso 2).
    private void PrepararConfirmacion()
    {
        var seleccionados = puntosPendientes.Where(p => codigosSeleccionados.Contains(p.Codigo)).ToList();
        if (seleccionados.Count == 0)
        {
            mensaje = "No seleccionaste ningún punto como torre.";
            error = true;
            return;
        }

        conflictosNombre = DetectarConflictosNombre(seleccionados);
        if (conflictosNombre.Count > 0)
        {
            decisionesConflicto = conflictosNombre.ToDictionary(c => c.CodigoNuevo, c => "ambas");
            mostrarSeleccionImportacion = false;
            mostrarConflictosNombre = true;
            return;
        }

        ContinuarHaciaVinculacionPatas(seleccionados);
    }

    private void ElegirDecisionConflicto(string codigo, string decision)
    {
        decisionesConflicto[codigo] = decision;
    }

    private void ContinuarDesdeConflictos()
    {
        mostrarConflictosNombre = false;
        var seleccionados = puntosPendientes.Where(p => codigosSeleccionados.Contains(p.Codigo)).ToList();
        ContinuarHaciaVinculacionPatas(seleccionados);
    }

    private void ContinuarHaciaVinculacionPatas(List<PuntoImportado> seleccionados)
    {
        candidatasPatas = ComputarCandidatasPatas(seleccionados);
        codigosPatasSeleccionadas = candidatasPatas.Select(c => c.Codigo).ToHashSet();

        if (candidatasPatas.Count > 0)
        {
            mostrarSeleccionImportacion = false;
            mostrarVinculacionPatas = true;
        }
        else
        {
            _ = EjecutarImportacionTrazado();
        }
    }

    // Compara un código nuevo contra los códigos ya existentes en la base
    // y detecta si se parece mucho a alguno sin ser exactamente igual
    // (ej. "102" ya existe y llega "102N" o "102NN"): o bien uno es
    // "prefijo" del otro, o difieren en muy pocos caracteres.
    private List<ConflictoNombre> DetectarConflictosNombre(List<PuntoImportado> seleccionados)
    {
        // Incluye también torres actualmente en la Papelera (Eliminado=true):
        // son justo el caso típico de "cargué otro archivo y ya no se llama
        // igual" — sus datos deben poder migrarse hacia la nueva referencia.
        var existentes = Db.ElementosTrazado.AsNoTracking().Select(t => new { t.Id, t.Codigo, t.Eliminado }).ToList();
        var codigosExistentes = existentes.Select(e => e.Codigo).ToHashSet();
        var resultado = new List<ConflictoNombre>();

        foreach (var p in seleccionados)
        {
            if (codigosExistentes.Contains(p.Codigo)) continue; // coincidencia exacta: es una actualización normal

            var similar = existentes
                .Where(e => SonNombresParecidos(p.Codigo, e.Codigo))
                .OrderBy(e => Math.Abs(e.Codigo.Length - p.Codigo.Length))
                .FirstOrDefault();

            if (similar is not null)
            {
                resultado.Add(new ConflictoNombre(p.Codigo, similar.Codigo, similar.Id, similar.Eliminado));
            }
        }

        return resultado;
    }

    private static bool SonNombresParecidos(string a, string b)
    {
        a = a.Trim().ToUpperInvariant();
        b = b.Trim().ToUpperInvariant();
        if (a == b) return false;
        if (a.Length == 0 || b.Length == 0) return false;

        // Uno es "prefijo" del otro: "102" vs "102N", "102" vs "102NN".
        if (a.StartsWith(b, StringComparison.Ordinal) || b.StartsWith(a, StringComparison.Ordinal)) return true;

        // Nombres de longitud parecida y muy pocos caracteres de diferencia.
        if (Math.Abs(a.Length - b.Length) <= 2 && DistanciaEdicion(a, b) <= 2) return true;

        return false;
    }

    // Distancia de Levenshtein clásica (número mínimo de inserciones,
    // borrados o cambios de un carácter para pasar de a a b).
    private static int DistanciaEdicion(string a, string b)
    {
        var costos = new int[b.Length + 1];
        for (int j = 0; j <= b.Length; j++) costos[j] = j;

        for (int i = 1; i <= a.Length; i++)
        {
            int anterior = costos[0];
            costos[0] = i;
            for (int j = 1; j <= b.Length; j++)
            {
                int actual = costos[j];
                costos[j] = a[i - 1] == b[j - 1]
                    ? anterior
                    : 1 + Math.Min(anterior, Math.Min(costos[j], costos[j - 1]));
                anterior = actual;
            }
        }
        return costos[b.Length];
    }

    private void AlternarSeleccionPata(string codigo, bool marcado)
    {
        if (marcado) codigosPatasSeleccionadas.Add(codigo);
        else codigosPatasSeleccionadas.Remove(codigo);
    }

    private List<CandidataPata> ComputarCandidatasPatas(List<PuntoImportado> torresSeleccionadas)
    {
        var resultado = new List<CandidataPata>();
        var noTorres = puntosPendientes.Where(p => !codigosSeleccionados.Contains(p.Codigo)).ToList();

        foreach (var punto in noTorres)
        {
            var masCercana = torresSeleccionadas
                .Select(t => new { Torre = t, Dist = DistanciaMetros(punto.Latitud, punto.Longitud, t.Latitud, t.Longitud) })
                .OrderBy(x => x.Dist)
                .FirstOrDefault();

            if (masCercana is not null && masCercana.Dist <= RadioPatasMetros)
            {
                resultado.Add(new CandidataPata(punto.Codigo, masCercana.Torre.Codigo, masCercana.Dist, punto.Latitud, punto.Longitud));
            }
        }

        return resultado.OrderBy(c => c.CodigoTorreCercana).ThenBy(c => c.DistanciaMetros).ToList();
    }

    private static double DistanciaMetros(double lat1, double lon1, double lat2, double lon2)
    {
        const double radioTierra = 6_371_000;
        double dLat = (lat2 - lat1) * Math.PI / 180;
        double dLon = (lon2 - lon1) * Math.PI / 180;
        double a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2)
            + Math.Cos(lat1 * Math.PI / 180) * Math.Cos(lat2 * Math.PI / 180) * Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        double c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
        return radioTierra * c;
    }

    private async Task EjecutarImportacionTrazado()
    {
        var seleccionados = puntosPendientes.Where(p => codigosSeleccionados.Contains(p.Codigo)).ToList();
        if (seleccionados.Count == 0)
        {
            mensaje = "No seleccionaste ningún punto como torre.";
            error = true;
            return;
        }

        // Una capa nueva por cada carga confirmada, para poder identificarla,
        // apagarla o eliminarla después desde el panel "🗂 Capas".
        var versionTexto = versionImportacionActual.Trim();
        var capaActual = new CapaTrazado
        {
            Nombre = $"{(origenImportacionActual == "Kmz" ? "KMZ" : "Excel")} — {DateTime.Now:dd/MM/yyyy HH:mm}"
                + (string.IsNullOrEmpty(versionTexto) ? "" : $" (v. {versionTexto})"),
            Origen = origenImportacionActual,
            FechaCarga = DateTime.Now,
            Version = string.IsNullOrEmpty(versionTexto) ? null : versionTexto
        };
        Db.Capas.Add(capaActual);
        Db.SaveChanges();
        Db.ChangeTracker.Clear();

        int nuevas = 0, actualizadas = 0, migradas = 0;

        foreach (var p in seleccionados)
        {
            var torre = Db.ElementosTrazado.FirstOrDefault(x => x.Codigo == p.Codigo);
            bool esNueva = torre is null;
            bool esMigracion = false;

            if (esNueva && decisionesConflicto.TryGetValue(p.Codigo, out var decision) && decision == "migrar")
            {
                var conflicto = conflictosNombre.FirstOrDefault(c => c.CodigoNuevo == p.Codigo);
                if (conflicto is not null)
                {
                    var torreAMigrar = Db.ElementosTrazado.FirstOrDefault(x => x.Id == conflicto.IdExistente);
                    if (torreAMigrar is not null)
                    {
                        // Es la misma torre con un nombre distinto: se le cambia el código
                        // y se actualiza como si siempre se hubiera llamado así. Como
                        // Componente/RegistroParametro/Material se vinculan por Id (no por
                        // código), todo lo ya cargado para esta torre queda intacto.
                        torreAMigrar.Codigo = p.Codigo;
                        torre = torreAMigrar;
                        esNueva = false;
                        esMigracion = true;
                        migradas++;
                    }
                }
            }

            if (esNueva)
            {
                torre = new ElementoTrazado { Codigo = p.Codigo };
                Db.ElementosTrazado.Add(torre);
                nuevas++;
            }
            else if (!esMigracion)
            {
                actualizadas++;
            }
            torre!.Nombre = p.Nombre;
            torre.Latitud = p.Latitud;
            torre.Longitud = p.Longitud;
            // La referencia gráfica pasa a pertenecer a esta nueva capa; si
            // venía de la Papelera (coincidencia exacta o migración), se
            // revive automáticamente.
            torre.CapaTrazadoId = capaActual.Id;
            torre.Eliminado = false;
            torre.FechaEliminacion = null;
            Db.SaveChanges();
            Db.ChangeTracker.Clear();

            SincronizadorCatalogoLocalizacion.Sincronizar(Db, torre);

            if (esNueva)
            {
                var torreGuardada = Db.ElementosTrazado.First(x => x.Codigo == p.Codigo);
                var patasDeEstaTorre = candidatasPatas
                    .Where(c => c.CodigoTorreCercana == p.Codigo && codigosPatasSeleccionadas.Contains(c.Codigo))
                    .ToList();
                CrearComponentesPorDefecto(torreGuardada.Id, patasDeEstaTorre);
            }
        }

        var patasVinculadas = candidatasPatas.Count(c => codigosPatasSeleccionadas.Contains(c.Codigo));
        mensaje = $"Trazado actualizado: {nuevas} torre(s) nueva(s) (con sus 4 patas por defecto"
            + (patasVinculadas > 0 ? $", {patasVinculadas} con ubicación real" : "")
            + $"), {actualizadas} actualizada(s)"
            + (migradas > 0 ? $", {migradas} migrada(s) desde una torre con nombre parecido" : "")
            + ".";
        error = false;
        mostrarSeleccionImportacion = false;
        mostrarVinculacionPatas = false;
        mostrarConflictosNombre = false;
        puntosPendientes = new();
        codigosSeleccionados = new();
        filtroImportacion = "";
        candidatasPatas = new();
        codigosPatasSeleccionadas = new();
        conflictosNombre = new();
        decisionesConflicto = new();
        versionImportacionActual = "";

        CargarCapas();
        CargarElementos();
        elementoSeleccionado = null;
        componentesDeLaTorre = new();
        await DibujarMapa();
    }

    private void CrearComponentesPorDefecto(int torreId, List<CandidataPata> patasReales)
    {
        // Toda torre nueva lleva, obligatoriamente, su "Hoja de vida"
        // (no se puede renombrar ni eliminar, y siempre muestra todas
        // las actividades). Orden = -1 para que siempre quede primera.
        Db.Componentes.Add(new Componente
        {
            ElementoTrazadoId = torreId,
            Nombre = "Hoja de vida",
            EsPredeterminado = true,
            EsHojaDeVida = true,
            Orden = -1
        });

        string[] letras = { "A", "B", "C", "D" };
        for (int i = 0; i < letras.Length; i++)
        {
            var real = i < patasReales.Count ? patasReales[i] : null;
            Db.Componentes.Add(new Componente
            {
                ElementoTrazadoId = torreId,
                Nombre = $"Pata {letras[i]}",
                EsPredeterminado = true,
                Orden = i,
                Latitud = real?.Latitud,
                Longitud = real?.Longitud
            });
        }
        Db.SaveChanges();
        Db.ChangeTracker.Clear();
    }

    // ---------- Agregar componente manual (trincho, cuneta, gavión...) ----------
    private async Task AgregarComponente()
    {
        if (elementoSeleccionado is null || string.IsNullOrWhiteSpace(nuevoNombreComponente)) return;

        Db.Componentes.Add(new Componente
        {
            ElementoTrazadoId = elementoSeleccionado.Id,
            Nombre = nuevoNombreComponente.Trim(),
            EsPredeterminado = false,
            Orden = componentesDeLaTorre.Count
        });
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        RecargarComponentesDeLaTorre();
        mostrarFormNuevoComponente = false;
        nuevoNombreComponente = "";
    }

    private void RecargarComponentesDeLaTorre()
    {
        if (elementoSeleccionado is null) { componentesDeLaTorre = new(); return; }
        componentesDeLaTorre = Db.Componentes.AsNoTracking()
            .Where(c => c.ElementoTrazadoId == elementoSeleccionado.Id && !c.Eliminado)
            .OrderByDescending(c => c.EsHojaDeVida).ThenBy(c => c.Orden).ThenBy(c => c.Nombre).ToList();
    }

    // ---------- Reordenar componentes manualmente ----------
    // Intercambia el Orden de este componente con el de su vecino (arriba
    // si direccion = -1, abajo si direccion = 1) y normaliza el Orden de
    // toda la lista según la posición resultante, para que el orden
    // manual quede fijo aunque haya empates o componentes sin Orden aún.
    // La "Hoja de vida" nunca entra en este reordenamiento: queda fija en
    // Orden = -1, siempre primera. Solo se reordenan los demás elementos
    // (patas, trinchos, gaviones...), renumerados 0..N entre ellos.
    // Arrastrar un elemento sobre otro lo deja en su lugar. La hoja de vida no se mueve: siempre primero.
    private int? arrComp, sobreComp;
    private void FinArrastreComp() { arrComp = null; sobreComp = null; }

    private async Task SoltarComponente(Componente destino)
    {
        var origenId = arrComp;
        FinArrastreComp();
        if (origenId is not int oid || destino.EsHojaDeVida || oid == destino.Id) return;
        var movibles = componentesDeLaTorre.Where(x => !x.EsHojaDeVida).ToList();
        var desde = movibles.FindIndex(x => x.Id == oid);
        var hasta = movibles.FindIndex(x => x.Id == destino.Id);
        if (desde < 0 || hasta < 0) return;
        var item = movibles[desde];
        movibles.RemoveAt(desde);
        movibles.Insert(hasta, item);
        for (int i = 0; i < movibles.Count; i++)
        {
            var entidad = await Db.Componentes.FindAsync(movibles[i].Id);
            if (entidad is not null) entidad.Orden = i + 1;
        }
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        RecargarComponentesDeLaTorre();
    }

    private async Task MoverComponente(Componente c, int direccion)
    {
        if (c.EsHojaDeVida) return;

        var movibles = componentesDeLaTorre.Where(x => !x.EsHojaDeVida).ToList();
        var indiceActual = movibles.FindIndex(x => x.Id == c.Id);
        var indiceVecino = indiceActual + direccion;
        if (indiceActual < 0 || indiceVecino < 0 || indiceVecino >= movibles.Count) return;

        (movibles[indiceActual], movibles[indiceVecino]) = (movibles[indiceVecino], movibles[indiceActual]);

        for (int i = 0; i < movibles.Count; i++)
        {
            var entidad = await Db.Componentes.FindAsync(movibles[i].Id);
            if (entidad is not null) entidad.Orden = i;
        }
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        RecargarComponentesDeLaTorre();
    }

    // ---------- Editar (renombrar) un componente ----------
    private void IniciarEdicionComponente(Componente c)
    {
        if (c.EsHojaDeVida) return; // obligatoria: no se puede renombrar
        idComponenteEnEdicion = c.Id;
        nombreEdicionComponente = c.Nombre;
    }

    private void CancelarEdicionComponente()
    {
        idComponenteEnEdicion = null;
        nombreEdicionComponente = "";
    }

    private async Task GuardarEdicionComponente(Componente c)
    {
        var nombre = nombreEdicionComponente.Trim();
        if (string.IsNullOrWhiteSpace(nombre)) return;

        var entidad = await Db.Componentes.FindAsync(c.Id);
        if (entidad is not null)
        {
            entidad.Nombre = nombre;
            await Db.SaveChangesAsync();
        }
        Db.ChangeTracker.Clear();

        idComponenteEnEdicion = null;
        nombreEdicionComponente = "";
        RecargarComponentesDeLaTorre();
    }

    // ---------- Eliminar un componente (se va a la Papelera) ----------
    private void PedirEliminarComponente(Componente c)
    {
        if (c.EsHojaDeVida) return; // obligatoria: no se puede eliminar
        idComponentePendienteEliminar = c.Id;
        _ = CalcularImpacto(a => a.Componente(c.Id));
        nombreComponentePendienteEliminar = c.Nombre;
        mostrarModalEliminarComponente = true;
    }

    private void CancelarEliminarComponente()
    {
        mostrarModalEliminarComponente = false;
        idComponentePendienteEliminar = 0;
        nombreComponentePendienteEliminar = "";
    }

    private async Task ConfirmarEliminarComponente()
    {
        var c = await Db.Componentes.FindAsync(idComponentePendienteEliminar);
        if (c is not null)
        {
            c.Eliminado = true;
            c.FechaEliminacion = DateTime.Now;
            await Db.SaveChangesAsync();
        }
        Db.ChangeTracker.Clear();

        mostrarModalEliminarComponente = false;
        idComponentePendienteEliminar = 0;
        nombreComponentePendienteEliminar = "";
        RecargarComponentesDeLaTorre();
    }

    // ---------- Orden de las pestañas de la ficha (arrastrar; igual en todas las torres) ----------
    private List<string> ordenPestanas = new();
    private string? arrPestana, sobrePestana;

    // Pestañas de la ficha abierta, en el orden guardado; las que no estén en él, al final en su orden de siempre.
    private List<string> PestanasFicha()
    {
        if (componenteSeleccionado is null) return new();
        var l = new List<string> { "archivos" };
        if (componenteSeleccionado.EsHojaDeVida) l.AddRange(new[] { "informacion", "riesgos", "planes" });
        l.AddRange(actividadesDelComponente.Select(a => "a" + a.Id));
        return l.Select((k, i) => (k, i))
            .OrderBy(x => ordenPestanas.IndexOf(x.k) is var p && p >= 0 ? p : int.MaxValue).ThenBy(x => x.i)
            .Select(x => x.k).ToList();
    }

    private void FinArrastrePestana() { arrPestana = null; sobrePestana = null; }

    private async Task SoltarPestana(string destino)
    {
        var origen = arrPestana;
        FinArrastrePestana();
        if (origen is null || origen == destino) return;
        var actual = PestanasFicha();
        var desde = actual.IndexOf(origen);
        var hasta = actual.IndexOf(destino);
        if (desde < 0 || hasta < 0) return;
        actual.RemoveAt(desde);
        actual.Insert(hasta, origen);
        // Las de esta ficha en su nuevo orden y, detrás, las de otras fichas (otras actividades) como estaban.
        ordenPestanas = actual.Concat(ordenPestanas.Where(k => !actual.Contains(k))).ToList();
        try
        {
            var config = await Db.Configuracion.FirstOrDefaultAsync(c => c.Id == 1);
            if (config is not null) { config.OrdenPestanasFicha = string.Join(",", ordenPestanas); await Db.SaveChangesAsync(); }
            Db.ChangeTracker.Clear();
        }
        catch { Db.ChangeTracker.Clear(); }
    }

    // ---------- Ficha del componente (pestañas por actividad) ----------
    private void AbrirFichaComponente(Componente c)
    {
        componenteSeleccionado = c;
        mostrarModalComponente = true;
        mensajesGuardado = new();
        mostrarConfigActividadesComponente = false;
        mostrarTabPlanos = false;
        mostrarTabInformacion = false;
        mostrarTabHallazgos = false;
        mostrarTabPlanesAccion = false;
        hallazgosTorre = new();
        planesTorre = new();
        if (c.EsHojaDeVida) _ = CargarHallazgosTorre();
        CargarRegistrosVinculadosComponente();
        CargarCamposExtraComponente();
        CargarArchivosDelComponente();
        CargarPlanosVinculadosDelComponente();
        CargarResultadosEnsayoDelComponente();
        CargarActividadesDelComponente();
        if (c.EsHojaDeVida) CargarResultadosEnsayoTorre();
        mostrarRelacionarMaterial = false;
