                                            <span class="hv-ens-pata">@porPata.Key</span>
                                            <div class="hv-ens-cont">
                                                <span class="hv-ens-n">@porPata.Count() resultado@(porPata.Count() == 1 ? "" : "s")</span>
                                                @foreach (var idInforme in porPata.Where(x => x.InformeId is not null).Select(x => x.InformeId!.Value).Distinct())
                                                {
                                                    <div class="hv-ens-inf">
                                                        @foreach (var arch in ArchivosDeInforme(idInforme))
                                                        {
                                                            <PildoraArchivo Url="@arch.RutaArchivo" Nombre="@arch.NombreOriginal" />
                                                        }
                                                        <button type="button" class="ens-mini hv-ens-mas" title="Subir o gestionar documentos del informe"
                                                                @onclick="() => AbrirArchivosInformePata(idInforme)"><Ico Nombre="agregar" /></button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            }
            else if (mostrarTabInformacion)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="small">Información (importada de Excel)</strong>
                        <span class="text-muted small">@TotalDatosAdicionalesTorre campo@(TotalDatosAdicionalesTorre == 1 ? "" : "s")</span>
                    </div>
                    @if (!HayDatosAdicionalesTorre)
                    {
                        <p class="text-muted small mb-0"><em>Esta torre no tiene datos adicionales cargados.</em></p>
                    }
                    else
                    {
                        <input class="form-control form-control-sm mb-2" placeholder="Buscar campo o valor..."
                               @bind="filtroDatosExtraTorre" @bind:event="oninput" />
                        <div>
                            @if (CamposExtraTorreFiltrados().Count > 0)
                            {
                                <div class="text-muted small mb-1">Datos de la torre</div>
                                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2 mb-3">
                                    @foreach (var campo in CamposExtraTorreFiltrados())
                                    {
                                        <div class="col">
                                            <div class="border rounded px-2 py-1 h-100">
                                                <div class="text-muted" style="font-size: 0.72rem;">@campo.Clave</div>
                                                <div class="small">@(string.IsNullOrWhiteSpace(campo.Valor) ? "—" : campo.Valor)</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
