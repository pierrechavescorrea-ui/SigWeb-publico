                            {
                                <div class="text-muted small mb-1">Datos por pata / elemento</div>
                                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2">
                                    @foreach (var (comp, campos) in CamposExtraPorComponenteFiltrados())
                                    {
                                        <div class="col">
                                            <div class="border rounded p-2 h-100">
                                                <div class="fw-semibold small mb-1">@comp.Nombre</div>
                                                @foreach (var campo in campos)
                                                {
                                                    <div class="d-flex justify-content-between gap-2 small border-top pt-1 mt-1">
                                                        <span class="text-muted">@campo.Clave</span>
                                                        <span class="text-end">@(string.IsNullOrWhiteSpace(campo.Valor) ? "—" : campo.Valor)</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            @if (CamposExtraTorreFiltrados().Count == 0 && CamposExtraPorComponenteFiltrados().Count == 0)
                            {
                                <p class="text-muted small"><em>Sin resultados.</em></p>
                            }
                        </div>
                    }
                </div>
            }
            else if (mostrarTabPlanesAccion)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="d-flex flex-wrap gap-1 align-items-center mb-1">
