    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;
    private bool BloqueadoPorImpacto => impacto is null || (impacto.RequiereEntender && !impactoOk);

    // Se lanza sin await para no congelar el aviso: por eso usa un analizador
    // con su propio DbContext (el de la página puede estar ocupado en ese momento).
    private async Task CalcularImpacto(Func<SigWeb.Data.Impacto.AnalizadorImpacto, Task<SigWeb.Data.Impacto.InformeImpacto>> f)
    {
        impacto = null; impactoOk = false;
        try
        {
            using var scope = Scopes.CreateScope();
            impacto = await f(scope.ServiceProvider.GetRequiredService<SigWeb.Data.Impacto.AnalizadorImpacto>());
        }
        catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private void PedirEliminarCapa(CapaTrazado c)
    {
        _ = CalcularImpacto(a => a.Capa(c.Id));
        capaPendienteEliminar = c.Id;
        nombreCapaPendienteEliminar = c.Nombre;
        mostrarModalEliminarCapa = true;
    }

    private void CancelarEliminarCapa()
    {
        mostrarModalEliminarCapa = false;
        capaPendienteEliminar = 0;
        nombreCapaPendienteEliminar = "";
    }

    // Envía a la Papelera solo la referencia gráfica de cada torre de esta
    // capa (Eliminado = true). Sus componentes, checklist y materiales no
    // se tocan: siguen intactos, listos para ser recuperados si más
    // adelante llega un KMZ/Excel con el mismo código o uno parecido.
    private async Task ConfirmarEliminarCapa()
    {
        var torresDeLaCapa = Db.ElementosTrazado
            .Where(e => e.CapaTrazadoId == capaPendienteEliminar && !e.Eliminado)
            .ToList();

        foreach (var t in torresDeLaCapa)
        {
            t.Eliminado = true;
            t.FechaEliminacion = DateTime.Now;
        }
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        foreach (var t in torresDeLaCapa)
        {
            SincronizadorCatalogoLocalizacion.MarcarInactivo(Db, t.Id);
        }

        mostrarModalEliminarCapa = false;
        capaPendienteEliminar = 0;
        nombreCapaPendienteEliminar = "";

        if (elementoSeleccionado is not null && torresDeLaCapa.Any(t => t.Id == elementoSeleccionado.Id))
        {
            elementoSeleccionado = null;
            componentesDeLaTorre = new();
        }

        CargarCapas();
        CargarElementos();
        await DibujarMapa();
    }

    private async Task DibujarMapa()
    {
        var torres = elementos.Select(e => new
        {
            id = e.Id,
            codigo = e.Codigo,
            latitud = e.Latitud,
            longitud = e.Longitud,
            icono = e.IconoMapa,
            color = e.ColorMapa
        });

        // Patas con ubicación real (tomada del KMZ al vincularlas) que el
        // usuario no haya ocultado con la palomita "ver en el mapa".
        var patas = Db.Componentes.AsNoTracking()
            .Where(c => !c.Eliminado && c.Latitud != null && c.Longitud != null && c.MostrarEnMapa)
            .Select(c => new { id = c.Id, torreId = c.ElementoTrazadoId, nombre = c.Nombre, latitud = c.Latitud, longitud = c.Longitud, icono = c.IconoMapa, color = c.ColorMapa })
            .ToList();

        // Elementos importados de DWG/DXF (cunetas, trinchos...), con
        // geometría propia (GeometriaJson: lista de caminos de [lat, lon]).
        var formas = Db.Componentes.AsNoTracking()
            .Where(c => !c.Eliminado && c.GeometriaJson != null && c.MostrarEnMapa)
            .Select(c => new { c.Id, c.ElementoTrazadoId, c.Nombre, c.GeometriaJson, c.ColorMapa })
            .ToList()
            .Select(c => new
            {
                id = c.Id,
                torreId = c.ElementoTrazadoId,
                nombre = c.Nombre,
                color = c.ColorMapa,
                caminos = System.Text.Json.JsonSerializer.Deserialize<List<List<double[]>>>(c.GeometriaJson!) ?? new()
            })
            .ToList();

        var config = new
        {
            iconoTorre = configIconoTorre,
            colorTorre = configColorTorre,
            iconoPata = configIconoPata,
            colorPata = configColorPata,
            capaBase = configCapaBase
        };

        await JS.InvokeVoidAsync("inicializarMapaTrazado", torres, patas, formas, config, referencia);
    }

