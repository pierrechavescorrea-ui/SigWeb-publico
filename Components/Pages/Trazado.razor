    private void SeleccionarActividadTab(int actividadId)
    {
        mostrarTabPlanos = false;
        mostrarTabHallazgos = false;
        mostrarTabPlanesAccion = false;
        mostrarTabInformacion = false;
        actividadTabSeleccionada = actividadId;
        mensajesGuardado = new();
        parametrosEnEdicion.Clear();

        estadosParametro = Db.EstadosParametro.AsNoTracking().Where(e => e.Activo).OrderBy(e => e.Orden).ThenBy(e => e.Id).ToList();

        parametrosDeActividad = Db.ParametrosActividad.AsNoTracking()
            .Where(p => p.ActividadId == actividadId && p.Activo)
            .OrderBy(p => p.Orden).ThenBy(p => p.Codigo)
            .ToList();

        var existentes = componenteSeleccionado is null
            ? new List<RegistroParametro>()
            : Db.RegistrosParametro.AsNoTracking()
                .Where(r => r.ComponenteId == componenteSeleccionado.Id)
                .ToList();

        registrosEditables = new();
        parametrosEnEdicion.Clear();
        archivosPorParametro = new();
        foreach (var p in parametrosDeActividad)
        {
            var existente = existentes.FirstOrDefault(r => r.ParametroActividadId == p.Id);
            registrosEditables[p.Id] = existente is not null
                ? new RegistroParametro
                {
                    Id = existente.Id,
                    ComponenteId = existente.ComponenteId,
                    ParametroActividadId = existente.ParametroActividadId,
                    Completado = existente.Completado,
                    EstadoParametroId = existente.EstadoParametroId,
                    Fecha = existente.Fecha,
                    FechaFacturado = existente.FechaFacturado,
                    Observaciones = existente.Observaciones
                }
                : new RegistroParametro { ComponenteId = componenteSeleccionado!.Id, ParametroActividadId = p.Id };

            archivosPorParametro[p.Id] = existente is not null
                ? Db.ArchivosRegistroParametro.AsNoTracking()
                    .Where(a => a.RegistroParametroId == existente.Id && !a.Eliminado)
                    .ToList()
                : new();
        }
    }

    // Sube uno o varios adjuntos para un parámetro. Si el registro
    // (checklist) todavía no existía en la base de datos, se crea aquí
    // mismo con el estado actual del checkbox/fecha/observación, para
    // poder engancharle los archivos por su Id.
    private async Task CargarArchivosParametro(InputFileChangeEventArgs e, int parametroId)
    {
        var registro = registrosEditables[parametroId];
        if (registro.Id == 0)
        {
            Db.RegistrosParametro.Add(registro);
            await Db.SaveChangesAsync();
        }

        const long maxBytes = 10 * 1024 * 1024; // 10 MB por archivo
        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "trazado");
        Directory.CreateDirectory(carpeta);

        foreach (var archivo in e.GetMultipleFiles(10))
        {
            if (archivo.Size > maxBytes)
            {
                mensajesGuardado[parametroId] = $"\"{archivo.Name}\" supera 10 MB y se omitió.";
                continue;
            }

            var extension = Path.GetExtension(archivo.Name);
            var nombreArchivo = $"{Guid.NewGuid()}{extension}";
            var rutaFisica = Path.Combine(carpeta, nombreArchivo);

            await using var stream = archivo.OpenReadStream(maxBytes);
            await using var destino = File.Create(rutaFisica);
            await stream.CopyToAsync(destino);

            Db.ArchivosRegistroParametro.Add(new ArchivoRegistroParametro
            {
                RegistroParametroId = registro.Id,
                NombreOriginal = archivo.Name,
                RutaArchivo = $"/uploads/trazado/{nombreArchivo}"
            });
        }

        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        archivosPorParametro[parametroId] = Db.ArchivosRegistroParametro.AsNoTracking()
            .Where(a => a.RegistroParametroId == registro.Id && !a.Eliminado).ToList();
        CargarRegistrosVinculadosComponente();
    }

    // ---------- Quitar un adjunto: pide confirmación y va a la Papelera ----------
    // Antes se borraba el archivo de una vez al hacer clic. Ahora, como
    // cualquier adjunto nuevo desde aquí en adelante, se pide confirmar y
    // solo se marca Eliminado = true; el archivo físico y la fila solo se
    // borran de verdad desde el módulo Papelera (o al vencer el plazo).
    private ArchivoRegistroParametro? archivoParametroPendienteEliminar;
    private int parametroIdPendienteEliminar;

    private void PedirEliminarArchivoParametro(ArchivoRegistroParametro archivo, int parametroId)
    {
        archivoParametroPendienteEliminar = archivo;
        parametroIdPendienteEliminar = parametroId;
        _ = CalcularImpacto(a => a.AdjuntoRegistro(archivo.Id));
    }

    private void CancelarEliminarArchivoParametro()
    {
        archivoParametroPendienteEliminar = null;
    }

    private async Task ConfirmarEliminarArchivoParametro()
    {
        if (archivoParametroPendienteEliminar is null) return;
        var archivo = archivoParametroPendienteEliminar;
        var parametroId = parametroIdPendienteEliminar;

        var entidad = await Db.ArchivosRegistroParametro.FindAsync(archivo.Id);
        if (entidad is not null)
        {
            entidad.Eliminado = true;
            entidad.FechaEliminacion = DateTime.Now;
            await Db.SaveChangesAsync();
        }
        Db.ChangeTracker.Clear();

        archivosPorParametro[parametroId] = Db.ArchivosRegistroParametro.AsNoTracking()
            .Where(a => a.RegistroParametroId == archivo.RegistroParametroId && !a.Eliminado).ToList();

        archivoParametroPendienteEliminar = null;
    }

    private async Task GuardarRegistro(ParametroActividad p)
    {
        var r = registrosEditables[p.Id];

        // Si no hay nada que guardar (ni marcado, ni observación) y
        // todavía no existía en la base de datos, no crea una fila vacía.
        // (Si ya tiene archivos adjuntos, el registro ya se creó al
        // subirlos, así que r.Id ya no será 0 en ese caso.)
        if (r.Id == 0 && !r.Completado && string.IsNullOrWhiteSpace(r.Observaciones) && r.FechaFacturado is null)
        {
            return;
        }

        if (r.Id == 0)
        {
            Db.RegistrosParametro.Add(r);
        }
        else
        {
            Db.RegistrosParametro.Update(r);
        }

        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        mensajesGuardado[p.Id] = "Guardado ✓";
        CargarRegistrosVinculadosComponente();
        RecalcularPctPie();
    }

    private void RecalcularPctPie() =>
        pctPie = elementoSeleccionado is null ? new(null, 0, 0) : SigWeb.Data.Pie.CumplimientoPie.DeTorre(Db, elementoSeleccionado.Id);

