                        }
                        else
                        {
                            @foreach (var porTipo in resultadosEnsayoTorre.GroupBy(x => x.Tipo.Id).OrderBy(g => g.First().Grupo).ThenBy(g => g.First().Tipo.Orden).ThenBy(g => g.First().Tipo.Nombre))
                            {
                                var tipoBloque = porTipo.First().Tipo;
                                <div class="ficha-bloque">
                                    <div class="ficha-bloque-titulo justify-content-between">
                                        <span>@tipoBloque.Nombre <span class="text-muted fw-normal small">· @porTipo.First().Grupo</span></span>
                                        <a class="small fw-normal" href="@($"ensayos/{tipoBloque.Id}")">Ver todos ▸</a>
                                    </div>
                                    @foreach (var porPata in porTipo.GroupBy(x => x.Pata).OrderBy(g => g.Key == EtiquetaEnsayoTorreCompleta ? 0 : 1).ThenBy(g => g.Key))
                                    {
