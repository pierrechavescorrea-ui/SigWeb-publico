                            {
                                <input type="date" class="form-control form-control-sm" @bind="registro.Fecha" />
                            }
                            else
                            {
                                <span>@(registro.Fecha?.ToString("dd/MM/yyyy") ?? "—")</span>
                            }
                        </div>
                        <div class="ficha-bloque-fila">
                            <span class="ficha-bloque-etiqueta">Facturado</span>
                            @if (enEdicion)
                            {
                                <input type="date" class="form-control form-control-sm" @bind="registro.FechaFacturado" />
                            }
                            else
                            {
                                <span>@(registro.FechaFacturado?.ToString("dd/MM/yyyy") ?? "—")</span>
                            }
                        </div>
