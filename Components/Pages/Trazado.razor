                        {
                            <span class="d-inline-flex align-items-center gap-1"><EstadoAccion Estado="e" />@planesTorre.Count(p => p.Estado == e)</span>
                        }
                        <a class="small ms-auto" href="planes-accion">Ver todos ▸</a>
                    </div>
                    @if (planesTorre.Count == 0)
                    {
                        <p class="text-muted small mb-0"><em>Sin planes de acción.</em></p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var p in planesTorre)
                            {
                                var exp = planAbierto == p.Plan.Id;
                                <div class="pa-tarjeta @(exp ? "pa-abierta" : "")">
                                    <div class="pa-tarjeta-cab" role="button" title="@(exp ? "Contraer" : "Ver el plan completo")" @onclick="() => planAbierto = exp ? null : p.Plan.Id">
                                        <span class="pa-flecha">@(exp ? "▾" : "▸")</span>
                                        <strong>@p.Plan.Codigo</strong>
                                        <span class="small text-muted">@p.Plan.Fecha.ToString("dd/MM/yyyy")</span>
                                        <ValorCatalogo Tipo="@SigWeb.Data.Riesgos.SembradorCatalogosRiesgo.TipoHallazgo" Valor="@p.Plan.TipoHallazgo" ClaseSinFormato="rg-chip" />
                                        <ValorCatalogo Tipo="@SigWeb.Data.Riesgos.SembradorCatalogosRiesgo.OrigenHallazgo" Valor="@p.Plan.OrigenHallazgo" ClaseSinFormato="rg-chip" />
                                        @if (p.RiesgoCodigo is not null) { <span class="rg-chip"><Ico Nombre="riesgos" /> @p.RiesgoCodigo</span> }
                                        @foreach (var d in p.Donde) { <span class="rg-chip">@d</span> }
                                        <EstadoAccion Estado="p.Estado" Clase="ms-auto" />
                                    </div>
                                    <div class="small mb-1">@p.Plan.DescripcionHallazgo</div>
                                    @if (exp)
                                    {
                                        <div class="rg-hd pa-detalle">
                                            <div class="rg-hd-col">
                                                <div class="rg-hd-tit">Procesos</div>
                                                @foreach (var pr in SelectorMultiple.Leer(p.Plan.Proceso)) { <ValorCatalogo Tipo="@SigWeb.Data.Riesgos.SembradorCatalogosRiesgo.ProcesoPlan" Valor="@pr" ClaseSinFormato="rg-chip me-1" /> }
                                                @if (string.IsNullOrWhiteSpace(p.Plan.Proceso)) { <span class="text-muted">—</span> }
                                            </div>
                                            <div class="rg-hd-col">
                                                <div class="rg-hd-tit">Riesgo de origen</div>
                                                @if (p.RiesgoCodigo is null) { <span class="text-muted">—</span> }
                                                else { <div><strong>@p.RiesgoCodigo</strong> · @p.RiesgoDescripcion</div> }
                                            </div>
                                            <div class="rg-hd-col" style="grid-column: 1 / -1;">
                                                <div class="rg-hd-tit">Análisis de causa</div>
                                                <div class="rg-multi">@(string.IsNullOrWhiteSpace(p.Plan.AnalisisCausa) ? "—" : p.Plan.AnalisisCausa)</div>
                                            </div>
                                        </div>
