    // ---------- Qué actividades se muestran en este elemento ----------
    // "Hoja de vida" siempre ve todas. Los demás elementos, si no tienen
    // ninguna actividad marcada en ComponenteActividad, también ven
    // todas (para no ocultar checklist ya cargado sin que el usuario lo
    // haya pedido); en cuanto se marca al menos una, se limita a esas.
    private List<Actividad> actividadesDelComponente = new();
    private HashSet<int> actividadesPermitidasIds = new();
    private bool mostrarConfigActividadesComponente = false;

    // Actividades de ámbito Torre (Hoja de vida) vs ámbito Pata (cualquier
    // otro elemento: patas, trinchos, gaviones...) son catálogos separados.
    private List<Actividad> ActividadesActivasPata => actividadesActivas.Where(a => a.Ambito == AmbitoActividad.Pata).ToList();

    private void CargarActividadesDelComponente()
    {
        if (componenteSeleccionado is null)
        {
            actividadesDelComponente = new();
            actividadesPermitidasIds = new();
            return;
        }

        if (componenteSeleccionado.EsHojaDeVida)
        {
            var catalogoTorre = actividadesActivas.Where(a => a.Ambito == AmbitoActividad.Torre).ToList();
            actividadesDelComponente = catalogoTorre;
            actividadesPermitidasIds = catalogoTorre.Select(a => a.Id).ToHashSet();
            return;
        }

        var catalogoPata = ActividadesActivasPata;

        actividadesPermitidasIds = Db.ComponenteActividades.AsNoTracking()
            .Where(ca => ca.ComponenteId == componenteSeleccionado.Id)
            .Select(ca => ca.ActividadId)
            .ToHashSet();

        // Solo se ven las actividades marcadas explícitamente para este
        // elemento — si no se marcó ninguna, no se ve ninguna (algunas
        // patas simplemente no tienen actividades aplicables). La única
        // excepción: una actividad de Tipo de Ensayo se ve igual si esta
        // pata ya tiene resultados cargados desde el módulo Ensayos para
        // ese tipo, para no esconder datos ya importados. El enlace real
        // (TipoEnsayoId) manda; para actividades sin enlazar (creadas
        // manualmente antes de este cambio) se usa el viejo respaldo por
        // coincidencia de nombre.
        var idsTipoConDatos = resultadosEnsayoComponente
            .Select(g => g.Tipo.Id)
            .ToHashSet();
        var nombresTipoConDatos = resultadosEnsayoComponente
            .Select(g => g.Tipo.Nombre)
            .ToList();

        actividadesDelComponente = catalogoPata.Where(a =>
            actividadesPermitidasIds.Contains(a.Id) ||
            (a.TipoEnsayoId is int idTipo
                ? idsTipoConDatos.Contains(idTipo)
                : NombreTipoEnsayoDesdeActividad(a.Nombre) is string nombreTipo && nombresTipoConDatos.Any(n => CoincideNombreTipoEnsayo(n, nombreTipo)))
        ).ToList();
    }

    private async Task AlternarActividadPermitida(int actividadId, bool marcado)
    {
        if (componenteSeleccionado is null || componenteSeleccionado.EsHojaDeVida) return;

        if (marcado)
        {
            bool yaExiste = await Db.ComponenteActividades.AnyAsync(ca =>
                ca.ComponenteId == componenteSeleccionado.Id && ca.ActividadId == actividadId);
            if (!yaExiste)
            {
                Db.ComponenteActividades.Add(new ComponenteActividad
                {
                    ComponenteId = componenteSeleccionado.Id,
                    ActividadId = actividadId
                });
                await Db.SaveChangesAsync();
            }
        }
        else
        {
            var existente = await Db.ComponenteActividades.FirstOrDefaultAsync(ca =>
                ca.ComponenteId == componenteSeleccionado.Id && ca.ActividadId == actividadId);
            if (existente is not null)
            {
                Db.ComponenteActividades.Remove(existente);
                await Db.SaveChangesAsync();
            }
        }
        Db.ChangeTracker.Clear();

        CargarActividadesDelComponente();

        if (actividadTabSeleccionada is null || !actividadesDelComponente.Any(a => a.Id == actividadTabSeleccionada))
        {
            if (actividadesDelComponente.Count > 0)
            {
                SeleccionarActividadTab(actividadesDelComponente[0].Id);
            }
            else
            {
                actividadTabSeleccionada = null;
                parametrosDeActividad = new();
            }
        }
    }

