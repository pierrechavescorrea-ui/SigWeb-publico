    // ---------- Planos del listado maestro vinculados a este componente ----------
    private void CargarPlanosVinculadosDelComponente()
    {
        mostrarVincularPlano = false;
        filtroVincularPlano = "";
        archivosDisponiblesVincular = new();

        if (componenteSeleccionado is null)
        {
            planosVinculadosDelComponente = new();
            return;
        }

        var vinculos = Db.ComponentesPlano.AsNoTracking()
            .Where(v => v.ComponenteId == componenteSeleccionado.Id)
            .ToList();
        if (vinculos.Count == 0)
        {
            planosVinculadosDelComponente = new();
            return;
        }

        var idsArchivos = vinculos.Select(v => v.ArchivoPlanoMaestroId).ToList();
        var archivos = Db.ArchivosPlanoMaestro.AsNoTracking()
            .Where(a => idsArchivos.Contains(a.Id) && !a.Eliminado)
            .ToDictionary(a => a.Id);

        var idsPlanos = archivos.Values.Select(a => a.PlanoMaestroId).Distinct().ToList();
        var planos = Db.PlanosMaestro.AsNoTracking()
            .Where(p => idsPlanos.Contains(p.Id) && !p.Eliminado)
            .ToDictionary(p => p.Id);

        planosVinculadosDelComponente = vinculos
            .Where(v => archivos.ContainsKey(v.ArchivoPlanoMaestroId) && planos.ContainsKey(archivos[v.ArchivoPlanoMaestroId].PlanoMaestroId))
            .Select(v => (v, archivos[v.ArchivoPlanoMaestroId], planos[archivos[v.ArchivoPlanoMaestroId].PlanoMaestroId]))
            .OrderBy(x => x.Item3.Codigo).ThenBy(x => x.Item2.NombreOriginal)
            .ToList();
    }

    // Se calcula solo aquí, dentro del manejador del evento oninput (nunca en
    // el marcado): ver el comentario junto a archivosDisponiblesVincular.
    // Busca por código/título del plano, pero el resultado es por ARCHIVO
    // (una hoja puntual), para poder vincular solo la que corresponde.
    private void BuscarPlanosParaVincular(ChangeEventArgs e)
    {
        filtroVincularPlano = e.Value?.ToString() ?? "";

        if (componenteSeleccionado is null || string.IsNullOrWhiteSpace(filtroVincularPlano))
        {
            archivosDisponiblesVincular = new();
            return;
        }

        var idsYaVinculados = planosVinculadosDelComponente.Select(x => x.Archivo.Id).ToHashSet();

        var planosCoincidentes = Db.PlanosMaestro.AsNoTracking()
            .Where(p => !p.Eliminado)
            .ToList()
            .Where(p => $"{p.Codigo} {p.Titulo}".Contains(filtroVincularPlano, StringComparison.OrdinalIgnoreCase))
            .ToDictionary(p => p.Id);

        if (planosCoincidentes.Count == 0)
        {
            archivosDisponiblesVincular = new();
            return;
        }

        var idsPlanos = planosCoincidentes.Keys.ToList();
        // Solo se vinculan archivos vigentes (no los obsoletos del listado maestro de planos).
        archivosDisponiblesVincular = Db.ArchivosPlanoMaestro.AsNoTracking()
            .Where(a => idsPlanos.Contains(a.PlanoMaestroId) && !a.Eliminado && a.Clase != SigWeb.Models.ClaseArchivoDocumento.Obsoleta)
            .ToList()
            .Where(a => !idsYaVinculados.Contains(a.Id))
            .Select(a => (a, planosCoincidentes[a.PlanoMaestroId]))
            .OrderBy(x => x.Item2.Codigo).ThenBy(x => x.Item1.NombreOriginal)
            .Take(20)
            .ToList();
    }

    private async Task VincularPlano(int archivoPlanoMaestroId)
    {
        if (componenteSeleccionado is null) return;

        bool yaExiste = await Db.ComponentesPlano.AnyAsync(v =>
            v.ComponenteId == componenteSeleccionado.Id && v.ArchivoPlanoMaestroId == archivoPlanoMaestroId);
        if (!yaExiste)
        {
            Db.ComponentesPlano.Add(new ComponentePlano
            {
                ComponenteId = componenteSeleccionado.Id,
                ArchivoPlanoMaestroId = archivoPlanoMaestroId
            });
            await Db.SaveChangesAsync();
        }
        Db.ChangeTracker.Clear();

        CargarPlanosVinculadosDelComponente();
    }

    private async Task QuitarVinculoPlano(int componentePlanoId)
    {
        var vinculo = await Db.ComponentesPlano.FindAsync(componentePlanoId);
        if (vinculo is not null)
        {
            Db.ComponentesPlano.Remove(vinculo);
            await Db.SaveChangesAsync();
        }
        Db.ChangeTracker.Clear();

        CargarPlanosVinculadosDelComponente();
    }

