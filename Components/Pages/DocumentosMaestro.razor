@page "/documentos"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.Documentos
@using SigWeb.Data.Tablas
@using SigWeb.Models
@inject AppDbContext Db
@inject IServiceScopeFactory Scopes
@inject IWebHostEnvironment Env
@inject SigWeb.Data.Catalogos.EstilosCatalogo EstilosCat

@if (formVer is not null && motor is not null)
{
    @* ---------- Actualizar un documento: datos + control de cambios con sus archivos (pantalla sola) ---------- *@
    <EncabezadoPagina Titulo="@(string.IsNullOrWhiteSpace(formVer.CodigoAnterior) ? $"Documento #{formVer.Id}" : formVer.CodigoAnterior)" Icono="documentos"
                      Subtitulo="Actualizar" OnAtras="() => formVer = null">
        <Acciones>
            <button type="button" class="pg-btn" title="Cancelar" @onclick="() => formVer = null"><Ico Nombre="cancelar" /></button>
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar" disabled="@guardando" @onclick="GuardarVersion">
                @if (guardando) { <span class="spinner-border spinner-border-sm" role="status"></span> } else { <Ico Nombre="guardar" /> }
            </button>
        </Acciones>
    </EncabezadoPagina>
    @if (!string.IsNullOrEmpty(mensajeForm))
    {
        <div class="alert alert-warning py-1">@mensajeForm</div>
    }
    <div class="card panel-formulario frm mb-3">
        <div class="card-body frm-cuerpo">
            <div class="row g-3">
                <div class="col-md-3 frm-destacado">
                    <label class="form-label mb-1 small">Código</label>
                    <input class="form-control form-control-sm" @bind="formVer.Codigo" />
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1 small">Tipo documental</label>
                    <select class="form-select form-select-sm" @bind="formVer.Tipo">
                        <option value=""></option>
                        @foreach (var o in Con(opcionesTipo, formVer.Tipo)) { <option value="@o">@o</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1 small">Estado</label>
                    <select class="form-select form-select-sm" @bind="formVer.Estado">
                        <option value=""></option>
                        @foreach (var o in Con(opcionesEstado, formVer.Estado)) { <option value="@o">@o</option> }
                    </select>
                </div>
                @foreach (var c in CamposEditables.Where(c => c.Id != formVer.CampoVersionId && c.Id != formVer.CampoFechaId))
                {
                    var campo = c;
                    <div class="col-md-3">
                        <label class="form-label mb-1 small">@campo.Nombre</label>
                        @EntradaCampo(campo, formVer.Valores.TryGetValue(campo.Id, out var v) ? v : null, val => formVer.Valores[campo.Id] = val)
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mb-1">
        <span class="rg-bloque-tit mb-0">Control de cambios</span>
        <span class="rg-chip">@formVer.Revisiones.Count(r => !r.Eliminar)</span>
        <button type="button" class="ens-mini" title="Agregar revisión" @onclick="AgregarRevision"><Ico Nombre="agregar" /></button>
    </div>
    <div class="tabla-scroll">
        <table class="table table-sm table-bordered align-middle mb-0 doc-cambios doc-revisiones">
            <thead>
                <tr>
                    <th style="width:90px;">Versión</th><th style="width:140px;">Fecha</th><th>Cambio</th><th style="width:180px;">Responsable</th>
                    <th style="width:24%;">Vigente</th><th style="width:24%;">Editable</th><th style="width:36px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rv in formVer.Revisiones)
                {
                    var fila = rv;
                    <tr class="@(fila.Eliminar ? "doc-rev-quitada" : "") @(fila == formVer.Revisiones.FirstOrDefault(r => !r.Eliminar) ? "doc-rev-actual" : "")">
                        <td class="p-0"><input class="form-control form-control-sm cc-input" @bind="fila.Version" disabled="@fila.Eliminar" /></td>
                        <td class="p-0"><input type="date" class="form-control form-control-sm cc-input" @bind="fila.Fecha" disabled="@fila.Eliminar" /></td>
                        <td class="p-0"><textarea class="form-control form-control-sm cc-input" rows="2" @bind="fila.Cambio" disabled="@fila.Eliminar"></textarea></td>
                        <td class="p-0"><input class="form-control form-control-sm cc-input" @bind="fila.Responsable" disabled="@fila.Eliminar" /></td>
                        <td>@CeldaArchivosRevision(fila, ClaseArchivoDocumento.Vigente)</td>
                        <td>@CeldaArchivosRevision(fila, ClaseArchivoDocumento.Editable)</td>
                        <td class="text-center">
                            @if (fila.Eliminar)
                            {
                                <button type="button" class="ens-mini" title="Deshacer" @onclick="() => fila.Eliminar = false"><Ico Nombre="restaurar" /></button>
                            }
                            else
                            {
                                <button type="button" class="ens-mini" title="@(fila.Id is null ? "Quitar" : "Quitar revisión (sus archivos van a la Papelera)")" @onclick="() => QuitarRevision(fila)"><Ico Nombre="eliminar" /></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (verVersionesDe is int vdId && docs.FirstOrDefault(x => x.Id == vdId) is { } docVer)
{
    var anteriores = verTodos ? ArchivosDe(vdId) : AnterioresDe(vdId);
    var vigVer = ActualesDe(vdId, ClaseArchivoDocumento.Vigente).ToHashSet();
    var ediVer = ActualesDe(vdId, ClaseArchivoDocumento.Editable).ToHashSet();
    <EncabezadoPagina Titulo="@(string.IsNullOrWhiteSpace(docVer.Codigo) ? $"Documento #{docVer.Id}" : docVer.Codigo)" Icono="documentos"
                      Subtitulo="@($"{(verTodos ? "Todos los archivos" : "Obsoletos")} ({anteriores.Count})")" OnAtras="() => verVersionesDe = null" />
    <div class="tabla-scroll tabla-auto"><table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin">
        <thead>
            <tr><th>Versión</th><th>Clase</th><th>Fecha</th><th>Archivo</th><th>Control de cambios</th><th>Cargado</th><th style="width:130px;"></th></tr>
        </thead>
        <tbody>
            @foreach (var v in anteriores)
            {
                <tr>
                    <td class="small fw-bold">@v.Version</td>
                    <td class="small">@(vigVer.Contains(v) ? "Vigente" : ediVer.Contains(v) ? "Editable" : v.Clase == ClaseArchivoDocumento.Obsoleta ? "Obsoleta" : v.Clase == ClaseArchivoDocumento.Vigente ? "Vigente reemplazada" : "Editable anterior")</td>
                    <td class="small text-nowrap">@(v.Fecha?.ToString("dd/MM/yyyy"))</td>
                    <td class="small">@v.NombreOriginal</td>
                    <td class="small">
                        @if (v.RevisionDocumentoId is int rvId && revisionPorId.TryGetValue(rvId, out var rv))
                        {
                            <div style="white-space:pre-line">@rv.Cambio</div>
                            @if (!string.IsNullOrWhiteSpace(rv.Responsable)) { <span class="text-muted">— @rv.Responsable</span> }
                        }
                        else if (cambiosPorVersion.TryGetValue(v.Id, out var cc) && cc.Count > 0)
                        {
                            <ul class="doc-cc mb-0">
                                @foreach (var x in cc)
                                {
                                    <li><span class="text-muted">@(x.Fecha?.ToString("dd/MM/yyyy"))</span> @x.Cambio @if (!string.IsNullOrWhiteSpace(x.Responsable)) { <span class="text-muted">— @x.Responsable</span> }</li>
                                }
                            </ul>
                        }
                        else if (!string.IsNullOrWhiteSpace(v.Observaciones)) { <span>@v.Observaciones</span> }
                    </td>
                    <td class="small text-nowrap text-muted">@v.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-nowrap">
                        <a class="ens-mini" href="@v.RutaArchivo" target="_blank" rel="noopener" title="Ver"><Ico Nombre="ubicar" /></a>
                        <a class="ens-mini" href="@v.RutaArchivo" download="@v.NombreOriginal" title="Descargar"><Ico Nombre="importar" /></a>
                        <button type="button" class="ens-mini" title="Reemplazar archivo" @onclick="() => AbrirReemplazo(v)"><Ico Nombre="editar" /></button>
                        <button type="button" class="ens-mini" title="Eliminar archivo" @onclick="() => PedirEliminarArchivo(v)"><Ico Nombre="eliminar" /></button>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
}
else
{
<div class="doc-listado @(pantallaCompleta ? "ens-pantalla" : "")">
<EncabezadoPagina Titulo="Listado maestro de documentos" Icono="documentos" Subtitulo="@($"{docs.Count} documento{(docs.Count == 1 ? "" : "s")}")" OnAtras="AtrasPantalla">
    <Acciones>
        <button type="button" class="pg-btn @(pantallaCompleta ? "activo" : "")" title="@(pantallaCompleta ? "Salir de pantalla completa" : "Pantalla completa")" @onclick="() => pantallaCompleta = !pantallaCompleta"><Ico Nombre="pantalla-completa" /></button>
        <button type="button" class="pg-btn @(verCargas ? "activo" : "")" title="@($"Cargas: {cargas.Count} de listado, {cargasArchivos.Count} de archivos")" @onclick="AlternarCargas"><Ico Nombre="cargas" />@(cargas.Count + cargasArchivos.Count > 0 ? $" {cargas.Count + cargasArchivos.Count}" : "")</button>
        <span class="pg-sep"></span>
        <BotonCampos Activo="verCampos" Deshabilitado="motor is null || modoEdicion" OnClick="() => verCampos = true" />
        <button type="button" class="pg-btn @(verImportar ? "activo" : "")" title="Importar listado (Excel)" disabled="@modoEdicion" @onclick="AlternarImportar"><Ico Nombre="cargar-excel" /></button>
        <button type="button" class="pg-btn @(verLote ? "activo" : "")" title="Cargar documentos (PDF, Word, Excel)" disabled="@(modoEdicion || motor is null)" @onclick="AlternarLote"><Ico Nombre="cargar-pdf" /></button>
        <BotonExportar Titulo="Listado maestro de documentos" Motor="motor" Filas="() => Mostrados.Select(d => d.Id)" Deshabilitado="motor is null" />
        <span class="pg-sep"></span>
        @if (!modoEdicion)
        {
            <button type="button" class="pg-btn pg-btn-peligro" title="Eliminar documento seleccionado" disabled="@(selId is null)" @onclick="PedirEliminar"><Ico Nombre="eliminar" /></button>
            <button type="button" class="pg-btn" title="Editar" disabled="@(motor is null)" @onclick="EntrarEdicion"><Ico Nombre="editar" /></button>
            <button type="button" class="pg-btn pg-btn-primario @(form is not null ? "activo" : "")" title="Nuevo documento" disabled="@(motor is null)" @onclick="Nuevo"><Ico Nombre="agregar" /></button>
        }
        else
        {
            <button type="button" class="pg-btn" title="Descartar cambios y salir de edición" @onclick="SalirEdicion"><Ico Nombre="cancelar" /></button>
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar cambios" disabled="@(cambios.Count == 0 || guardando)" @onclick="GuardarEdicion"><Ico Nombre="guardar" />@(cambios.Count > 0 ? $" {cambios.Count}" : "")</button>
        }
    </Acciones>
</EncabezadoPagina>

@if (verCampos && motor is not null)
{
    <PanelCampos Motor="motor" OnCerrar="() => verCampos = false" OnCambio="StateHasChanged" />
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(error ? "alert-warning" : "alert-success") py-1">@mensaje</div>
}

@* ---------- Cargas (bases de datos Excel que alimentan el listado) ---------- *@
@if (verCargas)
{
    <div class="card panel-formulario mb-3">
        <div class="card-body">
            <div class="btn-group btn-group-sm mb-2" role="group">
                <button type="button" class="btn @(pestanaCargas == "listado" ? "btn-dark" : "btn-outline-secondary")" title="Bases de datos Excel del listado" @onclick='() => { pestanaCargas = "listado"; elimCargas = null; elimCargasArch = null; }'><Ico Nombre="listado" /> @cargas.Count</button>
                <button type="button" class="btn @(pestanaCargas == "archivos" ? "btn-dark" : "btn-outline-secondary")" title="Cargas de archivos adjuntos" @onclick='() => { pestanaCargas = "archivos"; elimCargas = null; elimCargasArch = null; }'><Ico Nombre="adjuntar" /> @cargasArchivos.Count</button>
            </div>
            @if (pestanaCargas == "archivos")
            {
                <text>@PanelCargasArchivos()</text>
            }
            else if (cargas.Count == 0)
            {
                <div class="text-muted small">—</div>
            }
            else
            {
                <div class="tabla-scroll mb-2" style="max-height:260px;">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:32px;"><input type="checkbox" class="form-check-input" title="Todas" checked="@(cargasSel.Count == cargas.Count)" @onchange="@(e => { cargasSel = (bool)e.Value! ? cargas.Select(c => c.Id).ToHashSet() : new(); elimCargas = null; })" /></th>
                                <th>Archivo</th>
                                <th>Hoja</th>
                                <th>Fecha</th>
                                <th title="Documentos vigentes de esta carga">Doc.</th>
                                <th title="Filas de otras cargas actualizadas por código">Act.</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in cargas)
                            {
                                var id = c.Id;
                                <tr class="@(cargaFiltro == id ? "table-active" : "")">
                                    <td><input type="checkbox" class="form-check-input" checked="@cargasSel.Contains(id)" @onchange="@(e => { if ((bool)e.Value!) cargasSel.Add(id); else cargasSel.Remove(id); elimCargas = null; })" /></td>
                                    <td class="small">@c.NombreArchivo</td>
                                    <td class="small">@c.Hoja</td>
                                    <td class="small text-nowrap">@c.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="small text-end">@(docsPorCarga.TryGetValue(id, out var n) ? n : 0)</td>
                                    <td class="small text-end">@c.FilasActualizadas</td>
                                    <td><button type="button" class="ens-mini @(cargaFiltro == id ? "activo" : "")" title="Ver solo esta carga" @onclick="() => cargaFiltro = cargaFiltro == id ? null : id"><Ico Nombre="ubicar" /></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-danger btn-sm" title="@($"Eliminar cargas seleccionadas ({cargasSel.Count})")" disabled="@(cargasSel.Count == 0)" @onclick="PedirEliminarCargas"><Ico Nombre="eliminar" /> @cargasSel.Count</button>
                </div>
            }

            @if (pestanaCargas == "listado" && elimCargas is not null)
            {
                <div class="border border-danger rounded p-2 mt-2">
                    <PanelImpacto Informe="impactoCargas" OnEntendido="@(v => impactoCargasOk = v)" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => elimCargas = null"><Ico Nombre="cancelar" /></button>
                        <button class="btn btn-danger btn-sm" type="button" title="Eliminar cargas y sus documentos (van a la Papelera)" disabled="@BloqueadoCargas" @onclick="ConfirmarEliminarCargas"><Ico Nombre="eliminar" /></button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* ---------- Importar Excel: libro → hoja → fila de encabezados → columnas ---------- *@
@if (verImportar)
{
    <div class="card panel-formulario mb-3">
        <div class="card-body">
            <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
                <InputFile class="form-control form-control-sm" style="max-width:340px;" OnChange="SeleccionarLibro" accept=".xlsx,.xlsm" />
                @if (hojas.Count > 0)
                {
                    <select class="form-select form-select-sm" style="max-width:220px;" title="Hoja" value="@hojaSel" @onchange="CambiarHoja">
                        @foreach (var h in hojas) { <option value="@h">@h</option> }
                    </select>
                    <select class="form-select form-select-sm" style="max-width:240px;" title="Tipo documental de las filas de esta carga (si el Excel no trae la columna)" @bind="tipoCarga">
                        <option value="">Tipo documental: —</option>
                        @foreach (var o in opcionesTipo) { <option value="@o">@o</option> }
                    </select>
                }
                @if (leyendo) { <span class="spinner-border spinner-border-sm" role="status"></span> }
                <button type="button" class="btn btn-secondary btn-sm ms-auto" title="Cancelar" @onclick="CerrarImportar"><Ico Nombre="cancelar" /></button>
                <button type="button" class="btn btn-primary btn-sm" title="@($"Importar {FilasDatos().Count} fila(s)")"
                        disabled="@(filasHoja.Count == 0 || colsSel.Count == 0 || importando || DestinosRepetidos().Count > 0)" @onclick="Importar">
                    @if (importando) { <span class="spinner-border spinner-border-sm" role="status"></span> }
                    else { <Ico Nombre="importar" /> <span class="small">@FilasDatos().Count</span> }
                </button>
            </div>

            @if (filasHoja.Count > 0)
            {
                var enc = Encabezados();
                <div class="tabla-scroll mb-2" style="max-height:300px;">
                    <table class="table table-sm table-bordered align-middle mb-0 doc-vista">
                        <thead>
                            <tr>
                                <th title="Fila de encabezados">#</th>
                                @for (int c = 0; c < enc.Count; c++)
                                {
                                    var col = c;
                                    <th class="@(colsSel.Contains(col) ? "" : "doc-col-off")">
                                        <label class="d-flex align-items-center gap-1 mb-0 text-nowrap" title="Incluir columna">
                                            <input type="checkbox" class="form-check-input mt-0" checked="@colsSel.Contains(col)"
                                                   @onchange="@(e => AlternarColumna(col, (bool)e.Value!))" />
                                            @LectorExcelGenerico.LetraColumna(col)
                                        </label>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (int f = 0; f < Math.Min(filasHoja.Count, FilasVista); f++)
                            {
                                var fila = f;
                                <tr class="@(fila == filaEnc ? "doc-fila-enc" : fila < filaEnc ? "doc-fila-off" : "")" role="button" title="Usar como fila de encabezados" @onclick="() => ElegirEncabezado(fila)">
                                    <td class="text-muted small">
                                        <input type="radio" class="form-check-input mt-0 me-1" name="filaEnc" checked="@(fila == filaEnc)" />@(fila + 1)
                                    </td>
                                    @for (int c = 0; c < enc.Count; c++)
                                    {
                                        <td class="small text-nowrap @(colsSel.Contains(c) ? "" : "doc-col-off")">@Recortar(Celda(filasHoja[fila], c))</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Cada columna elegida del Excel → columna del listado (existente, propia o nueva). *@
                var repetidos = DestinosRepetidos();
                <div class="tabla-scroll" style="max-height:260px;">
                    <table class="table table-sm table-bordered align-middle mb-0 doc-mapeo">
                        <tbody>
                            @foreach (var c in colsSel.OrderBy(x => x))
                            {
                                var col = c;
                                var destino = destinos.TryGetValue(col, out var d0) ? d0 : DestinoNuevo;
                                <tr class="@(repetidos.Contains(destino) ? "table-danger" : "")">
                                    <td class="small text-nowrap" style="width:40%;"><span class="text-muted">@LectorExcelGenerico.LetraColumna(col)</span> @enc[col]</td>
                                    <td class="text-center text-muted" style="width:24px;">→</td>
                                    <td class="p-0">
                                        <select class="form-select form-select-sm cc-input" value="@destino" @onchange="@(e => destinos[col] = e.Value?.ToString() ?? DestinoNuevo)">
                                            <option value="@DestinoNuevo">＋ @enc[col]</option>
                                            <option value="nat:Codigo">Código</option>
                                            <option value="nat:TipoDocumental">Tipo documental</option>
                                            <option value="nat:Estado">Estado</option>
                                            @foreach (var campo in CamposDestino)
                                            {
                                                <option value="@($"c:{campo.Id}")">@campo.Nombre</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ---------- Carga masiva de archivos: sugiere el documento por código/nombre ---------- *@
@if (verLote)
{
    <div class="card panel-formulario mb-3">
        <div class="card-body">
            <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
                <div class="btn-group btn-group-sm" role="group" title="¿Qué estás cargando?">
                    @foreach (var cl in ClasesArchivo)
                    {
                        var clase = cl;
                        <button type="button" class="btn @(claseLote == clase ? "btn-dark" : "btn-outline-secondary")" title="@NombreClase(clase, true)" @onclick="() => CambiarClaseLote(clase)">@NombreClase(clase, true)</button>
                    }
                </div>
                <InputFile class="form-control form-control-sm" style="max-width:340px;" multiple OnChange="SeleccionarArchivos" accept=".pdf,.doc,.docx,.xls,.xlsx,.xlsm" />
                <input type="date" class="form-control form-control-sm" style="max-width:160px;" title="Fecha de las versiones" @bind="fechaLote" />
                @if (lote.Count > 0)
                {
                    <span class="text-muted small">@lote.Count(x => x.DocId is not null) / @lote.Count</span>
                }
                <button type="button" class="btn btn-secondary btn-sm ms-auto" title="Cancelar" @onclick="CerrarLote"><Ico Nombre="cancelar" /></button>
                <button type="button" class="btn btn-primary btn-sm" title="@($"Cargar {LoteListos.Count} archivo(s)")" disabled="@(LoteListos.Count == 0 || cargandoLote)" @onclick="CargarLote">
                    @if (cargandoLote) { <span class="spinner-border spinner-border-sm" role="status"></span> }
                    else { <Ico Nombre="guardar" /> <span class="small">@LoteListos.Count</span> }
                </button>
            </div>
            @if (lote.Count > 0)
            {
                // Dos archivos vigentes (o dos editables) para el mismo documento: el último cargado queda como actual.
                var repetidos = lote.Where(x => x.Incluir && x.DocId is not null && x.Clase != ClaseArchivoDocumento.Obsoleta)
                    .GroupBy(x => (x.DocId, x.Clase)).Where(g => g.Count() > 1).Select(g => g.Key).ToHashSet();
                <div class="tabla-scroll" style="max-height:420px;">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:32px;"></th>
                                <th>Archivo</th>
                                <th style="min-width:340px;">Documento</th>
                                <th style="width:130px;">Clase</th>
                                <th style="width:110px;">Versión</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in lote)
                            {
                                var it = a;
                                <tr class="@(it.DocId is null ? "doc-lote-sin" : "") @(it.Incluir ? "" : "doc-fila-off")">
                                    <td><input type="checkbox" class="form-check-input" checked="@it.Incluir" @onchange="@(e => it.Incluir = (bool)e.Value!)" /></td>
                                    <td class="small">
                                        <div class="text-truncate" style="max-width:320px;" title="@it.Archivo.Name">@it.Archivo.Name</div>
                                        <span class="text-muted">@((it.Archivo.Size / 1024.0).ToString("0")) KB</span>
                                    </td>
                                    <td class="small">
                                        <div class="d-flex gap-1">
                                            <input class="form-control form-control-sm" style="max-width:130px;" placeholder="Buscar..." value="@it.Busqueda" @oninput="@(e => it.Busqueda = e.Value?.ToString() ?? "")" />
                                            <select class="form-select form-select-sm" value="@(it.DocId?.ToString() ?? "")" @onchange="@(e => ElegirDocLote(it, e.Value?.ToString()))">
                                                <option value="">—</option>
                                                @foreach (var (id, etiqueta, puntos) in OpcionesLote(it))
                                                {
                                                    <option value="@id">@etiqueta@(puntos > 0 ? $"  ({Coincidencia(puntos)})" : "")</option>
                                                }
                                            </select>
                                        </div>
                                        @if (it.DocId is not null && repetidos.Contains((it.DocId, it.Clase)))
                                        {
                                            <span class="text-danger">Otro archivo de la misma clase va al mismo documento</span>
                                        }
                                    </td>
                                    <td class="p-0">
                                        <select class="form-select form-select-sm cc-input" value="@((int)it.Clase)" @onchange="@(e => { it.Clase = (ClaseArchivoDocumento)int.Parse(e.Value!.ToString()!); it.Version = it.DocId is int dd ? VersionSugerida(dd, it.Clase) : null; })">
                                            @foreach (var cl in ClasesArchivo) { <option value="@((int)cl)">@NombreClase(cl, false)</option> }
                                        </select>
                                    </td>
                                    <td class="p-0"><input class="form-control form-control-sm cc-input @(string.IsNullOrWhiteSpace(it.Version) && it.DocId is not null ? "is-invalid" : "")" @bind="it.Version" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

