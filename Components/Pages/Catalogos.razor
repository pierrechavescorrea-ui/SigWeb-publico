    private async Task SubirIcono(InputFileChangeEventArgs e)
    {
        mensajeIconos = "";
        var archivo = e.File;
        if (archivo is null) return;

        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (extension != ".svg" && extension != ".png")
        {
            mensajeIconos = "El ícono debe ser un archivo SVG o PNG.";
            errorIconos = true;
            return;
        }

        var nombre = string.IsNullOrWhiteSpace(nombreNuevoIcono)
            ? Path.GetFileNameWithoutExtension(archivo.Name)
            : nombreNuevoIcono.Trim();
        var categoria = string.IsNullOrWhiteSpace(categoriaNuevoIcono) ? "General" : categoriaNuevoIcono.Trim();

        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "iconos");
        Directory.CreateDirectory(carpeta);

        var nombreArchivo = $"{Guid.NewGuid()}{extension}";
        var rutaFisica = Path.Combine(carpeta, nombreArchivo);

        await using (var stream = archivo.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024))
        await using (var destino = File.Create(rutaFisica))
        {
            await stream.CopyToAsync(destino);
        }

        Db.IconosCatalogo.Add(new IconoCatalogo
        {
            Clave = $"custom-{Guid.NewGuid()}",
            Nombre = nombre,
            Categoria = categoria,
            RutaArchivo = $"/uploads/iconos/{nombreArchivo}"
        });
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        nombreNuevoIcono = "";
        mensajeIconos = $"Ícono \"{nombre}\" agregado a la galería.";
        errorIconos = false;
        CargarIconos();
    }

