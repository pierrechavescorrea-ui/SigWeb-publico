    private IEnumerable<ItemCatalogo> ItemsMostrados
    {
        get
        {
            var query = items.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(filtro))
            {
                query = query.Where(i => $"{i.Nombre} {i.Descripcion} {motor?.TextoBusqueda(i.Id)}".Contains(filtro, StringComparison.OrdinalIgnoreCase));
            }
            query = columnaOrden switch
            {
                "Nombre" => ordenAscendente ? query.OrderBy(i => i.Nombre) : query.OrderByDescending(i => i.Nombre),
                "Descripcion" => ordenAscendente ? query.OrderBy(i => i.Descripcion) : query.OrderByDescending(i => i.Descripcion),
                "Estado" => ordenAscendente ? query.OrderBy(i => i.Activo) : query.OrderByDescending(i => i.Activo),
                _ => motor is null ? query : motor.Ordenar(query, i => i.Id, columnaOrden, ordenAscendente)
            };
            return query;
        }
    }

    private void OrdenarPor(string columna)
    {
        if (columnaOrden == columna) ordenAscendente = !ordenAscendente;
        else { columnaOrden = columna; ordenAscendente = true; }
    }

    private string Flecha(string columna) => columnaOrden != columna ? "" : (ordenAscendente ? " ▲" : " ▼");

    private string ValorCampo(string clave) => valoresCamposActual.TryGetValue(clave, out var v) ? v : "";
    private bool EsVerdadero(string clave) => ValorCampo(clave) == "true";
