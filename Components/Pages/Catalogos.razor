    private bool mostrarSelectorIconoCatalogo = false;
    private DefinicionCatalogo? elimCatalogo;
    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;
    private bool BloqueadoPorImpacto => impacto is null || (impacto.RequiereEntender && !impactoOk);

    private IEnumerable<DefinicionCatalogo> DefinicionesMostradas =>
        string.IsNullOrWhiteSpace(filtroCatalogos)
