    // ---------- Catálogos: lista de definiciones ----------
    private void CargarDefiniciones()
    {
        definiciones = Db.DefinicionesCatalogo.AsNoTracking().Where(d => d.Activo).OrderBy(d => d.Orden).ThenBy(d => d.Nombre).ToList();
        if (!definiciones.Any(d => d.Nombre == tipoSeleccionado))
        {
            tipoSeleccionado = definiciones.FirstOrDefault()?.Nombre ?? "";
        }
    }

    private void CargarLista()
    {
        items = Db.Catalogos.AsNoTracking()
                  .Where(c => c.Tipo == tipoSeleccionado)
                  .OrderBy(c => c.Nombre)
                  .ToList();

        definicionActual = definiciones.FirstOrDefault(d => d.Nombre == tipoSeleccionado);
        itemsPorId = items.ToDictionary(i => i.Id);
        motorPendiente = true;
        camposDelCatalogoActual = definicionActual is null
            ? new()
            : Db.CamposCatalogoDefinicion.AsNoTracking()
                .Where(c => c.DefinicionCatalogoId == definicionActual.Id)
                .OrderBy(c => c.Orden).ThenBy(c => c.Nombre)
                .ToList();

        var itemIds = items.Select(i => i.Id).ToList();
        valoresPorItem = itemIds.Count == 0
            ? new()
            : Db.ValoresCampoCatalogoItem.AsNoTracking()
                .Where(v => itemIds.Contains(v.ItemCatalogoId))
                .ToDictionary(v => (v.ItemCatalogoId, v.Clave), v => v.Valor);
    }

    private async Task CrearCatalogo()
    {
        mensajeNuevoCatalogo = "";
        var nombre = (nuevoCatalogoNombre ?? "").Trim();
        if (string.IsNullOrWhiteSpace(nombre))
        {
            mensajeNuevoCatalogo = "El nombre del catálogo es obligatorio.";
            return;
        }

        bool duplicado = Db.DefinicionesCatalogo.AsNoTracking().Any(d => d.Nombre.ToLower() == nombre.ToLower());
        if (duplicado)
        {
            mensajeNuevoCatalogo = $"Ya existe un catálogo llamado \"{nombre}\".";
            return;
        }

        var definicion = new DefinicionCatalogo
        {
            Nombre = nombre,
            EntidadAsociada = (nuevoCatalogoEntidad ?? "").Trim(),
            EsPredeterminado = false,
            IconoCatalogoId = nuevoCatalogoIconoId,
            Orden = definiciones.Count
        };
        Db.DefinicionesCatalogo.Add(definicion);
        await Db.SaveChangesAsync();

        int orden = 0;
        foreach (var campo in nuevoCatalogoCampos)
        {
            var nombreCampo = (campo.Nombre ?? "").Trim();
            if (string.IsNullOrWhiteSpace(nombreCampo)) continue;
            Db.CamposCatalogoDefinicion.Add(new CampoCatalogoDefinicion
            {
                DefinicionCatalogoId = definicion.Id,
                Nombre = nombreCampo,
                Tipo = campo.Tipo,
                Orden = orden++
            });
        }
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        nuevoCatalogoNombre = "";
        nuevoCatalogoEntidad = "";
        nuevoCatalogoCampos = new();
        nuevoCatalogoIconoId = null;
        mostrarSelectorIconoCatalogo = false;
        mostrarNuevoCatalogo = false;

        CargarDefiniciones();
        tipoSeleccionado = definicion.Nombre;
        CancelarEdicion();
        CargarLista();
    }

