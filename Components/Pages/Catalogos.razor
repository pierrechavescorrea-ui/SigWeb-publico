    private async Task Guardar()
    {
        mensaje = "";
        var nombre = (itemActual.Nombre ?? "").Trim();

        if (string.IsNullOrWhiteSpace(nombre))
        {
            mensaje = "El nombre es obligatorio.";
            return;
        }

        bool duplicado = Db.Catalogos.AsNoTracking().Any(c =>
            c.Tipo == tipoSeleccionado &&
            c.Nombre.ToLower() == nombre.ToLower() &&
            c.Id != itemActual.Id);

        if (duplicado)
        {
            mensaje = $"\"{nombre}\" ya existe en {tipoSeleccionado}.";
            return;
        }

        itemActual.Nombre = nombre;
        itemActual.Tipo = tipoSeleccionado;

        if (modoEdicion)
        {
            Db.Catalogos.Update(itemActual);
        }
        else
        {
            Db.Catalogos.Add(itemActual);
        }

        await Db.SaveChangesAsync();

        foreach (var campo in camposDelCatalogoActual)
        {
            var valor = ValorCampo(campo.Nombre);
            var existente = await Db.ValoresCampoCatalogoItem.FirstOrDefaultAsync(
                v => v.ItemCatalogoId == itemActual.Id && v.Clave == campo.Nombre);
            if (existente is not null)
            {
                existente.Valor = valor;
            }
            else if (!string.IsNullOrWhiteSpace(valor))
            {
                Db.ValoresCampoCatalogoItem.Add(new ValorCampoCatalogoItem
                {
                    ItemCatalogoId = itemActual.Id,
                    Clave = campo.Nombre,
                    Valor = valor
                });
            }
        }
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        EstilosCat.Recargar();

        CerrarFormItem();
        CargarLista();
        CargarConteos();
    }

    private void Editar(ItemCatalogo i)
    {
        itemActual = new ItemCatalogo
        {
            Id = i.Id,
            Tipo = i.Tipo,
            Nombre = i.Nombre,
            Descripcion = i.Descripcion,
            Activo = i.Activo,
            ElementoTrazadoId = i.ElementoTrazadoId,
            Estilo = i.Estilo, ColorTexto = i.ColorTexto, ColorFondo = i.ColorFondo, Forma = i.Forma, Negrita = i.Negrita
        };
        valoresCamposActual = camposDelCatalogoActual.ToDictionary(
            c => c.Nombre,
            c => valoresPorItem.TryGetValue((i.Id, c.Nombre), out var v) ? v : "");
        modoEdicion = true;
        mensaje = "";
    }

    private void CancelarEdicion()
    {
        itemActual = new();
        valoresCamposActual = new();
        modoEdicion = false;
        mensaje = "";
    }

    private async Task CambiarEstado(ItemCatalogo i)
    {
        var item = await Db.Catalogos.FindAsync(i.Id);
        if (item is not null)
        {
            item.Activo = !item.Activo;
            await Db.SaveChangesAsync();
        }
        Db.ChangeTracker.Clear();
        CargarLista();
    }

