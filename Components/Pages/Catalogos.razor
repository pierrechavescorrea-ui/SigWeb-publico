            : definiciones.Where(d => d.Nombre.Contains(filtroCatalogos, StringComparison.OrdinalIgnoreCase));

    private string RutaIconoCatalogo(int? id)
    {
        var ruta = id is null ? null : iconosGaleria.FirstOrDefault(i => i.Id == id)?.RutaArchivo;
        if (ruta is not null) return ruta;
        return iconosGaleria.FirstOrDefault(i => i.Clave == "catalogo")?.RutaArchivo ?? "images/iconos/documento.svg";
    }

    private static string TituloItem(ItemCatalogo i) => string.IsNullOrWhiteSpace(i.Descripcion) ? i.Nombre : i.Nombre + " — " + i.Descripcion;

    private void CargarConteos()
    {
        conteoItems = Db.Catalogos.AsNoTracking().GroupBy(c => c.Tipo).Select(x => new { x.Key, N = x.Count() }).ToDictionary(x => x.Key, x => x.N);
    }

    private void AbrirCatalogo(DefinicionCatalogo d)
    {
        if (abierto && tipoSeleccionado == d.Nombre) { abierto = false; return; }
        tipoSeleccionado = d.Nombre;
        abierto = true;
        filtro = "";
        CerrarFormItem();
        CargarLista();
    }

    private void AlternarFormItem()
    {
        if (mostrarFormItem) CerrarFormItem();
        else { CancelarEdicion(); mostrarFormItem = true; }
    }

    private void CerrarFormItem() { CancelarEdicion(); mostrarFormItem = false; }

    private void EditarItem(ItemCatalogo i) { Editar(i); mostrarFormItem = true; }

    private async Task CalcularImpacto(Func<Task<SigWeb.Data.Impacto.InformeImpacto>> f)
    {
        impacto = null; impactoOk = false;
        try { impacto = await f(); } catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private void PedirEliminarCatalogo(DefinicionCatalogo d)
    {
        elimCatalogo = d;
        _ = CalcularImpacto(() => Analizador.Catalogo(d.Id));
    }

    private void CancelarEliminarCatalogo() { elimCatalogo = null; impacto = null; impactoOk = false; }

    private async Task EliminarCatalogoActual()
    {
        if (elimCatalogo is null || BloqueadoPorImpacto) return;
        var entidad = await Db.DefinicionesCatalogo.FirstOrDefaultAsync(x => x.Id == elimCatalogo.Id);
        if (entidad is not null)
        {
            entidad.Eliminado = true;
            entidad.FechaEliminacion = DateTime.Now;
            await Db.SaveChangesAsync();
        }
        Db.ChangeTracker.Clear();
        if (tipoSeleccionado == elimCatalogo.Nombre) abierto = false;
        CancelarEliminarCatalogo();
        CargarDefiniciones();
        CargarConteos();
        CargarLista();
    }

