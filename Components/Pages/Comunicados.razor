                <button type="button" class="gx-mas" title="Elementos del gráfico" data-grafico="@id" data-clave="@clave" onclick="sigwebElementosGrafico(this)">+</button>
            </div>
            <div class="com-grafico-lienzo"><canvas id="@id"></canvas></div>
        </div>
    };
    private string? firmaGraficos;

    private void AlternarGraficos() { verGraficos = !verGraficos; firmaGraficos = null; }

    private async Task DibujarGraficosAsync()
    {
        if (!verGraficos) return;
        var l = Filtrados.Select(c => (C: c, K: Calc(c.Id))).ToList();
        var firma = $"{l.Count}|{filtro}|{periodo}|{desde}|{hasta}|{fSentido}|{fEstado}|{fPlazo}|{fResponsable}|{fArea}|{soloSugeridas}|{soloRepetidos}|{cargaFiltro}|{comunicados.Count}";
        if (firma == firmaGraficos) return;
        firmaGraficos = firma;
        var es = System.Globalization.CultureInfo.GetCultureInfo("es-CO");
        const string Azul = "#2f6fdb", Naranja = "#f08a24", Verde = "#2e9e5b", Ambar = "#f2b705", Rojo = "#d64545", Gris = "#adb5bd";
        object Barra(string nombre, IEnumerable<int> datos, string color) => new { label = nombre, data = datos.ToArray(), backgroundColor = color, borderRadius = 4, maxBarThickness = 38 };
        object Opciones(bool apilado, bool horizontal = false) => new
        {
            responsive = true, maintainAspectRatio = false, indexAxis = horizontal ? "y" : "x",
            plugins = new { legend = new { position = "bottom", labels = new { boxWidth = 12 } } },
            scales = new { x = new { stacked = apilado, grid = new { display = horizontal } }, y = new { stacked = apilado, beginAtZero = true, ticks = new { precision = 0 }, grid = new { display = !horizontal } } }
        };
        object Dona(string[] etiquetas, int[] datos, string[] colores) => new
        {
            type = "doughnut",
            data = new { labels = etiquetas, datasets = new[] { new { data = datos, backgroundColor = colores, borderWidth = 2, sigwebEtiquetas = true } } },
            options = new { responsive = true, maintainAspectRatio = false, cutout = "62%", plugins = new { legend = new { position = "bottom", labels = new { boxWidth = 12 } } } }
        };

        // Por mes (o por año si el periodo es largo), entradas y salidas.
        var fechas = l.Where(x => x.C.Fecha is not null).Select(x => x.C.Fecha!.Value).ToList();
        var meses = fechas.Count == 0 ? 0 : ((fechas.Max().Year - fechas.Min().Year) * 12 + fechas.Max().Month - fechas.Min().Month + 1);
        agrupacionMes = meses <= 36;
        var claves = new List<DateTime>();
        if (fechas.Count > 0)
        {
            var ini = agrupacionMes ? new DateTime(fechas.Min().Year, fechas.Min().Month, 1) : new DateTime(fechas.Min().Year, 1, 1);
            var fin = fechas.Max();
            for (var p = ini; p <= fin; p = agrupacionMes ? p.AddMonths(1) : p.AddYears(1)) claves.Add(p);
        }
        DateTime Grupo(DateTime f) => agrupacionMes ? new DateTime(f.Year, f.Month, 1) : new DateTime(f.Year, 1, 1);
        int Cuenta(DateTime g, string sentido) => l.Count(x => x.C.Fecha is DateTime f && Grupo(f) == g && x.C.Sentido == sentido);
        var etiquetasMes = claves.Select(g => agrupacionMes ? g.ToString("MMM yy", es) : g.Year.ToString()).ToArray();
        await JS.InvokeVoidAsync("sigwebRenderGrafico", "com-g-mes", new
        {
            type = "bar",
            data = new { labels = etiquetasMes, datasets = new[] { Barra(LogicaComunicados.Entrada, claves.Select(g => Cuenta(g, LogicaComunicados.Entrada)), Azul), Barra(LogicaComunicados.Salida, claves.Select(g => Cuenta(g, LogicaComunicados.Salida)), Naranja) } },
            options = Opciones(true)
        });

        await JS.InvokeVoidAsync("sigwebRenderGrafico", "com-g-estado", Dona(
            new[] { LogicaComunicados.Cerrado, LogicaComunicados.Pendiente, LogicaComunicados.NA },
            new[] { l.Count(x => x.K.Estado == LogicaComunicados.Cerrado), l.Count(x => x.K.Estado == LogicaComunicados.Pendiente), l.Count(x => x.K.Estado == LogicaComunicados.NA) },
            new[] { Verde, Ambar, Gris }));

        await JS.InvokeVoidAsync("sigwebRenderGrafico", "com-g-plazo", Dona(
            new[] { LogicaComunicados.ATiempo, LogicaComunicados.Vencida },
            new[] { l.Count(x => x.K.Plazo == LogicaComunicados.ATiempo), l.Count(x => x.K.Plazo == LogicaComunicados.Vencida) },
            new[] { Verde, Rojo }));

        var resp = l.Select(x => x.K.Responsable).Where(r => r != "").Distinct().OrderBy(r => r).ToArray();
        await JS.InvokeVoidAsync("sigwebRenderGrafico", "com-g-resp", new
        {
            type = "bar",
            data = new
            {
                labels = resp,
                datasets = new[]
                {
                    Barra(LogicaComunicados.Cerrado, resp.Select(r => l.Count(x => x.K.Responsable == r && x.K.Estado == LogicaComunicados.Cerrado)), Verde),
                    Barra(LogicaComunicados.Pendiente, resp.Select(r => l.Count(x => x.K.Responsable == r && x.K.Estado == LogicaComunicados.Pendiente)), Ambar),
                    Barra(LogicaComunicados.Vencida, resp.Select(r => l.Count(x => x.K.Responsable == r && x.K.Plazo == LogicaComunicados.Vencida)), Rojo),
                }
            },
            options = Opciones(false)
        });

        // Tiempo promedio de respuesta: días de los comunicados ya respondidos (Cerrados), por mes de la
        // fecha del comunicado y por responsable; la línea punteada es el plazo configurado.
        var respondidos = l.Where(x => x.K.Estado == LogicaComunicados.Cerrado && x.K.Dias is not null && x.C.Fecha is not null).ToList();
        var respTiempo = respondidos.Select(x => x.K.Responsable).Where(r => r != "").Distinct().OrderBy(r => r).ToList();
        if (respTiempo.Count == 0 && respondidos.Count > 0) respTiempo.Add("");
        string[] coloresResp = { Azul, Naranja, "#7a5cc7", "#16a3b8", Verde, Rojo };
        object? Promedio(IEnumerable<int> dias) { var d = dias.ToList(); return d.Count == 0 ? null : Math.Round(d.Average(), 1); }
        var seriesTiempo = respTiempo.Select((r, i) => (object)new
        {
            type = "line", label = r == "" ? "Promedio" : r, borderColor = coloresResp[i % coloresResp.Length], backgroundColor = coloresResp[i % coloresResp.Length],
            data = claves.Select(g => Promedio(respondidos.Where(x => Grupo(x.C.Fecha!.Value) == g && (r == "" || x.K.Responsable == r)).Select(x => x.K.Dias!.Value))).ToArray(),
            spanGaps = true, tension = 0.3, pointRadius = 3, borderWidth = 2
        }).Append(new
        {
            type = "line", label = $"Plazo ({ajustes.PlazoDias} días)", borderColor = Rojo, backgroundColor = Rojo,
            data = claves.Select(_ => (object?)ajustes.PlazoDias).ToArray(), spanGaps = true, tension = 0.0, pointRadius = 0, borderWidth = 1.5,
            borderDash = new[] { 6, 4 }
        }).ToArray();
        await JS.InvokeVoidAsync("sigwebRenderGrafico", "com-g-tiempo", new
        {
            type = "line",
            data = new { labels = etiquetasMes, datasets = seriesTiempo },
            options = new
            {
                responsive = true, maintainAspectRatio = false,
                plugins = new { legend = new { position = "bottom", labels = new { boxWidth = 12 } } },
                scales = new { x = new { grid = new { display = false } }, y = new { beginAtZero = true, title = new { display = true, text = "días" } } }
            }
        });

        // Por responsable: promedio de días de los respondidos y "edad" promedio de los pendientes.
        var respProm = l.Select(x => x.K.Responsable).Where(r => r != "").Distinct().OrderBy(r => r).ToArray();
        await JS.InvokeVoidAsync("sigwebRenderGrafico", "com-g-tresp", new
        {
            type = "bar",
            data = new
            {
                labels = respProm,
                datasets = new object[]
                {
                    new { label = "Respondidos (días a la respuesta)", data = respProm.Select(r => Promedio(l.Where(x => x.K.Responsable == r && x.K.Estado == LogicaComunicados.Cerrado && x.K.Dias is not null).Select(x => x.K.Dias!.Value))).ToArray(), backgroundColor = Verde, borderRadius = 4, maxBarThickness = 38, sigwebEtiquetas = true },
                    new { label = "Pendientes (días sin respuesta)", data = respProm.Select(r => Promedio(l.Where(x => x.K.Responsable == r && x.K.Estado == LogicaComunicados.Pendiente && x.K.Dias is not null).Select(x => x.K.Dias!.Value))).ToArray(), backgroundColor = Ambar, borderRadius = 4, maxBarThickness = 38, sigwebEtiquetas = true },
                }
            },
            options = Opciones(false)
        });

        var areas = l.SelectMany(x => LogicaComunicados.Areas(x.C.ResponsableRespuesta)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(a => a).ToArray();
        bool De(string area, (Comunicado C, LogicaComunicados.Calculo K) x) => LogicaComunicados.Areas(x.C.ResponsableRespuesta).Contains(area, StringComparer.OrdinalIgnoreCase);
        await JS.InvokeVoidAsync("sigwebRenderGrafico", "com-g-area", new
        {
            type = "bar",
            data = new
            {
                labels = areas,
                datasets = new[]
                {
                    Barra(LogicaComunicados.Cerrado, areas.Select(a => l.Count(x => De(a, x) && x.K.Estado == LogicaComunicados.Cerrado)), Verde),
                    Barra(LogicaComunicados.Pendiente, areas.Select(a => l.Count(x => De(a, x) && x.K.Estado == LogicaComunicados.Pendiente)), Ambar),
                }
            },
            options = Opciones(true, horizontal: true)
        });
    }

    // ---------- Respuesta sugerida (columna AUTO del Excel) ----------
    private RenderFragment CeldaSugerida(Comunicado c) => __builder =>
    {
        var s = Calc(c.Id).Sugerida;
        if (s is null) return;
        <span class="com-sug" title="@($"{s.Consecutivo} · {s.Fecha:dd/MM/yyyy} · {s.Descripcion}")">
            <Ico Nombre="sugerencia" /> <span class="com-sug-cod">@s.Consecutivo</span>
            <button type="button" class="com-sug-btn com-ok" title="Aceptar: queda como su respuesta" @onclick:stopPropagation="true" @onclick="() => AceptarSugerencia(c.Id)"><Ico Nombre="aceptar" /></button>
            <button type="button" class="com-sug-btn" title="Descartar esta sugerencia" @onclick:stopPropagation="true" @onclick="() => DescartarSugerencia(c.Id)">✕</button>
        </span>
    };

    private async Task AceptarSugerencia(int id) => await AplicarSugerencias(new[] { id }, aceptar: true);
    private async Task DescartarSugerencia(int id) => await AplicarSugerencias(new[] { id }, aceptar: false);
    private async Task AceptarTodas() => await AplicarSugerencias(conSugerencia.Select(c => c.Id).ToList(), aceptar: true);

    private async Task AplicarSugerencias(IReadOnlyCollection<int> ids, bool aceptar)
    {
        guardando = true;
        try
        {
            var sug = ids.Where(i => Calc(i).Sugerida is not null).ToDictionary(i => i, i => Calc(i).Sugerida!.Consecutivo);
            var ents = await Db.Comunicados.Where(c => sug.Keys.Contains(c.Id)).ToListAsync();
            foreach (var e in ents)
            {
                if (aceptar) e.ConsecutivoRespuesta = sug[e.Id];
                else e.SugerenciaDescartada = sug[e.Id];
            }
            await Db.SaveChangesAsync();
            mensaje = aceptar ? $"{ents.Count} respuesta(s) aceptada(s)." : "Sugerencia descartada."; error = false;
            Cargar();
        }
        catch (Exception ex) { mensaje = "No se pudo guardar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    // ---------- Códigos con espacios (scripts del Excel: detectar y corregir) ----------
    private bool verRevision;
    private string pestanaRevision = "sugerencias";

    private async Task CorregirCodigos()
    {
        guardando = true;
        try
        {
            var ids = conEspacios.Select(c => c.Id).ToList();
            int n = 0;
            foreach (var e in await Db.Comunicados.Where(c => ids.Contains(c.Id)).ToListAsync())
            {
                var antes = (e.Consecutivo, e.ConsecutivoRespuesta, e.Descripcion);
                e.Consecutivo = LogicaComunicados.CorregirCodigos(e.Consecutivo);
                if (e.ConsecutivoRespuesta is not null) e.ConsecutivoRespuesta = LogicaComunicados.CorregirCodigos(e.ConsecutivoRespuesta);
                if (e.Descripcion is not null) e.Descripcion = LogicaComunicados.CorregirCodigos(e.Descripcion);
                if (antes != (e.Consecutivo, e.ConsecutivoRespuesta, e.Descripcion)) n++;
            }
            await Db.SaveChangesAsync();
            mensaje = $"Códigos corregidos en {n} comunicado(s)."; error = false;
            Cargar();
        }
        catch (Exception ex) { mensaje = "No se pudo corregir: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    // ---------- Ajustes ----------
    private bool verAjustes;
    private int ajPlazo = 8;
    private string ajSalida = "", ajEntrada = "";

    private void AbrirAjustes()
    {
        verAjustes = !verAjustes; verRevision = false;
        ajPlazo = ajustes.PlazoDias; ajSalida = ajustes.RespondeSalida; ajEntrada = ajustes.RespondeEntrada;
    }

    private async Task GuardarAjustes()
    {
        try
        {
            var cfg = await Db.Configuracion.FirstOrDefaultAsync(c => c.Id == 1);
            if (cfg is null) { cfg = new ConfiguracionEmpresa { Id = 1 }; Db.Configuracion.Add(cfg); }
            cfg.ComunicadosPlazoDias = Math.Max(0, ajPlazo);
            cfg.ComunicadosRespondeSalida = ajSalida.Trim();
            cfg.ComunicadosRespondeEntrada = ajEntrada.Trim();
            await Db.SaveChangesAsync();
            verAjustes = false; mensaje = "Ajustes guardados."; error = false;
            Cargar();
        }
        catch (Exception ex) { mensaje = "No se pudo guardar: " + ex.Message; error = true; }
    }

    // ---------- Adjuntos: archivos y enlaces a la nube ----------
    private int? menuAdj, verTodosAdj;
    private double menuX, menuY;
    private string mensajeAdj = "";
    private (int? Id, string Nombre, string Url)? formNube;   // Id null = enlace nuevo
    private int? reemplazarAdj;
    private AdjuntoComunicado? confirmarAdj;

    private RenderFragment CeldaAdjuntos(int id) => __builder =>
    {
        var l = AdjuntosDe(id);
        var nNube = l.Count(a => a.Clase == AdjuntoComunicado.Nube);
        <button type="button" class="ens-mini @(l.Count > 0 ? "" : "opacity-50")" title="@(l.Count > 0 ? $"Adjuntos: {l.Count - nNube} archivo(s), {nNube} enlace(s)" : "Sin adjuntos")" disabled="@modoEdicion"
                @onclick:stopPropagation="true" @onclick="@(e => AbrirMenuAdj(id, e))">
            <Ico Nombre="@(l.Count > 0 && nNube == l.Count ? "nube" : "documento")" />@(l.Count > 0 ? $" {l.Count}" : "")
        </button>
    };

    private void AbrirMenuAdj(int id, MouseEventArgs e)
    {
        if (menuAdj == id) { menuAdj = null; return; }
        menuAdj = id; menuX = e.ClientX; menuY = e.ClientY; mensajeAdj = ""; formNube = null; reemplazarAdj = null; confirmarAdj = null;
    }

    private RenderFragment MenuAdjuntos() => __builder =>
    {
        if (menuAdj is not int id) return;
        var l = AdjuntosDe(id);
        var x = menuX.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var y = (menuY + 8).ToString(System.Globalization.CultureInfo.InvariantCulture);
        <div class="doc-menu-fondo" @onclick="() => menuAdj = null"></div>
        <div class="doc-menu doc-menu-fijo" style="left:min(@(x)px, calc(100vw - 350px)); top:min(@(y)px, calc(100vh - 440px)); width:340px; max-height:430px; overflow:auto;">
            <button type="button" class="doc-menu-op" @onclick="() => { menuAdj = null; verTodosAdj = id; }">
                <Ico Nombre="listado" /> <span>Ver todos</span> <span class="text-muted ms-auto">@l.Count</span>
            </button>
            <div class="doc-menu-sep"></div>
            <text>@SeccionAdj(id, AdjuntoComunicado.Archivo, l.Where(a => a.Clase == AdjuntoComunicado.Archivo).ToList())</text>
            <text>@SeccionAdj(id, AdjuntoComunicado.Nube, l.Where(a => a.Clase == AdjuntoComunicado.Nube).ToList())</text>
            @if (!string.IsNullOrEmpty(mensajeAdj)) { <div class="small text-danger px-2">@mensajeAdj</div> }
        </div>
    };

    private RenderFragment SeccionAdj(int comId, string clase, List<AdjuntoComunicado> lista) => __builder =>
    {
        var esNube = clase == AdjuntoComunicado.Nube;
        <div class="doc-menu-sec d-flex align-items-center gap-1">
            <Ico Nombre="@(esNube ? "nube" : "documento")" />
            <span>@(esNube ? "Nube" : "Archivos")@(lista.Count > MaxMenu ? $" ({MaxMenu} de {lista.Count})" : lista.Count > 0 ? $" ({lista.Count})" : "")</span>
            @if (esNube)
            {
                <button type="button" class="ens-mini ms-auto" title="Agregar enlace (Drive, OneDrive, SharePoint…)" @onclick="() => formNube = (null, string.Empty, string.Empty)"><Ico Nombre="agregar" /></button>
            }
            else
            {
                <label class="ens-mini ms-auto mb-0" title="Cargar archivos"><Ico Nombre="agregar" /><InputFile class="d-none" multiple OnChange="@(e => CargarArchivos(comId, e))" /></label>
            }
        </div>
        if (esNube && formNube is { Id: null }) { <text>@FormNube(comId)</text> }
        if (lista.Count == 0 && !(esNube && formNube is { Id: null })) { <span class="doc-menu-op doc-menu-off"><Ico Nombre="@(esNube ? "enlace" : "documento")" /> <span>—</span></span> }
        foreach (var a in lista.Take(MaxMenu))
        {
            var adj = a;
            if (esNube && formNube is { Id: int fid } && fid == adj.Id) { <text>@FormNube(comId)</text> continue; }
            <div class="doc-menu-fila">
                <a class="doc-menu-op" href="@adj.Ruta" target="_blank" rel="noopener" title="@(esNube ? adj.Ruta : adj.Nombre)" @onclick="() => menuAdj = null">
                    <Ico Nombre="@(esNube ? "enlace" : "documento")" /> <span class="text-truncate">@adj.Nombre</span>
                </a>
                @if (!esNube && reemplazarAdj == adj.Id)
                {
                    <label class="ens-mini mb-0 activo" title="Elegir el archivo nuevo"><Ico Nombre="adjuntar" /><InputFile class="d-none" OnChange="@(e => ReemplazarArchivo(adj, e))" /></label>
                    <button type="button" class="ens-mini" title="Cancelar" @onclick="() => reemplazarAdj = null"><Ico Nombre="cancelar" /></button>
                }
                else
                {
                    <button type="button" class="ens-mini" title="@(esNube ? "Editar enlace" : "Editar (reemplazar archivo)")"
                            @onclick="() => { if (esNube) formNube = (adj.Id, adj.Nombre, adj.Ruta); else reemplazarAdj = adj.Id; }"><Ico Nombre="editar" /></button>
                    <button type="button" class="ens-mini" title="Eliminar" @onclick="() => confirmarAdj = adj"><Ico Nombre="eliminar" /></button>
                }
            </div>
            if (confirmarAdj?.Id == adj.Id)
            {
                <div class="doc-menu-confirma">
                    <div class="small mb-1"><Ico Nombre="eliminar" /> <strong>@adj.Nombre</strong></div>
                    <div class="d-flex gap-1 justify-content-end">
                        <button type="button" class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => confirmarAdj = null"><Ico Nombre="cancelar" /></button>
                        <button type="button" class="btn btn-danger btn-sm" title="Eliminar (va a la Papelera)" @onclick="() => EliminarAdjunto(adj)"><Ico Nombre="eliminar" /></button>
                    </div>
                </div>
            }
        }
    };

    private RenderFragment FormNube(int comId) => __builder =>
