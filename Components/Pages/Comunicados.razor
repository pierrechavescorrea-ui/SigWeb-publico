@page "/comunicados"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.Comunicados
@using SigWeb.Data.Documentos
@using SigWeb.Data.Tablas
@using SigWeb.Models
@inject AppDbContext Db
@inject IServiceScopeFactory Scopes
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<PageTitle>Comunicados</PageTitle>

@* Listado de comunicados (seguimiento de respuestas). Columnas propias con la lógica del Excel de
   control (estado, plazo, responsable, respuesta sugerida) + Campos del Excel o creados a mano +
   Adjuntos (archivos y enlaces a la nube). Ver Data/Comunicados/LogicaComunicados.cs. *@

@if (verTodosAdj is int vtId && porId.TryGetValue(vtId, out var comVer))
{
    var todos = AdjuntosDe(vtId);
    <EncabezadoPagina Titulo="@comVer.Consecutivo" Icono="comunicados" Subtitulo="@($"Adjuntos ({todos.Count})")" OnAtras="() => verTodosAdj = null" />
    <div class="tabla-scroll tabla-auto"><table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin">
        <thead><tr><th style="width:90px;">Tipo</th><th>Nombre</th><th>Dirección / archivo</th><th style="width:130px;">Cargado</th><th style="width:130px;"></th></tr></thead>
        <tbody>
            @foreach (var a in todos)
            {
                var adj = a;
                <tr>
                    <td class="small"><Ico Nombre="@(adj.Clase == AdjuntoComunicado.Nube ? "nube" : "documento")" /> @adj.Clase</td>
                    <td class="small">@adj.Nombre</td>
                    <td class="small text-truncate" style="max-width:420px;" title="@adj.Ruta">@(adj.Clase == AdjuntoComunicado.Nube ? adj.Ruta : Path.GetFileName(adj.Ruta))</td>
                    <td class="small text-nowrap text-muted">@adj.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-nowrap">
                        <a class="ens-mini" href="@adj.Ruta" target="_blank" rel="noopener" title="Abrir"><Ico Nombre="ubicar" /></a>
                        @if (adj.Clase == AdjuntoComunicado.Archivo)
                        {
                            <a class="ens-mini" href="@adj.Ruta" download="@adj.Nombre" title="Descargar"><Ico Nombre="importar" /></a>
                        }
                        <button type="button" class="ens-mini" title="Eliminar (va a la Papelera)" @onclick="() => EliminarAdjunto(adj)"><Ico Nombre="eliminar" /></button>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
}
else
{
<div class="@(pantallaCompleta ? "ens-pantalla" : "")">
<EncabezadoPagina Titulo="Comunicados" Icono="comunicados" Subtitulo="@($"{comunicados.Count} comunicado{(comunicados.Count == 1 ? "" : "s")}")" OnAtras="AtrasPantalla">
    <Acciones>
        <button type="button" class="pg-btn @(pantallaCompleta ? "activo" : "")" title="@(pantallaCompleta ? "Salir de pantalla completa" : "Pantalla completa")" @onclick="() => pantallaCompleta = !pantallaCompleta"><Ico Nombre="pantalla-completa" /></button>
        <button type="button" class="pg-btn @(verPanel ? "activo" : "")" title="@(verPanel ? "Ocultar filtros e indicadores" : "Mostrar filtros e indicadores")" @onclick="() => verPanel = !verPanel"><Ico Nombre="filtro" /></button>
        <button type="button" class="pg-btn @(verGraficos ? "activo" : "")" title="@(verGraficos ? "Volver a la tabla" : "Gráficos")" @onclick="AlternarGraficos">📈</button>
        <button type="button" class="pg-btn @(verRevision ? "activo" : "")" title="@($"Respuestas sugeridas ({conSugerencia.Count}) · códigos con espacios ({conEspacios.Count})")" disabled="@modoEdicion" @onclick="() => { verRevision = !verRevision; verAjustes = false; }">
            <Ico Nombre="sugerencia" />@(conSugerencia.Count + conEspacios.Count > 0 ? $" {conSugerencia.Count + conEspacios.Count}" : "")
        </button>
        <button type="button" class="pg-btn @(verAjustes ? "activo" : "")" title="Ajustes (plazo y responsables)" disabled="@modoEdicion" @onclick="AbrirAjustes"><Ico Nombre="mantenimiento" /></button>
        <button type="button" class="pg-btn @(verCargas ? "activo" : "")" title="@($"Cargas ({cargas.Count})")" disabled="@modoEdicion" @onclick="AlternarCargas"><Ico Nombre="cargas" />@(cargas.Count > 0 ? $" {cargas.Count}" : "")</button>
        <span class="pg-sep"></span>
        <BotonCampos Activo="verCampos" Deshabilitado="motor is null || modoEdicion" OnClick="() => verCampos = true" />
        <button type="button" class="pg-btn @(mostrarImportar ? "activo" : "")" title="Importar listado (Excel)" disabled="@modoEdicion" @onclick="AlternarImportar"><Ico Nombre="cargar-excel" /></button>
        <BotonExportar Titulo="Comunicados" Motor="motor" Filas="() => Mostrados.Select(m => m.Id)" Deshabilitado="motor is null" />
        <span class="pg-sep"></span>
        @if (!modoEdicion)
        {
            <button type="button" class="pg-btn pg-btn-peligro" title="Eliminar comunicado seleccionado" disabled="@(selId is null)" @onclick="PedirEliminar"><Ico Nombre="eliminar" /></button>
            <button type="button" class="pg-btn" title="Editar" disabled="@(motor is null)" @onclick="EntrarEdicion"><Ico Nombre="editar" /></button>
            <button type="button" class="pg-btn pg-btn-primario @(form is not null ? "activo" : "")" title="Nuevo comunicado" disabled="@(motor is null)" @onclick="Nuevo"><Ico Nombre="agregar" /></button>
        }
        else
        {
            <button type="button" class="pg-btn" title="Descartar cambios y salir de edición" @onclick="SalirEdicion"><Ico Nombre="cancelar" /></button>
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar cambios" disabled="@(cambios.Count == 0 || guardando)" @onclick="GuardarEdicion"><Ico Nombre="guardar" />@(cambios.Count > 0 ? $" {cambios.Count}" : "")</button>
        }
    </Acciones>
</EncabezadoPagina>

@if (verCampos && motor is not null)
{
    <PanelCampos Motor="motor" OnCerrar="() => verCampos = false" OnCambio="StateHasChanged" />
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(error ? "alert-warning" : "alert-success") py-1 px-2 small d-flex align-items-center gap-2">
        <span class="flex-grow-1">@mensaje</span>
        <button type="button" class="btn-close btn-sm" @onclick='() => mensaje = ""'></button>
    </div>
}

@* ---------- Ajustes: plazo de respuesta y quién responde según el sentido ---------- *@
@if (verAjustes)
{
    <div class="card panel-formulario mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-sm-3 col-lg-2">
                    <label class="form-label mb-1 small">Plazo de respuesta (días)</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="ajPlazo" />
                </div>
                <div class="col-sm-4 col-lg-3">
                    <label class="form-label mb-1 small">Responde los de salida</label>
                    <input class="form-control form-control-sm" @bind="ajSalida" />
                </div>
                <div class="col-sm-4 col-lg-3">
                    <label class="form-label mb-1 small">Responde los de entrada</label>
                    <input class="form-control form-control-sm" @bind="ajEntrada" />
                </div>
                <div class="col-auto ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => verAjustes = false"><Ico Nombre="cancelar" /></button>
                    <button type="button" class="btn btn-primary btn-sm" title="Guardar" @onclick="GuardarAjustes"><Ico Nombre="guardar" /></button>
                </div>
            </div>
        </div>
    </div>
}

@* ---------- Revisión: respuestas sugeridas y códigos con espacios ---------- *@
@if (verRevision)
{
    <div class="card panel-formulario mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn @(pestanaRevision == "sugerencias" ? "btn-dark" : "btn-outline-secondary")" title="Respuestas sugeridas" @onclick='() => pestanaRevision = "sugerencias"'><Ico Nombre="sugerencia" /> @conSugerencia.Count</button>
                    <button type="button" class="btn @(pestanaRevision == "codigos" ? "btn-dark" : "btn-outline-secondary")" title="Códigos con espacios junto a los guiones" @onclick='() => pestanaRevision = "codigos"'><Ico Nombre="corregir" /> @conEspacios.Count</button>
                </div>
                <span class="ms-auto"></span>
                @if (pestanaRevision == "sugerencias")
                {
                    <button type="button" class="btn btn-primary btn-sm" title="@($"Aceptar todas las sugerencias ({conSugerencia.Count})")" disabled="@(conSugerencia.Count == 0 || guardando)" @onclick="AceptarTodas"><Ico Nombre="aceptar" /> @conSugerencia.Count</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary btn-sm" title="@($"Corregir todos ({conEspacios.Count})")" disabled="@(conEspacios.Count == 0 || guardando)" @onclick="CorregirCodigos"><Ico Nombre="corregir" /> @conEspacios.Count</button>
                }
            </div>
            @if (pestanaRevision == "sugerencias")
            {
                if (conSugerencia.Count == 0) { <div class="text-muted small">—</div> }
                else
                {
                    <div class="tabla-scroll" style="max-height:340px;">
                        <table class="table table-sm table-bordered align-middle mb-0 com-sug-tabla">
                            <thead><tr><th>Pendiente</th><th style="width:28px;"></th><th>Respuesta sugerida</th><th style="width:76px;"></th></tr></thead>
                            <tbody>
                                @foreach (var c in conSugerencia)
                                {
                                    var com = c;
                                    var s = calc[com.Id].Sugerida!;
                                    <tr>
                                        <td class="small"><strong>@com.Consecutivo</strong> <span class="text-muted">· @com.Fecha?.ToString("dd/MM/yyyy") · @com.Sentido</span><div class="text-muted text-truncate" style="max-width:420px;" title="@com.Descripcion">@com.Descripcion</div></td>
                                        <td class="text-center text-muted">→</td>
                                        <td class="small"><strong>@s.Consecutivo</strong> <span class="text-muted">· @s.Fecha?.ToString("dd/MM/yyyy") · @s.Sentido</span><div class="text-muted text-truncate" style="max-width:420px;" title="@s.Descripcion">@s.Descripcion</div></td>
                                        <td class="text-nowrap text-center">
                                            <button type="button" class="ens-mini com-ok" title="Aceptar: queda como su respuesta" @onclick="() => AceptarSugerencia(com.Id)"><Ico Nombre="aceptar" /></button>
                                            <button type="button" class="ens-mini" title="Descartar esta sugerencia" @onclick="() => DescartarSugerencia(com.Id)"><Ico Nombre="cancelar" /></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                if (conEspacios.Count == 0) { <div class="text-muted small">—</div> }
                else
                {
                    <div class="tabla-scroll" style="max-height:340px;">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead><tr><th>Consecutivo</th><th>Consecutivo RTA</th><th>Descripción</th></tr></thead>
                            <tbody>
                                @foreach (var c in conEspacios)
                                {
                                    <tr>
                                        <td class="small @(LogicaComunicados.TieneEspaciosIndebidos(c.Consecutivo) ? "com-espacio" : "")">@c.Consecutivo</td>
                                        <td class="small @(LogicaComunicados.TieneEspaciosIndebidos(c.ConsecutivoRespuesta) ? "com-espacio" : "")">@c.ConsecutivoRespuesta</td>
                                        <td class="small @(LogicaComunicados.TieneEspaciosIndebidos(c.Descripcion) ? "com-espacio" : "")">@c.Descripcion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
}

@* ---------- Cargas (bases de datos Excel) ---------- *@
@if (verCargas)
{
    <div class="card panel-formulario mb-3">
        <div class="card-body">
            @if (cargas.Count == 0) { <div class="text-muted small">—</div> }
            else
            {
                <div class="tabla-scroll mb-2" style="max-height:280px;">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:32px;"><input type="checkbox" class="form-check-input" title="Todas" checked="@(cargasSel.Count == cargas.Count)" @onchange="@(e => { cargasSel = (bool)e.Value! ? cargas.Select(c => c.Id).ToHashSet() : new(); elimCargas = null; })" /></th>
                                <th>Archivo</th><th>Hoja</th><th>Fecha</th><th title="Comunicados nuevos">Nuevos</th><th title="Comunicados actualizados">Act.</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in cargas)
                            {
                                var id = c.Id;
                                <tr class="@(cargaFiltro == id ? "table-active" : "")">
                                    <td><input type="checkbox" class="form-check-input" checked="@cargasSel.Contains(id)" @onchange="@(e => { if ((bool)e.Value!) cargasSel.Add(id); else cargasSel.Remove(id); elimCargas = null; })" /></td>
                                    <td class="small">@c.NombreArchivo</td>
                                    <td class="small">@c.Hoja</td>
                                    <td class="small text-nowrap">@c.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="small text-end">@c.FilasCreadas</td>
                                    <td class="small text-end">@c.FilasActualizadas</td>
                                    <td><button type="button" class="ens-mini @(cargaFiltro == id ? "activo" : "")" title="Ver solo esta carga" @onclick="() => cargaFiltro = cargaFiltro == id ? null : id"><Ico Nombre="ubicar" /></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-danger btn-sm" title="@($"Eliminar cargas seleccionadas ({cargasSel.Count})")" disabled="@(cargasSel.Count == 0)" @onclick="PedirEliminarCargas"><Ico Nombre="eliminar" /> @cargasSel.Count</button>
                </div>
            }
            @if (elimCargas is not null)
            {
                <div class="border border-danger rounded p-2 mt-2">
                    <PanelImpacto Informe="impactoCargas" OnEntendido="@(v => impactoCargasOk = v)" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => elimCargas = null"><Ico Nombre="cancelar" /></button>
                        <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@(impactoCargas is null || (impactoCargas.RequiereEntender && !impactoCargasOk))" @onclick="ConfirmarEliminarCargas"><Ico Nombre="eliminar" /></button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (mostrarImportar)
{
    <PanelImportarExcel Destinos="DestinosImportacion" Importando="importando" OnImportar="ImportarExcel" OnCancelar="() => mostrarImportar = false" />
}

@* ---------- Nuevo comunicado ---------- *@
@if (form is not null && motor is not null)
{
    <FormularioSig Titulo="Nuevo comunicado" Icono="agregar" Clase="mb-3" OnCerrar="() => form = null">
        <ChildContent>
            <SeccionFormulario Titulo="Identificación">
                <CampoFormulario Etiqueta="Consecutivo" Ancho="col-md-4" Obligatorio="true" Destacado="true"><input class="form-control" @bind="form.Consecutivo" @bind:event="oninput" /></CampoFormulario>
                <CampoFormulario Etiqueta="Fecha" Ancho="col-md-2"><input type="date" class="form-control" @bind="form.Fecha" /></CampoFormulario>
                <CampoFormulario Etiqueta="Entrada / Salida" Ancho="col-md-2">
                    <select class="form-select" @bind="form.Sentido"><option value=""></option><option>@LogicaComunicados.Entrada</option><option>@LogicaComunicados.Salida</option></select>
                </CampoFormulario>
                <CampoFormulario Etiqueta="Tipo" Ancho="col-md-2"><input class="form-control" list="dl-com-tipo" @bind="form.Tipo" /></CampoFormulario>
                <CampoFormulario Etiqueta="Remitente" Ancho="col-md-2"><input class="form-control" list="dl-com-rem" @bind="form.Remitente" /></CampoFormulario>
            </SeccionFormulario>
            <SeccionFormulario Titulo="Contenido">
                <CampoFormulario Etiqueta="Descripción" Ancho="col-md-7"><textarea class="form-control" rows="3" @bind="form.Descripcion"></textarea></CampoFormulario>
                <CampoFormulario Etiqueta="Observaciones" Ancho="col-md-5"><textarea class="form-control" rows="3" @bind="form.Observaciones"></textarea></CampoFormulario>
            </SeccionFormulario>
            <SeccionFormulario Titulo="Respuesta">
                <CampoFormulario Etiqueta="Requiere respuesta" Ancho="col-md-2">
                    <select class="form-select" @bind="form.Requiere"><option value=""></option><option value="SI">Sí</option><option value="NO">No</option></select>
                </CampoFormulario>
                <CampoFormulario Etiqueta="Responsable de RTA" Ancho="col-md-4"><SelectorEtiquetas Valor="@form.ResponsableRta" Opciones="areasTodas" OnCambio="@(v => form.ResponsableRta = v)" /></CampoFormulario>
                <CampoFormulario Etiqueta="Consecutivo RTA" Ancho="col-md-3"><input class="form-control" @bind="form.ConsecutivoRta" /></CampoFormulario>
                <CampoFormulario Etiqueta="Fecha respuesta" Ancho="col-md-3"><input type="date" class="form-control" @bind="form.FechaRta" /></CampoFormulario>
            </SeccionFormulario>
            @if (CamposEditables.Any())
            {
                <SeccionFormulario Titulo="Campos adicionales">
                    @foreach (var c in CamposEditables)
                    {
                        var campo = c;
                        <CampoFormulario Etiqueta="@campo.Nombre" Ancho="col-md-3">
                            @EntradaCampo(campo, form.Campos.TryGetValue(campo.Id, out var v) ? v : null, val => form.Campos[campo.Id] = val)
                        </CampoFormulario>
                    }
                </SeccionFormulario>
            }
        </ChildContent>
        <Acciones>
            <button type="button" class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => form = null"><Ico Nombre="cancelar" /></button>
            <button type="button" class="btn btn-primary btn-sm" title="Guardar" disabled="@(guardando || string.IsNullOrWhiteSpace(form.Consecutivo))" @onclick="GuardarNuevo"><Ico Nombre="guardar" /></button>
        </Acciones>
    </FormularioSig>
}
<datalist id="dl-com-tipo">@foreach (var o in Sugerencias(c => c.Tipo)) { <option value="@o"></option> }</datalist>
<datalist id="dl-com-rem">@foreach (var o in Sugerencias(c => c.Remitente)) { <option value="@o"></option> }</datalist>
<datalist id="dl-com-area">@foreach (var o in areasTodas) { <option value="@o"></option> }</datalist>

@if (elimId is int eid && porId.TryGetValue(eid, out var comElim))
{
    <div class="card panel-formulario mb-3 border-danger">
        <div class="card-body">
            <div class="mb-2"><Ico Nombre="eliminar" /> <strong>@comElim.Consecutivo</strong> <span class="text-muted small">@comElim.Descripcion</span></div>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2">
                <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => elimId = null"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@(impacto is null || (impacto.RequiereEntender && !impactoOk))" @onclick="ConfirmarEliminar"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}

@if (verPanel)
{
@* ---------- Filtros ---------- *@
<div class="mpie-barra mb-2 com-filtros">
    <input class="form-control form-control-sm" style="max-width:240px;" placeholder="Buscar consecutivo, descripción…" @bind="filtro" @bind:event="oninput" />
    <select class="form-select form-select-sm" style="max-width:150px;" title="Periodo" value="@periodo" @onchange="CambiarPeriodo">
        <option value="">Todo el tiempo</option>
        <option value="mes">Este mes</option>
        <option value="30">Últimos 30 días</option>
        <option value="90">Últimos 90 días</option>
        <option value="anio">Este año</option>
        <option value="rango">Rango…</option>
    </select>
    @if (periodo == "rango")
    {
        <input type="date" class="form-control form-control-sm" style="max-width:140px;" title="Desde" @bind="desde" />
        <input type="date" class="form-control form-control-sm" style="max-width:140px;" title="Hasta" @bind="hasta" />
    }
    <select class="form-select form-select-sm" style="max-width:130px;" title="Entrada / Salida" @bind="fSentido">
        <option value="">Entrada y salida</option><option>@LogicaComunicados.Entrada</option><option>@LogicaComunicados.Salida</option>
    </select>
    <select class="form-select form-select-sm" style="max-width:130px;" title="Estado" @bind="fEstado">
        <option value="">Todo estado</option><option>@LogicaComunicados.Pendiente</option><option>@LogicaComunicados.Cerrado</option><option>@LogicaComunicados.NA</option>
    </select>
    <select class="form-select form-select-sm" style="max-width:130px;" title="Plazo" @bind="fPlazo">
        <option value="">Todo plazo</option><option>@LogicaComunicados.ATiempo</option><option>@LogicaComunicados.Vencida</option>
    </select>
    <select class="form-select form-select-sm" style="max-width:150px;" title="Responsable" @bind="fResponsable">
        <option value="">Todo responsable</option>
        @foreach (var o in calc.Values.Select(x => x.Responsable).Where(x => x != "").Distinct().OrderBy(x => x)) { <option value="@o">@o</option> }
    </select>
    <select class="form-select form-select-sm" style="max-width:170px;" title="Responsable de RTA (área)" @bind="fArea">
        <option value="">Toda área</option>
        @foreach (var o in areasTodas) { <option value="@o">@o</option> }
    </select>
    <button type="button" class="btn btn-sm @(soloSugeridas ? "btn-dark" : "btn-outline-secondary")" title="Solo con respuesta sugerida" @onclick="() => soloSugeridas = !soloSugeridas"><Ico Nombre="sugerencia" /></button>
    <button type="button" class="btn btn-sm @(soloRepetidos ? "btn-dark" : "btn-outline-secondary")" title="Solo consecutivos repetidos" @onclick="() => soloRepetidos = !soloRepetidos">⧉</button>
    @if (cargaFiltro is int cf && cargas.FirstOrDefault(c => c.Id == cf) is { } cg)
    {
        <span class="rg-chip"><Ico Nombre="cargas" /> @cg.NombreArchivo <button type="button" class="rg-chip-x" title="Quitar" @onclick="() => cargaFiltro = null">✕</button></span>
    }
    @if (HayFiltros)
    {
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Quitar filtros" @onclick="LimpiarFiltros">✕</button>
    }
    <span class="text-muted small ms-auto">@Mostrados.Count() / @comunicados.Count</span>
</div>

@* ---------- Indicadores (de lo filtrado; clic = filtrar) ---------- *@
var ind = Indicadores();
<div class="com-kpis mb-2">
    <button type="button" class="com-kpi" title="Comunicados mostrados" @onclick="QuitarEstadoPlazo"><span class="com-kpi-n">@ind.Total</span><span class="com-kpi-t">Comunicados</span></button>
    <button type="button" class="com-kpi" title="Requieren respuesta" @onclick="QuitarEstadoPlazo"><span class="com-kpi-n">@ind.Requieren</span><span class="com-kpi-t">Requieren respuesta</span></button>
    <button type="button" class="com-kpi com-kpi-verde @(fEstado == LogicaComunicados.Cerrado ? "activo" : "")" @onclick="() => AlternarEstado(LogicaComunicados.Cerrado)"><span class="com-kpi-n">@ind.Cerrados</span><span class="com-kpi-t">Cerrados</span></button>
    <button type="button" class="com-kpi com-kpi-ambar @(fEstado == LogicaComunicados.Pendiente ? "activo" : "")" @onclick="() => AlternarEstado(LogicaComunicados.Pendiente)"><span class="com-kpi-n">@ind.Pendientes</span><span class="com-kpi-t">Pendientes</span></button>
    <button type="button" class="com-kpi com-kpi-rojo @(fPlazo == LogicaComunicados.Vencida ? "activo" : "")" @onclick="AlternarVencidas"><span class="com-kpi-n">@ind.Vencidas</span><span class="com-kpi-t">Vencidas</span></button>
    <div class="com-kpi com-kpi-fijo"><span class="com-kpi-n">@(ind.PctATiempo is double p ? $"{p:0}%" : "—")</span><span class="com-kpi-t">A tiempo</span></div>
    <div class="com-kpi com-kpi-fijo"><span class="com-kpi-n">@(ind.PromedioDias is double d ? d.ToString("0.0") : "—")</span><span class="com-kpi-t">Días promedio</span></div>
</div>
}

@* ---------- Gráficos (de lo filtrado). Con los gráficos abiertos no se muestra la tabla. ---------- *@
@if (verGraficos)
{
    <div class="com-graficos mb-3">
        @GraficoCaja("com-g-mes", TituloMes, "comunicados:mes", true)
        @GraficoCaja("com-g-estado", "Estado", "comunicados:estado", false)
        @GraficoCaja("com-g-tiempo", "Tiempo promedio de respuesta (días)", "comunicados:tiempo", true)
        @GraficoCaja("com-g-plazo", "Plazo de respuesta", "comunicados:plazo", false)
        @GraficoCaja("com-g-resp", "Por responsable", "comunicados:responsable", false)
        @GraficoCaja("com-g-tresp", "Tiempo promedio por responsable", "comunicados:tiempo-responsable", false)
        @GraficoCaja("com-g-area", "Por área (Responsable de RTA)", "comunicados:area", true)
    </div>
}
else
{
    var nMostrados = Mostrados.Count();
    @if (nMostrados > limite)
    {
        @* Solo se dibujan las primeras filas (rápido con miles de comunicados); el resto, a pedido. *@
        <div class="com-mas-filas">
            <span>@limite.ToString("N0") de @nMostrados.ToString("N0")</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" title="Mostrar 500 filas más" @onclick="() => limite += 500">＋ 500</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" title="Mostrar todas las filas" @onclick="() => limite = int.MaxValue">Todas</button>
        </div>
    }
<div class="tabla-scroll tabla-auto"><table class="table table-sm table-bordered @(modoEdicion ? "" : "table-hover") tabla-compacta align-middle mb-0 tabla-pin tabla-docs @(modoEdicion ? "doc-editando" : "")">
    <thead>
        <tr>
            @foreach (var c in Columnas)
            {
                if (modoEdicion)
                {
                    @* En edición: el borde derecho del encabezado se arrastra para cambiar el ancho de la columna. *@
                    <th style="@Ancho(c)"><div class="th-redim" title="Arrastra la esquina para cambiar el ancho">@c.Nombre</div></th>
                }
                else
                {
                    <th class="th-ordenable" style="@Ancho(c)" @onclick="() => OrdenarPor(c.Clave)">@c.Nombre@(Flecha(c.Clave))</th>
                }
            }
        </tr>
    </thead>
    <tbody>
        @if (motor is not null)
        {
            @foreach (var m in Mostrados.Take(limite))
            {
                var com = m;
                var id = m.Id;
                <tr class="@(!modoEdicion && selId == id ? "table-active" : "")" @onclick="() => { if (!modoEdicion) selId = id; }">
                    @foreach (var c in Columnas)
                    {
                        var campo = c;
                        var nat = campo.Origen == OrigenCampoTabla.Nativo;
                        if (nat && campo.Clave == ColAdjuntos)
                        {
                            <td class="text-center">@CeldaAdjuntos(id)</td>
                        }
                        else if (nat && campo.Clave == ColSugerida && !modoEdicion)
                        {
                            <td class="small">@CeldaSugerida(com)</td>
                        }
                        else if (modoEdicion && EsEditable(campo))
                        {
                            <td class="small p-0 @(cambios.ContainsKey((id, ClaveCambio(campo))) ? "doc-cambio" : "")">@EntradaEdicion(com, campo)</td>
                        }
                        else if (nat && !string.IsNullOrWhiteSpace(filtro) && ColumnasResaltables.Contains(campo.Clave) && Motor.Estilo(id, campo) is null)
                        {
                            <td class="small @(campo.Clave == "Descripcion" ? "rg-multi" : "")">@Resaltar(Motor.Texto(id, campo, out _))</td>
                        }
                        else
                        {
                            <CeldaCampo Motor="Motor" Campo="campo" Fila="id" SoloLectura="true" Clase="@(nat && campo.Clave is "Descripcion" or "Observaciones" ? "rg-multi" : null)" OnCambio="StateHasChanged" />
                        }
                    }
                </tr>
            }
            @if (!Mostrados.Any())
            {
                <tr><td colspan="@Math.Max(1, Columnas.Count())" class="text-muted small text-center py-2"><em>Sin comunicados.</em></td></tr>
            }
        }
    </tbody>
</table></div>
}
@MenuAdjuntos()
</div>
}

@code {
    private const string Tabla = LogicaComunicados.Tabla;
    private const string ColAdjuntos = "Adjuntos", ColSugerida = "Sugerida";
    private const long MaxArchivo = 50L * 1024 * 1024;
    private const int MaxMenu = 3;
    private static readonly HashSet<string> ColumnasResaltables = new() { "Consecutivo", "Descripcion", "ConsecutivoRta", "Remitente", "Observaciones" };

    private bool pantallaCompleta;
    private EventCallback AtrasPantalla => pantallaCompleta ? EventCallback.Factory.Create(this, () => pantallaCompleta = false) : default;

    private List<Comunicado> comunicados = new();
    private Dictionary<int, Comunicado> porId = new();
    private Dictionary<int, LogicaComunicados.Calculo> calc = new();
    private Dictionary<int, List<AdjuntoComunicado>> adjuntos = new();
    private List<Comunicado> conSugerencia = new(), conEspacios = new();
    private List<string> areasTodas = new();
    // Valores del Excel de control (SGMTO. COMUNICADOS): plazo 8 días; SALIDA → INGETEC, ENTRADA → JEJ.
    private static readonly LogicaComunicados.Ajustes AjustesExcel = new(8, "INGETEC", "JEJ");
    private LogicaComunicados.Ajustes ajustes = AjustesExcel;
    private int? selId;
    private string mensaje = "";
    private bool error, guardando;
    private int limite = 500;

    [SupplyParameterFromQuery(Name = "buscar")] public string? BuscarQ { get; set; }
    // ?estado=…&plazo=…&responsable=… (tablero de inicio): llegan como filtros.
    [SupplyParameterFromQuery(Name = "estado")] public string? EstadoQ { get; set; }
    [SupplyParameterFromQuery(Name = "plazo")] public string? PlazoQ { get; set; }
    [SupplyParameterFromQuery(Name = "responsable")] public string? ResponsableQ { get; set; }
    private string? buscarAplicado, filtrosAplicados;
    protected override void OnParametersSet()
    {
        var f = $"{EstadoQ}|{PlazoQ}|{ResponsableQ}";
        if (f != filtrosAplicados)
        {
            filtrosAplicados = f;
            if (!string.IsNullOrWhiteSpace(EstadoQ)) fEstado = EstadoQ;
            if (!string.IsNullOrWhiteSpace(PlazoQ)) fPlazo = PlazoQ;
            if (!string.IsNullOrWhiteSpace(ResponsableQ)) fResponsable = ResponsableQ;
        }
        if (BuscarQ == buscarAplicado) return;
        buscarAplicado = BuscarQ;
        if (!string.IsNullOrWhiteSpace(BuscarQ)) filtro = BuscarQ;
    }

    protected override void OnInitialized() => Cargar();

    private void Cargar()
    {
        motorPendiente = true;
        Db.ChangeTracker.Clear();
        try
        {
            var cfg = Db.Configuracion.AsNoTracking().FirstOrDefault(c => c.Id == 1);
            if (cfg is not null) ajustes = new(cfg.ComunicadosPlazoDias ?? AjustesExcel.PlazoDias,
                string.IsNullOrWhiteSpace(cfg.ComunicadosRespondeSalida) ? AjustesExcel.RespondeSalida : cfg.ComunicadosRespondeSalida,
                string.IsNullOrWhiteSpace(cfg.ComunicadosRespondeEntrada) ? AjustesExcel.RespondeEntrada : cfg.ComunicadosRespondeEntrada);
            comunicados = Db.Comunicados.AsNoTracking().OrderBy(c => c.Fecha).ThenBy(c => c.Id).ToList();
            var ids = comunicados.Select(c => c.Id).ToList();
            adjuntos = Db.AdjuntosComunicado.AsNoTracking().Where(a => ids.Contains(a.ComunicadoId)).ToList()
                .GroupBy(a => a.ComunicadoId).ToDictionary(g => g.Key, g => g.OrderBy(a => a.Clase).ThenByDescending(a => a.FechaCarga).ToList());
            cargas = Db.CargasComunicados.AsNoTracking().OrderByDescending(c => c.Fecha).ToList();
        }
        catch (Exception ex) { comunicados = new(); adjuntos = new(); cargas = new(); mensaje = "No se pudo leer el listado (¿falta aplicar la migración?): " + ex.Message; error = true; }
        porId = comunicados.ToDictionary(c => c.Id);
        calc = LogicaComunicados.Calcular(comunicados, ajustes, DateTime.Today);
        conSugerencia = comunicados.Where(c => calc[c.Id].Sugerida is not null).OrderByDescending(c => c.Fecha).ToList();
        conEspacios = comunicados.Where(c => calc[c.Id].EspaciosIndebidos || LogicaComunicados.TieneEspaciosIndebidos(c.Descripcion)).ToList();
        areasTodas = comunicados.SelectMany(c => LogicaComunicados.Areas(c.ResponsableRespuesta)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(a => a).ToList();
        cargasSel.RemoveWhere(id => cargas.All(c => c.Id != id));
        if (cargaFiltro is int cf && cargas.All(c => c.Id != cf)) cargaFiltro = null;
        if (selId is int s && !porId.ContainsKey(s)) selId = null;
        firmaGraficos = null;
    }

    private List<AdjuntoComunicado> AdjuntosDe(int id) => adjuntos.TryGetValue(id, out var l) ? l : new();
    private LogicaComunicados.Calculo Calc(int id) => calc.TryGetValue(id, out var c) ? c : new();
    private IEnumerable<string> Sugerencias(Func<Comunicado, string?> f) =>
        comunicados.Select(f).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).Take(300);

    // ---------- Campos (columnas propias + Excel + creadas) ----------
    private MotorTabla? motor;
    private MotorTabla Motor => motor!;
    private bool verCampos, motorPendiente = true;
    private string? colOrden;
    private bool ordenAsc = true;

    private IEnumerable<CampoTabla> Columnas => motor?.Visibles ?? Enumerable.Empty<CampoTabla>();
    private IEnumerable<CampoTabla> CamposEditables => motor?.Ordenados.Where(c => c.Origen != OrigenCampoTabla.Nativo && !c.Calculado) ?? Enumerable.Empty<CampoTabla>();

    private IEnumerable<ColumnaNativa> ColumnasNativas()
    {
        Comunicado? C(int id) => porId.TryGetValue(id, out var c) ? c : null;
        var nombreCarga = cargas.ToDictionary(c => c.Id, c => c.NombreArchivo + (string.IsNullOrWhiteSpace(c.Hoja) ? "" : " › " + c.Hoja));
        return new[]
        {
            new ColumnaNativa("Tipo", "Tipo", TipoCampoTabla.Texto, id => C(id)?.Tipo),
            new ColumnaNativa("Remitente", "Remitente", TipoCampoTabla.Texto, id => C(id)?.Remitente),
            new ColumnaNativa("Sentido", "Entrada / Salida", TipoCampoTabla.Texto, id => C(id)?.Sentido),
            new ColumnaNativa("Consecutivo", "Consecutivo", TipoCampoTabla.Texto, id => C(id)?.Consecutivo),
            new ColumnaNativa("Fecha", "Fecha", TipoCampoTabla.Fecha, id => C(id)?.Fecha),
            new ColumnaNativa("Descripcion", "Descripción", TipoCampoTabla.Texto, id => C(id)?.Descripcion),
            new ColumnaNativa("Requiere", "Requiere respuesta", TipoCampoTabla.Texto, id => C(id)?.RequiereRespuesta switch { true => "Sí", false => "No", _ => null }),
            new ColumnaNativa("Estado", "Estado", TipoCampoTabla.Texto, id => Calc(id).Estado),
            new ColumnaNativa("ConsecutivoRta", "Consecutivo RTA", TipoCampoTabla.Texto, id => C(id)?.ConsecutivoRespuesta),
            new ColumnaNativa(ColSugerida, "Respuesta sugerida", TipoCampoTabla.Texto, id => Calc(id).Sugerida?.Consecutivo),
            new ColumnaNativa("FechaRta", "Fecha respuesta", TipoCampoTabla.Fecha, id => Calc(id).FechaRespuesta),
            new ColumnaNativa("Dias", "Tiempo transcurrido (días)", TipoCampoTabla.Numero, id => Calc(id).Dias),
            new ColumnaNativa("Plazo", "Plazo", TipoCampoTabla.Texto, id => Calc(id).Plazo),
            new ColumnaNativa("ResponsableRta", "Responsable de RTA", TipoCampoTabla.Texto, id => C(id)?.ResponsableRespuesta),
            new ColumnaNativa("Observaciones", "Observaciones", TipoCampoTabla.Texto, id => C(id)?.Observaciones),
            new ColumnaNativa("Responsable", "Responsable", TipoCampoTabla.Texto, id => Calc(id).Responsable),
            new ColumnaNativa(ColAdjuntos, "Adjuntos", TipoCampoTabla.Numero, id => (double)AdjuntosDe(id).Count),
            new ColumnaNativa("Carga", "Carga", TipoCampoTabla.Texto, id => C(id)?.CargaComunicadosId is int k && nombreCarga.TryGetValue(k, out var n) ? n : null, visiblePorDefecto: false),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (motorPendiente)
        {
            motorPendiente = false;
            try
            {
                var primeraVez = !await Db.CamposTabla.AnyAsync(c => c.Tabla == Tabla);
                motor = await MotorTabla.CargarAsync(Db, Tabla, ColumnasNativas(), comunicados.Select(c => (c.Id, c.Consecutivo)));
                if (primeraVez) await SembrarFormatosAsync();
            }
            catch { motor = null; }
            StateHasChanged();
            return;
        }
        await DibujarGraficosAsync();
    }

    // La primera vez, los mismos formatos condicionales del Excel: consecutivo repetido, Estado y Plazo.
    private async Task SembrarFormatosAsync()
    {
        if (motor is null) return;
        async Task Regla(string clave, OperadorFormato op, string? valor, string estilo, string forma)
        {
            if (motor.PorClave(clave) is { } c)
                await motor.GuardarFormatoAsync(Db, new FormatoCondicional { CampoTablaId = c.Id, Operador = op, Valor1 = valor, Estilo = estilo, Forma = forma, Negrita = forma == "pildora" });
        }
        await Regla("Consecutivo", OperadorFormato.Duplicado, null, "rojo-suave", "celda");
        await Regla("Consecutivo", OperadorFormato.CodigoConEspacios, null, "amarillo-suave", "celda");
        // Mismos colores del Excel: Pendiente/Vencida en rojo suave, Cerrado/A tiempo en verde suave.
        await Regla("Estado", OperadorFormato.Igual, LogicaComunicados.Pendiente, "rojo-suave", "pildora");
        await Regla("Estado", OperadorFormato.Igual, LogicaComunicados.Cerrado, "verde-suave", "pildora");
        await Regla("Estado", OperadorFormato.Igual, LogicaComunicados.NA, "gris-suave", "pildora");
        await Regla("Plazo", OperadorFormato.Igual, LogicaComunicados.ATiempo, "verde-suave", "pildora");
        await Regla("Plazo", OperadorFormato.Igual, LogicaComunicados.Vencida, "rojo-suave", "pildora");
    }

    private static string Ancho(CampoTabla c) => c.Origen != OrigenCampoTabla.Nativo ? "" : c.Clave switch
    {
        "Consecutivo" or "ConsecutivoRta" or ColSugerida => "min-width:170px;", "Descripcion" => "min-width:260px;",
        "Fecha" or "FechaRta" => "width:96px;", "Estado" or "Plazo" => "width:100px;", ColAdjuntos => "width:70px;", _ => ""
    };

    private RenderFragment EntradaCampo(CampoTabla c, string? valor, Action<string?> alCambiar, string clase = "") => __builder =>
    {
        switch (c.Tipo)
        {
            case TipoCampoTabla.Numero:
                <input type="number" step="any" class="form-control form-control-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))" />
                break;
            case TipoCampoTabla.Fecha:
                <input type="date" class="form-control form-control-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))" />
                break;
            case TipoCampoTabla.Lista:
                <select class="form-select form-select-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))">
                    <option value=""></option>
                    @foreach (var o in motor!.OpcionesDe(c)) { <option value="@o">@o</option> }
                </select>
                break;
            case TipoCampoTabla.SiNo:
                <div class="text-center"><input type="checkbox" class="form-check-input" checked="@(valor == "1")" @onchange="@(e => alCambiar((bool)e.Value! ? "1" : "0"))" /></div>
                break;
            default:
                if (clase.Contains("cc-input"))
                {
                    <textarea class="form-control form-control-sm @clase cc-ajusta" rows="1" @onchange="@(e => alCambiar(e.Value?.ToString()))">@valor</textarea>
                }
                else
                {
                    <input class="form-control form-control-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))" />
                }
                break;
        }
    };

    // Texto con lo buscado resaltado (como el filtro del Excel).
    private RenderFragment Resaltar(string texto) => __builder =>
    {
        var q = filtro.Trim();
        var i = string.IsNullOrEmpty(q) ? -1 : texto.IndexOf(q, StringComparison.OrdinalIgnoreCase);
        if (i < 0) { <text>@texto</text> return; }
        var antes = texto.Substring(0, i);
        var marca = texto.Substring(i, q.Length);
        var despues = texto.Substring(i + q.Length);
        <text>@antes<mark class="com-marca">@marca</mark>@despues</text>
    };

    // ---------- Filtros, orden e indicadores ----------
    private string filtro = "", periodo = "", fSentido = "", fEstado = "", fPlazo = "", fResponsable = "", fArea = "";
    private DateTime? desde, hasta;
    private bool soloSugeridas, soloRepetidos;
    private int? cargaFiltro;

    private bool HayFiltros => filtro != "" || periodo != "" || fSentido != "" || fEstado != "" || fPlazo != "" || fResponsable != "" || fArea != ""
                               || soloSugeridas || soloRepetidos || cargaFiltro is not null;

    private void LimpiarFiltros()
    {
        filtro = periodo = fSentido = fEstado = fPlazo = fResponsable = fArea = "";
        desde = hasta = null; soloSugeridas = soloRepetidos = false; cargaFiltro = null;
    }

    private void CambiarPeriodo(ChangeEventArgs e)
    {
        periodo = e.Value?.ToString() ?? "";
        var hoy = DateTime.Today;
        (desde, hasta) = periodo switch
        {
            "mes" => (new DateTime(hoy.Year, hoy.Month, 1), (DateTime?)hoy),
            "30" => (hoy.AddDays(-30), hoy),
            "90" => (hoy.AddDays(-90), hoy),
            "anio" => (new DateTime(hoy.Year, 1, 1), hoy),
            "rango" => (desde, hasta),
            _ => ((DateTime?)null, (DateTime?)null)
        };
    }

    private void AlternarEstado(string e) { fEstado = fEstado == e ? "" : e; }
    private void AlternarVencidas() { fPlazo = fPlazo == LogicaComunicados.Vencida ? "" : LogicaComunicados.Vencida; }
    private void QuitarEstadoPlazo() { fEstado = ""; fPlazo = ""; }

    private IEnumerable<Comunicado> Filtrados => comunicados.Where(c =>
    {
        var k = Calc(c.Id);
        if (cargaFiltro is not null && c.CargaComunicadosId != cargaFiltro) return false;
        if (desde is DateTime d0 && (c.Fecha is null || c.Fecha.Value.Date < d0.Date)) return false;
        if (hasta is DateTime d1 && (c.Fecha is null || c.Fecha.Value.Date > d1.Date)) return false;
        if (fSentido != "" && c.Sentido != fSentido) return false;
        if (fEstado != "" && k.Estado != fEstado) return false;
        if (fPlazo != "" && k.Plazo != fPlazo) return false;
        if (fResponsable != "" && k.Responsable != fResponsable) return false;
        if (fArea != "" && !LogicaComunicados.Areas(c.ResponsableRespuesta).Contains(fArea, StringComparer.OrdinalIgnoreCase)) return false;
        if (soloSugeridas && k.Sugerida is null) return false;
        if (soloRepetidos && !k.CodigoDuplicado) return false;
        if (filtro.Trim() is { Length: > 0 } q)
        {
            var t = string.Join(" ", c.Consecutivo, c.Descripcion, c.ConsecutivoRespuesta, c.Remitente, c.Observaciones, c.ResponsableRespuesta, k.Plazo);
            if (!t.Contains(q, StringComparison.OrdinalIgnoreCase)
                && !LogicaComunicados.Clave(t).Contains(LogicaComunicados.Clave(q))
                && !(motor is not null && motor.TextoBusqueda(c.Id).Contains(q, StringComparison.OrdinalIgnoreCase))) return false;
        }
        return true;
    });

    private IEnumerable<Comunicado> Mostrados
    {
        get
        {
            var q = Filtrados;
            return motor is not null && colOrden is not null ? motor.Ordenar(q, c => c.Id, colOrden, ordenAsc) : q.OrderByDescending(c => c.Fecha).ThenByDescending(c => c.Id);
        }
    }

    private void OrdenarPor(string clave) { if (colOrden == clave) ordenAsc = !ordenAsc; else { colOrden = clave; ordenAsc = true; } }
    private string Flecha(string clave) => colOrden == clave ? (ordenAsc ? " ▲" : " ▼") : "";

    private sealed record Ind(int Total, int Requieren, int Cerrados, int Pendientes, int Vencidas, double? PctATiempo, double? PromedioDias);

    private Ind Indicadores()
    {
        var l = Filtrados.Select(c => (C: c, K: Calc(c.Id))).ToList();
        var req = l.Where(x => x.C.RequiereRespuesta == true).ToList();
        var conPlazo = req.Count(x => x.K.Plazo != "");
        var aTiempo = req.Count(x => x.K.Plazo == LogicaComunicados.ATiempo);
        var cerr = req.Where(x => x.K.Estado == LogicaComunicados.Cerrado && x.K.Dias is not null).Select(x => (double)x.K.Dias!.Value).ToList();
        return new Ind(l.Count, req.Count, req.Count(x => x.K.Estado == LogicaComunicados.Cerrado), req.Count(x => x.K.Estado == LogicaComunicados.Pendiente),
            req.Count(x => x.K.Plazo == LogicaComunicados.Vencida), conPlazo == 0 ? null : 100.0 * aTiempo / conPlazo, cerr.Count == 0 ? null : cerr.Average());
    }

    // ---------- Gráficos (Chart.js, js/graficoEnsayos.js: sigwebRenderGrafico) ----------
    private bool verGraficos, agrupacionMes = true;
    private bool verPanel = true;   // filtros e indicadores (botón del encabezado)
    private string TituloMes => agrupacionMes ? "Comunicados por mes" : "Comunicados por año";

    // Caja de un gráfico: título y botón "+" (elementos del gráfico: leyenda, etiquetas, ejes, títulos…).
    private RenderFragment GraficoCaja(string id, string titulo, string clave, bool ancho) => __builder =>
    {
        <div class="com-grafico @(ancho ? "com-grafico-ancho" : "")">
