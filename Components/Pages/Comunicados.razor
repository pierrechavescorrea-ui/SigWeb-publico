            </div>
        </div>
    };

    // Dirección válida: http(s); sin esquema se le pone https://.
    private static string? Url(string texto)
    {
        var t = texto.Trim();
        if (t.Length == 0) return null;
        if (!t.Contains("://")) t = "https://" + t;
        return Uri.TryCreate(t, UriKind.Absolute, out var u) && (u.Scheme == Uri.UriSchemeHttps || u.Scheme == Uri.UriSchemeHttp) ? u.ToString() : null;
    }

    private static string NombreDeUrl(string url)
    {
        var host = Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host.ToLowerInvariant() : "";
        return host.Contains("drive.google") || host.Contains("docs.google") ? "Google Drive"
            : host.Contains("sharepoint") ? "SharePoint" : host.Contains("onedrive") || host.Contains("1drv") ? "OneDrive"
            : host.Contains("dropbox") ? "Dropbox" : host.Length > 0 ? host : "Enlace";
    }

    private async Task GuardarNube(int comId)
    {
        if (formNube is not { } f) return;
        var url = Url(f.Url);
        if (url is null) { mensajeAdj = "La dirección no es válida (debe empezar por https://)."; return; }
        try
        {
            var nombre = string.IsNullOrWhiteSpace(f.Nombre) ? NombreDeUrl(url) : f.Nombre.Trim();
            if (f.Id is int idEdit)
            {
                if (await Db.AdjuntosComunicado.FirstOrDefaultAsync(a => a.Id == idEdit) is { } ent) { ent.Nombre = nombre; ent.Ruta = url; }
            }
            else Db.AdjuntosComunicado.Add(new AdjuntoComunicado { ComunicadoId = comId, Clase = AdjuntoComunicado.Nube, Nombre = nombre, Ruta = url });
            await Db.SaveChangesAsync();
            formNube = null; mensajeAdj = "";
            RecargarAdjuntos();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeAdj = "No se pudo guardar: " + ex.Message; }
    }

    private async Task<string> GuardarArchivo(IBrowserFile archivo)
    {
        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "comunicados");
        Directory.CreateDirectory(carpeta);
        var nombre = $"{Guid.NewGuid():N}{Path.GetExtension(archivo.Name)}";
        await using (var s = archivo.OpenReadStream(MaxArchivo))
        await using (var destino = File.Create(Path.Combine(carpeta, nombre)))
            await s.CopyToAsync(destino);
        return $"/uploads/comunicados/{nombre}";
    }

    private async Task CargarArchivos(int comId, InputFileChangeEventArgs e)
    {
        mensajeAdj = "";
        var fallos = new List<string>();
        foreach (var f in e.GetMultipleFiles(50))
        {
            if (f.Size > MaxArchivo) { fallos.Add($"{f.Name} (supera 50 MB)"); continue; }
            try
            {
                Db.AdjuntosComunicado.Add(new AdjuntoComunicado { ComunicadoId = comId, Clase = AdjuntoComunicado.Archivo, Nombre = f.Name, Ruta = await GuardarArchivo(f) });
                await Db.SaveChangesAsync();
            }
            catch (Exception ex) { Db.ChangeTracker.Clear(); fallos.Add($"{f.Name} ({ex.Message})"); }
        }
        if (fallos.Count > 0) mensajeAdj = "No se cargaron: " + string.Join("; ", fallos);
        RecargarAdjuntos();
    }

    private async Task ReemplazarArchivo(AdjuntoComunicado a, InputFileChangeEventArgs e)
    {
        if (e.File.Size > MaxArchivo) { mensajeAdj = "El archivo supera 50 MB."; return; }
        try
        {
            var ent = await Db.AdjuntosComunicado.FirstAsync(x => x.Id == a.Id);
            var anterior = ent.Ruta;
            ent.Ruta = await GuardarArchivo(e.File);
            ent.Nombre = e.File.Name;
            ent.FechaCarga = DateTime.Now;
            await Db.SaveChangesAsync();
            SigWeb.Data.Papelera.ProveedorPapeleraAdjuntosMaterial.BorrarFisico(Env, anterior);
            reemplazarAdj = null;
            RecargarAdjuntos();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeAdj = "No se pudo reemplazar: " + ex.Message; }
    }

    private async Task EliminarAdjunto(AdjuntoComunicado a)
    {
        var ent = await Db.AdjuntosComunicado.FirstOrDefaultAsync(x => x.Id == a.Id);
        if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
        confirmarAdj = null;
        mensaje = $"{a.Nombre} enviado a la Papelera."; error = false;
        RecargarAdjuntos();
    }

    private void RecargarAdjuntos()
    {
        Db.ChangeTracker.Clear();
        var ids = comunicados.Select(c => c.Id).ToList();
        adjuntos = Db.AdjuntosComunicado.AsNoTracking().Where(a => ids.Contains(a.ComunicadoId)).ToList()
            .GroupBy(a => a.ComunicadoId).ToDictionary(g => g.Key, g => g.OrderBy(a => a.Clase).ThenByDescending(a => a.FechaCarga).ToList());
    }

    // ---------- Edición de la tabla (solo con Editar; nada se guarda hasta Guardar) ----------
    private bool modoEdicion;
    private Dictionary<(int Fila, string Clave), string?> cambios = new();
    private static readonly HashSet<string> NativasEditables = new() { "Tipo", "Remitente", "Sentido", "Consecutivo", "Fecha", "Descripcion", "Requiere", "ConsecutivoRta", "FechaRta", "ResponsableRta", "Observaciones" };

    private static bool EsEditable(CampoTabla c) => c.Origen == OrigenCampoTabla.Nativo ? NativasEditables.Contains(c.Clave) : !c.Calculado;
    private static string ClaveCambio(CampoTabla c) => c.Origen == OrigenCampoTabla.Nativo ? c.Clave : "c:" + c.Id;

    private string? ValorActual(Comunicado c, CampoTabla campo) => campo.Origen != OrigenCampoTabla.Nativo ? motor?.Registro(c.Id, campo)?.Valor : campo.Clave switch
    {
        "Tipo" => c.Tipo, "Remitente" => c.Remitente, "Sentido" => c.Sentido, "Consecutivo" => c.Consecutivo,
        "Fecha" => c.Fecha?.ToString("yyyy-MM-dd"), "Descripcion" => c.Descripcion,
        "Requiere" => c.RequiereRespuesta switch { true => "SI", false => "NO", _ => null },
        "ConsecutivoRta" => c.ConsecutivoRespuesta, "FechaRta" => c.FechaRespuesta?.ToString("yyyy-MM-dd"),
        "ResponsableRta" => c.ResponsableRespuesta, "Observaciones" => c.Observaciones, _ => null
    };

    private string? ValorEdicion(Comunicado c, CampoTabla campo) => cambios.TryGetValue((c.Id, ClaveCambio(campo)), out var v) ? v : ValorActual(c, campo);

    private void Cambiar(Comunicado c, CampoTabla campo, string? valor)
    {
        valor = string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();
        var k = (c.Id, ClaveCambio(campo));
        if ((valor ?? "") == (ValorActual(c, campo) ?? "")) cambios.Remove(k); else cambios[k] = valor;
    }

    private RenderFragment EntradaEdicion(Comunicado c, CampoTabla campo) => __builder =>
    {
        var v = ValorEdicion(c, campo);
        string? lista = campo.Clave switch { "Tipo" => "dl-com-tipo", "Remitente" => "dl-com-rem", "ResponsableRta" => "dl-com-area", _ => null };
        if (campo.Origen != OrigenCampoTabla.Nativo) { <text>@EntradaCampo(campo, v, val => Cambiar(c, campo, val), "cc-input")</text> return; }
        switch (campo.Clave)
        {
            case "Fecha":
            case "FechaRta":
                <input type="date" class="form-control form-control-sm cc-input" value="@v" @onchange="@(e => Cambiar(c, campo, e.Value?.ToString()))" />
                break;
            case "Sentido":
                <select class="form-select form-select-sm cc-input" value="@v" @onchange="@(e => Cambiar(c, campo, e.Value?.ToString()))">
                    <option value=""></option><option>@LogicaComunicados.Entrada</option><option>@LogicaComunicados.Salida</option>
                </select>
                break;
            case "Requiere":
                <select class="form-select form-select-sm cc-input" value="@v" @onchange="@(e => Cambiar(c, campo, e.Value?.ToString()))">
                    <option value=""></option><option value="SI">Sí</option><option value="NO">No</option>
                </select>
                break;
            case "ResponsableRta":
                <SelectorEtiquetas Valor="@v" Opciones="areasTodas" Placeholder="" OnCambio="@(val => Cambiar(c, campo, val))" />
                break;
            case "Descripcion":
            case "Observaciones":
            case "Consecutivo":
            case "ConsecutivoRta":
                @* El texto se ajusta al ancho de la celda (crece hacia abajo). *@
                <textarea class="form-control form-control-sm cc-input cc-ajusta" rows="1" @onchange="@(e => Cambiar(c, campo, e.Value?.ToString()))">@v</textarea>
                break;
            default:
                <input class="form-control form-control-sm cc-input cc-ancho" value="@v" list="@lista" title="@v"
                       @onchange="@(e => Cambiar(c, campo, e.Value?.ToString()))" />
                break;
        }
    };

    private void EntrarEdicion()
    {
        modoEdicion = true; cambios.Clear(); menuAdj = null;
        mostrarImportar = false; verCargas = false; form = null; elimId = null; verCampos = false; verRevision = false; verAjustes = false; mensaje = "";
    }

    private void SalirEdicion() { modoEdicion = false; cambios.Clear(); }

    private async Task GuardarEdicion()
    {
        if (motor is null || cambios.Count == 0) return;
        if (cambios.Any(k => k.Key.Clave == "Consecutivo" && string.IsNullOrWhiteSpace(k.Value)))
        { mensaje = "El consecutivo no puede quedar vacío."; error = true; return; }
        guardando = true;
        try
        {
            var filas = cambios.Keys.Select(k => k.Fila).Distinct().ToList();
            var ents = await Db.Comunicados.Where(c => filas.Contains(c.Id)).ToDictionaryAsync(c => c.Id);
            foreach (var ((fila, clave), valor) in cambios.Where(k => !k.Key.Clave.StartsWith("c:")))
            {
                if (!ents.TryGetValue(fila, out var e)) continue;
                switch (clave)
                {
                    case "Tipo": e.Tipo = valor; break;
                    case "Remitente": e.Remitente = valor; break;
                    case "Sentido": e.Sentido = LogicaComunicados.Sentido(valor); break;
                    case "Consecutivo": e.Consecutivo = valor ?? e.Consecutivo; break;
                    case "Fecha": e.Fecha = FechaTexto.Parsear(valor); break;
                    case "Descripcion": e.Descripcion = valor; break;
                    case "Requiere": e.RequiereRespuesta = LogicaComunicados.SiNo(valor); break;
                    case "ConsecutivoRta": e.ConsecutivoRespuesta = valor; break;
                    case "FechaRta": e.FechaRespuesta = FechaTexto.Parsear(valor); break;
                    case "ResponsableRta": e.ResponsableRespuesta = valor; break;
                    case "Observaciones": e.Observaciones = valor; break;
                }
            }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            var porIdCampo = motor.Campos.ToDictionary(c => c.Id);
            foreach (var ((fila, clave), valor) in cambios.Where(k => k.Key.Clave.StartsWith("c:")).ToList())
                if (porIdCampo.TryGetValue(int.Parse(clave[2..]), out var campo)) await motor.GuardarValorAsync(Db, fila, campo, valor);
            mensaje = $"{cambios.Count} cambio(s) guardado(s) en {filas.Count} comunicado(s)."; error = false;
            modoEdicion = false; cambios.Clear();
            Cargar();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo guardar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    // ---------- Nuevo comunicado ----------
    private sealed class FormComunicado
    {
        public string? Consecutivo { get; set; }
        public DateTime? Fecha { get; set; } = DateTime.Today;
        public string? Sentido { get; set; }
        public string? Tipo { get; set; }
        public string? Remitente { get; set; }
        public string? Descripcion { get; set; }
        public string? Requiere { get; set; }
        public string? ResponsableRta { get; set; }
        public string? ConsecutivoRta { get; set; }
        public DateTime? FechaRta { get; set; }
        public string? Observaciones { get; set; }
        public Dictionary<int, string?> Campos { get; } = new();
    }

    private FormComunicado? form;

    private void Nuevo()
    {
        if (form is not null) { form = null; return; }
        mostrarImportar = false; verCargas = false; elimId = null; mensaje = "";
        form = new FormComunicado();
    }

    private async Task GuardarNuevo()
    {
        if (form is null || motor is null || string.IsNullOrWhiteSpace(form.Consecutivo)) return;
        guardando = true;
        try
        {
            var e = new Comunicado
            {
                Consecutivo = form.Consecutivo.Trim(), Fecha = form.Fecha, Sentido = LogicaComunicados.Sentido(form.Sentido),
                Tipo = Limpio(form.Tipo), Remitente = Limpio(form.Remitente), Descripcion = Limpio(form.Descripcion),
                RequiereRespuesta = LogicaComunicados.SiNo(form.Requiere), ResponsableRespuesta = Limpio(form.ResponsableRta),
                ConsecutivoRespuesta = Limpio(form.ConsecutivoRta), FechaRespuesta = form.FechaRta, Observaciones = Limpio(form.Observaciones)
            };
            Db.Comunicados.Add(e);
            await Db.SaveChangesAsync();
            foreach (var c in CamposEditables.ToList())
                if (form.Campos.TryGetValue(c.Id, out var v) && !string.IsNullOrWhiteSpace(v)) await motor.GuardarValorAsync(Db, e.Id, c, v);
            selId = e.Id;
            mensaje = $"Comunicado {e.Consecutivo} agregado."; error = false;
            form = null;
            Cargar();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo guardar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    private static string? Limpio(string? t) => string.IsNullOrWhiteSpace(t) ? null : t.Trim();

    // ---------- Eliminar (Papelera, con sus adjuntos) ----------
    private int? elimId;
    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;

    private void PedirEliminar()
    {
        if (selId is not int id) return;
        form = null; mostrarImportar = false; elimId = id; impacto = null; impactoOk = false;
        _ = CalcularImpacto(id);
    }

    private async Task CalcularImpacto(int id)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            impacto = await scope.ServiceProvider.GetRequiredService<SigWeb.Data.Impacto.AnalizadorImpacto>().Comunicados(new[] { id });
        }
        catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmarEliminar()
    {
        if (elimId is not int id) return;
        var ahora = DateTime.Now; ahora = new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, ahora.Minute, ahora.Second);
        var c = await Db.Comunicados.FirstOrDefaultAsync(x => x.Id == id);
        if (c is not null)
        {
            c.Eliminado = true; c.FechaEliminacion = ahora;
            foreach (var a in await Db.AdjuntosComunicado.Where(a => a.ComunicadoId == id).ToListAsync()) { a.Eliminado = true; a.FechaEliminacion = ahora; }
            await Db.SaveChangesAsync();
        }
        mensaje = $"{c?.Consecutivo} enviado a la Papelera."; error = false;
        elimId = null; selId = null;
        Cargar();
    }

    // ---------- Cargas (bases de datos Excel) ----------
    private bool verCargas, mostrarImportar, importando;
    private List<CargaComunicados> cargas = new();
    private HashSet<int> cargasSel = new();
    private List<int>? elimCargas;
    private SigWeb.Data.Impacto.InformeImpacto? impactoCargas;
    private bool impactoCargasOk;

    private void AlternarCargas() { verCargas = !verCargas; mostrarImportar = false; elimCargas = null; }
    private void AlternarImportar() { mostrarImportar = !mostrarImportar; verCargas = false; form = null; mensaje = ""; }

    private void PedirEliminarCargas()
    {
        if (cargasSel.Count == 0) return;
        elimCargas = cargasSel.ToList(); impactoCargas = null; impactoCargasOk = false;
        _ = CalcularImpactoCargas(elimCargas);
    }

    private async Task CalcularImpactoCargas(List<int> ids)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            impactoCargas = await scope.ServiceProvider.GetRequiredService<SigWeb.Data.Impacto.AnalizadorImpacto>().CargasComunicados(ids);
        }
        catch { impactoCargas = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmarEliminarCargas()
    {
        if (elimCargas is null) return;
        var ids = elimCargas;
        // Misma marca de tiempo para la carga, sus comunicados y sus adjuntos: la Papelera los restaura juntos.
        var ahora = DateTime.Now; ahora = new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, ahora.Minute, ahora.Second);
        foreach (var c in await Db.CargasComunicados.Where(c => ids.Contains(c.Id)).ToListAsync()) { c.Eliminado = true; c.FechaEliminacion = ahora; }
        var coms = await Db.Comunicados.Where(m => m.CargaComunicadosId != null && ids.Contains(m.CargaComunicadosId.Value)).ToListAsync();
        var idsCom = coms.Select(c => c.Id).ToList();
        foreach (var m in coms) { m.Eliminado = true; m.FechaEliminacion = ahora; }
        foreach (var a in await Db.AdjuntosComunicado.Where(a => idsCom.Contains(a.ComunicadoId)).ToListAsync()) { a.Eliminado = true; a.FechaEliminacion = ahora; }
        await Db.SaveChangesAsync();
        mensaje = $"{ids.Count} carga(s) y {coms.Count} comunicado(s) enviados a la Papelera."; error = false;
        elimCargas = null; cargasSel.Clear();
        Cargar();
    }

    // ---------- Importar (Excel): cada columna a una propia, a un Campo, a uno nuevo o se omite ----------
    private IReadOnlyList<DestinoColumna> DestinosImportacion =>
        ImportadorComunicados.DestinosPropios
            .Concat(CamposEditables.Select(c => new DestinoColumna($"c:{c.Id}", c.Nombre))).ToList();

    private async Task ImportarExcel(ImportacionExcel imp)
    {
        mensaje = "";
        if (imp.Filas.Count == 0) { mensaje = "No hay filas con datos para importar."; error = true; return; }
        importando = true;
        try
        {
            var nombres = (motor?.Campos ?? new()).ToDictionary(c => c.Id, c => c.Nombre);
            var r = await ImportadorComunicados.ImportarAsync(Db, imp, nombres);
            mensaje = $"{r.Creados} comunicado(s) nuevo(s), {r.Actualizados} actualizado(s)." + (r.Avisos.Count > 0 ? " " + string.Join(" ", r.Avisos) : "");
            error = r.Avisos.Count > 0;
            mostrarImportar = false;
            Cargar();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo importar: " + ex.Message; error = true; }
        finally { importando = false; }
    }
