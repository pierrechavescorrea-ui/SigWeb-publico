        if (formNube is not { } f) return;
        <div class="com-nube-form">
            <input class="form-control form-control-sm mb-1" placeholder="Nombre (p. ej. Carpeta en Drive)" value="@f.Nombre" @oninput="@(e => formNube = (f.Id, e.Value?.ToString() ?? "", formNube?.Url ?? ""))" />
