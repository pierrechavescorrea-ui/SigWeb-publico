    // Vigente: la revisión vigente del listado (o la versión actual). Obsoleta: la revisión anterior, si la hay.
    private string? VersionSugerida(int planoId, ClaseArchivoDocumento clase)
    {
        if (!planosPorId.TryGetValue(planoId, out var p)) return null;
        if (clase == ClaseArchivoDocumento.Obsoleta) return string.IsNullOrWhiteSpace(p.RevisionAnterior) ? null : p.RevisionAnterior.Trim();
        if (!string.IsNullOrWhiteSpace(p.RevisionVigente)) return p.RevisionVigente.Trim();
        return ArchivosPlanos.Actuales(ArchivosDe(planoId)).FirstOrDefault()?.Version;
    }

    private async Task<string> GuardarArchivo(IBrowserFile archivo)
    {
        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "planos");
        Directory.CreateDirectory(carpeta);
        var nombre = $"{Guid.NewGuid()}{Path.GetExtension(archivo.Name)}";
        await using (var s = archivo.OpenReadStream(MaxArchivo))
        await using (var destino = File.Create(Path.Combine(carpeta, nombre)))
            await s.CopyToAsync(destino);
        return $"/uploads/planos/{nombre}";
    }

    // Guarda los archivos en una carga. Un vigente con otra versión actualiza la revisión del listado
    // (la anterior pasa a "Rev. anterior").
    private async Task<(int Ok, List<string> Fallos)> Guardar(string origen, string? descripcion, DateTime? fecha, IEnumerable<ArchivoACargar> archivos)
    {
        var lista = archivos.ToList();
        var carga = new CargaArchivosPlanos { Fecha = DateTime.Now, Origen = origen, Descripcion = descripcion };
        Db.CargasArchivosPlanos.Add(carga);
        await Db.SaveChangesAsync();
        int ok = 0; var fallos = new List<string>();
        var momento = DateTime.Now;
        foreach (var a in lista)
        {
            try
            {
                var ruta = await GuardarArchivo(a.Archivo);
                momento = momento.AddMilliseconds(10);
                Db.ArchivosPlanoMaestro.Add(new ArchivoPlanoMaestro
                {
                    PlanoMaestroId = a.FilaId, Clase = a.Clase, Version = a.Version, Fecha = fecha,
                    NombreOriginal = a.Archivo.Name, RutaArchivo = ruta, FechaCarga = momento, CargaArchivosPlanosId = carga.Id
                });
                if (a.Clase == ClaseArchivoDocumento.Vigente)
                {
                    var p = await Db.PlanosMaestro.FirstAsync(x => x.Id == a.FilaId);
                    if (!string.Equals((p.RevisionVigente ?? "").Trim(), a.Version, StringComparison.OrdinalIgnoreCase))
                    {
                        if (!string.IsNullOrWhiteSpace(p.RevisionVigente)) p.RevisionAnterior = p.RevisionVigente;
                        p.RevisionVigente = a.Version;
                        if (fecha is not null) p.Fecha = fecha;
                    }
                }
                await Db.SaveChangesAsync();
                ok++;
            }
            catch (Exception ex) { fallos.Add($"{a.Archivo.Name} ({ex.Message})"); }
        }
        var cg = await Db.CargasArchivosPlanos.FirstAsync(c => c.Id == carga.Id);
        if (ok == 0) Db.CargasArchivosPlanos.Remove(cg); else cg.Archivos = ok;
        await Db.SaveChangesAsync();
        return (ok, fallos);
    }

    private async Task CargarLote((DateTime? Fecha, List<ArchivoACargar> Archivos) lote)
    {
        cargandoLote = true;
        try
        {
            var clases = string.Join(", ", lote.Archivos.Select(a => PanelCargaArchivos.Nombre(a.Clase, true).ToLowerInvariant()).Distinct());
            var (ok, fallos) = await Guardar("Carga masiva", clases, lote.Fecha, lote.Archivos);
            mensaje = $"{ok} archivo(s) cargado(s)." + (fallos.Count > 0 ? " No se cargaron: " + string.Join("; ", fallos) : "");
            error = fallos.Count > 0;
            verLote = false;
            CargarPlanos();
        }
        finally { cargandoLote = false; }
    }

    // ---------- Archivos para un plano (una o varias hojas) ----------
    private sealed class FormArchivos
    {
        public int PlanoId;
        public ClaseArchivoDocumento Clase = ClaseArchivoDocumento.Vigente;
        public string? Version;
        public DateTime? Fecha = DateTime.Today;
        public List<IBrowserFile> Archivos = new();
    }

    private FormArchivos? formArch;

    private void AbrirArchivosPlano(PlanoMaestro p)
    {
        verImportar = false; verLote = false; mensaje = "";
        formArch = new FormArchivos { PlanoId = p.Id };
        formArch.Version = VersionSugerida(p.Id, formArch.Clase);
    }

    private async Task GuardarArchivosPlano()
    {
        if (formArch is null || formArch.Archivos.Count == 0 || string.IsNullOrWhiteSpace(formArch.Version)) return;
        var f = formArch;
        var grandes = f.Archivos.Where(a => a.Size > MaxArchivo).Select(a => a.Name).ToList();
        guardando = true;
        try
        {
            var (ok, fallos) = await Guardar("Archivo agregado", $"{CodigoPlano(f.PlanoId)} v{f.Version!.Trim()}", f.Fecha,
                f.Archivos.Where(a => a.Size <= MaxArchivo).Select(a => new ArchivoACargar(a, f.PlanoId, f.Clase, f.Version!.Trim())));
            fallos.AddRange(grandes.Select(n => $"{n} (supera 50 MB)"));
            mensaje = $"{ok} archivo(s) cargado(s)." + (fallos.Count > 0 ? " No se cargaron: " + string.Join("; ", fallos) : "");
            error = fallos.Count > 0;
            formArch = null;
            CargarPlanos();
        }
        finally { guardando = false; }
    }

    // ---------- Cargas: Excel del listado y archivos ----------
    private bool verCargas;
    private string pestanaCargas = "listado";
    private List<CargaPlanos> cargas = new();
    private Dictionary<int, int> planosPorCarga = new();
    private List<CargaArchivosPlanos> cargasArchivos = new();
    private Dictionary<int, List<ArchivoPlanoMaestro>> archivosPorCarga = new();
    private HashSet<int> cargasSel = new(), cargasArchSel = new();
    private int? cargaFiltro, cargaArchFiltro, cargaArchAbierta;
    private (string Tipo, List<int> Ids)? elimCargas;
    private SigWeb.Data.Impacto.InformeImpacto? impactoCargas;
    private bool impactoCargasOk;
    private bool BloqueadoCargas => impactoCargas is null || (impactoCargas.RequiereEntender && !impactoCargasOk);

    private void AlternarCargas() { verCargas = !verCargas; elimCargas = null; }

    private void PedirEliminarCargas(string tipo)
    {
        var ids = (tipo == "listado" ? cargasSel : cargasArchSel).ToList();
        if (ids.Count == 0) return;
        elimCargas = (tipo, ids); impactoCargas = null; impactoCargasOk = false;
        _ = CalcularImpactoCargas(tipo, ids);
    }

    private async Task CalcularImpactoCargas(string tipo, List<int> ids)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            var an = scope.ServiceProvider.GetRequiredService<SigWeb.Data.Impacto.AnalizadorImpacto>();
            impactoCargas = tipo == "listado" ? await an.CargasPlanos(ids) : await an.CargasArchivosPlanos(ids);
        }
        catch { impactoCargas = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmarEliminarCargas()
    {
        if (elimCargas is null || BloqueadoCargas) return;
        var (tipo, ids) = elimCargas.Value;
        // Misma marca de tiempo para la carga y lo suyo: la Papelera los restaura juntos.
        var ahora = DateTime.Now; ahora = new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, ahora.Minute, ahora.Second);
        int n = 0;
        if (tipo == "listado")
        {
            foreach (var c in await Db.CargasPlanos.Where(c => ids.Contains(c.Id)).ToListAsync()) { c.Eliminado = true; c.FechaEliminacion = ahora; }
            foreach (var p in await Db.PlanosMaestro.Where(p => !p.Eliminado && p.CargaPlanosId != null && ids.Contains(p.CargaPlanosId.Value)).ToListAsync())
            { p.Eliminado = true; p.FechaEliminacion = ahora; n++; }
            mensaje = $"{ids.Count} carga(s) y {n} plano(s) enviados a la Papelera.";
        }
        else
        {
            foreach (var c in await Db.CargasArchivosPlanos.Where(c => ids.Contains(c.Id)).ToListAsync()) { c.Eliminado = true; c.FechaEliminacion = ahora; }
            foreach (var a in await Db.ArchivosPlanoMaestro.Where(a => !a.Eliminado && a.CargaArchivosPlanosId != null && ids.Contains(a.CargaArchivosPlanosId.Value)).ToListAsync())
            { a.Eliminado = true; a.FechaEliminacion = ahora; n++; }
            mensaje = $"{ids.Count} carga(s) y {n} archivo(s) enviados a la Papelera.";
        }
        await Db.SaveChangesAsync();
        error = false;
        elimCargas = null; cargasSel.Clear(); cargasArchSel.Clear();
        CargarPlanos();
    }

    // ---------- Impacto ----------
    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;
    private bool BloqueadoPorImpacto => impacto is null || (impacto.RequiereEntender && !impactoOk);

    private async Task CalcularImpacto(Func<SigWeb.Data.Impacto.AnalizadorImpacto, Task<SigWeb.Data.Impacto.InformeImpacto>> f)
    {
        impacto = null; impactoOk = false;
        try
        {
            using var scope = Scopes.CreateScope();
            impacto = await f(scope.ServiceProvider.GetRequiredService<SigWeb.Data.Impacto.AnalizadorImpacto>());
        }
        catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    // ---------- Reemplazar / eliminar un archivo ----------
    private ArchivoPlanoMaestro? reemplazo, archivoPendienteEliminar;
    private IBrowserFile? archivoReemplazo;

    private void AbrirReemplazo(ArchivoPlanoMaestro a) { menuCodigo = null; reemplazo = a; archivoReemplazo = null; }

    // Mismo registro (versión, clase, vínculos con componentes); cambia el archivo. El anterior se borra del disco.
    private async Task Reemplazar()
    {
        if (reemplazo is null || archivoReemplazo is null) return;
        if (archivoReemplazo.Size > MaxArchivo) { mensaje = "El archivo supera 50 MB."; error = true; reemplazo = null; return; }
        guardando = true;
        try
        {
            var ruta = await GuardarArchivo(archivoReemplazo);
            var ent = await Db.ArchivosPlanoMaestro.FirstAsync(x => x.Id == reemplazo.Id);
            var anterior = ent.RutaArchivo;
            ent.RutaArchivo = ruta;
            ent.NombreOriginal = archivoReemplazo.Name;
            await Db.SaveChangesAsync();
            try
            {
                var fisica = Path.Combine(Env.WebRootPath, anterior.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                if (File.Exists(fisica)) File.Delete(fisica);
            }
            catch { }
            mensaje = $"Archivo reemplazado: {archivoReemplazo.Name}."; error = false;
            reemplazo = null;
            CargarPlanos();
        }
        catch (Exception ex) { mensaje = "No se pudo reemplazar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    private void PedirEliminarArchivo(ArchivoPlanoMaestro a)
    {
        menuCodigo = null; archivoPendienteEliminar = a;
        _ = CalcularImpacto(an => an.ArchivoPlano(a.Id));
    }

    private async Task ConfirmarEliminarArchivo()
    {
        if (archivoPendienteEliminar is null || BloqueadoPorImpacto) return;
        var ent = await Db.ArchivosPlanoMaestro.FirstOrDefaultAsync(x => x.Id == archivoPendienteEliminar.Id);
        if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
        archivoPendienteEliminar = null;
        CargarPlanos();
    }

    // ---------- Eliminar plano ----------
    private PlanoMaestro? planoPendienteEliminar;

    private void PedirEliminar(PlanoMaestro p)
    {
        planoPendienteEliminar = p;
        _ = CalcularImpacto(an => an.Plano(p.Id));
    }

    private async Task ConfirmarEliminar()
    {
        if (planoPendienteEliminar is null || BloqueadoPorImpacto) return;
        var ent = await Db.PlanosMaestro.FirstOrDefaultAsync(x => x.Id == planoPendienteEliminar.Id);
        if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
        planoPendienteEliminar = null;
        CargarPlanos();
    }
