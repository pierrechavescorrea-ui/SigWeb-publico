@code {
    // ---------- Pantalla completa (igual que Ensayos): la tabla ocupa la ventana y todo sigue funcionando ----------
    private bool pantallaCompleta;
    private EventCallback AtrasPantalla => pantallaCompleta ? EventCallback.Factory.Create(this, () => pantallaCompleta = false) : default;

    private const string Tabla = "planos";
    private const long MaxArchivo = PanelCargaArchivos.MaxArchivo;
    private static readonly ClaseArchivoDocumento[] ClasesPlano = { ClaseArchivoDocumento.Vigente, ClaseArchivoDocumento.Obsoleta };

    private List<PlanoMaestro> planos = new();
    private Dictionary<int, PlanoMaestro> planosPorId = new();
    private Dictionary<int, List<ArchivoPlanoMaestro>> archivosPorPlano = new();
    private string filtro = "";
    private string mensaje = "";
    private bool error = false;
    private bool guardando;

    // ?buscar=texto (buscador rápido Ctrl + K): llega como filtro de la lista.
    [SupplyParameterFromQuery(Name = "buscar")] public string? BuscarQ { get; set; }
    private string? buscarAplicado;
    protected override void OnParametersSet()
    {
        if (BuscarQ == buscarAplicado) return;
        buscarAplicado = BuscarQ;
        if (!string.IsNullOrWhiteSpace(BuscarQ)) filtro = BuscarQ;
    }

    protected override async Task OnInitializedAsync()
    {
        iconosDisponibles = Db.IconosCatalogo.AsNoTracking().Where(i => i.Activo).OrderBy(i => i.Categoria).ThenBy(i => i.Nombre).ToList();
        CargarGrupos();
        CargarPlanos();
        motor = await MotorTabla.CargarAsync(Db, Tabla, ColumnasNativas(), FilasMotor());
    }

    private void CargarPlanos()
    {
        Db.ChangeTracker.Clear();
        planos = Db.PlanosMaestro.AsNoTracking().Where(p => !p.Eliminado).OrderBy(p => p.Codigo).ToList();
        planosPorId = planos.ToDictionary(p => p.Id);
        if (motor is not null) motor.Filas = FilasMotor().ToList();
        conteoGrupos = planos.Where(p => p.GrupoPlanoId != null).GroupBy(p => p.GrupoPlanoId!.Value).ToDictionary(x => x.Key, x => x.Count());
        var archivos = Db.ArchivosPlanoMaestro.AsNoTracking().Where(a => !a.Eliminado).ToList();
        archivosPorPlano = archivos.GroupBy(a => a.PlanoMaestroId).ToDictionary(g => g.Key, g => g.ToList());

        cargas = Db.CargasPlanos.AsNoTracking().OrderByDescending(c => c.Fecha).ToList();
        planosPorCarga = planos.Where(p => p.CargaPlanosId != null).GroupBy(p => p.CargaPlanosId!.Value).ToDictionary(g => g.Key, g => g.Count());
        cargasArchivos = Db.CargasArchivosPlanos.AsNoTracking().OrderByDescending(c => c.Fecha).ToList();
        archivosPorCarga = archivos.Where(a => a.CargaArchivosPlanosId != null && planosPorId.ContainsKey(a.PlanoMaestroId))
            .GroupBy(a => a.CargaArchivosPlanosId!.Value).ToDictionary(g => g.Key, g => g.ToList());
        cargasSel.RemoveWhere(id => cargas.All(c => c.Id != id));
        cargasArchSel.RemoveWhere(id => cargasArchivos.All(c => c.Id != id));
        if (cargaFiltro is int cf && cargas.All(c => c.Id != cf)) cargaFiltro = null;
        if (cargaArchFiltro is int caf && cargasArchivos.All(c => c.Id != caf)) cargaArchFiltro = null;
    }

    private List<ArchivoPlanoMaestro> ArchivosDe(int planoId) => archivosPorPlano.TryGetValue(planoId, out var l) ? l : new();
    private string CodigoPlano(int id) => planosPorId.TryGetValue(id, out var p) ? p.Codigo : $"#{id}";

    // ---------- Campos (columnas visibles, campos creados, fórmulas y formatos) ----------
    private MotorTabla? motor;
    private bool verCampos;

    private IEnumerable<ColumnaNativa> ColumnasNativas() => new[]
    {
        new ColumnaNativa("Codigo", "Código", TipoCampoTabla.Texto, id => planosPorId.TryGetValue(id, out var p) ? p.Codigo : null),
        new ColumnaNativa("Titulo", "Título", TipoCampoTabla.Texto, id => planosPorId.TryGetValue(id, out var p) ? p.Titulo : null),
        new ColumnaNativa("Fecha", "Fecha", TipoCampoTabla.Fecha, id => planosPorId.TryGetValue(id, out var p) ? p.Fecha : null),
        new ColumnaNativa("RevisionVigente", "Rev. vigente", TipoCampoTabla.Texto, id => planosPorId.TryGetValue(id, out var p) ? p.RevisionVigente : null),
        new ColumnaNativa("Estado", "Estado", TipoCampoTabla.Texto, id => planosPorId.TryGetValue(id, out var p) ? p.Estado : null),
        new ColumnaNativa("Grupo", "Grupo", TipoCampoTabla.Texto, id => planosPorId.TryGetValue(id, out var p) && p.GrupoPlanoId is int g ? grupos.FirstOrDefault(x => x.Id == g)?.Nombre : null),
        new ColumnaNativa("RevisionAnterior", "Rev. anterior", TipoCampoTabla.Texto, id => planosPorId.TryGetValue(id, out var p) ? p.RevisionAnterior : null, false),
        new ColumnaNativa("Notas", "Notas", TipoCampoTabla.Texto, id => planosPorId.TryGetValue(id, out var p) ? p.Notas : null, false),
    };

    private IEnumerable<(int Id, string Etiqueta)> FilasMotor() =>
        planos.Select(p => (p.Id, string.IsNullOrWhiteSpace(p.Titulo) ? p.Codigo : $"{p.Codigo} — {p.Titulo}"));

    // El Grupo solo se ve en "Todos" (dentro de un grupo sería repetido).
    private IEnumerable<CampoTabla> ColumnasVisibles =>
        motor is null ? Enumerable.Empty<CampoTabla>() : motor.Visibles.Where(c => !(c.Clave == "Grupo" && c.Origen == OrigenCampoTabla.Nativo && grupoSelId is not null));

    private IEnumerable<CampoTabla> CamposEditables =>
        motor?.Ordenados.Where(c => c.Origen != OrigenCampoTabla.Nativo && !c.Calculado) ?? Enumerable.Empty<CampoTabla>();

    // ---------- Grupos (disciplinas) ----------
    private List<IconoCatalogo> iconosDisponibles = new();
    private List<GrupoPlano> grupos = new();
    private Dictionary<int, int> conteoGrupos = new();
    private int? grupoSelId;               // null = "Todos"
    private int? grupoDestinoId;           // grupo al que se cargan Excel/PDF
    private GrupoPlano grupoActual = new();
    private bool modoEdicionGrupo, mostrarFormGrupo, mostrarSelectorIconoGrupo;
    private string mensajeGrupo = "";
    private GrupoPlano? elimGrupo;

    private string RutaIcono(int? id)
    {
        var ruta = id is null ? null : iconosDisponibles.FirstOrDefault(i => i.Id == id)?.RutaArchivo;
        return ruta ?? "images/iconos/documento.svg";
    }

    private string NombreDestino => grupoDestinoId is null ? "Todos" : (grupos.FirstOrDefault(g => g.Id == grupoDestinoId)?.Nombre ?? "");

    private IEnumerable<PlanoMaestro> PlanosDestino => grupoDestinoId is null ? planos : planos.Where(p => p.GrupoPlanoId == grupoDestinoId);

    private void CargarGrupos()
    {
        grupos = Db.GruposPlano.AsNoTracking().Where(g => g.Activo).OrderBy(g => g.Orden).ThenBy(g => g.Nombre).ToList();
        if (grupoSelId is not null && !grupos.Any(g => g.Id == grupoSelId)) grupoSelId = null;
    }

    private void SeleccionarTodos() { grupoSelId = null; }

    private void SeleccionarGrupo(GrupoPlano g) { grupoSelId = grupoSelId == g.Id ? null : g.Id; }

    private void AlternarFormGrupo()
    {
        if (mostrarFormGrupo) CerrarFormGrupo();
        else { grupoActual = new(); modoEdicionGrupo = false; mensajeGrupo = ""; mostrarFormGrupo = true; }
    }

    private void CerrarFormGrupo()
    {
        grupoActual = new(); modoEdicionGrupo = false; mensajeGrupo = "";
        mostrarFormGrupo = false; mostrarSelectorIconoGrupo = false;
    }

    private void EditarGrupo(GrupoPlano g)
    {
        grupoActual = new GrupoPlano { Id = g.Id, Nombre = g.Nombre, IconoCatalogoId = g.IconoCatalogoId, Orden = g.Orden, Activo = g.Activo };
        modoEdicionGrupo = true; mostrarFormGrupo = true; mostrarSelectorIconoGrupo = false;
    }

    private async Task GuardarGrupo()
    {
        mensajeGrupo = "";
        var nombre = (grupoActual.Nombre ?? "").Trim();
        if (string.IsNullOrWhiteSpace(nombre)) { mensajeGrupo = "El nombre es obligatorio."; return; }
        bool dup = Db.GruposPlano.IgnoreQueryFilters().AsNoTracking().Any(g => g.Nombre.ToLower() == nombre.ToLower() && g.Id != grupoActual.Id);
        if (dup) { mensajeGrupo = $"Ya existe \"{nombre}\" (puede estar en la Papelera)."; return; }
        grupoActual.Nombre = nombre;
        if (modoEdicionGrupo) Db.GruposPlano.Update(grupoActual);
        else { grupoActual.Orden = grupos.Count; Db.GruposPlano.Add(grupoActual); }
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        CerrarFormGrupo();
        CargarGrupos();
        CargarPlanos();
    }

    private void PedirEliminarGrupo(GrupoPlano g)
    {
        elimGrupo = g;
        _ = CalcularImpacto(an => an.GrupoPlano(g.Id));
    }

    private void CancelarEliminarGrupo() { elimGrupo = null; impacto = null; impactoOk = false; }

    private async Task ConfirmarEliminarGrupo()
    {
        if (elimGrupo is null || BloqueadoPorImpacto) return;
        var g = await Db.GruposPlano.FirstOrDefaultAsync(x => x.Id == elimGrupo.Id);
        if (g is not null) { g.Eliminado = true; g.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
        Db.ChangeTracker.Clear();
        if (grupoSelId == elimGrupo.Id) grupoSelId = null;
        CancelarEliminarGrupo();
        CargarGrupos();
        CargarPlanos();
    }

    private async Task CambiarGrupoPlano(PlanoMaestro p, ChangeEventArgs e)
    {
        int? nuevo = int.TryParse(e.Value?.ToString(), out var v) ? v : null;
        var ent = await Db.PlanosMaestro.FirstOrDefaultAsync(x => x.Id == p.Id);
        if (ent is not null) { ent.GrupoPlanoId = nuevo; await Db.SaveChangesAsync(); }
        CargarPlanos();
    }

    // ---------- Filtro y orden ----------
    private string columnaOrden = "Codigo";
    private bool ordenAscendente = true;

    private IEnumerable<PlanoMaestro> PlanosFiltrados
    {
        get
        {
            var q = (grupoSelId is null ? planos : planos.Where(p => p.GrupoPlanoId == grupoSelId))
                .Where(p => cargaFiltro is null || p.CargaPlanosId == cargaFiltro)
                .Where(p => cargaArchFiltro is null || ArchivosDe(p.Id).Any(a => a.CargaArchivosPlanosId == cargaArchFiltro));
            if (!string.IsNullOrWhiteSpace(filtro))
                q = q.Where(p => $"{p.Codigo} {p.Titulo} {p.Estado} {p.RevisionVigente} {(motor is null ? "" : motor.TextoBusqueda(p.Id))}"
                    .Contains(filtro, StringComparison.OrdinalIgnoreCase));
            return columnaOrden switch
            {
                "Codigo" => ordenAscendente ? q.OrderBy(p => p.Codigo) : q.OrderByDescending(p => p.Codigo),
                "Titulo" => ordenAscendente ? q.OrderBy(p => p.Titulo) : q.OrderByDescending(p => p.Titulo),
                "Fecha" => ordenAscendente ? q.OrderBy(p => p.Fecha) : q.OrderByDescending(p => p.Fecha),
                "RevisionVigente" => ordenAscendente ? q.OrderBy(p => p.RevisionVigente) : q.OrderByDescending(p => p.RevisionVigente),
                "Estado" => ordenAscendente ? q.OrderBy(p => p.Estado) : q.OrderByDescending(p => p.Estado),
                _ => OrdenarPorCampo(q)
            };
        }
    }

    // Orden por cualquier otro campo (Grupo, campos creados o calculados), con el valor que muestra la tabla.
    private IEnumerable<PlanoMaestro> OrdenarPorCampo(IEnumerable<PlanoMaestro> query)
    {
        var c = motor?.PorClave(columnaOrden);
        if (motor is null || c is null) return query;
        object? V(PlanoMaestro p) { try { return motor.Valor(p.Id, c); } catch { return null; } }
        var cmp = Comparer<object?>.Create(FormulaExcel.Comparar);
        return ordenAscendente ? query.OrderBy(V, cmp) : query.OrderByDescending(V, cmp);
    }

    private void OrdenarPor(string columna)
    {
        if (columnaOrden == columna) ordenAscendente = !ordenAscendente;
        else { columnaOrden = columna; ordenAscendente = true; }
    }

    private string Flecha(string columna) => columnaOrden != columna ? "" : (ordenAscendente ? " ▲" : " ▼");

    // ---------- Código como vínculo: actual (todas sus hojas) y versiones anteriores ----------
    private int? menuCodigo, verAnterioresDe;
    private bool verTodos;   // pantalla de archivos: todos (true) u obsoletos/anteriores
    private const int MaxMenu = 3;   // archivos vigentes que se listan en el menú; el resto, con "Ver todos"
    private double menuX, menuY;

    private RenderFragment CeldaCodigo(PlanoMaestro p) => __builder =>
    {
        if (ArchivosDe(p.Id).Count == 0) { <span>@p.Codigo</span> return; }
        <button type="button" class="doc-vinculo" title="Ver plano" @onclick:stopPropagation="true" @onclick="@(e => AbrirMenuCodigo(p.Id, e))">@p.Codigo</button>
    };

    private void AbrirMenuCodigo(int id, MouseEventArgs e)
    {
        if (menuCodigo == id) { menuCodigo = null; return; }
        menuCodigo = id; menuX = e.ClientX; menuY = e.ClientY;
    }

    // Fuera de la tabla y en posición fija: no queda bajo las columnas inmovilizadas.
    private RenderFragment MenuCodigo() => __builder =>
    {
        if (menuCodigo is not int id) return;
        var actuales = ArchivosPlanos.Actuales(ArchivosDe(id));
        var anteriores = ArchivosPlanos.Anteriores(ArchivosDe(id)).Count;
        var x = menuX.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var y = (menuY + 8).ToString(System.Globalization.CultureInfo.InvariantCulture);
        <div class="doc-menu-fondo" @onclick="() => menuCodigo = null"></div>
        <div class="doc-menu doc-menu-fijo" style="left:min(@(x)px, calc(100vw - 330px)); top:min(@(y)px, calc(100vh - 260px)); width:320px;">
            <button type="button" class="doc-menu-op" @onclick="() => { menuCodigo = null; verAnterioresDe = id; verTodos = true; }">
                <Ico Nombre="listado" /> <span>Ver todos</span> <span class="text-muted ms-auto">@ArchivosDe(id).Count</span>
            </button>
            <div class="doc-menu-sep"></div>
            <div class="doc-menu-sec">Vigente@(actuales.Count > MaxMenu ? $" ({MaxMenu} de {actuales.Count})" : "")</div>
            @if (actuales.Count == 0)
            {
                <span class="doc-menu-op doc-menu-off"><Ico Nombre="documento" /> <span>—</span></span>
            }
            @foreach (var a in actuales.Take(MaxMenu))
            {
                var arch = a;
                <div class="doc-menu-fila">
                    <a class="doc-menu-op" href="@arch.RutaArchivo" target="_blank" rel="noopener" title="@arch.NombreOriginal" @onclick="() => menuCodigo = null">
                        <Ico Nombre="documento" /> <span class="text-truncate">@arch.NombreOriginal</span>
                        <span class="text-muted ms-auto">@(string.IsNullOrWhiteSpace(arch.Version) ? "" : "v" + arch.Version)</span>
                    </a>
                    <button type="button" class="ens-mini" title="Reemplazar archivo" @onclick="() => AbrirReemplazo(arch)"><Ico Nombre="editar" /></button>
                    <button type="button" class="ens-mini" title="Eliminar archivo" @onclick="() => PedirEliminarArchivo(arch)"><Ico Nombre="eliminar" /></button>
                </div>
            }
            <div class="doc-menu-sep"></div>
            @if (anteriores > 0)
            {
                <button type="button" class="doc-menu-op" @onclick="() => { menuCodigo = null; verAnterioresDe = id; verTodos = false; }">
                    <Ico Nombre="versiones" /> <span>Ver obsoletos</span> <span class="text-muted ms-auto">@anteriores</span>
                </button>
            }
            else { <span class="doc-menu-op doc-menu-off"><Ico Nombre="versiones" /> <span>Ver obsoletos</span></span> }
        </div>
    };

    // ---------- Importar listado (Excel) ----------
    private bool verImportar, importando;

    private void AbrirExcel(int? grupoId)
    {
        verImportar = !verImportar || grupoDestinoId != grupoId;
        grupoDestinoId = grupoId;
        verLote = false; formArch = null; mensaje = "";
    }

    private IReadOnlyList<DestinoColumna> DestinosImportacion =>
        new List<DestinoColumna>
        {
            new("nat:Codigo", "Código", "codigo", "cod", "cod."),
            new("nat:Titulo", "Título", "titulo del documento", "titulo", "descripcion", "nombre"),
            new("nat:Fecha", "Fecha", "fecha de emision", "fecha de version"),
            new("nat:RevisionVigente", "Rev. vigente", "revision vigente", "revision", "rev", "rev.", "version"),
            new("nat:Estado", "Estado"),
            new("nat:Notas", "Notas", "observaciones"),
            new("nat:RevisionAnterior", "Rev. anterior", "revision anterior"),
            new("nat:Grupo", "Grupo", "disciplina"),
        }.Concat(CamposEditables.Select(c => new DestinoColumna($"c:{c.Id}", c.Nombre))).ToList();

    private static readonly string[] FormatosFecha = { "dd/MM/yyyy", "d/M/yyyy", "yyyy-MM-dd", "dd-MM-yyyy", "dd/MM/yy", "dd/MM/yyyy HH:mm" };

    private static DateTime? Fecha(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return null;
        texto = texto.Trim();
        if (DateTime.TryParseExact(texto, FormatosFecha, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var f)) return f;
        if (double.TryParse(texto, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var n) && n > 20000 && n < 80000) return DateTime.FromOADate(n);
        return DateTime.TryParse(texto, System.Globalization.CultureInfo.GetCultureInfo("es-CO"), System.Globalization.DateTimeStyles.None, out f) ? f : null;
    }

    private async Task Importar(ImportacionExcel imp)
    {
        var colCodigo = imp.ColumnaDe("nat:Codigo");
        if (colCodigo is null) { mensaje = "Relaciona la columna del código del plano."; error = true; return; }
        importando = true; mensaje = ""; error = false;
        try
        {
            string? Val(string[] f, string destino) => imp.ColumnaDe(destino) is int c ? ImportacionExcel.Celda(f, c).Trim() : null;
            var nativos = new HashSet<string>(ColumnasNativas().Select(n => n.Nombre), StringComparer.OrdinalIgnoreCase);
            var porId = CamposEditables.ToDictionary(c => c.Id);
            var nombres = imp.Destinos.Where(kv => !kv.Value.StartsWith("nat:"))
                .ToDictionary(kv => kv.Key, kv => kv.Value.StartsWith("c:") && porId.TryGetValue(int.Parse(kv.Value[2..]), out var campo)
                    ? campo.Nombre
                    : nativos.Contains(imp.Encabezados[kv.Key]) ? imp.Encabezados[kv.Key] + " (Excel)" : imp.Encabezados[kv.Key]);
            var gruposPorNombre = grupos.GroupBy(g => MigracionDocumentos.Normalizar(g.Nombre)).ToDictionary(g => g.Key, g => g.First().Id);

            var carga = new CargaPlanos { NombreArchivo = imp.NombreArchivo, Hoja = imp.Hoja, FilaEncabezados = imp.FilaEncabezados, Fecha = DateTime.Now };
            Db.CargasPlanos.Add(carga);
            await Db.SaveChangesAsync();
            var origen = $"{imp.NombreArchivo} › {imp.Hoja} — {carga.Fecha:dd/MM/yyyy HH:mm}";

            // Un código es único en todo el listado (todos los grupos): si ya existe, se actualiza.
            var mapa = (await Db.PlanosMaestro.Where(p => !p.Eliminado).ToListAsync())
                .GroupBy(p => CoincidenciaPlanos.Normalizar(p.Codigo)).ToDictionary(g => g.Key, g => g.First());
            int nuevos = 0, actualizados = 0, sinGrupo = 0;
            var porFila = new List<(PlanoMaestro Plano, string[] Fila)>();
            foreach (var f in imp.Filas)
            {
                var codigo = ImportacionExcel.Celda(f, colCodigo.Value).Trim();
                if (codigo.Length == 0) continue;
                var clave = CoincidenciaPlanos.Normalizar(codigo);
                if (!mapa.TryGetValue(clave, out var p))
                {
                    p = new PlanoMaestro { Codigo = codigo, CargaPlanosId = carga.Id, GrupoPlanoId = grupoDestinoId };
                    Db.PlanosMaestro.Add(p);
                    mapa[clave] = p;
                    nuevos++;
                }
                else if (p.Id != 0) actualizados++;
                if (Val(f, "nat:Titulo") is string t) p.Titulo = t;
                if (imp.ColumnaDe("nat:Fecha") is not null) p.Fecha = Fecha(Val(f, "nat:Fecha"));
                if (Val(f, "nat:RevisionVigente") is string rv) p.RevisionVigente = rv;
                if (Val(f, "nat:Estado") is string es) p.Estado = es;
                if (Val(f, "nat:Notas") is string no) p.Notas = string.IsNullOrWhiteSpace(no) ? null : no;
                if (Val(f, "nat:RevisionAnterior") is string ra) p.RevisionAnterior = string.IsNullOrWhiteSpace(ra) ? null : ra;
                if (Val(f, "nat:Grupo") is { Length: > 0 } gr)
                {
                    if (gruposPorNombre.TryGetValue(MigracionDocumentos.Normalizar(gr), out var gid)) p.GrupoPlanoId = gid; else sinGrupo++;
                }
                else if (grupoDestinoId is not null) p.GrupoPlanoId = grupoDestinoId;
                p.Origen = origen;
                porFila.Add((p, f));
            }
            carga.FilasCreadas = nuevos;
            carga.FilasActualizadas = actualizados;
            await Db.SaveChangesAsync();

            var extras = new Dictionary<int, Dictionary<string, string>>();
            foreach (var (p, f) in porFila)
                extras[p.Id] = nombres.ToDictionary(kv => kv.Value, kv => ImportacionExcel.Celda(f, kv.Key), StringComparer.OrdinalIgnoreCase);
            if (nombres.Count > 0) await MotorTabla.GuardarExtrasExcelAsync(Db, Tabla, extras);

            mensaje = $"{nuevos} plano(s) nuevo(s), {actualizados} actualizado(s)." + (sinGrupo > 0 ? $" {sinGrupo} fila(s) con un grupo que no existe quedaron sin cambiar de grupo." : "");
            verImportar = false;
            CargarPlanos();
            motor = await MotorTabla.CargarAsync(Db, Tabla, ColumnasNativas(), FilasMotor());
        }
        catch (Exception ex) { mensaje = "No se pudo importar: " + ex.Message; error = true; }
        finally { importando = false; }
    }

    // ---------- Carga masiva de PDF ----------
