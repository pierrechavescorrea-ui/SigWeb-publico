@page "/planos"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.Documentos
@using SigWeb.Data.Planos
@using SigWeb.Data.Tablas
@using SigWeb.Models
@inject AppDbContext Db
@inject IServiceScopeFactory Scopes
@inject IWebHostEnvironment Env

@if (formArch is not null && planosPorId.TryGetValue(formArch.PlanoId, out var pfa))
{
    @* ---------- Actualizar un plano (pantalla sola): cargar hojas de una versión ---------- *@
    var actualesPfa = ArchivosPlanos.Actuales(ArchivosDe(pfa.Id)).Select(a => a.Id).ToHashSet();
    <EncabezadoPagina Titulo="@pfa.Codigo" Icono="planos" Subtitulo="@(string.IsNullOrWhiteSpace(pfa.Titulo) ? "Actualizar" : pfa.Titulo)" OnAtras="() => formArch = null">
        <Acciones>
            <button type="button" class="pg-btn" title="Cancelar" @onclick="() => formArch = null"><Ico Nombre="cancelar" /></button>
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar" disabled="@(formArch.Archivos.Count == 0 || string.IsNullOrWhiteSpace(formArch.Version) || guardando)" @onclick="GuardarArchivosPlano">
                @if (guardando) { <span class="spinner-border spinner-border-sm" role="status"></span> } else { <Ico Nombre="guardar" /> @(formArch.Archivos.Count > 0 ? formArch.Archivos.Count.ToString() : "") }
            </button>
        </Acciones>
    </EncabezadoPagina>
    <div class="card panel-formulario frm mb-3">
        <div class="card-body frm-cuerpo">
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Clase</label>
                    <select class="form-select form-select-sm" value="@((int)formArch.Clase)" @onchange="@(e => { formArch.Clase = (ClaseArchivoDocumento)int.Parse(e.Value!.ToString()!); formArch.Version = VersionSugerida(formArch.PlanoId, formArch.Clase); })">
                        @foreach (var cl in ClasesPlano) { <option value="@((int)cl)">@PanelCargaArchivos.Nombre(cl, false)</option> }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Versión</label>
                    <input class="form-control form-control-sm" @bind="formArch.Version" />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Fecha</label>
                    <input type="date" class="form-control form-control-sm" @bind="formArch.Fecha" />
                </div>
                <div class="col-md-6">
                    <label class="form-label mb-1 small">Archivos (hojas)</label>
                    <InputFile class="form-control form-control-sm" multiple accept=".pdf" OnChange="@(e => formArch.Archivos = e.GetMultipleFiles(50).ToList())" />
                </div>
            </div>
        </div>
    </div>
    @if (ArchivosDe(pfa.Id).Count > 0)
    {
        <div class="rg-bloque-tit">Archivos del plano</div>
        <div class="tabla-scroll"><table class="table table-sm table-bordered tabla-compacta align-middle mb-0">
            <thead><tr><th style="width:90px;">Versión</th><th style="width:150px;">Clase</th><th style="width:110px;">Fecha</th><th>Archivo</th></tr></thead>
            <tbody>
                @foreach (var a in ArchivosDe(pfa.Id).OrderByDescending(a => actualesPfa.Contains(a.Id)).ThenByDescending(a => a.FechaCarga))
                {
                    <tr>
                        <td class="small fw-bold">@a.Version</td>
                        <td class="small">@(actualesPfa.Contains(a.Id) ? "Vigente" : a.Clase == ClaseArchivoDocumento.Obsoleta ? "Obsoleta" : "Vigente reemplazada")</td>
                        <td class="small text-nowrap">@(a.Fecha?.ToString("dd/MM/yyyy"))</td>
                        <td class="small"><PildoraArchivo Url="@a.RutaArchivo" Nombre="@a.NombreOriginal" /></td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
}
else if (verAnterioresDe is int vaId && planosPorId.TryGetValue(vaId, out var planoVer))
{
    var actualesVer = ArchivosPlanos.Actuales(ArchivosDe(vaId)).Select(a => a.Id).ToHashSet();
    var anteriores = verTodos
        ? ArchivosDe(vaId).OrderByDescending(a => actualesVer.Contains(a.Id)).ThenByDescending(a => a.FechaCarga).ThenBy(a => a.NombreOriginal).ToList()
        : ArchivosPlanos.Anteriores(ArchivosDe(vaId));
    <EncabezadoPagina Titulo="@planoVer.Codigo" Icono="planos" Subtitulo="@($"{(verTodos ? "Todos los archivos" : "Obsoletos")} ({anteriores.Count})")" OnAtras="() => verAnterioresDe = null" />
    <div class="tabla-scroll tabla-auto"><table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin">
        <thead>
            <tr><th>Versión</th><th>Clase</th><th>Fecha</th><th>Archivo</th><th>Cargado</th><th style="width:130px;"></th></tr>
        </thead>
        <tbody>
            @foreach (var a in anteriores)
            {
                <tr>
                    <td class="small fw-bold">@a.Version</td>
                    <td class="small">@(actualesVer.Contains(a.Id) ? "Vigente" : a.Clase == ClaseArchivoDocumento.Obsoleta ? "Obsoleta" : "Vigente reemplazada")</td>
                    <td class="small text-nowrap">@(a.Fecha?.ToString("dd/MM/yyyy"))</td>
                    <td class="small">@a.NombreOriginal</td>
                    <td class="small text-nowrap text-muted">@a.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-nowrap">
                        <a class="ens-mini" href="@a.RutaArchivo" target="_blank" rel="noopener" title="Ver"><Ico Nombre="ubicar" /></a>
                        <a class="ens-mini" href="@a.RutaArchivo" download="@a.NombreOriginal" title="Descargar"><Ico Nombre="importar" /></a>
                        <button type="button" class="ens-mini" title="Reemplazar archivo" @onclick="() => AbrirReemplazo(a)"><Ico Nombre="editar" /></button>
                        <button type="button" class="ens-mini" title="Eliminar archivo" @onclick="() => PedirEliminarArchivo(a)"><Ico Nombre="eliminar" /></button>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
}
else
{
<div class="planos-listado @(pantallaCompleta ? "ens-pantalla" : "")">
<EncabezadoPagina Titulo="Listado maestro de planos" Icono="planos" Subtitulo="@($"{planos.Count} plano{(planos.Count == 1 ? "" : "s")}")" OnAtras="AtrasPantalla">
    <Acciones>
        <button type="button" class="pg-btn @(pantallaCompleta ? "activo" : "")" title="@(pantallaCompleta ? "Salir de pantalla completa" : "Pantalla completa")" @onclick="() => pantallaCompleta = !pantallaCompleta"><Ico Nombre="pantalla-completa" /></button>
        <button type="button" class="pg-btn @(verCargas ? "activo" : "")" title="@($"Cargas: {cargas.Count} de listado, {cargasArchivos.Count} de archivos")" @onclick="AlternarCargas"><Ico Nombre="cargas" />@(cargas.Count + cargasArchivos.Count > 0 ? $" {cargas.Count + cargasArchivos.Count}" : "")</button>
        <span class="pg-sep"></span>
        <BotonCampos Activo="verCampos" Deshabilitado="motor is null" OnClick="() => verCampos = true" />
        <button type="button" class="pg-btn @(verImportar ? "activo" : "")" title="Importar listado (Excel)" disabled="@(motor is null)" @onclick="() => AbrirExcel(grupoSelId)"><Ico Nombre="cargar-excel" /></button>
        <button type="button" class="pg-btn @(verLote ? "activo" : "")" title="Cargar planos (PDF)" disabled="@(motor is null)" @onclick="() => AbrirPdfs(grupoSelId)"><Ico Nombre="cargar-pdf" /></button>
        <BotonExportar Titulo="Listado maestro de planos" Selector="table.tabla-planos" />
        <span class="pg-sep"></span>
        <button type="button" class="pg-btn pg-btn-primario @(mostrarFormGrupo ? "activo" : "")" title="Nuevo grupo de planos" @onclick="AlternarFormGrupo"><Ico Nombre="agregar" /></button>
    </Acciones>
</EncabezadoPagina>

@if (verCampos && motor is not null)
{
    <PanelCampos Motor="motor" OnCerrar="() => verCampos = false" OnCambio="StateHasChanged" />
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(error ? "alert-warning" : "alert-success") py-1">@mensaje</div>
}

@* ---------- Cargas: Excel del listado y archivos ---------- *@
@if (verCargas)
{
    <div class="card panel-formulario mb-3">
        <div class="card-body">
            <div class="btn-group btn-group-sm mb-2" role="group">
                <button type="button" class="btn @(pestanaCargas == "listado" ? "btn-dark" : "btn-outline-secondary")" title="Bases de datos Excel del listado" @onclick='() => { pestanaCargas = "listado"; elimCargas = null; }'><Ico Nombre="listado" /> @cargas.Count</button>
                <button type="button" class="btn @(pestanaCargas == "archivos" ? "btn-dark" : "btn-outline-secondary")" title="Cargas de archivos" @onclick='() => { pestanaCargas = "archivos"; elimCargas = null; }'><Ico Nombre="adjuntar" /> @cargasArchivos.Count</button>
            </div>
            @if (pestanaCargas == "listado")
            {
                if (cargas.Count == 0) { <div class="text-muted small">—</div> }
                else
                {
                    <div class="tabla-scroll mb-2" style="max-height:280px;">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width:32px;"><input type="checkbox" class="form-check-input" title="Todas" checked="@(cargasSel.Count == cargas.Count)" @onchange="@(e => { cargasSel = (bool)e.Value! ? cargas.Select(c => c.Id).ToHashSet() : new(); elimCargas = null; })" /></th>
                                    <th>Archivo</th><th>Hoja</th><th>Fecha</th>
                                    <th title="Planos de esta carga">Pl.</th><th title="Filas de otras cargas actualizadas por código">Act.</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in cargas)
                                {
                                    var id = c.Id;
                                    <tr class="@(cargaFiltro == id ? "table-active" : "")">
                                        <td><input type="checkbox" class="form-check-input" checked="@cargasSel.Contains(id)" @onchange="@(e => { if ((bool)e.Value!) cargasSel.Add(id); else cargasSel.Remove(id); elimCargas = null; })" /></td>
                                        <td class="small">@c.NombreArchivo</td>
                                        <td class="small">@c.Hoja</td>
                                        <td class="small text-nowrap">@c.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="small text-end">@(planosPorCarga.TryGetValue(id, out var n) ? n : 0)</td>
                                        <td class="small text-end">@c.FilasActualizadas</td>
                                        <td><button type="button" class="ens-mini @(cargaFiltro == id ? "activo" : "")" title="Ver solo esta carga" @onclick="() => cargaFiltro = cargaFiltro == id ? null : id"><Ico Nombre="ubicar" /></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-danger btn-sm" title="@($"Eliminar cargas seleccionadas ({cargasSel.Count})")" disabled="@(cargasSel.Count == 0)" @onclick='() => PedirEliminarCargas("listado")'><Ico Nombre="eliminar" /> @cargasSel.Count</button>
                    </div>
                }
            }
            else
            {
                if (cargasArchivos.Count == 0) { <div class="text-muted small">—</div> }
                else
                {
                    <div class="tabla-scroll mb-2" style="max-height:320px;">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width:32px;"><input type="checkbox" class="form-check-input" title="Todas" checked="@(cargasArchSel.Count == cargasArchivos.Count)" @onchange="@(e => { cargasArchSel = (bool)e.Value! ? cargasArchivos.Select(c => c.Id).ToHashSet() : new(); elimCargas = null; })" /></th>
                                    <th>Fecha</th><th>Origen</th><th>Descripción</th><th title="Archivos">Arch.</th><th title="Planos">Pl.</th>
                                    <th style="width:70px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in cargasArchivos)
                                {
                                    var id = c.Id;
                                    var lista = archivosPorCarga.TryGetValue(id, out var l) ? l : new List<ArchivoPlanoMaestro>();
                                    <tr class="@(cargaArchFiltro == id ? "table-active" : "")">
                                        <td><input type="checkbox" class="form-check-input" checked="@cargasArchSel.Contains(id)" @onchange="@(e => { if ((bool)e.Value!) cargasArchSel.Add(id); else cargasArchSel.Remove(id); elimCargas = null; })" /></td>
                                        <td class="small text-nowrap">@c.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="small">@c.Origen</td>
                                        <td class="small">@c.Descripcion</td>
                                        <td class="small text-end">@lista.Count</td>
                                        <td class="small text-end">@lista.Select(a => a.PlanoMaestroId).Distinct().Count()</td>
                                        <td class="text-nowrap">
                                            <button type="button" class="ens-mini @(cargaArchAbierta == id ? "activo" : "")" title="Archivos de esta carga" @onclick="() => cargaArchAbierta = cargaArchAbierta == id ? null : id"><Ico Nombre="listado" /></button>
                                            <button type="button" class="ens-mini @(cargaArchFiltro == id ? "activo" : "")" title="Ver solo sus planos" @onclick="() => cargaArchFiltro = cargaArchFiltro == id ? null : id"><Ico Nombre="ubicar" /></button>
                                        </td>
                                    </tr>
                                    if (cargaArchAbierta == id)
                                    {
                                        <tr>
                                            <td></td>
                                            <td colspan="6" class="p-0">
                                                <table class="table table-sm mb-0 doc-sub">
                                                    @foreach (var a in lista.OrderBy(a => CodigoPlano(a.PlanoMaestroId)))
                                                    {
                                                        <tr>
                                                            <td class="small fw-bold">@CodigoPlano(a.PlanoMaestroId)</td>
                                                            <td class="small">@(a.Clase == ClaseArchivoDocumento.Obsoleta ? "Obsoleta" : "Vigente")</td>
                                                            <td class="small">@(string.IsNullOrWhiteSpace(a.Version) ? "" : "v" + a.Version)</td>
                                                            <td class="small">@a.NombreOriginal</td>
                                                            <td class="text-nowrap"><a class="ens-mini" href="@a.RutaArchivo" target="_blank" rel="noopener" title="Ver"><Ico Nombre="ubicar" /></a></td>
                                                        </tr>
                                                    }
                                                </table>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-danger btn-sm" title="@($"Eliminar cargas de archivos seleccionadas ({cargasArchSel.Count})")" disabled="@(cargasArchSel.Count == 0)" @onclick='() => PedirEliminarCargas("archivos")'><Ico Nombre="eliminar" /> @cargasArchSel.Count</button>
                    </div>
                }
            }
            @if (elimCargas is not null)
            {
                <div class="border border-danger rounded p-2 mt-2">
                    <PanelImpacto Informe="impactoCargas" OnEntendido="@(v => impactoCargasOk = v)" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => elimCargas = null"><Ico Nombre="cancelar" /></button>
                        <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@BloqueadoCargas" @onclick="ConfirmarEliminarCargas"><Ico Nombre="eliminar" /></button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* ---------- Importar listado (Excel) ---------- *@
@if (verImportar && motor is not null)
{
    <PanelImportarExcel Destinos="DestinosImportacion" Importando="importando" OnImportar="Importar" OnCancelar="() => verImportar = false">
        <Extra>
            <span class="rg-chip" title="Grupo de los planos nuevos"><Ico Nombre="carpeta" /> @NombreDestino</span>
        </Extra>
    </PanelImportarExcel>
}

@* ---------- Carga masiva de PDF ---------- *@
@if (verLote)
{
    <PanelCargaArchivos Indice="indice" Clases="ClasesPlano" VersionSugerida="VersionSugerida" Accept=".pdf" TituloFila="Plano"
                        Cargando="cargandoLote" OnCargar="CargarLote" OnCancelar="() => verLote = false" />
}

@if (mostrarFormGrupo)
{
    <div class="mb-3">
        <div>
            <div class="frm-linea mb-0">
                <button type="button" class="frm-icono-btn" title="Elegir ícono" @onclick="@(() => mostrarSelectorIconoGrupo = !mostrarSelectorIconoGrupo)">
                    <img src="@RutaIcono(grupoActual.IconoCatalogoId)" alt="" />
                </button>
                <CampoFormulario Etiqueta="@(modoEdicionGrupo ? "Editar grupo" : "Nuevo grupo")" Ancho="" Obligatorio="true" Destacado="true">
                    <input class="form-control" @bind="grupoActual.Nombre" placeholder="Estructural" />
                </CampoFormulario>
                <div class="frm-linea-btns">
                    <button class="btn btn-secondary btn-sm" type="button" @onclick="CerrarFormGrupo" title="Cancelar"><Ico Nombre="cancelar" /></button>
                    <button class="btn btn-primary btn-sm" type="button" @onclick="GuardarGrupo" title="@(modoEdicionGrupo ? "Guardar" : "Agregar")"><Ico Nombre="@(modoEdicionGrupo ? "guardar" : "agregar")" /></button>
                </div>
            </div>
            @if (mostrarSelectorIconoGrupo)
            {
                <SelectorIconos Iconos="iconosDisponibles" IconoSeleccionadoId="grupoActual.IconoCatalogoId" PermitirNinguno="false"
                                OnSeleccionar="@(id => { grupoActual.IconoCatalogoId = id; mostrarSelectorIconoGrupo = false; })" />
            }
            @if (!string.IsNullOrEmpty(mensajeGrupo))
            {
                <div class="alert alert-warning py-1 mt-2 mb-0">@mensajeGrupo</div>
            }
        </div>
    </div>
}

@if (elimGrupo is not null)
{
    <div class="card panel-formulario mb-3 border-danger">
        <div class="card-body">
            <div class="mb-2"><Ico Nombre="eliminar" /> <strong>@elimGrupo.Nombre</strong></div>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2">
                <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="CancelarEliminarGrupo"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@BloqueadoPorImpacto" @onclick="ConfirmarEliminarGrupo"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}

<div class="ens-grid mb-3">
    <div class="ens-cuadro @(grupoSelId is null ? "activo" : "")" role="button" title="Todos" @onclick="SeleccionarTodos">
        <img src="images/iconos/documento.svg" alt="" />
        <div class="ens-nombre">Todos</div>
        <div class="ens-cuenta">@planos.Count</div>
        <div class="ens-acc-pie">
            <button type="button" class="ens-mini" title="Importar listado (Excel)" @onclick:stopPropagation="true" @onclick="() => AbrirExcel(null)"><Ico Nombre="cargar-excel" /></button>
            <button type="button" class="ens-mini" title="Cargar planos (PDF)" @onclick:stopPropagation="true" @onclick="() => AbrirPdfs(null)"><Ico Nombre="cargar-pdf" /></button>
        </div>
    </div>
    @foreach (var g in grupos)
    {
        <div class="ens-cuadro @(grupoSelId == g.Id ? "activo" : "")" role="button" title="@g.Nombre" @onclick="() => SeleccionarGrupo(g)">
            <div class="ens-acc">
                <button type="button" class="ens-mini" title="Editar grupo" @onclick:stopPropagation="true" @onclick="() => EditarGrupo(g)"><Ico Nombre="editar" /></button>
                <button type="button" class="ens-mini" title="Eliminar grupo" @onclick:stopPropagation="true" @onclick="() => PedirEliminarGrupo(g)"><Ico Nombre="eliminar" /></button>
            </div>
            <img src="@RutaIcono(g.IconoCatalogoId)" alt="" />
            <div class="ens-nombre">@g.Nombre</div>
            <div class="ens-cuenta">@(conteoGrupos.TryGetValue(g.Id, out var n) ? n : 0)</div>
            <div class="ens-acc-pie">
                <button type="button" class="ens-mini" title="Importar listado (Excel)" @onclick:stopPropagation="true" @onclick="() => AbrirExcel(g.Id)"><Ico Nombre="cargar-excel" /></button>
                <button type="button" class="ens-mini" title="Cargar planos (PDF)" @onclick:stopPropagation="true" @onclick="() => AbrirPdfs(g.Id)"><Ico Nombre="cargar-pdf" /></button>
            </div>
        </div>
    }
</div>

<div class="mpie-barra mb-2">
    <input class="form-control form-control-sm" style="max-width:260px;" placeholder="Buscar plano..." @bind="filtro" @bind:event="oninput" />
    @if (cargaFiltro is int cf && cargas.FirstOrDefault(c => c.Id == cf) is { } cg)
    {
        <span class="rg-chip"><Ico Nombre="cargas" /> @cg.NombreArchivo <button type="button" class="rg-chip-x" title="Quitar" @onclick="() => cargaFiltro = null">✕</button></span>
    }
    @if (cargaArchFiltro is int caf && cargasArchivos.FirstOrDefault(c => c.Id == caf) is { } ca)
    {
        <span class="rg-chip"><Ico Nombre="adjuntar" /> @ca.Origen @ca.Fecha.ToString("dd/MM HH:mm") <button type="button" class="rg-chip-x" title="Quitar" @onclick="() => cargaArchFiltro = null">✕</button></span>
    }
</div>

<div class="tabla-scroll tabla-auto"><table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin tabla-planos">
    <thead>
        <tr>
            @foreach (var c in ColumnasVisibles)
            {
                <th class="th-ordenable" @onclick="() => OrdenarPor(c.Clave)">@c.Nombre@(Flecha(c.Clave))</th>
            }
            <th style="width:80px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in PlanosFiltrados)
        {
            var plano = p;
            <tr>
                @foreach (var c in ColumnasVisibles)
                {
                    if (c.Origen == OrigenCampoTabla.Nativo && c.Clave == "Codigo")
                    {
                        <td class="small fw-bold">@CeldaCodigo(plano)</td>
                    }
                    else if (c.Origen == OrigenCampoTabla.Nativo && c.Clave == "Grupo")
                    {
                        <td class="small">
                            <select class="form-select form-select-sm sel-grupo-plano" value="@(plano.GrupoPlanoId?.ToString() ?? "")" title="Grupo" @onchange="e => CambiarGrupoPlano(plano, e)">
                                <option value="">—</option>
                                @foreach (var g in grupos) { <option value="@g.Id">@g.Nombre</option> }
                            </select>
                        </td>
                    }
                    else
                    {
                        <CeldaCampo Motor="motor!" Campo="c" Fila="plano.Id" OnCambio="StateHasChanged" />
                    }
                }
                <td class="text-nowrap text-end">
                    <button type="button" class="ens-mini" title="Actualizar" @onclick="() => AbrirArchivosPlano(plano)"><Ico Nombre="nueva-version" /></button>
                    <button type="button" class="btn btn-sm btn-outline-danger py-0" title="Eliminar (va a la Papelera)" @onclick="() => PedirEliminar(plano)"><Ico Nombre="eliminar" /></button>
                </td>
            </tr>
        }
    </tbody>
</table></div>
@MenuCodigo()
</div>
}

