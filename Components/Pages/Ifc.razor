        [JsonPropertyName("lista_materiales")] public List<FilaLista> ListaMateriales { get; set; } = new();
    }
    private sealed class MetaJ
    {
        [JsonPropertyName("plano_base")] public string? PlanoBase { get; set; }
    }
    private sealed class MiembroJ
    {
        [JsonPropertyName("id")] public string Id { get; set; } = "";
        [JsonPropertyName("fuente")] public string? Fuente { get; set; }
        [JsonPropertyName("plano")] public PlanoJ? Plano { get; set; }
        [JsonPropertyName("marcas")] public List<string>? Marcas { get; set; }
        [JsonPropertyName("a")] public double[]? A { get; set; }
        [JsonPropertyName("b")] public double[]? B { get; set; }
        [JsonPropertyName("tipo")] public string? Tipo { get; set; }
        [JsonPropertyName("cara")] public string? Cara { get; set; }
    }
    private sealed class PlanoJ
    {
        [JsonPropertyName("codigo")] public string Codigo { get; set; } = "";
        [JsonPropertyName("hoja")] public int Hoja { get; set; }
        [JsonPropertyName("titulo")] public string? Titulo { get; set; }
    }
    private sealed class FilaLista
    {
        [JsonPropertyName("hoja")] public int Hoja { get; set; }
        [JsonPropertyName("hoja_txt")] public string? HojaTxt { get; set; }
        [JsonPropertyName("clase")] public string Clase { get; set; } = "";
        [JsonPropertyName("marca")] public string Marca { get; set; } = "";
        [JsonPropertyName("perfil")] public string Perfil { get; set; } = "";
        [JsonPropertyName("long_mm")] public string LongMm { get; set; } = "";
        [JsonPropertyName("cant")] public string Cant { get; set; } = "";
        [JsonPropertyName("acero")] public string Acero { get; set; } = "";
        [JsonPropertyName("conjunto")] public string Conjunto { get; set; } = "";
    }
