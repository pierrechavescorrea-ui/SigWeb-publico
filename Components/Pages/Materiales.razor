    private async Task AgregarUbicacion(int materialId)
    {
        var torre = lugares.TorrePorCodigo(torreTexto);
        var u = new UbicacionMaterial { MaterialId = materialId };
        if (tipoLugar == "tiro") u.TiroId = tiroSel;
        else { u.ElementoTrazadoId = torre?.Id; if (tipoLugar == "elemento") u.ComponenteId = elementoSel; }
        if (u.TiroId is null && u.ElementoTrazadoId is null) return;
        if (UbicacionesDe(materialId).Any(x => x.TiroId == u.TiroId && x.ElementoTrazadoId == u.ElementoTrazadoId && x.ComponenteId == u.ComponenteId))
        { mensajeUbic = "Ya está en esa ubicación."; return; }
        try
        {
            Db.UbicacionesMaterial.Add(u);
            await Db.SaveChangesAsync();
            torreTexto = ""; elementoSel = null; tiroSel = null; mensajeUbic = "";
            var abierto = menuUbic;
            CargarLista();
            menuUbic = abierto;
        }
        catch (Exception ex) { mensajeUbic = "No se pudo guardar (¿falta aplicar la migración?): " + ex.Message; }
    }

    private async Task QuitarUbicacion(UbicacionMaterial u)
    {
        var ent = await Db.UbicacionesMaterial.FirstOrDefaultAsync(x => x.Id == u.Id);
        if (ent is not null) { Db.UbicacionesMaterial.Remove(ent); await Db.SaveChangesAsync(); }
        var abierto = menuUbic;
        CargarLista();
        menuUbic = abierto;
    }

    // ---------- Cargar adjuntos ----------
    private sealed class ArchivoAdj
    {
        public IBrowserFile Archivo = null!;
        public string Clase = AdjuntoMaterial.Otros;
    }

    private sealed class CargaAdj
    {
        public int MaterialId;
        public string Clase = AdjuntoMaterial.Remision;
        public List<ArchivoAdj> Archivos = new();
    }

    private CargaAdj? cargaAdj;
    private string mensajeAdj = "";

    private void AbrirCargaAdjuntos(int id) => AbrirCargaAdjuntos(id, AdjuntoMaterial.Remision);

    private void AbrirCargaAdjuntos(int id, string clase) { menuAdj = null; reemplazo = null; elimAdjunto = null; mensajeAdj = ""; cargaAdj = new CargaAdj { MaterialId = id, Clase = clase }; }

    private void CambiarClaseCarga(string clase)
    {
        if (cargaAdj is null) return;
        cargaAdj.Clase = clase;
        foreach (var a in cargaAdj.Archivos) a.Clase = clase;
    }

    // Cada archivo toma la clase elegida arriba; se puede cambiar por archivo.
    private void SeleccionarAdjuntos(InputFileChangeEventArgs e)
    {
        if (cargaAdj is null) return;
        foreach (var f in e.GetMultipleFiles(100))
        {
            if (cargaAdj.Archivos.Any(x => x.Archivo.Name == f.Name && x.Archivo.Size == f.Size)) continue;
            cargaAdj.Archivos.Add(new ArchivoAdj { Archivo = f, Clase = cargaAdj.Clase });
        }
    }

    private async Task<string> GuardarArchivo(IBrowserFile archivo)
    {
        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "materiales");
        Directory.CreateDirectory(carpeta);
        var nombre = $"{Guid.NewGuid()}{Path.GetExtension(archivo.Name)}";
        await using (var s = archivo.OpenReadStream(MaxArchivo))
        await using (var destino = File.Create(Path.Combine(carpeta, nombre)))
            await s.CopyToAsync(destino);
        return $"/uploads/materiales/{nombre}";
    }

    private async Task GuardarAdjuntos()
    {
        if (cargaAdj is null) return;
        guardando = true; mensajeAdj = "";
        int ok = 0; var fallos = new List<string>();
        try
        {
            var momento = DateTime.Now;
            foreach (var a in cargaAdj.Archivos)
            {
                if (a.Archivo.Size > MaxArchivo) { fallos.Add($"{a.Archivo.Name} (supera 50 MB)"); continue; }
                try
                {
                    var ruta = await GuardarArchivo(a.Archivo);
                    momento = momento.AddMilliseconds(10);
                    Db.AdjuntosMaterial.Add(new AdjuntoMaterial { MaterialId = cargaAdj.MaterialId, Clase = a.Clase, NombreOriginal = a.Archivo.Name, RutaArchivo = ruta, FechaCarga = momento });
                    await Db.SaveChangesAsync();
                    ok++;
                }
                catch (Exception ex) { fallos.Add($"{a.Archivo.Name} ({ex.Message})"); }
            }
            mensaje = $"{ok} adjunto(s) cargado(s)." + (fallos.Count > 0 ? " No se cargaron: " + string.Join("; ", fallos) : "");
            error = fallos.Count > 0;
            cargaAdj = null;
            CargarLista();
        }
        finally { guardando = false; }
    }

    // ---------- Editar / eliminar un adjunto ----------
    private AdjuntoMaterial? reemplazo, elimAdjunto;
    private IBrowserFile? archivoReemplazo;
    private string claseReemplazo = AdjuntoMaterial.Otros;
    private SigWeb.Data.Impacto.InformeImpacto? impactoAdj;
    private bool impactoAdjOk;

    private void AbrirReemplazo(AdjuntoMaterial a)
    {
        menuAdj = null; elimAdjunto = null; cargaAdj = null; reemplazo = a; archivoReemplazo = null; claseReemplazo = a.Clase; mensajeAdj = "";
    }

    // Mismo registro; cambia el archivo (el anterior se borra del disco) y/o la clase.
    private async Task Reemplazar()
    {
        if (reemplazo is null) return;
        if (archivoReemplazo is not null && archivoReemplazo.Size > MaxArchivo) { mensajeAdj = "El archivo supera 50 MB."; return; }
        guardando = true;
        try
        {
            var ent = await Db.AdjuntosMaterial.FirstAsync(x => x.Id == reemplazo.Id);
            ent.Clase = claseReemplazo;
            string? anterior = null;
            if (archivoReemplazo is not null)
            {
                anterior = ent.RutaArchivo;
                ent.RutaArchivo = await GuardarArchivo(archivoReemplazo);
                ent.NombreOriginal = archivoReemplazo.Name;
            }
            await Db.SaveChangesAsync();
            SigWeb.Data.Papelera.ProveedorPapeleraAdjuntosMaterial.BorrarFisico(Env, anterior);
            mensaje = $"Adjunto actualizado: {ent.NombreOriginal}."; error = false;
            reemplazo = null;
            CargarLista();
        }
        catch (Exception ex) { mensajeAdj = "No se pudo guardar: " + ex.Message; }
        finally { guardando = false; }
    }

    private void PedirEliminarAdjunto(AdjuntoMaterial a)
    {
        menuAdj = null; reemplazo = null; cargaAdj = null; elimAdjunto = a; impactoAdj = null; impactoAdjOk = false;
        _ = CalcularImpactoAdjunto(a.Id);
    }

    private async Task CalcularImpactoAdjunto(int id)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            impactoAdj = await scope.ServiceProvider.GetRequiredService<SigWeb.Data.Impacto.AnalizadorImpacto>().AdjuntoDeMaterial(id);
        }
        catch { impactoAdj = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmarEliminarAdjunto()
    {
        if (elimAdjunto is null) return;
        var ent = await Db.AdjuntosMaterial.FirstOrDefaultAsync(x => x.Id == elimAdjunto.Id);
        if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
        mensaje = $"Adjunto {elimAdjunto.NombreOriginal} enviado a la Papelera."; error = false;
        elimAdjunto = null;
        CargarLista();
    }

    // ---------- Edición de la tabla (solo con Editar; nada se guarda hasta Guardar) ----------
    private bool modoEdicion;
    private Dictionary<(int Fila, int Campo), string?> cambios = new();

    private string? ValorActual(int fila, CampoTabla c) => motor?.Registro(fila, c)?.Valor;
    private string? ValorEdicion(int fila, CampoTabla c) => cambios.TryGetValue((fila, c.Id), out var v) ? v : ValorActual(fila, c);

    private void Cambiar(int fila, CampoTabla c, string? valor)
    {
        valor = string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();
        if ((valor ?? "") == (ValorActual(fila, c) ?? "")) cambios.Remove((fila, c.Id));
        else cambios[(fila, c.Id)] = valor;
    }

    private void EntrarEdicion()
    {
        modoEdicion = true; cambios.Clear(); menuAdj = null; menuUbic = null;
        mostrarImportar = false; verCargas = false; form = null; elimId = null; verCampos = false; mensaje = "";
    }

    private void SalirEdicion() { modoEdicion = false; cambios.Clear(); }

    private async Task GuardarEdicion()
    {
        if (motor is null || cambios.Count == 0) return;
        guardando = true;
        try
        {
            var porId = motor.Campos.ToDictionary(c => c.Id);
            var filas = cambios.Keys.Select(k => k.Fila).Distinct().Count();
            foreach (var ((fila, campoId), valor) in cambios.ToList())
                if (porId.TryGetValue(campoId, out var campo)) await motor.GuardarValorAsync(Db, fila, campo, valor);
            mensaje = $"{cambios.Count} cambio(s) guardado(s) en {filas} material(es)."; error = false;
            modoEdicion = false; cambios.Clear();
            CargarLista();
        }
        catch (Exception ex) { mensaje = "No se pudo guardar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    // ---------- Nuevo material ----------
    private Dictionary<int, string?>? form;

    private void Nuevo()
    {
        if (form is not null) { form = null; return; }
        mostrarImportar = false; verCargas = false; elimId = null; mensaje = "";
        form = new();
    }

    private async Task GuardarNuevo()
    {
        if (form is null || motor is null) return;
        guardando = true;
        try
        {
            var ent = new Material { Fecha = DateTime.Now, EnCampos = true };
            Db.Materiales.Add(ent);
            await Db.SaveChangesAsync();
            foreach (var c in CamposEditables.ToList())
                if (form.TryGetValue(c.Id, out var v) && !string.IsNullOrWhiteSpace(v))
                    await motor.GuardarValorAsync(Db, ent.Id, c, v);
            selId = ent.Id;
            form = null;
            CargarLista();
        }
        catch (Exception ex) { mensaje = "No se pudo guardar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    // ---------- Eliminar material (Papelera, con sus adjuntos) ----------
    private int? elimId;
    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;

    private void PedirEliminar(int? id)
    {
        if (id is not int i) return;
        form = null; mostrarImportar = false; elimId = i; impacto = null; impactoOk = false;
        _ = CalcularImpacto(i);
    }

    private async Task CalcularImpacto(int id)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            impacto = await scope.ServiceProvider.GetRequiredService<SigWeb.Data.Impacto.AnalizadorImpacto>().Material(id);
        }
        catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmarEliminar()
    {
        if (elimId is not int id) return;
        var titulo = TituloDe(id);
        var m = await Db.Materiales.FirstOrDefaultAsync(x => x.Id == id);
        if (m is not null) { m.Eliminado = true; m.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
        mensaje = $"{titulo} enviado a la Papelera."; error = false;
        elimId = null; selId = null;
        CargarLista();
    }

    // ---------- Cargas (bases de datos Excel) ----------
    private bool verCargas, mostrarImportar, importando;
    private List<CargaMateriales> cargasMat = new();
    private Dictionary<int, int> materialesPorCarga = new();
    private HashSet<int> cargasSel = new();
    private List<int>? elimCargas;
    private SigWeb.Data.Impacto.InformeImpacto? impactoCargas;
    private bool impactoCargasOk;

    private void AlternarCargas() { verCargas = !verCargas; mostrarImportar = false; elimCargas = null; }
    private void AlternarImportar() { mostrarImportar = !mostrarImportar; verCargas = false; form = null; mensaje = ""; }

    private void PedirEliminarCargas()
    {
        if (cargasSel.Count == 0) return;
        elimCargas = cargasSel.ToList(); impactoCargas = null; impactoCargasOk = false;
        _ = CalcularImpactoCargas(elimCargas);
    }

    private async Task CalcularImpactoCargas(List<int> ids)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            impactoCargas = await scope.ServiceProvider.GetRequiredService<SigWeb.Data.Impacto.AnalizadorImpacto>().CargasMateriales(ids);
        }
        catch { impactoCargas = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmarEliminarCargas()
    {
        if (elimCargas is null) return;
        var ids = elimCargas;
        // Misma marca de tiempo para la carga y sus materiales: la Papelera los restaura juntos.
        var ahora = DateTime.Now; ahora = new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, ahora.Minute, ahora.Second);
        foreach (var c in await Db.CargasMateriales.Where(c => ids.Contains(c.Id)).ToListAsync()) { c.Eliminado = true; c.FechaEliminacion = ahora; }
        int n = 0;
        foreach (var m in await Db.Materiales.Where(m => !m.Eliminado && m.CargaMaterialesId != null && ids.Contains(m.CargaMaterialesId.Value)).ToListAsync())
        { m.Eliminado = true; m.FechaEliminacion = ahora; n++; }
        await Db.SaveChangesAsync();
        mensaje = $"{ids.Count} carga(s) y {n} material(es) enviados a la Papelera."; error = false;
        elimCargas = null; cargasSel.Clear();
        CargarLista();
    }

    // ---------- Importar listado (Excel), igual que Documentos ----------
    // Cada columna del Excel va a una columna existente del listado o a una nueva con su encabezado.
    private IReadOnlyList<DestinoColumna> DestinosImportacion =>
        CamposEditables.Select(c => new DestinoColumna($"c:{c.Id}", c.Nombre)).ToList();

    private async Task ImportarExcel(ImportacionExcel imp)
    {
        mensaje = "";
        if (imp.Filas.Count == 0) { mensaje = "No hay filas con datos para importar."; error = true; return; }
        importando = true;
        try
        {
            var carga = new CargaMateriales { NombreArchivo = imp.NombreArchivo, Hoja = imp.Hoja, FilaEncabezados = imp.FilaEncabezados, Fecha = DateTime.Now, FilasCreadas = imp.Filas.Count };
            Db.CargasMateriales.Add(carga);
            await Db.SaveChangesAsync();
            var nuevos = imp.Filas.Select(f => (M: new Material { Fecha = DateTime.Now, EnCampos = true, CargaMaterialesId = carga.Id }, F: f)).ToList();
            Db.Materiales.AddRange(nuevos.Select(x => x.M));
            await Db.SaveChangesAsync();

            // A la columna existente elegida (toma su nombre) o a una nueva con el encabezado del Excel
            // (si se llamaría como la columna propia "Adjuntos", se marca "(Excel)").
            var porId = (motor?.Campos ?? new()).ToDictionary(c => c.Id);
            var nombres = imp.Destinos.ToDictionary(kv => kv.Key, kv => kv.Value.StartsWith("c:") && porId.TryGetValue(int.Parse(kv.Value[2..]), out var campo)
                ? campo.Nombre
                : string.Equals(imp.Encabezados[kv.Key], ColAdjuntos, StringComparison.OrdinalIgnoreCase) ? imp.Encabezados[kv.Key] + " (Excel)" : imp.Encabezados[kv.Key]);
            Db.ChangeTracker.Clear();
            var extras = nuevos.ToDictionary(x => x.M.Id, x => nombres.ToDictionary(kv => kv.Value, kv => ImportacionExcel.Celda(x.F, kv.Key), StringComparer.OrdinalIgnoreCase));
            await MotorTabla.GuardarExtrasExcelAsync(Db, Tabla, extras);
            mensaje = $"{nuevos.Count} material(es) importado(s)."; error = false;
            mostrarImportar = false;
            CargarLista();
        }
        catch (Exception ex) { mensaje = "No se pudo importar: " + ex.Message; error = true; }
        finally { importando = false; }
    }
}
