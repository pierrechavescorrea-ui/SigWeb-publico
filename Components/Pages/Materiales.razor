@page "/materiales"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using SigWeb.Data
@using SigWeb.Models
@using SigWeb.Data.Tablas
@using SigWeb.Data.Documentos
@inject AppDbContext Db
@inject IServiceScopeFactory Scopes
@inject IWebHostEnvironment Env

@* Listado de materiales (16/10/2026): sus columnas son Campos (importados del Excel o creados a mano)
   más la propia "Adjuntos" (Remisión, Certificado, Registro fotográfico, Otros). Solo lectura hasta Editar. *@

@if (verTodosDe is int vtId && materiales.FirstOrDefault(x => x.Id == vtId) is { } matVer)
{
    var todos = AdjuntosDe(vtId).OrderBy(a => Array.IndexOf(AdjuntoMaterial.Clases, a.Clase)).ToList();
    <EncabezadoPagina Titulo="@TituloDe(matVer.Id)" Icono="materiales" Subtitulo="@($"Adjuntos ({todos.Count})")" OnAtras="() => verTodosDe = null">
        <Acciones>
            <button type="button" class="pg-btn pg-btn-primario" title="Cargar adjuntos" @onclick="() => AbrirCargaAdjuntos(vtId)"><Ico Nombre="adjuntar" /></button>
        </Acciones>
    </EncabezadoPagina>
    <div class="tabla-scroll tabla-auto"><table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin">
        <thead>
            <tr><th>Clase</th><th>Archivo</th><th>Cargado</th><th style="width:130px;"></th></tr>
        </thead>
        <tbody>
            @foreach (var a in todos)
            {
                var adj = a;
                <tr>
                    <td class="small">@adj.Clase</td>
                    <td class="small">@adj.NombreOriginal</td>
                    <td class="small text-nowrap text-muted">@adj.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-nowrap">
                        <a class="ens-mini" href="@adj.RutaArchivo" target="_blank" rel="noopener" title="Ver"><Ico Nombre="ubicar" /></a>
                        <a class="ens-mini" href="@adj.RutaArchivo" download="@adj.NombreOriginal" title="Descargar"><Ico Nombre="importar" /></a>
                        <button type="button" class="ens-mini" title="Editar (reemplazar archivo o clase)" @onclick="() => AbrirReemplazo(adj)"><Ico Nombre="editar" /></button>
                        <button type="button" class="ens-mini" title="Eliminar adjunto" @onclick="() => PedirEliminarAdjunto(adj)"><Ico Nombre="eliminar" /></button>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
}
else
{
<div class="@(pantallaCompleta ? "ens-pantalla" : "")">
<EncabezadoPagina Titulo="Materiales" Icono="materiales" Subtitulo="@($"{materiales.Count} material{(materiales.Count == 1 ? "" : "es")}")" OnAtras="AtrasPantalla">
    <Acciones>
        <button type="button" class="pg-btn @(pantallaCompleta ? "activo" : "")" title="@(pantallaCompleta ? "Salir de pantalla completa" : "Pantalla completa")" @onclick="() => pantallaCompleta = !pantallaCompleta"><Ico Nombre="pantalla-completa" /></button>
        <button type="button" class="pg-btn @(verCargas ? "activo" : "")" title="@($"Cargas ({cargasMat.Count})")" disabled="@modoEdicion" @onclick="AlternarCargas"><Ico Nombre="cargas" />@(cargasMat.Count > 0 ? $" {cargasMat.Count}" : "")</button>
        <span class="pg-sep"></span>
        <BotonCampos Activo="verCampos" Deshabilitado="motor is null || modoEdicion" OnClick="() => verCampos = true" />
        <button type="button" class="pg-btn @(mostrarImportar ? "activo" : "")" title="Importar listado (Excel)" disabled="@modoEdicion" @onclick="AlternarImportar"><Ico Nombre="cargar-excel" /></button>
        <BotonExportar Titulo="Materiales" Motor="motor" Filas="() => Mostrados.Select(m => m.Id)" Deshabilitado="motor is null" />
        <span class="pg-sep"></span>
        @if (!modoEdicion)
        {
            <button type="button" class="pg-btn pg-btn-peligro" title="Eliminar material seleccionado" disabled="@(selId is null)" @onclick="() => PedirEliminar(selId)"><Ico Nombre="eliminar" /></button>
            <button type="button" class="pg-btn" title="Editar" disabled="@(motor is null)" @onclick="EntrarEdicion"><Ico Nombre="editar" /></button>
            <button type="button" class="pg-btn pg-btn-primario @(form is not null ? "activo" : "")" title="Nuevo material" disabled="@(motor is null)" @onclick="Nuevo"><Ico Nombre="agregar" /></button>
        }
        else
        {
            <button type="button" class="pg-btn" title="Descartar cambios y salir de edición" @onclick="SalirEdicion"><Ico Nombre="cancelar" /></button>
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar cambios" disabled="@(cambios.Count == 0 || guardando)" @onclick="GuardarEdicion"><Ico Nombre="guardar" />@(cambios.Count > 0 ? $" {cambios.Count}" : "")</button>
        }
    </Acciones>
</EncabezadoPagina>

@if (verCampos && motor is not null)
{
    <PanelCampos Motor="motor" OnCerrar="() => verCampos = false" OnCambio="StateHasChanged" />
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(error ? "alert-warning" : "alert-success") py-1">@mensaje</div>
}

@* ---------- Cargas (bases de datos Excel) ---------- *@
@if (verCargas)
{
    <div class="card panel-formulario mb-3">
        <div class="card-body">
            @if (cargasMat.Count == 0) { <div class="text-muted small">—</div> }
            else
            {
                <div class="tabla-scroll mb-2" style="max-height:280px;">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:32px;"><input type="checkbox" class="form-check-input" title="Todas" checked="@(cargasSel.Count == cargasMat.Count)" @onchange="@(e => { cargasSel = (bool)e.Value! ? cargasMat.Select(c => c.Id).ToHashSet() : new(); elimCargas = null; })" /></th>
                                <th>Archivo</th><th>Hoja</th><th>Fecha</th><th title="Materiales de esta carga">Mat.</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in cargasMat)
                            {
                                var id = c.Id;
                                <tr class="@(cargaFiltro == id ? "table-active" : "")">
                                    <td><input type="checkbox" class="form-check-input" checked="@cargasSel.Contains(id)" @onchange="@(e => { if ((bool)e.Value!) cargasSel.Add(id); else cargasSel.Remove(id); elimCargas = null; })" /></td>
                                    <td class="small">@c.NombreArchivo</td>
                                    <td class="small">@c.Hoja</td>
                                    <td class="small text-nowrap">@c.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="small text-end">@(materialesPorCarga.TryGetValue(id, out var n) ? n : 0)</td>
                                    <td><button type="button" class="ens-mini @(cargaFiltro == id ? "activo" : "")" title="Ver solo esta carga" @onclick="() => cargaFiltro = cargaFiltro == id ? null : id"><Ico Nombre="ubicar" /></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-danger btn-sm" title="@($"Eliminar cargas seleccionadas ({cargasSel.Count})")" disabled="@(cargasSel.Count == 0)" @onclick="PedirEliminarCargas"><Ico Nombre="eliminar" /> @cargasSel.Count</button>
                </div>
            }
            @if (elimCargas is not null)
            {
                <div class="border border-danger rounded p-2 mt-2">
                    <PanelImpacto Informe="impactoCargas" OnEntendido="@(v => impactoCargasOk = v)" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => elimCargas = null"><Ico Nombre="cancelar" /></button>
                        <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@(impactoCargas is null || (impactoCargas.RequiereEntender && !impactoCargasOk))" @onclick="ConfirmarEliminarCargas"><Ico Nombre="eliminar" /></button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (mostrarImportar)
{
    <PanelImportarExcel Destinos="DestinosImportacion" Importando="importando" OnImportar="ImportarExcel" OnCancelar="() => mostrarImportar = false" />
}

@* ---------- Nuevo material ---------- *@
@if (form is not null && motor is not null)
{
    <FormularioSig Titulo="Nuevo material" Icono="agregar" Clase="mb-3" OnCerrar="() => form = null">
        <ChildContent>
            @if (CamposEditables.Any())
            {
                <SeccionFormulario Titulo="Datos del material">
                    @foreach (var c in CamposEditables)
                    {
                        var campo = c;
                        <CampoFormulario Etiqueta="@campo.Nombre" Ancho="col-md-3" Destacado="@campo.Nombre.Contains("material", StringComparison.OrdinalIgnoreCase)">
                            @EntradaCampo(campo, form.TryGetValue(campo.Id, out var v) ? v : null, val => form[campo.Id] = val)
                        </CampoFormulario>
                    }
                </SeccionFormulario>
            }
            else
            {
                <div class="frm-vacio">—</div>
            }
        </ChildContent>
        <Acciones>
            <button type="button" class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => form = null"><Ico Nombre="cancelar" /></button>
            <button type="button" class="btn btn-primary btn-sm" title="Guardar" disabled="@guardando" @onclick="GuardarNuevo"><Ico Nombre="guardar" /></button>
        </Acciones>
    </FormularioSig>
}

@if (elimId is int eid)
{
    <div class="card panel-formulario mb-3 border-danger">
        <div class="card-body">
            <div class="mb-2"><Ico Nombre="eliminar" /> <strong>@TituloDe(eid)</strong></div>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2">
                <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => elimId = null"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@(impacto is null || (impacto.RequiereEntender && !impactoOk))" @onclick="ConfirmarEliminar"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}

@* ---------- Filtros ---------- *@
<div class="mpie-barra mb-2">
    <input class="form-control form-control-sm" style="max-width:260px;" placeholder="Buscar material..." @bind="filtro" @bind:event="oninput" />
    @if (cargaFiltro is int cf && cargasMat.FirstOrDefault(c => c.Id == cf) is { } cg)
    {
        <span class="rg-chip"><Ico Nombre="cargas" /> @cg.NombreArchivo <button type="button" class="rg-chip-x" title="Quitar" @onclick="() => cargaFiltro = null">✕</button></span>
    }
    @if (cargaFiltro is not null || !string.IsNullOrWhiteSpace(filtro))
    {
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Quitar filtros" @onclick="LimpiarFiltros">✕</button>
        <span class="text-muted small">@Mostrados.Count() / @materiales.Count</span>
    }
</div>

<div class="tabla-scroll tabla-auto"><table class="table table-sm table-bordered @(modoEdicion ? "" : "table-hover") tabla-compacta align-middle mb-0 tabla-pin @(modoEdicion ? "doc-editando" : "")">
    <thead>
        <tr>
            @foreach (var c in Columnas)
            {
                <th class="th-ordenable" @onclick="() => OrdenarPor(c.Clave)">@c.Nombre@(Flecha(c.Clave))</th>
            }
            <th style="width:40px;"></th>
        </tr>
    </thead>
    <tbody>
        @if (motor is not null)
        {
            @foreach (var m in Mostrados)
            {
                var id = m.Id;
                <tr class="@(!modoEdicion && selId == id ? "table-active" : "")" @onclick="() => { if (!modoEdicion) selId = id; }">
                    @foreach (var c in Columnas)
                    {
                        var campo = c;
                        if (campo.Origen == OrigenCampoTabla.Nativo && campo.Clave == ColUbicacion)
                        {
                            <td class="small">@CeldaUbicacion(id)</td>
                        }
                        else if (campo.Origen == OrigenCampoTabla.Nativo && campo.Clave == ColAdjuntos)
                        {
                            <td class="text-center">@CeldaAdjuntos(id)</td>
                        }
                        else if (modoEdicion && !campo.Calculado && campo.Origen != OrigenCampoTabla.Nativo)
                        {
                            <td class="small p-0 @(cambios.ContainsKey((id, campo.Id)) ? "doc-cambio" : "")">
                                @EntradaCampo(campo, ValorEdicion(id, campo), val => Cambiar(id, campo, val), "cc-input")
                            </td>
                        }
                        else
                        {
                            <CeldaCampo Motor="Motor" Campo="campo" Fila="id" SoloLectura="true" OnCambio="StateHasChanged" />
                        }
                    }
                    <td class="text-nowrap text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger py-0" title="Eliminar (va a la Papelera)" disabled="@modoEdicion" @onclick:stopPropagation="true" @onclick="() => { selId = id; PedirEliminar(id); }"><Ico Nombre="eliminar" /></button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table></div>
@MenuAdjuntos()
@MenuUbicacion()
</div>
}

@* ---------- Cargar adjuntos a un material ---------- *@
@if (cargaAdj is not null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-box-custom" style="max-width:640px;">
            <h5 class="mb-2"><Ico Nombre="adjuntar" /> @TituloDe(cargaAdj.MaterialId)</h5>
            <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
                <div class="btn-group btn-group-sm" role="group" title="Clase">
                    @foreach (var cl in AdjuntoMaterial.Clases)
                    {
                        var clase = cl;
                        <button type="button" class="btn @(cargaAdj.Clase == clase ? "btn-dark" : "btn-outline-secondary")" @onclick="() => CambiarClaseCarga(clase)">@clase</button>
                    }
                </div>
                <InputFile class="form-control form-control-sm" multiple OnChange="SeleccionarAdjuntos" />
            </div>
            @if (cargaAdj.Archivos.Count > 0)
            {
                <div class="tabla-scroll mb-2" style="max-height:300px;">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <tbody>
                            @foreach (var a in cargaAdj.Archivos)
                            {
                                var it = a;
                                <tr>
                                    <td class="small">
                                        <div class="text-truncate" style="max-width:340px;" title="@it.Archivo.Name">@it.Archivo.Name</div>
                                        <span class="text-muted">@((it.Archivo.Size / 1024.0).ToString("0")) KB</span>
                                        @if (it.Archivo.Size > MaxArchivo) { <span class="text-danger"> · supera 50 MB</span> }
                                    </td>
                                    <td class="p-0" style="width:190px;">
                                        <select class="form-select form-select-sm cc-input" value="@it.Clase" @onchange="@(e => it.Clase = e.Value?.ToString() ?? AdjuntoMaterial.Otros)">
                                            @foreach (var cl in AdjuntoMaterial.Clases) { <option value="@cl">@cl</option> }
                                        </select>
                                    </td>
                                    <td style="width:36px;"><button type="button" class="ens-mini" title="Quitar" @onclick="() => cargaAdj.Archivos.Remove(it)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (!string.IsNullOrEmpty(mensajeAdj)) { <div class="alert alert-warning py-1">@mensajeAdj</div> }
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => cargaAdj = null"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-primary btn-sm" title="@($"Cargar {cargaAdj.Archivos.Count(x => x.Archivo.Size <= MaxArchivo)} archivo(s)")" disabled="@(guardando || !cargaAdj.Archivos.Any(x => x.Archivo.Size <= MaxArchivo))" @onclick="GuardarAdjuntos">
                    @if (guardando) { <span class="spinner-border spinner-border-sm" role="status"></span> } else { <Ico Nombre="guardar" /> }
                </button>
            </div>
        </div>
    </div>
}

@* ---------- Editar un adjunto: reemplazar el archivo y/o cambiar su clase ---------- *@
@if (reemplazo is not null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-box-custom" style="max-width:520px;">
            <h5 class="mb-2"><Ico Nombre="editar" /> @TituloDe(reemplazo.MaterialId)</h5>
            <div class="small text-muted mb-2">@reemplazo.NombreOriginal</div>
            <select class="form-select form-select-sm mb-2" title="Clase" @bind="claseReemplazo">
                @foreach (var cl in AdjuntoMaterial.Clases) { <option value="@cl">@cl</option> }
            </select>
            <InputFile class="form-control form-control-sm mb-2" OnChange="@(e => archivoReemplazo = e.File)" />
            @if (!string.IsNullOrEmpty(mensajeAdj)) { <div class="alert alert-warning py-1">@mensajeAdj</div> }
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => reemplazo = null"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-primary btn-sm" title="Guardar" disabled="@(guardando || (archivoReemplazo is null && claseReemplazo == reemplazo.Clase))" @onclick="Reemplazar"><Ico Nombre="guardar" /></button>
            </div>
        </div>
    </div>
}

@if (elimAdjunto is not null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-box-custom" style="max-width:520px;">
            <h5 class="mb-2"><Ico Nombre="eliminar" /> @TituloDe(elimAdjunto.MaterialId) · @elimAdjunto.Clase</h5>
            <div class="small text-muted mb-2">@elimAdjunto.NombreOriginal</div>
            <PanelImpacto Informe="impactoAdj" OnEntendido="@(v => impactoAdjOk = v)" />
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => elimAdjunto = null"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" title="Eliminar (va a la Papelera)" disabled="@(impactoAdj is null || (impactoAdj.RequiereEntender && !impactoAdjOk))" @onclick="ConfirmarEliminarAdjunto"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}

@code {
    private const string Tabla = SigWeb.Data.ListadoMateriales.MigracionMateriales.Tabla;
    private const string ColAdjuntos = "Adjuntos";
    private const string ColUbicacion = "Ubicacion";
    private const long MaxArchivo = 50L * 1024 * 1024;
    private const int MaxMenu = 3;

    // ---------- Pantalla completa (igual que Ensayos) ----------
    private bool pantallaCompleta;
    private EventCallback AtrasPantalla => pantallaCompleta ? EventCallback.Factory.Create(this, () => pantallaCompleta = false) : default;

    private List<Material> materiales = new();
    private Dictionary<int, List<AdjuntoMaterial>> adjuntos = new();   // material → adjuntos, el más reciente primero
    private int? selId;
    private string mensaje = "";
    private bool error, guardando;

    // ?buscar=texto (buscador rápido Ctrl + K): llega como filtro de la lista.
    [SupplyParameterFromQuery(Name = "buscar")] public string? BuscarQ { get; set; }
    private string? buscarAplicado;
    protected override void OnParametersSet()
    {
        if (BuscarQ == buscarAplicado) return;
        buscarAplicado = BuscarQ;
        if (!string.IsNullOrWhiteSpace(BuscarQ)) filtro = BuscarQ;
    }

    protected override void OnInitialized() => CargarLista();

    private void CargarLista()
    {
        motorPendiente = true;
        Db.ChangeTracker.Clear();
        materiales = Db.Materiales.AsNoTracking().Where(m => !m.Eliminado).OrderBy(m => m.Id).ToList();
        var ids = materiales.Select(m => m.Id).ToList();
        try
        {
            adjuntos = Db.AdjuntosMaterial.AsNoTracking().Where(a => ids.Contains(a.MaterialId)).ToList()
                .GroupBy(a => a.MaterialId).ToDictionary(g => g.Key, g => g.OrderByDescending(a => a.FechaCarga).ThenByDescending(a => a.Id).ToList());
        }
        catch { adjuntos = new(); }   // sin la migración aplicada
        try
        {
            ubicaciones = Db.UbicacionesMaterial.AsNoTracking().Where(u => ids.Contains(u.MaterialId)).OrderBy(u => u.Id).ToList()
                .GroupBy(u => u.MaterialId).ToDictionary(g => g.Key, g => g.ToList());
            lugares = SigWeb.Data.ListadoMateriales.LugaresMaterial.Cargar(Db);
        }
        catch { ubicaciones = new(); }
        cargasMat = Db.CargasMateriales.AsNoTracking().OrderByDescending(c => c.Fecha).ToList();
        materialesPorCarga = materiales.Where(m => m.CargaMaterialesId != null).GroupBy(m => m.CargaMaterialesId!.Value).ToDictionary(g => g.Key, g => g.Count());
        cargasSel.RemoveWhere(id => cargasMat.All(c => c.Id != id));
        if (cargaFiltro is int cf && cargasMat.All(c => c.Id != cf)) cargaFiltro = null;
        if (selId is int s && materiales.All(m => m.Id != s)) selId = null;
    }

    private List<AdjuntoMaterial> AdjuntosDe(int id) => adjuntos.TryGetValue(id, out var l) ? l : new();

    // ---------- Campos ----------
    private MotorTabla? motor;
    private MotorTabla Motor => motor!;
    private bool verCampos, motorPendiente = true;
    private string? colOrden;
    private bool ordenAsc = true;

    private IEnumerable<CampoTabla> Columnas => motor?.Visibles ?? Enumerable.Empty<CampoTabla>();

    private IEnumerable<ColumnaNativa> ColumnasNativas() => new[]
    {
        new ColumnaNativa(ColUbicacion, "Ubicación", TipoCampoTabla.Texto, id => string.Join(", ", UbicacionesDe(id).Select(u => lugares.Etiqueta(u)))),
        new ColumnaNativa(ColAdjuntos, "Adjuntos", TipoCampoTabla.Numero, id => (double)AdjuntosDe(id).Count),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!motorPendiente) return;
        motorPendiente = false;
        try
        {
            motor = await MotorTabla.CargarAsync(Db, Tabla, ColumnasNativas(), materiales.Select(m => (m.Id, $"#{m.Id}")));
            await SincronizarTitulosAsync();
        }
        catch { motor = null; }
        StateHasChanged();
    }

    private IEnumerable<CampoTabla> CamposEditables =>
        motor?.Ordenados.Where(c => c.Origen != OrigenCampoTabla.Nativo && !c.Calculado) ?? Enumerable.Empty<CampoTabla>();

    // Nombre que identifica el material fuera de esta pantalla (Papelera, Trazado, impacto): la primera
    // columna cuyo nombre diga "material"; si no hay, la primera columna del listado.
    private CampoTabla? CampoTitulo => motor?.Ordenados.Where(c => c.Origen != OrigenCampoTabla.Nativo)
        .OrderByDescending(c => MigracionDocumentos.Normalizar(c.Nombre).Contains("material")).FirstOrDefault();

    private string TituloDe(int id)
    {
        var c = CampoTitulo;
        var t = c is null || motor is null ? "" : motor.Texto(id, c, out _);
        return string.IsNullOrWhiteSpace(t) ? $"Material #{id}" : t;
    }

    // Guarda ese nombre en Material.NombreMaterial (lo leen Papelera, Trazado y el análisis de impacto).
    private async Task SincronizarTitulosAsync()
    {
        if (motor is null || CampoTitulo is null) return;
        var cambiar = materiales.Select(m => (m, t: TituloDe(m.Id))).Where(x => !x.t.StartsWith("Material #") && x.t != x.m.NombreMaterial).ToList();
        if (cambiar.Count == 0) return;
        var ids = cambiar.Select(x => x.m.Id).ToList();
        var ents = await Db.Materiales.Where(m => ids.Contains(m.Id)).ToDictionaryAsync(m => m.Id);
        foreach (var (m, t) in cambiar)
        {
            var corto = t.Length > 200 ? t[..200] : t;
            if (ents.TryGetValue(m.Id, out var e)) e.NombreMaterial = corto;
            m.NombreMaterial = corto;
        }
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
    }

    // Entrada según el tipo del campo (misma que Documentos).
    private RenderFragment EntradaCampo(CampoTabla c, string? valor, Action<string?> alCambiar, string clase = "") => __builder =>
    {
        switch (c.Tipo)
        {
            case TipoCampoTabla.Numero:
                <input type="number" step="any" class="form-control form-control-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))" />
                break;
            case TipoCampoTabla.Fecha:
                <input type="date" class="form-control form-control-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))" />
                break;
            case TipoCampoTabla.Lista:
                <select class="form-select form-select-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))">
                    <option value=""></option>
                    @foreach (var o in Con(motor!.OpcionesDe(c), valor)) { <option value="@o">@o</option> }
                </select>
                break;
            case TipoCampoTabla.SiNo:
                <div class="text-center"><input type="checkbox" class="form-check-input" checked="@(valor == "1")" @onchange="@(e => alCambiar((bool)e.Value! ? "1" : "0"))" /></div>
                break;
            default:
                <input class="form-control form-control-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))" />
                break;
        }
    };

    private static IEnumerable<string> Con(IEnumerable<string> opciones, string? actual)
    {
        var l = opciones.ToList();
        return string.IsNullOrWhiteSpace(actual) || l.Contains(actual, StringComparer.OrdinalIgnoreCase) ? l : l.Append(actual);
    }

    // ---------- Filtro y orden ----------
    private string filtro = "";
    private int? cargaFiltro;

    private void LimpiarFiltros() { filtro = ""; cargaFiltro = null; }

    private IEnumerable<Material> Mostrados
    {
        get
        {
            var q = materiales.Where(m => (cargaFiltro is null || m.CargaMaterialesId == cargaFiltro)
                && (string.IsNullOrWhiteSpace(filtro)
                    || (motor is not null && motor.TextoBusqueda(m.Id).Contains(filtro, StringComparison.OrdinalIgnoreCase))
                    || AdjuntosDe(m.Id).Any(a => a.NombreOriginal.Contains(filtro, StringComparison.OrdinalIgnoreCase))));
            return motor is not null && colOrden is not null ? motor.Ordenar(q, m => m.Id, colOrden, ordenAsc) : q;
        }
    }

    private void OrdenarPor(string clave) { if (colOrden == clave) ordenAsc = !ordenAsc; else { colOrden = clave; ordenAsc = true; } }
    private string Flecha(string clave) => colOrden == clave ? (ordenAsc ? " ▲" : " ▼") : "";

