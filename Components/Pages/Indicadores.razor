                @if (celda is (int ci, int cm2) && ci == f.Id)
                {
                    <div class="ind-editor-linea">
                        <div class="ind-editor-cab">
                            <span class="ind-panel-per">@CalculoIndicadores.NombrePeriodo(f, anio, cm2)</span>
                            <button type="button" class="gf-x" title="Cerrar" @onclick="() => celda = null">✕</button>
                        </div>
                        @EditorMedicion(f, cm2)
                    </div>
                }

                <div class="ind-det-cuerpo">
                    <div class="com-grafico ind-det-graf">
                        <div class="com-grafico-cab">
                            <div class="com-grafico-tit">@anio</div>
                            <button type="button" class="gx-mas" title="Elementos del gráfico" data-grafico="ind-foco-g" data-clave="@($"indicadores:{f.Id}")" onclick="sigwebElementosGrafico(this)">+</button>
                        </div>
                        <div class="com-grafico-lienzo"><canvas id="ind-foco-g"></canvas></div>
                    </div>
                    <dl class="ind-ficha">
                        <dt>Fórmula de medición</dt><dd>@(string.IsNullOrWhiteSpace(f.Formula) ? "—" : f.Formula)</dd>
                        <dt>Objetivo</dt><dd>@(string.IsNullOrWhiteSpace(f.Objetivo) ? "—" : f.Objetivo)</dd>
                        <dt>Unidad</dt><dd>@CalculoIndicadores.NombreUnidad(f.Unidad)</dd>
                        <dt>Fuente de información</dt><dd>@(string.IsNullOrWhiteSpace(f.FuenteInformacion) ? "—" : f.FuenteInformacion)</dd>
                        <dt>Periodo de cálculo</dt><dd>@(f.Acumulado ? $"Acumulado desde {f.FechaInicio:dd/MM/yyyy}" : "Solo el periodo")</dd>
                    </dl>
                </div>
            </section>
        }
    </div>
}
