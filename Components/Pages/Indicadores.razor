                            <span class="ind-mes-n">@CalculoIndicadores.Mes(anio, mes)</span>
                            <span class="ind-mes-v">@(c.Texto == "" ? (c.Clase.Contains("ind-no") ? "·" : "＋") : c.Texto)</span>
