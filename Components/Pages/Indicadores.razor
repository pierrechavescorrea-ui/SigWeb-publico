    private static void Alternar(List<string> sel, string v)
    {
        if (sel.RemoveAll(x => string.Equals(x, v, StringComparison.OrdinalIgnoreCase)) == 0) sel.Add(v);
    }

    // ---------- Eliminar (Papelera) ----------
    private int? elimId;
    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;

    private void PedirEliminar()
    {
        if (selId is not int id) return;
        form = null; congelarMes = null; elimId = id; impacto = null; impactoOk = false;
        _ = CalcularImpacto(id);
    }

    private async Task CalcularImpacto(int id)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            impacto = await scope.ServiceProvider.GetRequiredService<SigWeb.Data.Impacto.AnalizadorImpacto>().Indicadores(id);
        }
        catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmarEliminar()
    {
        if (elimId is not int id) return;
        var ahora = DateTime.Now; ahora = new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, ahora.Minute, ahora.Second);
        var ind = await Db.Indicadores.FirstOrDefaultAsync(x => x.Id == id);
        if (ind is not null)
        {
            ind.Eliminado = true; ind.FechaEliminacion = ahora;
            var meds = await Db.MedicionesIndicador.Where(m => m.IndicadorId == id).ToListAsync();
            var idsMed = meds.Select(m => m.Id).ToList();
            foreach (var m in meds) { m.Eliminado = true; m.FechaEliminacion = ahora; }
            foreach (var a in await Db.ArchivosMedicionIndicador.Where(a => idsMed.Contains(a.MedicionIndicadorId)).ToListAsync()) { a.Eliminado = true; a.FechaEliminacion = ahora; }
            await Db.SaveChangesAsync();
        }
        mensaje = $"{ind?.Nombre} enviado a la Papelera."; error = false;
        elimId = null; selId = null; celda = null;
        Cargar();
    }


