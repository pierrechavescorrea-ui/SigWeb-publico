                <td class="small"><span class="ind-origen ind-origen-@((int)i.Fuente)">@IconoFuente(i.Fuente) @CalculoIndicadores.NombreFuente(i.Fuente)</span></td>
                @for (var m = 1; m <= 12; m++)
                {
                    var mes = m;
                    var c = CeldaDe(i, mes);
                    <td class="ind-celda @c.Clase @(celda == (i.Id, mes) ? "ind-celda-sel" : "")" title="@c.Titulo" @onclick="() => AbrirCelda(i, mes)" @onclick:stopPropagation="true">
                        <span class="ind-valor">@c.Texto</span>
                        @if (c.Congelado)
                        {
                            <span class="ind-marca" title="Congelado"><Ico Nombre="candado" /></span>
