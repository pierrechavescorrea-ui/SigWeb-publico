    // ---------- Gráficos: uno por indicador (valor de cada mes de medición + meta) ----------
    private string? firmaGraficos;

    private void CambiarVista(string v) { vista = v; firmaGraficos = null; celda = null; }

    // ---------- Indicador por indicador / tablero ----------
    private void Enfocar(Indicador i)
    {
        selId = i.Id;
        if (celda is (int ci, _) && ci != i.Id) celda = null;
        firmaGraficos = null;
    }

    private void AlternarCelda(Indicador i, int mes)
    {
        if (celda == (i.Id, mes)) { celda = null; return; }
        AbrirCelda(i, mes);
    }

    private void AbrirTarjeta(Indicador i, int? mes)
    {
        CambiarVista("indicador");
        Enfocar(i);
        if (mes is int m) AbrirCelda(i, m);
    }

    // Último mes del año con valor (calculado, congelado o digitado).
    private (int Mes, Celda C)? UltimoMedido(Indicador ind)
    {
        for (var m = 12; m >= 1; m--)
        {
            var c = CeldaDe(ind, m);
            if (c.Valor is not null) return (m, c);
        }
        return null;
    }

    private Celda? AnteriorMedido(Indicador ind, int mes)
    {
        for (var m = mes - 1; m >= 1; m--)
        {
            var c = CeldaDe(ind, m);
            if (c.Valor is not null) return c;
        }
        return null;
    }

    // Verde si el cambio va hacia donde está la meta (subir si la meta es "≥", bajar si es "≤").
    private static string ClaseTendencia(Indicador i, decimal ahora, decimal antes) =>
        (ahora > antes) == !(i.OperadorMeta is "<=" or "<") ? "sube" : "baja";

    private sealed record Resumen(int Cumplen, int Medidos, decimal? Promedio);

    private Resumen ResumenAnio(Indicador ind)
    {
        var v = Enumerable.Range(1, 12).Select(m => CeldaDe(ind, m).Valor).Where(x => x is not null).Select(x => x!.Value).ToList();
        return new(v.Count(x => CalculoIndicadores.Cumple(ind, x) == true), v.Count, v.Count == 0 ? null : Math.Round(v.Average(), 2));
    }

    // Posición (0–100) de un valor en la barra de meta: porcentaje sobre 100; lo demás, sobre el mayor de meta y valor (+25 %).
    private string Pct(Indicador ind, decimal? v)
    {
        if (v is not decimal x) return "0";
        var tope = ind.Unidad == "porcentaje" ? Math.Max(100m, Math.Max(ind.Meta ?? 0, x)) : Math.Max(ind.Meta ?? 0, x) * 1.25m;
        if (tope <= 0) tope = 1;
        return Math.Clamp(x / tope * 100, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    }

    private RenderFragment GraficoCaja(Indicador ind) => __builder =>
    {
        <div class="com-grafico">
            <div class="com-grafico-cab">
                <div class="com-grafico-tit">@ind.Nombre</div>
                <button type="button" class="gx-mas" title="Elementos del gráfico" data-grafico="@($"ind-g-{ind.Id}")" data-clave="@($"indicadores:{ind.Id}")" onclick="sigwebElementosGrafico(this)">+</button>
            </div>
            <div class="com-grafico-lienzo"><canvas id="@($"ind-g-{ind.Id}")"></canvas></div>
        </div>
    };

    private object ConfigGrafico(Indicador ind)
    {
        var meses = Enumerable.Range(1, 12).Where(m => CalculoIndicadores.Mide(ind, anio, m)).ToList();
        var celdas = meses.Select(m => CeldaDe(ind, m)).ToList();
        var colores = celdas.Select(c => CalculoIndicadores.Cumple(ind, c.Valor) switch { true => "#2e9e5b", false => "#d64545", _ => "#adb5bd" }).ToArray();
        var datasets = new List<object>
        {
            new { type = "bar", label = ind.Nombre, data = celdas.Select(c => (object?)c.Valor).ToArray(), backgroundColor = colores, borderRadius = 4, maxBarThickness = 38, sigwebEtiquetas = true, order = 2 }
        };
        if (ind.Meta is decimal meta)
            datasets.Add(new { type = "line", label = $"Meta ({Operador(ind.OperadorMeta)} {CalculoIndicadores.Formato(ind, meta)})", data = meses.Select(_ => (object?)meta).ToArray(), borderColor = "#3b4658", backgroundColor = "#3b4658", borderDash = new[] { 6, 4 }, pointRadius = 0, borderWidth = 2, fill = false, order = 1 });
        return new
        {
            type = "bar",
            data = new { labels = meses.Select(m => CalculoIndicadores.Mes(anio, m)).ToArray(), datasets },
            options = new
            {
                responsive = true, maintainAspectRatio = false,
                plugins = new { legend = new { position = "bottom", labels = new { boxWidth = 12 } } },
                scales = new { x = new { grid = new { display = false } }, y = new { beginAtZero = true, suggestedMax = ind.Unidad == "porcentaje" ? 100 : (int?)null } }
            }
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (vista is not ("graficos" or "indicador")) return;
        var lista = Mostrados.ToList();
        if (vista == "indicador")
        {
            var f = lista.FirstOrDefault(x => x.Id == selId) ?? lista.FirstOrDefault();
            lista = f is null ? new() : new() { f };
        }
        var firma = $"{vista}|{version}|{anio}|{fFuente}|{buscar}|{string.Join(",", lista.Select(i => i.Id))}";
        if (firma == firmaGraficos) return;
        firmaGraficos = firma;
        try
        {
            foreach (var ind in lista)
                await JS.InvokeVoidAsync("sigwebRenderGrafico", vista == "indicador" ? "ind-foco-g" : $"ind-g-{ind.Id}", ConfigGrafico(ind));
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { firmaGraficos = null; }
    }
}
