        }
    </tbody>
</table></div>
}

@* ---------- Panel de la medición (lateral, solo en la matriz: la página se corre para no tapar meses) ---------- *@
@if (vista == "matriz" && celda is (int cInd, int cMes) && indicadores.FirstOrDefault(x => x.Id == cInd) is { } indSel)
{
    <aside class="ind-panel">
        <div class="ind-panel-cab">
            <div class="ind-panel-tits">
                <span class="ind-panel-per">@CalculoIndicadores.NombrePeriodo(indSel, anio, cMes)</span>
                <span class="ind-panel-tit">@indSel.Nombre</span>
            </div>
            <button type="button" class="gf-x" title="Cerrar" @onclick="() => celda = null">✕</button>
        </div>
        <div class="ind-panel-cuerpo">@EditorMedicion(indSel, cMes)</div>
    </aside>
}
</div>

@code {
    private const long MaxArchivo = 50L * 1024 * 1024;

    private bool pantallaCompleta, verDescripcion = true, guardando, error;
    private string vista = "indicador";   // indicador | tablero | matriz | graficos
    private EventCallback AtrasPantalla => pantallaCompleta ? EventCallback.Factory.Create(this, () => pantallaCompleta = false) : default;
    private string mensaje = "", buscar = "", fFuente = "";

    private List<Indicador> indicadores = new();
    private Dictionary<(int Ind, int Anio, int Mes), MedicionIndicador> mediciones = new();
    private Dictionary<int, List<ArchivoMedicionIndicador>> archivos = new();
    private ContextoIndicadores ctx = new();
    private readonly Dictionary<(int Ind, int Mes), ResultadoIndicador?> vivo = new();
    private int anio = DateTime.Today.Year;
    private List<int> anios = new();
    private int? selId;
    private int version;
    private List<string> tiposHallazgo = new(), origenes = new(), procesos = new(), remitentes = new();

    protected override void OnInitialized() => Cargar();

    // ?indicador={id} (tablero de inicio): abre ese indicador en la vista indicador.
    [SupplyParameterFromQuery(Name = "indicador")] public int? IndicadorQ { get; set; }
    private int? indicadorAplicado;
    protected override void OnParametersSet()
    {
        if (IndicadorQ == indicadorAplicado) return;
        indicadorAplicado = IndicadorQ;
        if (IndicadorQ is int i && indicadores.Any(x => x.Id == i)) { selId = i; vista = "indicador"; celda = null; }
    }

    private void Cargar()
    {
        Db.ChangeTracker.Clear();
        indicadores = Db.Indicadores.AsNoTracking().OrderBy(i => i.Orden).ThenBy(i => i.Id).ToList();
        var meds = Db.MedicionesIndicador.AsNoTracking().ToList();
        mediciones = meds.GroupBy(m => (m.IndicadorId, m.Anio, m.Mes)).ToDictionary(g => g.Key, g => g.OrderByDescending(m => m.Id).First());
        var idsMed = meds.Select(m => m.Id).ToList();
        archivos = Db.ArchivosMedicionIndicador.AsNoTracking().Where(a => idsMed.Contains(a.MedicionIndicadorId)).ToList()
            .GroupBy(a => a.MedicionIndicadorId).ToDictionary(g => g.Key, g => g.OrderBy(a => a.Id).ToList());
        ctx = ContextoIndicadores.Cargar(Db);

        static IEnumerable<string> Lineas(string? t) => (t ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        List<string> Catalogo(string tipo, IEnumerable<string> usados) =>
            Db.Catalogos.AsNoTracking().Where(c => c.Tipo == tipo && c.Activo).Select(c => c.Nombre).ToList()
                .Concat(usados).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
        tiposHallazgo = Catalogo(SigWeb.Data.Riesgos.SembradorCatalogosRiesgo.TipoHallazgo, ctx.Planes.Select(p => p.TipoHallazgo));
        origenes = Catalogo(SigWeb.Data.Riesgos.SembradorCatalogosRiesgo.OrigenHallazgo, ctx.Planes.Select(p => p.OrigenHallazgo));
        procesos = Catalogo(SigWeb.Data.Riesgos.SembradorCatalogosRiesgo.ProcesoPlan, ctx.Planes.SelectMany(p => Lineas(p.Proceso)));
        remitentes = ctx.Comunicados.Select(c => c.Remitente ?? "").Where(x => x.Trim().Length > 0).Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();

        var hoy = DateTime.Today.Year;
        // Años con datos en cualquier fuente (mediciones, comunicados, planes, registros del PIE, inicio de
        // indicadores acumulados), sin huecos entre el más antiguo y el siguiente al actual.
        var conDatos = meds.Select(m => m.Anio)
            .Concat(ctx.Comunicados.Where(c => c.Fecha is not null).Select(c => c.Fecha!.Value.Year))
            .Concat(ctx.Planes.Select(p => p.Fecha.Year))
            .Concat(ctx.PieCeldas.SelectMany(c => new[] { c.Fecha?.Year, c.Facturado?.Year }).Where(y => y is not null).Select(y => y!.Value))
            .Concat(indicadores.Where(i => i.FechaInicio is not null).Select(i => i.FechaInicio!.Value.Year))
            .Where(y => y >= 2000 && y <= hoy + 1)
            .Append(hoy).ToList();
        var desde = conDatos.Min();
        anios = Enumerable.Range(desde, hoy + 1 - desde + 1).OrderByDescending(a => a).ToList();
        if (selId is null || !indicadores.Any(i => i.Id == selId)) selId = indicadores.FirstOrDefault()?.Id;
        Recalcular();
        version++;
    }

    // Valores en vivo del año elegido (lo calculado sin congelar).
    private void Recalcular()
    {
        vivo.Clear();
        foreach (var ind in indicadores.Where(i => CalculoIndicadores.Calculado(i.Fuente)))
            for (var m = 1; m <= 12; m++)
                if (CalculoIndicadores.Mide(ind, anio, m))
                    vivo[(ind.Id, m)] = CalculoIndicadores.Calcular(ind, anio, m, ctx, BaseMes(ind.Id, m));
    }

    // Base elegida para ese mes (Matriz PIE); null = la del indicador.
    private string? BaseMes(int indId, int mes) => mediciones.TryGetValue((indId, anio, mes), out var m) ? m.BaseCalculo : null;

    private void CambiarAnio(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var a)) return;
        anio = a; celda = null;
        if (congelarMes is not null) congelarMes = 12;
        Recalcular();
        version++;
    }

    private bool verInactivos;

    private IEnumerable<Indicador> Mostrados => indicadores.Where(i =>
        (verInactivos || !i.Inactivo) &&
        (fFuente == "" || ((int)i.Fuente).ToString() == fFuente) &&
        (string.IsNullOrWhiteSpace(buscar) || i.Nombre.Contains(buscar.Trim(), StringComparison.OrdinalIgnoreCase)
            || i.Formula.Contains(buscar.Trim(), StringComparison.OrdinalIgnoreCase) || i.Responsable.Contains(buscar.Trim(), StringComparison.OrdinalIgnoreCase)));

    private bool EsMesActual(int m) => anio == DateTime.Today.Year && m == DateTime.Today.Month;

    // ---------- Valor de cada celda ----------
    private sealed record Celda(string Texto, string Clase, string Titulo, bool Congelado, int Soportes, decimal? Valor);

    private Celda CeldaDe(Indicador ind, int mes)
    {
        mediciones.TryGetValue((ind.Id, anio, mes), out var m);
        var cierre = CalculoIndicadores.Mide(ind, anio, mes);
        var sop = m is not null && archivos.TryGetValue(m.Id, out var l) ? l.Count : 0;
        var obs = string.IsNullOrWhiteSpace(m?.Observaciones) ? "" : "\n" + m!.Observaciones;
        if (m?.Congelado == true || !CalculoIndicadores.Calculado(ind.Fuente))
        {
            if (m is null || (!m.NoAplica && m.Valor is null))
                return new("", cierre ? "ind-vacio" : "ind-no", (cierre ? "Sin registrar" : "No es mes de medición") + obs, m?.Congelado == true, sop, null);
            if (m.NoAplica) return new("N/A", "ind-na", (m.Detalle ?? "") + obs, m.Congelado, sop, null);
            return new(CalculoIndicadores.Formato(ind, m.Valor), ClaseCumple(ind, m.Valor),
                (m.Detalle ?? (m.Numerador is not null ? $"{Num(m.Numerador)} / {Num(m.Denominador)}" : "")) + obs, m.Congelado, sop, m.Valor);
        }
        if (!cierre) return new("", "ind-no", "No es mes de medición" + obs, false, sop, null);
        vivo.TryGetValue((ind.Id, mes), out var r);
        if (r is null) return new("", "ind-futuro", "Periodo por venir" + obs, false, sop, null);
        if (r.NoAplica || r.Valor is null) return new("N/A", "ind-na ind-vivo", r.Detalle + obs, false, sop, null);
        return new(CalculoIndicadores.Formato(ind, r.Valor), ClaseCumple(ind, r.Valor) + " ind-vivo", "En vivo: " + r.Detalle + obs, false, sop, r.Valor);
    }

    private static string ClaseCumple(Indicador ind, decimal? v) => CalculoIndicadores.Cumple(ind, v) switch { true => "ind-ok", false => "ind-mal", _ => "" };

    private static string Num(decimal? v) => v is decimal x ? x.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("es-CO")) : "—";

    private static string Operador(string o) => o switch { ">=" => "≥", "<=" => "≤", _ => o };

    private static string IconoFuente(FuenteIndicador f) => f switch
    {
        FuenteIndicador.CumplimientoPie => "▦",
        FuenteIndicador.Comunicados => "✉",
        FuenteIndicador.PlanesAccion => "☑",
        FuenteIndicador.CurvaS => "∫",
        _ => "✎"
    };

    // ---------- Panel de una celda ----------
    private (int Ind, int Mes)? celda;
    private decimal? pValor, pNum, pDen;
    private bool pNA;
    private string? pObs;

    private void AbrirCelda(Indicador ind, int mes)
    {
        selId = ind.Id;
        celda = (ind.Id, mes);
        mediciones.TryGetValue((ind.Id, anio, mes), out var m);
        pValor = m?.Valor; pNum = m?.Numerador; pDen = m?.Denominador; pNA = m?.NoAplica ?? false; pObs = m?.Observaciones;
    }

    // Medición del periodo (con seguimiento), creada si no existe.
    private async Task<MedicionIndicador> MedicionAsync(int indId, int mes)
    {
        var m = await Db.MedicionesIndicador.Where(x => x.IndicadorId == indId && x.Anio == anio && x.Mes == mes).OrderByDescending(x => x.Id).FirstOrDefaultAsync();
        if (m is null) { m = new MedicionIndicador { IndicadorId = indId, Anio = anio, Mes = mes }; Db.MedicionesIndicador.Add(m); }
        return m;
    }

    // Valor digitado: el valor, o numerador / denominador (× 100 si es porcentaje).
    private void PasarDigitado(Indicador ind, MedicionIndicador m)
    {
        m.NoAplica = pNA;
        m.Numerador = pNA ? null : pNum;
        m.Denominador = pNA ? null : pDen;
        m.Valor = pNA ? null : pValor ?? (pNum is decimal n && pDen is decimal d && d != 0 ? Math.Round(n / d * (ind.Unidad == "porcentaje" ? 100 : 1), 2) : null);
    }

    private async Task GuardarCelda()
    {
        if (celda is not (int idInd, int mes) || indicadores.FirstOrDefault(i => i.Id == idInd) is not { } ind) return;
        guardando = true;
        try
        {
            var m = await MedicionAsync(idInd, mes);
            if (!CalculoIndicadores.Calculado(ind.Fuente) && !m.Congelado) PasarDigitado(ind, m);
            m.Observaciones = string.IsNullOrWhiteSpace(pObs) ? null : pObs.Trim();
            await Db.SaveChangesAsync();
            Cargar();
            AbrirCelda(ind, mes);
            mensaje = ""; error = false;
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo guardar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    private async Task CongelarCelda()
    {
        if (celda is not (int idInd, int mes) || indicadores.FirstOrDefault(i => i.Id == idInd) is not { } ind) return;
        guardando = true;
        try
        {
            var m = await MedicionAsync(idInd, mes);
            if (CalculoIndicadores.Calculado(ind.Fuente))
            {
                if (CalculoIndicadores.Calcular(ind, anio, mes, ctx, BaseMes(ind.Id, mes)) is not { } r) return;
                Fijar(m, r);
            }
            else PasarDigitado(ind, m);
            m.Observaciones = string.IsNullOrWhiteSpace(pObs) ? null : pObs.Trim();
            m.Congelado = true; m.FechaCongelado = DateTime.Now;
            await Db.SaveChangesAsync();
            Cargar();
            AbrirCelda(ind, mes);
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo congelar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    private static void Fijar(MedicionIndicador m, ResultadoIndicador r)
    {
        m.Valor = r.NoAplica ? null : r.Valor;
        m.NoAplica = r.NoAplica || r.Valor is null;
        m.Numerador = r.Numerador; m.Denominador = r.Denominador;
        m.Detalle = r.Detalle;
    }

    private async Task CambiarBaseMes(ChangeEventArgs e)
    {
        if (celda is not (int idInd, int mes) || indicadores.FirstOrDefault(i => i.Id == idInd) is not { } ind) return;
        guardando = true;
        try
        {
            var m = await MedicionAsync(idInd, mes);
            if (m.Congelado) return;
            var v = e.Value?.ToString();
            m.BaseCalculo = string.IsNullOrEmpty(v) ? null : v;
            await Db.SaveChangesAsync();
            var obs = pObs;
            Cargar();
            AbrirCelda(ind, mes);
            pObs = obs;
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo cambiar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    private async Task DescongelarCelda()
    {
        if (celda is not (int idInd, int mes) || indicadores.FirstOrDefault(i => i.Id == idInd) is not { } ind) return;
        guardando = true;
        try
        {
            var m = await MedicionAsync(idInd, mes);
            m.Congelado = false; m.FechaCongelado = null;
            // Lo calculado vuelve a verse en vivo: no se guarda un valor viejo.
            if (CalculoIndicadores.Calculado(ind.Fuente)) { m.Valor = null; m.NoAplica = false; m.Numerador = null; m.Denominador = null; m.Detalle = null; }
            await Db.SaveChangesAsync();
            Cargar();
            AbrirCelda(ind, mes);
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo descongelar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    // ---------- Soportes de la medición ----------
    private async Task CargarSoportes(InputFileChangeEventArgs e)
    {
        if (celda is not (int idInd, int mes) || indicadores.FirstOrDefault(i => i.Id == idInd) is not { } ind) return;
        var fallos = new List<string>();
        try
        {
            var m = await MedicionAsync(idInd, mes);
            await Db.SaveChangesAsync();
            var carpeta = Path.Combine(Env.WebRootPath, "uploads", "indicadores");
            Directory.CreateDirectory(carpeta);
            foreach (var f in e.GetMultipleFiles(50))
            {
                if (f.Size > MaxArchivo) { fallos.Add($"{f.Name} (supera 50 MB)"); continue; }
                try
                {
                    var nombre = $"{Guid.NewGuid():N}{Path.GetExtension(f.Name)}";
                    await using (var s = f.OpenReadStream(MaxArchivo))
                    await using (var destino = File.Create(Path.Combine(carpeta, nombre)))
                        await s.CopyToAsync(destino);
                    Db.ArchivosMedicionIndicador.Add(new ArchivoMedicionIndicador { MedicionIndicadorId = m.Id, NombreOriginal = f.Name, RutaArchivo = $"/uploads/indicadores/{nombre}" });
                    await Db.SaveChangesAsync();
                }
                catch (Exception ex) { fallos.Add($"{f.Name} ({ex.Message})"); }
            }
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); fallos.Add(ex.Message); }
        mensaje = fallos.Count > 0 ? "No se cargaron: " + string.Join("; ", fallos) : ""; error = fallos.Count > 0;
        var obs = pObs;
        Cargar();
        AbrirCelda(ind, mes);
        pObs = obs;
    }

    private async Task EliminarSoporte(ArchivoMedicionIndicador a)
    {
        var ent = await Db.ArchivosMedicionIndicador.FirstOrDefaultAsync(x => x.Id == a.Id);
        if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
        mensaje = $"{a.NombreOriginal} enviado a la Papelera."; error = false;
        var c = celda;
        Cargar();
        celda = c;
    }

    // ---------- Congelar un periodo (todos los indicadores) ----------
    private int? congelarMes;

    private void AbrirCongelar()
    {
        if (congelarMes is not null) { congelarMes = null; return; }
        // Por defecto, el mes anterior (el último cerrado).
        var hoy = DateTime.Today;
        congelarMes = anio == hoy.Year ? Math.Max(1, hoy.Month - 1) : 12;
        form = null; elimId = null;
    }

    private sealed record PorCongelarItem(Indicador Ind, string Texto);

    // Lo calculado sin congelar y lo digitado sin bloquear del mes elegido (sin consultar la base).
    private List<PorCongelarItem> PorCongelar(int mes)
    {
        var l = new List<PorCongelarItem>();
        foreach (var ind in indicadores)
        {
            if (!CalculoIndicadores.Mide(ind, anio, mes)) continue;
            mediciones.TryGetValue((ind.Id, anio, mes), out var m);
            if (m?.Congelado == true) continue;
            if (CalculoIndicadores.Calculado(ind.Fuente))
            {
                if (vivo.TryGetValue((ind.Id, mes), out var r) && r is not null)
                    l.Add(new(ind, r.NoAplica || r.Valor is null ? "N/A" : CalculoIndicadores.Formato(ind, r.Valor)));
            }
            else if (m is not null && (m.NoAplica || m.Valor is not null))
                l.Add(new(ind, m.NoAplica ? "N/A" : CalculoIndicadores.Formato(ind, m.Valor)));
        }
        return l;
    }

    private async Task CongelarPeriodo(int mes)
    {
        guardando = true;
        try
        {
            var ahora = DateTime.Now;
            var n = 0;
            foreach (var x in PorCongelar(mes))
            {
                var m = await MedicionAsync(x.Ind.Id, mes);
                if (CalculoIndicadores.Calculado(x.Ind.Fuente))
                {
                    if (CalculoIndicadores.Calcular(x.Ind, anio, mes, ctx, BaseMes(x.Ind.Id, mes)) is not { } r) continue;
                    Fijar(m, r);
                }
                m.Congelado = true; m.FechaCongelado = ahora;
                n++;
            }
            await Db.SaveChangesAsync();
            mensaje = $"{n} indicador(es) congelados en {CalculoIndicadores.Mes(anio, mes)}."; error = false;
            congelarMes = null;
            Cargar();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo congelar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    // ---------- Nuevo / editar ----------
    private Indicador? form;
    private ConfigIndicador formCfg = new();
    private bool formNuevo;

    private void Nuevo()
    {
        if (form is not null && formNuevo) { form = null; return; }
        form = new Indicador { Responsable = indicadores.LastOrDefault()?.Responsable ?? "" };
        formCfg = new ConfigIndicador();
        formNuevo = true; elimId = null; congelarMes = null;
    }

    private void Editar()
    {
        if (selId is not int id || indicadores.FirstOrDefault(i => i.Id == id) is not { } ind) return;
        form = new Indicador();
        Copiar(ind, form);
        form.Id = ind.Id;
        formCfg = ConfigIndicador.Leer(ind.Configuracion);
        formNuevo = false; elimId = null; congelarMes = null;
    }

    private static void Copiar(Indicador o, Indicador d)
    {
        d.Nombre = o.Nombre.Trim(); d.Formula = o.Formula; d.Objetivo = o.Objetivo; d.Meta = o.Meta; d.OperadorMeta = o.OperadorMeta;
        d.Unidad = o.Unidad; d.Frecuencia = o.Frecuencia; d.FrecuenciaTexto = string.IsNullOrWhiteSpace(o.FrecuenciaTexto) ? null : o.FrecuenciaTexto.Trim();
        d.Tendencia = o.Tendencia; d.TipoIndicador = o.TipoIndicador; d.Responsable = o.Responsable; d.FuenteInformacion = o.FuenteInformacion;
        d.Fuente = o.Fuente; d.Configuracion = o.Configuracion; d.Acumulado = o.Acumulado; d.FechaInicio = o.FechaInicio;
        d.Inactivo = o.Inactivo; d.FechaFin = o.FechaFin;
    }

    // Al inhabilitar, por defecto se mide hasta hoy (se puede cambiar la fecha).
    private void CambiarActivo(bool activo)
    {
        if (form is null) return;
        form.Inactivo = !activo;
        if (form.Inactivo && form.FechaFin is null) form.FechaFin = DateTime.Today;
    }

    private void CambiarFuente(FuenteIndicador f)
    {
        if (form is null) return;
        form.Fuente = f;
        if (f == FuenteIndicador.Comunicados && formCfg.Calculo == "tiempo") form.Unidad = "dias";
    }

    private void CambiarCalculoComunicados(ChangeEventArgs e)
    {
        formCfg.Calculo = e.Value?.ToString() ?? "cobertura";
        if (form is not null) form.Unidad = formCfg.Calculo == "tiempo" ? "dias" : "porcentaje";
    }

    private Indicador FormComoIndicador()
    {
        var x = new Indicador();
        if (form is null) return x;
        Copiar(form, x);
        x.Configuracion = form.Fuente is FuenteIndicador.Comunicados or FuenteIndicador.PlanesAccion or FuenteIndicador.CumplimientoPie ? formCfg.Escribir() : null;
        return x;
    }

    // Último mes de medición ya empezado (para la vista previa del formulario).
    private static (int Anio, int Mes) UltimoCierre(Indicador ind)
    {
        var p = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        for (var i = 0; i < 24; i++, p = p.AddMonths(-1))
            if (CalculoIndicadores.EsCierre(ind, p.Month)) return (p.Year, p.Month);
        return (DateTime.Today.Year, DateTime.Today.Month);
    }

    private ResultadoIndicador? Previa(int a, int m) => CalculoIndicadores.Calcular(FormComoIndicador(), a, m, ctx);

    private async Task GuardarForm()
    {
        if (form is null || string.IsNullOrWhiteSpace(form.Nombre)) return;
        guardando = true;
        try
        {
            var datos = FormComoIndicador();
            if (formNuevo)
            {
                var nuevo = new Indicador();
                Copiar(datos, nuevo);
                nuevo.Orden = (indicadores.Count == 0 ? 0 : indicadores.Max(i => i.Orden)) + 1;
                Db.Indicadores.Add(nuevo);
                await Db.SaveChangesAsync();
                selId = nuevo.Id;
            }
            else if (await Db.Indicadores.FirstOrDefaultAsync(i => i.Id == form.Id) is { } ent)
            {
                Copiar(datos, ent);
                await Db.SaveChangesAsync();
            }
            mensaje = $"{datos.Nombre} guardado."; error = false;
            form = null;
            Cargar();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo guardar: " + ex.Message; error = true; }
        finally { guardando = false; }
    }

    // Selección múltiple con píldoras (ninguna = todas).
    private RenderFragment Pildoras(string titulo, List<string> opciones, List<string> sel) => __builder =>
    {
        <div class="ind-pildoras">
            <span class="ind-pildoras-tit">@titulo <span class="text-muted fw-normal">@(sel.Count == 0 ? "· todos" : $"· {sel.Count}")</span></span>
            <div class="gf-valores">
                @foreach (var o in opciones)
                {
                    var op = o;
                    <button type="button" class="gf-pill @(sel.Contains(op, StringComparer.OrdinalIgnoreCase) ? "activo" : "")" @onclick="() => Alternar(sel, op)">@op</button>
                }
                @if (opciones.Count == 0)
                {
                    <span class="text-muted small">(sin valores)</span>
                }
            </div>
        </div>
