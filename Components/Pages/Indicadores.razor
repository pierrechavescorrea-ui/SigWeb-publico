@page "/indicadores"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.Indicadores
@using SigWeb.Models
@inject AppDbContext Db
@inject IServiceScopeFactory Scopes
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<PageTitle>Indicadores</PageTitle>

@* Matriz de indicadores del SGI. Cada indicador dice de dónde sale su valor (Fuente): se digita
   (con soportes) o se calcula de Matriz PIE, Comunicados o Planes de acción para el periodo de su
   frecuencia. Lo calculado se ve en vivo hasta que se congela (queda el valor, el cálculo y la fecha).
   Lógica en Data/Indicadores/CalculoIndicadores.cs. *@

<div class="@(pantallaCompleta ? "ens-pantalla" : "") @(vista == "matriz" && celda is not null ? "ind-con-panel" : "")">
<EncabezadoPagina Titulo="Indicadores" Icono="indicadores" Subtitulo="@($"{indicadores.Count} indicador{(indicadores.Count == 1 ? "" : "es")} · {anio}")" OnAtras="AtrasPantalla">
    <Acciones>
        <button type="button" class="pg-btn @(pantallaCompleta ? "activo" : "")" title="@(pantallaCompleta ? "Salir de pantalla completa" : "Pantalla completa")" @onclick="() => pantallaCompleta = !pantallaCompleta"><Ico Nombre="pantalla-completa" /></button>
        <button type="button" class="pg-btn @(vista == "indicador" ? "activo" : "")" title="Indicador por indicador" @onclick='() => CambiarVista("indicador")'><Ico Nombre="indicador" /></button>
        <button type="button" class="pg-btn @(vista == "tablero" ? "activo" : "")" title="Todos (tablero)" @onclick='() => CambiarVista("tablero")'><Ico Nombre="tablero" /></button>
        <button type="button" class="pg-btn @(vista == "matriz" ? "activo" : "")" title="Matriz" @onclick='() => CambiarVista("matriz")'><Ico Nombre="listado" /></button>
        <button type="button" class="pg-btn @(vista == "graficos" ? "activo" : "")" title="Gráficos" @onclick='() => CambiarVista("graficos")'>📈</button>
        @if (vista == "matriz")
        {
            <button type="button" class="pg-btn @(verDescripcion ? "activo" : "")" title="@(verDescripcion ? "Ocultar columnas de descripción" : "Mostrar columnas de descripción")" @onclick="() => verDescripcion = !verDescripcion"><Ico Nombre="informacion" /></button>
        }
        <button type="button" class="pg-btn @(congelarMes is not null ? "activo" : "")" title="Congelar un periodo (todos los indicadores)" @onclick="AbrirCongelar"><Ico Nombre="candado" /></button>
        <span class="pg-sep"></span>
        <button type="button" class="pg-btn pg-btn-peligro" title="Eliminar indicador seleccionado" disabled="@(selId is null)" @onclick="PedirEliminar"><Ico Nombre="eliminar" /></button>
        <button type="button" class="pg-btn @(form is not null && !formNuevo ? "activo" : "")" title="Editar indicador seleccionado" disabled="@(selId is null)" @onclick="Editar"><Ico Nombre="editar" /></button>
        <button type="button" class="pg-btn pg-btn-primario @(form is not null && formNuevo ? "activo" : "")" title="Nuevo indicador" @onclick="Nuevo"><Ico Nombre="agregar" /></button>
    </Acciones>
</EncabezadoPagina>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(error ? "alert-warning" : "alert-success") py-1 px-2 small d-flex align-items-center gap-2">
        <span class="flex-grow-1">@mensaje</span>
        <button type="button" class="btn-close btn-sm" @onclick='() => mensaje = ""'></button>
    </div>
}

@* ---------- Nuevo / editar indicador ---------- *@
@if (form is not null)
{
    <FormularioSig Titulo="@(formNuevo ? "Nuevo indicador" : "Editar indicador")" Icono="indicador" Clase="mb-3 ind-form" OnCerrar="() => form = null">
        <Subtitulo>@(formNuevo ? null : form.Nombre)</Subtitulo>
        <ChildContent>
            <SeccionFormulario Titulo="Indicador">
                <CampoFormulario Etiqueta="Nombre" Ancho="col-lg-5" Obligatorio="true" Destacado="true">
                    <input class="form-control" @bind="form.Nombre" @bind:event="oninput" />
                </CampoFormulario>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label mb-1 small">Tipo de indicador</label>
                    <input class="form-control form-control-sm" list="dl-ind-tipo" @bind="form.TipoIndicador" />
                </div>
                <div class="col-sm-6 col-lg-4">
                    <label class="form-label mb-1 small">Responsable</label>
                    <input class="form-control form-control-sm" list="dl-ind-resp" @bind="form.Responsable" />
                </div>
                <div class="col-lg-7">
                    <label class="form-label mb-1 small">Fórmula de medición</label>
                    <textarea class="form-control form-control-sm" rows="2" @bind="form.Formula"></textarea>
                </div>
                <div class="col-lg-5">
                    <label class="form-label mb-1 small">Fuente de información</label>
                    <input class="form-control form-control-sm" list="dl-ind-finfo" @bind="form.FuenteInformacion" />
                </div>
            </SeccionFormulario>

            <SeccionFormulario Titulo="Meta y periodicidad">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label mb-1 small">Objetivo (como se escribe)</label>
                    <input class="form-control form-control-sm" placeholder="mayor = 90%" @bind="form.Objetivo" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label mb-1 small">Meta (para evaluar)</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select form-select-sm" style="max-width:72px;" @bind="form.OperadorMeta">
                            <option value=">=">≥</option>
                            <option value=">">&gt;</option>
                            <option value="<=">≤</option>
                            <option value="<">&lt;</option>
                            <option value="=">=</option>
                        </select>
                        <input type="number" step="any" class="form-control" @bind="form.Meta" />
                    </div>
                </div>
                <div class="col-sm-4 col-lg-2">
                    <label class="form-label mb-1 small">Unidad</label>
                    <select class="form-select form-select-sm" @bind="form.Unidad">
                        <option value="porcentaje">Porcentaje</option>
                        <option value="dias">Días</option>
                        <option value="numero">Número</option>
                    </select>
                </div>
                <div class="col-sm-4 col-lg-2">
                    <label class="form-label mb-1 small">Tendencia</label>
                    <select class="form-select form-select-sm" @bind="form.Tendencia">
                        <option value="positiva">Positiva</option>
                        <option value="negativa">Negativa</option>
                    </select>
                </div>
                <div class="col-sm-4 col-lg-2">
                    <label class="form-label mb-1 small">Frecuencia</label>
                    <select class="form-select form-select-sm" @bind="form.Frecuencia">
                        @foreach (var f in Enum.GetValues<FrecuenciaIndicador>())
                        {
                            <option value="@f">@CalculoIndicadores.NombreFrecuencia(f)</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <label class="form-label mb-1 small">Frecuencia (como se escribe)</label>
                    <input class="form-control form-control-sm" placeholder="@CalculoIndicadores.NombreFrecuencia(form.Frecuencia)" @bind="form.FrecuenciaTexto" />
                </div>
                <div class="col-sm-6 col-lg-4">
                    <label class="form-label mb-1 small">Periodo de cálculo</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select form-select-sm" value="@(form.Acumulado ? "acum" : "periodo")" @onchange="@(e => form.Acumulado = e.Value?.ToString() == "acum")">
                            <option value="periodo">Solo el periodo</option>
                            <option value="acum">Acumulado desde</option>
                        </select>
                        @if (form.Acumulado)
                        {
                            <input type="date" class="form-control" @bind="form.FechaInicio" />
                        }
                    </div>
                </div>
            </SeccionFormulario>

            <SeccionFormulario Titulo="Vigencia" SinFila="true">
            <div class="ind-estado-fila mt-0">
                <label class="ind-interruptor" title="@(form.Inactivo ? "Inactivo: no sale en las vistas" : "Activo")">
                    <input type="checkbox" checked="@(!form.Inactivo)" @onchange="@(e => CambiarActivo(e.Value is true))" />
                    <span class="ind-interruptor-pista"></span>
                    <span>@(form.Inactivo ? "Inactivo" : "Activo")</span>
                </label>
                <div class="input-group input-group-sm" style="width:auto;">
                    <span class="input-group-text">Medir hasta</span>
                    <input type="date" class="form-control" @bind="form.FechaFin" />
                    @if (form.FechaFin is not null)
                    {
                        <button type="button" class="btn btn-outline-secondary" title="Sin fecha final" @onclick="() => form.FechaFin = null">✕</button>
                    }
                </div>
            </div>

            </SeccionFormulario>

            @* Origen del dato: se digita o se calcula desde otra interfaz *@
            <SeccionFormulario Titulo="Origen del dato" SinFila="true">
            <div class="ind-fuentes mt-0">
                @foreach (var f in Enum.GetValues<FuenteIndicador>())
                {
                    var fuente = f;
                    <button type="button" class="ind-fuente @(form.Fuente == fuente ? "activo" : "")" @onclick="() => CambiarFuente(fuente)">
                        <span class="ind-fuente-ico">@IconoFuente(fuente)</span>
                        <span>@CalculoIndicadores.NombreFuente(fuente)</span>
                    </button>
                }
            </div>

            @if (form.Fuente == FuenteIndicador.Comunicados)
            {
                <div class="row g-2 ind-config">
                    <div class="col-sm-4 col-lg-3">
                        <label class="form-label mb-1 small">Cálculo</label>
                        <select class="form-select form-select-sm" value="@formCfg.Calculo" @onchange="CambiarCalculoComunicados">
                            <option value="cobertura">Cobertura: respondidos / requieren respuesta × 100</option>
                            <option value="oportunidad">Oportunidad: respondidos en el plazo / requieren respuesta × 100</option>
                            <option value="tiempo">Tiempo promedio de respuesta (días)</option>
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label mb-1 small">Sentido</label>
                        <select class="form-select form-select-sm" @bind="formCfg.Sentido">
                            <option value="Entrada">Entrada</option>
                            <option value="Salida">Salida</option>
                            <option value="">Todos</option>
                        </select>
                    </div>
                    <div class="col-sm-5 col-lg-4">
                        <label class="form-label mb-1 small">Remitente contiene</label>
                        <input class="form-control form-control-sm" list="dl-ind-rem" placeholder="Todos" @bind="formCfg.Remitente" />
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label mb-1 small">Plazo (días)</label>
                        <input type="number" min="0" class="form-control form-control-sm" placeholder="@ctx.Ajustes.PlazoDias" disabled="@(formCfg.Calculo != "oportunidad")" @bind="formCfg.PlazoDias" />
                    </div>
                </div>
            }
            else if (form.Fuente == FuenteIndicador.CumplimientoPie)
            {
                <div class="row g-2 ind-config">
                    <div class="col-sm-6 col-lg-4">
                        <label class="form-label mb-1 small" title="Por defecto; cada mes se puede cambiar">Medir con</label>
                        <select class="form-select form-select-sm" @bind="formCfg.BasePie">
                            @foreach (var b in CalculoIndicadores.BasesPie)
                            {
                                <option value="@b.Clave">@b.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
            }
            else if (form.Fuente == FuenteIndicador.PlanesAccion)
            {
                <div class="ind-config">
                    @Pildoras("Tipo de hallazgo", tiposHallazgo, formCfg.TiposHallazgo)
                    @Pildoras("Origen del hallazgo", origenes, formCfg.Origenes)
                    @Pildoras("Proceso", procesos, formCfg.Procesos)
                </div>
            }

            @if (CalculoIndicadores.Calculado(form.Fuente))
            {
                var mesPrev = UltimoCierre(form);
                var prev = Previa(mesPrev.Anio, mesPrev.Mes);
                <div class="ind-previa">
                    <span class="ind-previa-per">@CalculoIndicadores.NombrePeriodo(FormComoIndicador(), mesPrev.Anio, mesPrev.Mes)</span>
                    <span class="ind-previa-val @ClaseCumple(FormComoIndicador(), prev?.Valor)">@(prev is null ? "—" : prev.NoAplica || prev.Valor is null ? "N/A" : CalculoIndicadores.Formato(FormComoIndicador(), prev.Valor))</span>
                    <span class="ind-previa-det">@prev?.Detalle</span>
                </div>
            }

            </SeccionFormulario>
        </ChildContent>
        <Acciones>
            <button type="button" class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => form = null"><Ico Nombre="cancelar" /></button>
            <button type="button" class="btn btn-primary btn-sm" title="Guardar" disabled="@(guardando || string.IsNullOrWhiteSpace(form.Nombre))" @onclick="GuardarForm"><Ico Nombre="guardar" /></button>
        </Acciones>
    </FormularioSig>
}
<datalist id="dl-ind-tipo"><option value="Eficacia"></option><option value="Eficiencia"></option><option value="Efectividad"></option><option value="cualitativo y/o cuantitativo"></option>@foreach (var o in indicadores.Select(i => i.TipoIndicador).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct()) { <option value="@o"></option> }</datalist>
<datalist id="dl-ind-resp">@foreach (var o in indicadores.Select(i => i.Responsable).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct()) { <option value="@o"></option> }</datalist>
<datalist id="dl-ind-finfo">@foreach (var o in indicadores.Select(i => i.FuenteInformacion).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct()) { <option value="@o"></option> }</datalist>
<datalist id="dl-ind-rem">@foreach (var o in remitentes) { <option value="@o"></option> }</datalist>

@* ---------- Eliminar (Papelera, con sus mediciones y soportes) ---------- *@
@if (elimId is int eid && indicadores.FirstOrDefault(i => i.Id == eid) is { } indElim)
{
    <div class="card panel-formulario mb-3 border-danger">
        <div class="card-body">
            <div class="mb-2"><Ico Nombre="eliminar" /> <strong>@indElim.Nombre</strong></div>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2">
                <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => elimId = null"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@(impacto is null || (impacto.RequiereEntender && !impactoOk))" @onclick="ConfirmarEliminar"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}

@* ---------- Congelar un periodo para todos los indicadores ---------- *@
@if (congelarMes is int cm)
{
    var lista = PorCongelar(cm);
    <div class="card panel-formulario mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <Ico Nombre="candado" />
                <select class="form-select form-select-sm" style="width:auto;" value="@cm" @onchange="@(e => congelarMes = int.TryParse(e.Value?.ToString(), out var v) ? v : cm)">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var mm = m;
                        <option value="@mm">@CalculoIndicadores.Mes(anio, mm)</option>
                    }
                </select>
                <span class="small text-muted">@lista.Count indicador(es)</span>
            </div>
            @if (lista.Count > 0)
            {
                <table class="table table-sm tabla-compacta mb-2 ind-tabla-congelar">
                    <tbody>
                        @foreach (var x in lista)
                        {
                            <tr>
                                <td class="small">@x.Ind.Nombre</td>
                                <td class="small text-muted">@CalculoIndicadores.NombreFuente(x.Ind.Fuente)</td>
                                <td class="small text-end fw-semibold">@x.Texto</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => congelarMes = null"><Ico Nombre="cancelar" /></button>
                <button type="button" class="btn btn-primary btn-sm" title="Congelar" disabled="@(lista.Count == 0 || guardando)" @onclick="() => CongelarPeriodo(cm)"><Ico Nombre="candado" /> @lista.Count</button>
            </div>
        </div>
    </div>
}

@* ---------- Filtros ---------- *@
<div class="mpie-barra mb-2 ind-filtros">
    <select class="form-select form-select-sm" style="width:auto;" title="Año" value="@anio" @onchange="CambiarAnio">
        @foreach (var a in anios)
        {
            <option value="@a">@a</option>
        }
    </select>
    <select class="form-select form-select-sm" style="width:auto;" title="Fuente" @bind="fFuente">
        <option value="">Todas las fuentes</option>
        @foreach (var f in Enum.GetValues<FuenteIndicador>())
        {
            <option value="@((int)f)">@CalculoIndicadores.NombreFuente(f)</option>
        }
    </select>
    <input class="form-control form-control-sm" style="max-width:260px;" placeholder="Buscar indicador…" @bind="buscar" @bind:event="oninput" />
    @if (indicadores.Any(i => i.Inactivo))
    {
        <label class="form-check form-check-inline mb-0 small"><input class="form-check-input" type="checkbox" @bind="verInactivos" /> Ver inactivos (@indicadores.Count(i => i.Inactivo))</label>
    }
    <span class="ind-leyenda">
        <span class="ind-ley ind-ok">Cumple</span>
        <span class="ind-ley ind-mal">No cumple</span>
        <span class="ind-ley ind-na">N/A</span>
        <span class="ind-ley"><Ico Nombre="candado" /> Congelado</span>
        <span class="ind-ley ind-vivo-ley">En vivo</span>
    </span>
</div>

@if (vista == "indicador")
{
    var foco = Mostrados.FirstOrDefault(i => i.Id == selId) ?? Mostrados.FirstOrDefault();
    <div class="ind-foco">
        @* Lista de indicadores: valor más reciente y los 12 meses en miniatura *@
        <nav class="ind-rail">
            @foreach (var ind in Mostrados)
            {
                var i = ind;
                var ult = UltimoMedido(i);
                <button type="button" class="ind-rail-item @(foco?.Id == i.Id ? "activo" : "")" @onclick="() => Enfocar(i)">
                    <span class="ind-rail-cab">
                        <span class="ind-rail-ico ind-origen-@((int)i.Fuente)" title="@CalculoIndicadores.NombreFuente(i.Fuente)">@IconoFuente(i.Fuente)</span>
                        <span class="ind-rail-nom">@i.Nombre @if (i.Inactivo) { <span class="ind-inactivo">Inactivo</span> }</span>
                        <span class="ind-rail-val @(ult is null ? "" : ult.Value.C.Clase)">@(ult?.C.Texto ?? "—")</span>
                    </span>
                    <span class="ind-tira">
                        @for (var m = 1; m <= 12; m++)
                        {
                            var c = CeldaDe(i, m);
                            <span class="ind-tira-m @c.Clase" title="@($"{CalculoIndicadores.Mes(anio, m)}: {(c.Texto == "" ? "—" : c.Texto)}")"></span>
                        }
                    </span>
                </button>
            }
            @if (!Mostrados.Any())
            {
                <span class="text-muted small p-2">Sin indicadores.</span>
            }
        </nav>

        @if (foco is not null)
        {
            var f = foco;
            var ult = UltimoMedido(f);
            var res = ResumenAnio(f);
            var lista = Mostrados.ToList();
            var pos = lista.FindIndex(x => x.Id == f.Id);
            <section class="ind-det">
                <div class="ind-det-cab">
                    <button type="button" class="ind-nav" title="Anterior" disabled="@(pos <= 0)" @onclick="() => Enfocar(lista[pos - 1])">‹</button>
                    <div class="ind-det-tits">
                        <h2 class="ind-det-nom">@f.Nombre</h2>
                        <div class="ind-chips">
                            <span class="ind-origen ind-origen-@((int)f.Fuente)">@IconoFuente(f.Fuente) @CalculoIndicadores.NombreFuente(f.Fuente)</span>
                            <span class="ind-chip">@(string.IsNullOrWhiteSpace(f.FrecuenciaTexto) ? CalculoIndicadores.NombreFrecuencia(f.Frecuencia) : f.FrecuenciaTexto)</span>
                            @if (!string.IsNullOrWhiteSpace(f.TipoIndicador)) { <span class="ind-chip">@f.TipoIndicador</span> }
                            @if (!string.IsNullOrWhiteSpace(f.Responsable)) { <span class="ind-chip">@f.Responsable</span> }
                            <span class="ind-chip">Tendencia @f.Tendencia</span>
                            @if (f.FechaFin is DateTime ff) { <span class="ind-chip @(f.Inactivo ? "ind-chip-off" : "")">@(f.Inactivo ? "Inactivo · " : "")Hasta @ff.ToString("dd/MM/yyyy")</span> }
                            else if (f.Inactivo) { <span class="ind-chip ind-chip-off">Inactivo</span> }
                        </div>
                    </div>
                    <span class="ind-det-pos">@(pos + 1) / @lista.Count</span>
                    <button type="button" class="ind-nav" title="Siguiente" disabled="@(pos >= lista.Count - 1)" @onclick="() => Enfocar(lista[pos + 1])">›</button>
                </div>

                <div class="ind-kpis">
                    <div class="ind-kpi ind-kpi-grande @(ult is null ? "" : ult.Value.C.Clase)">
                        <span class="ind-kpi-tit">@(ult is null ? "Sin medición" : $"Último · {CalculoIndicadores.Mes(anio, ult.Value.Mes)}")</span>
                        <span class="ind-kpi-val">@(ult?.C.Texto ?? "—")</span>
                        @if (ult is not null)
                        {
                            <span class="ind-kpi-est">@(CalculoIndicadores.Cumple(f, ult.Value.C.Valor) switch { true => "Cumple la meta", false => "No cumple la meta", _ => "" })@(ult.Value.C.Congelado ? " · congelado" : CalculoIndicadores.Calculado(f.Fuente) ? " · en vivo" : "")</span>
                        }
                    </div>
                    <div class="ind-kpi ind-kpi-meta">
                        <span class="ind-kpi-tit">Meta @Operador(f.OperadorMeta) @CalculoIndicadores.Formato(f, f.Meta)</span>
                        <div class="ind-barra" title="@(ult is null ? "" : $"{ult.Value.C.Texto} frente a la meta")">
                            <span class="ind-barra-relleno @(ult is null ? "" : ult.Value.C.Clase)" style="width:@Pct(f, ult?.C.Valor)%;"></span>
                            @if (f.Meta is decimal)
                            {
                                <span class="ind-barra-meta" style="left:@Pct(f, f.Meta)%;"></span>
                            }
                        </div>
                        <span class="ind-kpi-sub">@f.Objetivo</span>
                    </div>
                    <div class="ind-kpi">
                        <span class="ind-kpi-tit">Meses que cumplen</span>
                        <span class="ind-kpi-val">@res.Cumplen<small> / @res.Medidos</small></span>
                        <span class="ind-kpi-sub">@anio</span>
                    </div>
                    <div class="ind-kpi">
                        <span class="ind-kpi-tit">Promedio del año</span>
                        <span class="ind-kpi-val">@CalculoIndicadores.Formato(f, res.Promedio)</span>
