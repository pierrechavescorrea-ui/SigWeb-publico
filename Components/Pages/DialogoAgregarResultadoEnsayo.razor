@* Captura manual (o edición) de un resultado de ensayo, a partir de la
   plantilla de campos del Tipo de Ensayo. Los campos de tipo Fórmula se
   recalculan solos mientras se escribe; Torre y Elemento se resuelven
   igual que en la carga por Excel, para que este resultado también
   aparezca automáticamente en Trazado. *@
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.Ensayos
@using SigWeb.Models
@inject AppDbContext Db
@inject IWebHostEnvironment Env

<div class="modal-backdrop-custom">
    <div class="modal-box-custom" style="@(cantidadCilindros > 1 ? "max-width: 96vw; width: 96vw;" : "max-width: 900px;")">
        @if (guardando)
        {
            <div class="overlay-procesando">
                <div class="spinner-border text-primary" role="status"></div>
                <div>Guardando...</div>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">
                @(esEdicion
                    ? (editandoLote ? $"Editar muestra ({cantidadCilindros} {(ClaveCampoCilindro is not null ? "cilindros" : "resultados")})" : "Editar resultado")
                    : (cantidadCilindros > 1 ? $"Agregar {(ClaveCampoCilindro is not null ? $"muestra ({cantidadCilindros} cilindros)" : $"{cantidadCilindros} resultados")}" : "Agregar resultado"))
            </h5>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="Cerrar"></button>
        </div>

        @if (usaTorre)
        {
            <div class="row g-2 mb-2">
                <div class="col-md-4">
                    <label class="form-label mb-1 small">Torre</label>
                    <input class="form-control form-control-sm" list="listaTorresDialogo" value="@torreTexto"
                           @oninput="@(e => { torreTexto = e.Value?.ToString() ?? ""; ActualizarPreviewElemento(); })" placeholder="Código de torre" />
                    <datalist id="listaTorresDialogo">
                        @foreach (var t in torresDisponibles)
                        {
                            <option value="@t"></option>
                        }
                    </datalist>
                    @if (!string.IsNullOrWhiteSpace(torreTexto) && !torreResuelta)
                    {
                        <div class="form-text text-warning">No se encontró esa torre; se guarda sin asociar.</div>
                    }
                </div>
                @if (!ModoLote && mostrarElemento)
                {
                    <div class="col-md-4">
                        <label class="form-label mb-1 small">Elemento (pata)</label>
                        <input class="form-control form-control-sm" value="@elementoTexto"
                               @oninput="@(e => { elementoTexto = e.Value?.ToString() ?? ""; ActualizarPreviewElemento(); })" placeholder="Ej: B, BC, B (PED)..." />
                        <div class="form-text">@previewElemento</div>
                    </div>
                }
                @if (!ModoLote && mostrarInforme)
                {
                    <div class="col-md-4">
                        <label class="form-label mb-1 small">No. Informe</label>
                        <input class="form-control form-control-sm" @bind="informeNumero" placeholder="Opcional" />
                    </div>
                }
            </div>

            <div class="row g-2 mb-2">
                @if (mostrarDisenoMezcla)
                {
                    <div class="col-md-6">
                        <label class="form-label mb-1 small">Diseño de mezcla — código</label>
                        <input class="form-control form-control-sm mb-1" @bind="disenoMezclaCodigo" placeholder="Ej: BO-DP-295-2026" />
                        <InputFile class="form-control form-control-sm" OnChange="SeleccionarDisenoMezcla" accept=".pdf,image/*" />
                        @if (!string.IsNullOrWhiteSpace(disenoMezclaArchivoActual))
                        {
                            <div class="form-text"><a href="@disenoMezclaArchivoActual" target="_blank" rel="noopener" class="text-decoration-none">📄 Archivo actual</a></div>
                        }
                    </div>
                }
                @if (!ModoLote && mostrarInforme)
                {
                    <div class="col-md-6">
                        <label class="form-label mb-1 small">Informe — adjuntar PDF(s)</label>
                        <InputFile class="form-control form-control-sm" OnChange="SeleccionarArchivosInforme" multiple accept=".pdf" />
                        @if (archivosInformeExistentes.Count > 0)
                        {
                            <ul class="small ps-3 mt-1 mb-0">
                                @foreach (var archivoExistente in archivosInformeExistentes)
                                {
                                    <li>
                                        <a href="@archivoExistente.RutaArchivo" target="_blank" rel="noopener" class="text-decoration-none">📄 @archivoExistente.NombreOriginal</a>
                                        <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1" title="Quitar"
                                                @onclick="() => EliminarArchivoInformeExistente(archivoExistente, archivosInformeExistentes)">✕</button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row g-2 mb-2">
                <div class="col-md-3">
                    <label class="form-label mb-1 small">Localización</label>
                    <input class="form-control form-control-sm" list="listaLocalizacionesDialogo" value="@localizacionTexto"
                           @oninput="@(e => { localizacionTexto = e.Value?.ToString() ?? ""; confirmandoNuevaLocalizacion = false; ActualizarPreviewElemento(); })"
                           placeholder="Ej: PR12+300, Sitio 3, Vía El Pepino..." />
                    <datalist id="listaLocalizacionesDialogo">
                        @foreach (var l in localizacionesDisponibles)
                        {
                            <option value="@l"></option>
                        }
                    </datalist>
                </div>
                @if (!ModoLote && mostrarElemento)
                {
                    <div class="col-md-3">
                        <label class="form-label mb-1 small">Elemento</label>
                        <input class="form-control form-control-sm" value="@elementoTexto"
                               @oninput="@(e => { elementoTexto = e.Value?.ToString() ?? ""; ActualizarPreviewElemento(); })" placeholder="Ej: Capa 1, Relleno, A, B, Trincho..." />
                        <div class="form-text">@previewElemento</div>
                    </div>
                }
                @if (!ModoLote && mostrarInforme)
                {
                    <div class="col-md-3">
                        <label class="form-label mb-1 small">No. Informe</label>
                        <input class="form-control form-control-sm" @bind="informeNumero" placeholder="Opcional" />
                    </div>
                }
                @if (!ModoLote && mostrarFechaEjecucion)
                {
                    <div class="col-md-3">
                        <label class="form-label mb-1 small">Fecha de ejecución</label>
                        <input type="date" class="form-control form-control-sm" value="@fechaEjecucionTexto"
                               @onchange="@(e => fechaEjecucionTexto = e.Value?.ToString() ?? "")" />
                    </div>
                }
            </div>

            @if (confirmandoNuevaLocalizacion)
            {
                <div class="alert alert-warning py-2 small d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <span>La localización "<strong>@localizacionPendienteTexto</strong>" no existe en el catálogo. ¿Deseas agregarla y continuar?</span>
                    <span class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-primary" @onclick="ConfirmarNuevaLocalizacion">Sí, agregar y guardar</button>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelarNuevaLocalizacion" title="Cancelar"><Ico Nombre="cancelar" /></button>
                    </span>
                </div>
            }

            @if (!ModoLote && mostrarInforme)
            {
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="form-label mb-1 small">Informe — adjuntar PDF(s)</label>
                        <InputFile class="form-control form-control-sm" OnChange="SeleccionarArchivosInforme" multiple accept=".pdf" />
                        @if (archivosInformeExistentes.Count > 0)
                        {
                            <ul class="small ps-3 mt-1 mb-0">
                                @foreach (var archivoExistente in archivosInformeExistentes)
                                {
                                    <li>
                                        <a href="@archivoExistente.RutaArchivo" target="_blank" rel="noopener" class="text-decoration-none">📄 @archivoExistente.NombreOriginal</a>
                                        <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1" title="Quitar"
                                                @onclick="() => EliminarArchivoInformeExistente(archivoExistente, archivosInformeExistentes)">✕</button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        }

        @if (!esEdicion)
        {
            <div class="row g-2 mb-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label mb-1 small">@(ClaveCampoCilindro is not null ? "Cilindros de la muestra" : "Resultados a agregar")</label>
                    <input type="number" min="1" max="24" class="form-control form-control-sm" value="@cantidadCilindros"
                           @onchange="@(e => CambiarCantidadCilindros(e.Value?.ToString()))" />
                </div>
                @if (cantidadCilindros > 1 && ClaveCampoMuestra is not null)
                {
                    <div class="col-md-3">
                        <label class="form-label mb-1 small">No. Muestra (para los @cantidadCilindros cilindros)</label>
                        <input class="form-control form-control-sm" value="@ObtenerValor(ClaveCampoMuestra)"
                               @onchange="@(e => ActualizarMuestraCompartida(e.Value?.ToString() ?? ""))" />
                    </div>
                }
                @if (cantidadCilindros > 1 && ClaveCampoFechaMuestra is not null)
                {
                    <div class="col-md-3">
                        <label class="form-label mb-1 small">Fecha muestra (para los @cantidadCilindros cilindros)</label>
                        <input type="date" class="form-control form-control-sm" value="@ObtenerValor(ClaveCampoFechaMuestra)"
                               @onchange="@(e => ActualizarFechaMuestraCompartida(e.Value?.ToString() ?? ""))" />
                    </div>
                }
            </div>
        }
        @if (UsaInformePorEdadLote)
        {
            <div class="row g-2 mb-2">
                <div class="col-12">
                    <label class="form-label mb-1 small">No. de informe por edad de ensayo</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var edad in EdadesUnicasEnLote)
                        {
                            <div style="min-width:220px;">
                                <label class="form-label mb-1 small text-muted">@edad días</label>
                                <input class="form-control form-control-sm mb-1" placeholder="No. Informe" value="@ObtenerInformeParaEdad(edad)"
                                       @onchange="@(e => ActualizarInformeParaEdad(edad, e.Value?.ToString() ?? ""))" />
                                <InputFile class="form-control form-control-sm" multiple accept=".pdf,.xlsx,.xls,.doc,.docx,image/*"
                                           OnChange="@(e => SeleccionarArchivosEdad(edad, e))" />
                                @if (archivosExistentesPorEdad.TryGetValue(edad, out var existentesEdad) && existentesEdad.Count > 0)
                                {
                                    <ul class="small ps-3 mt-1 mb-0">
                                        @foreach (var archivoExistente in existentesEdad)
                                        {
                                            <li>
                                                <a href="@archivoExistente.RutaArchivo" target="_blank" rel="noopener" class="text-decoration-none">📄 @archivoExistente.NombreOriginal</a>
                                                <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1" title="Quitar"
                                                        @onclick="() => EliminarArchivoInformeExistente(archivoExistente, existentesEdad)">✕</button>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!ModoLote && esElementoEspecial)
        {
            <div class="row g-2 mb-2">
                <div class="col-md-4">
                    <label class="form-label mb-1 small">Nombre para este elemento en Trazado</label>
                    <input class="form-control form-control-sm" list="listaElementosEspecialesDialogo" @bind="elementoEspecialNombre" />
                    <datalist id="listaElementosEspecialesDialogo">
                        @foreach (var n in elementosEspecialesDeTorre)
                        {
                            <option value="@n"></option>
                        }
                    </datalist>
                </div>
            </div>
        }

        @if (ModoLote)
        {
            <div class="d-flex justify-content-end align-items-center gap-2 mb-1">
                <label class="form-label mb-0 small text-muted">Tamaño de la tabla</label>
                <input type="range" min="65" max="100" step="5" class="form-range" style="width:120px;" value="@escalaTablaLote"
                       @oninput="@(e => escalaTablaLote = int.TryParse(e.Value?.ToString(), out var n) ? n : escalaTablaLote)" />
                <span class="small text-muted" style="width:34px;">@(escalaTablaLote)%</span>
            </div>
            <div class="table-responsive mb-2 tabla-lote-cilindros modal-area-flexible" style="zoom:@(escalaTablaLote)%;">
                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="col-cilindro">@(ClaveCampoCilindro is not null ? "Cilindro" : "#")</th>
                            <th class="th-campo-diligenciar">@(usaTorre ? "Elemento (pata)" : "Elemento")</th>
                            @foreach (var campo in CamposTabla)
                            {
                                <th class="@(EsCampoResaltable(campo) ? "th-campo-diligenciar" : "")">@campo.Etiqueta@(string.IsNullOrEmpty(campo.Unidad) ? "" : $" ({campo.Unidad})")</th>
                            }
                            @if (!usaTorre)
                            {
                                <th class="th-campo-diligenciar">Fecha de ejecución</th>
                            }
                            @if (UsaInformePorFilaLote)
                            {
                                <th>No. Informe</th>
                                <th>Informe (PDF)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < filasCilindros.Count; i++)
                        {
                            var indice = i;
                            var fila = filasCilindros[i];
                            <tr>
                                <td class="col-cilindro text-muted text-center fw-semibold">@(ClaveCampoCilindro is string cc ? ObtenerValorFila(fila, cc) : (indice + 1).ToString())</td>
                                <td>
                                    <input class="form-control form-control-sm" value="@ObtenerValorFila(fila, ClaveElementoFila)"
                                           placeholder="@elementoTexto"
                                           @onchange="@(e => ActualizarValorFila(indice, ClaveElementoFila, e.Value?.ToString() ?? ""))" />
                                </td>
                                @foreach (var campo in CamposTabla)
                                {
                                    <td>
                                        @if (campo.Clave == ClaveCampoFechaEnsayo)
                                        {
                                            <span class="small text-muted" title="Se calcula sola: Fecha muestra + Edad">@ObtenerValorFila(fila, campo.Clave)</span>
                                        }
                                        else if (campo.TipoDato == TipoDatoCampoEnsayo.Formula)
                                        {
                                            <span class="small text-muted">@ObtenerValorFila(fila, campo.Clave)</span>
                                        }
                                        else if (EsCampoDiametro(campo))
                                        {
                                            <div class="d-flex gap-1 flex-nowrap">
                                                <select class="form-select form-select-sm" value="@OpcionDiametro(ObtenerValorFila(fila, campo.Clave))"
                                                        @onchange="@(e => ActualizarValorFila(indice, campo.Clave, e.Value?.ToString() == "otro" ? "" : e.Value?.ToString() ?? ""))">
                                                    @foreach (var d in DiametrosPreset)
                                                    {
                                                        <option value="@d.Valor">@d.Etiqueta</option>
                                                    }
                                                    <option value="otro">Otro</option>
                                                </select>
                                                @if (OpcionDiametro(ObtenerValorFila(fila, campo.Clave)) == "otro")
                                                {
                                                    <input type="number" step="any" class="form-control form-control-sm" placeholder="mm" value="@ObtenerValorFila(fila, campo.Clave)"
                                                           @onchange="@(e => ActualizarValorFila(indice, campo.Clave, e.Value?.ToString() ?? ""))" />
                                                }
                                            </div>
                                        }
                                        else if (campo.TipoDato == TipoDatoCampoEnsayo.Fecha)
                                        {
                                            <input type="date" class="form-control form-control-sm" value="@ObtenerValorFila(fila, campo.Clave)"
                                                   @onchange="@(e => ActualizarValorFila(indice, campo.Clave, e.Value?.ToString() ?? ""))" />
                                        }
                                        else if (campo.TipoDato == TipoDatoCampoEnsayo.Numero)
                                        {
                                            <input type="number" step="any" class="form-control form-control-sm" value="@ObtenerValorFila(fila, campo.Clave)"
                                                   @onchange="@(e => ActualizarValorFila(indice, campo.Clave, e.Value?.ToString() ?? ""))" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm" value="@ObtenerValorFila(fila, campo.Clave)"
                                                   @onchange="@(e => ActualizarValorFila(indice, campo.Clave, e.Value?.ToString() ?? ""))" />
                                        }
                                    </td>
                                }
                                @if (!usaTorre)
                                {
                                    <td>
                                        <input type="date" class="form-control form-control-sm" value="@ObtenerValorFila(fila, ClaveFechaEjecucionFila)"
                                               @onchange="@(e => ActualizarValorFila(indice, ClaveFechaEjecucionFila, e.Value?.ToString() ?? ""))" />
                                    </td>
                                }
                                @if (UsaInformePorFilaLote)
                                {
                                    <td>
                                        <input class="form-control form-control-sm" placeholder="Opcional" value="@ObtenerInformeParaFila(indice)"
                                               @onchange="@(e => ActualizarInformeParaFila(indice, e.Value?.ToString() ?? ""))" />
                                    </td>
                                    <td>
                                        <InputFile class="form-control form-control-sm" multiple accept=".pdf" OnChange="@(e => SeleccionarArchivosFila(indice, e))" />
                                        @if (archivosExistentesPorFila.TryGetValue(indice, out var existentesFila) && existentesFila.Count > 0)
                                        {
                                            <ul class="small ps-3 mt-1 mb-0">
                                                @foreach (var archivoExistente in existentesFila)
                                                {
                                                    <li>
                                                        <a href="@archivoExistente.RutaArchivo" target="_blank" rel="noopener" class="text-decoration-none">📄 @archivoExistente.NombreOriginal</a>
                                                        <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1" title="Quitar"
                                                                @onclick="() => EliminarArchivoInformeExistente(archivoExistente, existentesFila)">✕</button>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="row g-2 mb-2">
                <div class="row g-2">
                    @foreach (var campo in campos)
                    {
                        <div class="col-md-3">
                            <label class="form-label mb-1 small @(EsCampoResaltable(campo) ? "label-campo-diligenciar" : "")">@campo.Etiqueta@(string.IsNullOrEmpty(campo.Unidad) ? "" : $" ({campo.Unidad})")</label>
                            @if (campo.Clave == ClaveCampoFechaEnsayo)
                            {
                                <input class="form-control form-control-sm" readonly title="Se calcula sola: Fecha muestra + Edad" value="@ObtenerValor(campo.Clave)" />
                            }
                            else if (campo.TipoDato == TipoDatoCampoEnsayo.Formula)
                            {
                                <input class="form-control form-control-sm" readonly value="@ObtenerValor(campo.Clave)" />
                            }
                            else if (EsCampoDiametro(campo))
                            {
                                <select class="form-select form-select-sm" value="@OpcionDiametro(ObtenerValor(campo.Clave))"
                                        @onchange="@(e => ActualizarValor(campo.Clave, e.Value?.ToString() == "otro" ? "" : e.Value?.ToString() ?? ""))">
                                    @foreach (var d in DiametrosPreset)
                                    {
                                        <option value="@d.Valor">@d.Etiqueta</option>
                                    }
                                    <option value="otro">Otro (mm)</option>
                                </select>
                                @if (OpcionDiametro(ObtenerValor(campo.Clave)) == "otro")
                                {
                                    <input type="number" step="any" class="form-control form-control-sm mt-1" placeholder="mm" value="@ObtenerValor(campo.Clave)"
                                           @onchange="@(e => ActualizarValor(campo.Clave, e.Value?.ToString() ?? ""))" />
                                }
                            }
                            else if (campo.TipoDato == TipoDatoCampoEnsayo.Fecha)
                            {
                                <input type="date" class="form-control form-control-sm" value="@ObtenerValor(campo.Clave)"
                                       @onchange="@(e => ActualizarValor(campo.Clave, e.Value?.ToString() ?? ""))" />
                            }
                            else if (campo.TipoDato == TipoDatoCampoEnsayo.Numero)
                            {
                                <input type="number" step="any" class="form-control form-control-sm" value="@ObtenerValor(campo.Clave)"
                                       @onchange="@(e => ActualizarValor(campo.Clave, e.Value?.ToString() ?? ""))" />
                            }
                            else
                            {
                                <input class="form-control form-control-sm" value="@ObtenerValor(campo.Clave)"
                                       @onchange="@(e => ActualizarValor(campo.Clave, e.Value?.ToString() ?? ""))" />
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (CamposConAdjunto.Count > 0)
        {
            <div class="row g-2 mb-2">
                @foreach (var campo in CamposConAdjunto)
                {
                    <div class="col-md-4">
                        <label class="form-label mb-1 small">📄 @campo.Etiqueta</label>
                        <InputFile class="form-control form-control-sm" OnChange="@(e => SeleccionarAdjunto(campo.Clave, e.File))" />
                        @if (adjuntosPendientes.TryGetValue(campo.Clave, out var pend))
                        {
                            <div class="small text-muted text-truncate">@pend.Name</div>
                        }
                        else if (adjuntosActuales.TryGetValue(campo.Clave, out var act) && !adjuntosQuitar.Contains(campo.Clave))
                        {
                            <div class="small d-flex justify-content-between">
                                <a href="@act.Ruta" target="_blank" class="text-truncate text-decoration-none">📄 @act.Nombre</a>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Quitar adjunto" @onclick="() => adjuntosQuitar.Add(campo.Clave)">✕</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="alert alert-warning py-1">@mensaje</div>
        }

        <div class="d-flex justify-content-end gap-2 mt-2">
            <button class="btn btn-secondary btn-sm" @onclick="Cerrar" title="Cancelar"><Ico Nombre="cancelar" /></button>
            <button class="btn btn-primary btn-sm" disabled="@guardando" @onclick="Guardar">@(guardando ? "Guardando..." : "Guardar")</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int TipoEnsayoId { get; set; }
    [Parameter] public int? ResultadoEnsayoId { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }

    private bool esEdicion => ResultadoEnsayoId is not null;
    private List<CampoEnsayo> campos = new();
    private List<string> torresDisponibles = new();

    // true (por defecto): formulario ligado a Torre/Elemento(pata) de
    // Trazado, como Resistencia a la compresión. false: ensayos que no
