    // ---------- Lote de cilindros (crear varios resultados de una vez,
    // compartiendo torre/pata/muestra, con No. de cilindro consecutivo) ----------
    private int cantidadCilindros = 1;
    private List<Dictionary<string, string>> filasCilindros = new();
    private int ultimoCilindroRegistrado = 0;

    // Cuando se edita un resultado que comparte No. Muestra con otros
    // (una muestra de varios cilindros), se editan todos juntos en la
    // misma tabla de lote — editandoLote lo marca, e idsFilasCilindros
    // trae el Id real de cada fila (en el mismo orden que filasCilindros)
    // para actualizar esos registros en vez de crear nuevos.
    private bool editandoLote = false;
    private List<int> idsFilasCilindros = new();

    // Zoom propio de la tabla de cilindros (independiente del de la Vista
    // Excel): con muchos cilindros y columnas, reducir un poco el tamaño
    // ayuda a ver más sin tener que desplazarse tanto.
    private int escalaTablaLote = 100;

    // Está en modo tabla/lote siempre que haya más de un resultado, sea
    // creando varios de una vez o editando una muestra ya guardada — no
    // depende de que el Tipo de Ensayo tenga un campo "Cilindro": sirve
    // igual para cualquier Tipo de Ensayo (ej. 4 patas x 2 profundidades).
    private bool ModoLote => cantidadCilindros > 1;

    // Clave con la que cada fila del lote guarda su propio "Elemento" (no
    // es un CampoEnsayo real, es el mismo campo resultado.ElementoTexto
    // que en modo normal se diligencia una sola vez arriba) — así una
    // muestra puede variar el Elemento por fila (ej. cada pata de una
    // torre) en vez de compartir uno solo para todo el lote.
    private const string ClaveElementoFila = "__ElementoFila";

    // Igual que ClaveElementoFila, pero para la Fecha de ejecución (solo
    // aplica a Tipos que no usan Torre): cada fila del lote tiene su
    // propia fecha en vez de compartir una sola para todo el lote.
    private const string ClaveFechaEjecucionFila = "__FechaEjecucionFila";

    // Detecta genéricamente los campos "No. Muestra" y "No. Cilindro" por su
    // etiqueta (igual que EnsayosDatos.razor con ClaveCampoMuestra), en vez
    // de asumir una clave fija: no todos los Tipos de Ensayo tienen cilindros.
    private string? ClaveCampoCilindro =>
        campos.FirstOrDefault(c => c.Etiqueta.Contains("cilindro", StringComparison.OrdinalIgnoreCase))?.Clave;

    private string? ClaveCampoMuestra =>
        campos.FirstOrDefault(c => c.Etiqueta.Contains("muestra", StringComparison.OrdinalIgnoreCase)
            && !c.Etiqueta.Contains("fecha", StringComparison.OrdinalIgnoreCase))?.Clave;

    // Fecha muestra, Fecha ensayo y Edad: la primera se comparte entre los
    // cilindros del lote (se vacía el concreto el mismo día para todos),
    // la segunda se calcula sola (Fecha muestra + Edad) y no se edita.
    private string? ClaveCampoFechaMuestra =>
        campos.FirstOrDefault(c => c.Etiqueta.Contains("fecha", StringComparison.OrdinalIgnoreCase)
            && c.Etiqueta.Contains("muestra", StringComparison.OrdinalIgnoreCase))?.Clave;

    private string? ClaveCampoFechaEnsayo =>
        campos.FirstOrDefault(c => c.Etiqueta.Contains("fecha", StringComparison.OrdinalIgnoreCase)
            && c.Etiqueta.Contains("ensayo", StringComparison.OrdinalIgnoreCase))?.Clave;

    private string? ClaveCampoEdad =>
        campos.FirstOrDefault(c => c.Etiqueta.Contains("edad", StringComparison.OrdinalIgnoreCase))?.Clave;

    // Campos que se diligencian por cilindro en la tabla (todos menos el
    // No. de cilindro, que va aparte autonumerado, y la Muestra y Fecha de
    // muestra, que son compartidas y se editan arriba una sola vez).
    private List<CampoEnsayo> CamposTabla =>
        campos.Where(c => c.Clave != ClaveCampoCilindro && c.Clave != ClaveCampoMuestra && c.Clave != ClaveCampoFechaMuestra).ToList();

    // Diámetros típicos de cilindro de concreto, en mm (4" y 6"), para que
    // el usuario elija en vez de escribir el equivalente en milímetros a mano.
    private static readonly (string Valor, string Etiqueta)[] DiametrosPreset = new[]
    {
        ("101.6", "4″ (101.6)"),
        ("152.4", "6″ (152.4)"),
    };

    // Un campo "se resalta" cuando el usuario realmente tiene que
    // diligenciarlo a mano: no aplica a los que se calculan solos
    // (Fórmula) ni a la Fecha de ensayo (Fecha muestra + Edad).
    private bool EsCampoResaltable(CampoEnsayo campo) =>
        campo.Clave != ClaveCampoFechaEnsayo && campo.TipoDato != TipoDatoCampoEnsayo.Formula;

    private static bool EsCampoDiametro(CampoEnsayo campo) =>
        campo.Etiqueta.Contains("diámetro", StringComparison.OrdinalIgnoreCase)
        || campo.Etiqueta.Contains("diametro", StringComparison.OrdinalIgnoreCase);

    private static string OpcionDiametro(string valorActual) =>
        DiametrosPreset.Any(d => d.Valor == valorActual) ? valorActual : "otro";

    // ---------- Informe por edad de ensayo (modo lote) ----------
    // Si el Tipo de Ensayo tiene "Edad", cada edad distinta usada en el
    // lote (7, 14, 28 días...) lleva su propio No. de Informe, en vez de
    // uno solo compartido por todos los cilindros.
    private bool UsaInformePorEdadLote => ModoLote && ClaveCampoEdad is not null;

