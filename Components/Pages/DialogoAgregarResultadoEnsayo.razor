    // Se actualiza solo dentro de ActualizarPreviewElemento (evento), nunca
    // se consulta la base de datos directamente desde el marcado: eso
    // puede disparar "A second operation was started on this context..."
    // en Blazor Server si el render coincide con otra operación async.
    private bool torreResuelta = false;

    protected override void OnInitialized()
    {
        campos = Db.CamposEnsayo.AsNoTracking().Where(c => c.TipoEnsayoId == TipoEnsayoId && c.Activo).OrderBy(c => c.Orden).ToList();
        torresDisponibles = Db.ElementosTrazado.AsNoTracking().Where(t => !t.Eliminado).OrderBy(t => t.Codigo).Select(t => t.Codigo).ToList();
        var tipoEnsayo = Db.TiposEnsayo.AsNoTracking().FirstOrDefault(t => t.Id == TipoEnsayoId);
        usaTorre = tipoEnsayo?.UsaTorre ?? true;
        mostrarElemento = tipoEnsayo?.MostrarElemento ?? true;
        mostrarInforme = tipoEnsayo?.MostrarInforme ?? true;
        mostrarFechaEjecucion = tipoEnsayo?.MostrarFechaEjecucion ?? true;
        mostrarDisenoMezcla = tipoEnsayo?.MostrarDisenoMezcla ?? true;
        localizacionesDisponibles = Db.Catalogos.AsNoTracking()
            .Where(c => c.Tipo == TipoCatalogoLocalizacion && c.Activo)
            .OrderBy(c => c.Nombre).Select(c => c.Nombre).ToList();

        if (ResultadoEnsayoId is int id)
        {
            var r = Db.ResultadosEnsayo.AsNoTracking().FirstOrDefault(x => x.Id == id);
            if (r is not null)
            {
                elementoTexto = r.ElementoTexto;
                disenoMezclaCodigo = r.DisenoMezclaCodigo ?? "";
                disenoMezclaArchivoActual = r.DisenoMezclaArchivo;
                localizacionTexto = r.Localizacion ?? "";
                fechaEjecucionTexto = r.FechaEjecucion?.ToString("yyyy-MM-dd") ?? "";

                if (r.ElementoTrazadoId is int idTorre)
                {
                    torreTexto = Db.ElementosTrazado.AsNoTracking().FirstOrDefault(t => t.Id == idTorre)?.Codigo ?? "";
                    // Tipos que piden Localización en vez de Torre: si el resultado no trae texto de localización pero sí la
                    // torre que se está editando, se propone por defecto la localización del catálogo vinculada a esa torre
                    // (editable; no se borra nada).
                    if (!usaTorre && string.IsNullOrWhiteSpace(localizacionTexto))
                    {
                        localizacionTexto = Db.Catalogos.AsNoTracking()
                            .Where(c => c.Tipo == TipoCatalogoLocalizacion && c.Activo && c.ElementoTrazadoId == idTorre)
                            .OrderBy(c => c.Nombre).Select(c => c.Nombre).FirstOrDefault() ?? "";
                    }
                }
                if (r.InformeId is int idInforme)
                {
                    var informe = Db.Informes.AsNoTracking().FirstOrDefault(i => i.Id == idInforme);
                    informeNumero = informe?.Numero ?? "";
                    archivosInformeExistentes = Db.ArchivosInforme.AsNoTracking().Where(a => a.InformeId == idInforme).ToList();
                }

                if (r.SubElemento == SubElementoResultado.Otro)
                {
                    var idComponenteExistente = Db.ResultadosEnsayoComponente.AsNoTracking()
                        .Where(rc => rc.ResultadoEnsayoId == id).Select(rc => rc.ComponenteId).FirstOrDefault();
                    if (idComponenteExistente != 0)
                    {
                        elementoEspecialNombre = Db.Componentes.AsNoTracking()
                            .FirstOrDefault(c => c.Id == idComponenteExistente)?.Nombre ?? "";
                    }
                }

                var camposPorId = campos.ToDictionary(c => c.Id, c => c.Clave);
                foreach (var v in Db.ValoresCampoEnsayo.AsNoTracking().Where(v => v.ResultadoEnsayoId == id))
                {
                    if (camposPorId.TryGetValue(v.CampoEnsayoId, out var clave)) valores[clave] = v.Valor;
                }

                // Si este resultado comparte No. Muestra con otros (una
                // muestra de varios cilindros), se editan todos juntos en
                // la tabla de lote, en vez de editar solo este uno.
                if (ClaveCampoMuestra is string claveMuestraEdit
                    && valores.TryGetValue(claveMuestraEdit, out var muestraEdit)
                    && !string.IsNullOrWhiteSpace(muestraEdit))
                {
                    var campoMuestraId = campos.FirstOrDefault(c => c.Clave == claveMuestraEdit)?.Id;
                    if (campoMuestraId is int idCampoMuestra)
                    {
                        var idsActivos = Db.ResultadosEnsayo.AsNoTracking()
                            .Where(x => x.TipoEnsayoId == TipoEnsayoId && !x.Eliminado)
                            .Select(x => x.Id).ToHashSet();

                        var idsDelGrupo = Db.ValoresCampoEnsayo.AsNoTracking()
                            .Where(v => v.CampoEnsayoId == idCampoMuestra && v.Valor == muestraEdit)
                            .Select(v => v.ResultadoEnsayoId)
                            .Distinct()
                            .Where(x => idsActivos.Contains(x))
                            .OrderBy(x => x)
                            .ToList();

                        if (idsDelGrupo.Count > 1)
                        {
                            CargarLoteParaEdicion(idsDelGrupo);
                        }
                    }
                }
            }
        }

        if (ResultadoEnsayoId is int idAdj) CargarAdjuntosActuales(idsFilasCilindros.Count > 0 ? idsFilasCilindros : new List<int> { idAdj });

        ActualizarPreviewElemento();
        RecalcularFormulas();
        CalcularUltimoCilindroRegistrado();
    }

    // Carga N resultados existentes (los de una misma muestra) en
    // filasCilindros/idsFilasCilindros, para editarlos juntos con la misma
    // tabla que usa el lote al crear uno nuevo.
    private void CargarLoteParaEdicion(List<int> ids)
    {
        idsFilasCilindros = ids;
        cantidadCilindros = ids.Count;
        filasCilindros = new();

        var camposPorId = campos.ToDictionary(c => c.Id, c => c.Clave);
        var resultadosDelGrupo = Db.ResultadosEnsayo.AsNoTracking()
            .Where(r => ids.Contains(r.Id)).ToDictionary(r => r.Id, r => r);
        foreach (var idResultado in ids)
        {
            var fila = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var v in Db.ValoresCampoEnsayo.AsNoTracking().Where(v => v.ResultadoEnsayoId == idResultado))
            {
                if (camposPorId.TryGetValue(v.CampoEnsayoId, out var clave)) fila[clave] = v.Valor;
            }
            var resultadoActual = resultadosDelGrupo.TryGetValue(idResultado, out var rr) ? rr : null;
            fila[ClaveElementoFila] = resultadoActual?.ElementoTexto ?? "";
            fila[ClaveFechaEjecucionFila] = resultadoActual?.FechaEjecucion?.ToString("yyyy-MM-dd") ?? "";
            filasCilindros.Add(fila);
        }

        // Precarga el informe (y sus archivos ya subidos) con lo que ya
        // tenía guardado cada resultado — por edad si el Tipo de Ensayo
        // tiene "Edad" (concreto), o por fila si no (ej. Densidades).
        for (var i = 0; i < ids.Count; i++)
        {
            var r = resultadosDelGrupo.TryGetValue(ids[i], out var rr2) ? rr2 : null;
            if (r?.InformeId is not int idInf) continue;
            var numero = Db.Informes.AsNoTracking().FirstOrDefault(inf => inf.Id == idInf)?.Numero;
            var archivosDelInforme = Db.ArchivosInforme.AsNoTracking().Where(a => a.InformeId == idInf).ToList();

            if (ClaveCampoEdad is string claveEdad
                && filasCilindros[i].TryGetValue(claveEdad, out var edad) && !string.IsNullOrWhiteSpace(edad))
            {
                if (!informesPorEdad.ContainsKey(edad))
                {
                    if (!string.IsNullOrWhiteSpace(numero)) informesPorEdad[edad] = numero!;
                    archivosExistentesPorEdad[edad] = archivosDelInforme;
                }
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(numero)) informesPorFila[i] = numero!;
                archivosExistentesPorFila[i] = archivosDelInforme;
            }
        }

        editandoLote = true;
        RecalcularFormulasFilas();
    }

    private string ObtenerValor(string clave) => valores.TryGetValue(clave, out var v) ? v : "";

    private void ActualizarValor(string clave, string valor)
    {
        valores[clave] = valor;
        RecalcularFormulas();
    }

    private void RecalcularFormulas()
    {
        foreach (var campo in campos.Where(c => c.TipoDato == TipoDatoCampoEnsayo.Formula && !string.IsNullOrWhiteSpace(c.Formula)))
        {
            try { valores[campo.Clave] = EvaluadorFormulas.Evaluar(campo.Formula!, valores!); }
            catch { valores[campo.Clave] = ""; }
        }
        CalcularFechaEnsayo(valores);
    }

    // Fecha de ensayo = Fecha de muestra + Edad (días). Se calcula sola,
    // no se escribe a mano. Si falta la fecha de muestra o la edad (o no
    // son válidas), simplemente no toca el campo.
    private void CalcularFechaEnsayo(Dictionary<string, string> destino)
    {
        if (ClaveCampoFechaMuestra is not string claveFM) return;
        if (ClaveCampoEdad is not string claveEdad) return;
        if (ClaveCampoFechaEnsayo is not string claveFE) return;

        var fechaTxt = destino.TryGetValue(claveFM, out var fm) ? fm : "";
        var edadTxt = destino.TryGetValue(claveEdad, out var ed) ? ed : "";
        if (DateTime.TryParse(fechaTxt, out var fecha) && int.TryParse(edadTxt, out var edad))
        {
            destino[claveFE] = fecha.AddDays(edad).ToString("yyyy-MM-dd");
        }
    }

    // Busca el No. de cilindro más alto ya guardado para este Tipo de
    // Ensayo, para que el lote nuevo continúe la numeración donde quedó la
    // última muestra (en vez de reiniciar en 1 cada vez).
    private void CalcularUltimoCilindroRegistrado()
    {
        ultimoCilindroRegistrado = 0;
        var claveCilindro = ClaveCampoCilindro;
        if (claveCilindro is null) return;
        var campoId = campos.FirstOrDefault(c => c.Clave == claveCilindro)?.Id;
        if (campoId is null) return;

        var valoresExistentes = Db.ValoresCampoEnsayo.AsNoTracking()
            .Where(v => v.CampoEnsayoId == campoId)
            .Select(v => v.Valor)
            .ToList();
        foreach (var v in valoresExistentes)
        {
            if (int.TryParse(v, out var n) && n > ultimoCilindroRegistrado) ultimoCilindroRegistrado = n;
        }
    }

    private void CambiarCantidadCilindros(string? texto)
    {
        if (!int.TryParse(texto, out var n) || n < 1) n = 1;
        if (n > 24) n = 24; // límite razonable para no crear cientos de filas por error
        cantidadCilindros = n;
        AjustarFilasCilindros();
    }

    // Ajusta filasCilindros al tamaño pedido, reasignando el No. de
    // cilindro consecutivo en cada fila, y precargando cada fila nueva con
    // lo que ya se había escrito en el formulario normal (ej. f'c diseño),
    // para que el usuario solo tenga que corregir lo que cambia por cilindro.
    private void AjustarFilasCilindros()
    {
        var claveCilindro = ClaveCampoCilindro;
        var claveMuestra = ClaveCampoMuestra;

        while (filasCilindros.Count < cantidadCilindros)
        {
            var nuevaFila = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var (k, v) in valores)
            {
                if (k == claveCilindro || k == claveMuestra) continue;
                nuevaFila[k] = v;
            }
            nuevaFila[ClaveElementoFila] = elementoTexto;
            nuevaFila[ClaveFechaEjecucionFila] = fechaEjecucionTexto;
            filasCilindros.Add(nuevaFila);
        }
        while (filasCilindros.Count > cantidadCilindros)
        {
            filasCilindros.RemoveAt(filasCilindros.Count - 1);
        }

        if (claveCilindro is not null)
        {
            for (var i = 0; i < filasCilindros.Count; i++)
            {
                filasCilindros[i][claveCilindro] = (ultimoCilindroRegistrado + i + 1).ToString();
            }
        }

        RecalcularFormulasFilas();
    }

    private string ObtenerValorFila(Dictionary<string, string> fila, string clave) =>
        fila.TryGetValue(clave, out var v) ? v : "";

    // Campos que, al cambiarlos en un cilindro, se propagan automáticamente
    // a los demás cilindros de la muestra — a menos que esa otra fila ya
    // tenga un valor distinto (se asume que lo cambiaron a mano a propósito).
    private static bool EsCampoPropagable(CampoEnsayo campo) =>
        EsCampoDiametro(campo)
        || campo.Etiqueta.Contains("diseño", StringComparison.OrdinalIgnoreCase)
        || campo.Etiqueta.Contains("observaciones", StringComparison.OrdinalIgnoreCase);

    private void ActualizarValorFila(int indice, string clave, string valor)
    {
        if (indice < 0 || indice >= filasCilindros.Count) return;

        var campo = CamposTabla.FirstOrDefault(c => c.Clave == clave);
        var anterior = ObtenerValorFila(filasCilindros[indice], clave);
        filasCilindros[indice][clave] = valor;

        if (campo is not null && EsCampoPropagable(campo) && filasCilindros.Count > 1)
        {
            for (var i = 0; i < filasCilindros.Count; i++)
            {
                if (i == indice) continue;
                if (ObtenerValorFila(filasCilindros[i], clave) == anterior)
                {
                    filasCilindros[i][clave] = valor;
                }
            }
        }

        RecalcularFormulasFilas();
    }

    private void ActualizarMuestraCompartida(string valor)
    {
        if (ClaveCampoMuestra is string clave) ActualizarValor(clave, valor);
    }

    private void ActualizarFechaMuestraCompartida(string valor)
    {
        if (ClaveCampoFechaMuestra is not string clave) return;
        ActualizarValor(clave, valor); // también recalcula Fecha ensayo del formulario normal
        RecalcularFormulasFilas(); // y la de cada fila del lote, si hay
    }

    // Recalcula las fórmulas de cada fila del lote, combinando los campos
    // compartidos (valores) con los propios de esa fila — así una fórmula
    // que use un campo compartido (ej. f'c diseño, o Fecha muestra para
    // calcular la Fecha de ensayo) también calcula bien.
    private void RecalcularFormulasFilas()
    {
        foreach (var fila in filasCilindros)
        {
            var combinados = new Dictionary<string, string>(valores, StringComparer.OrdinalIgnoreCase);
            foreach (var (k, v) in fila) combinados[k] = v;

            CalcularFechaEnsayo(combinados);
            if (ClaveCampoFechaEnsayo is string claveFE && combinados.TryGetValue(claveFE, out var fechaCalculada))
            {
                fila[claveFE] = fechaCalculada;
            }

            foreach (var campo in campos.Where(c => c.TipoDato == TipoDatoCampoEnsayo.Formula && !string.IsNullOrWhiteSpace(c.Formula)))
            {
                try { fila[campo.Clave] = EvaluadorFormulas.Evaluar(campo.Formula!, combinados!); }
                catch { fila[campo.Clave] = ""; }
                combinados[campo.Clave] = fila[campo.Clave];
            }
        }
    }

    private void ActualizarPreviewElemento()
    {
        List<string>? patasValidas = null;
        SigWeb.Models.ElementoTrazado? torre = null;

        if (usaTorre)
        {
            var texto = torreTexto.Trim();
            torre = Db.ElementosTrazado.AsNoTracking().FirstOrDefault(t => !t.Eliminado && t.Codigo.ToLower() == texto.ToLower());
            if (torre is null)
            {
                // El texto puede ser un alias ya aprendido (ej. de una carga
                // por Excel de Ensayos donde el usuario confirmó a qué torre
                // corresponde un texto que no coincidía exactamente).
                var idAlias = Db.AliasTorres.AsNoTracking().FirstOrDefault(a => a.Texto.ToLower() == texto.ToLower())?.ElementoTrazadoId;
                if (idAlias is int idT) torre = Db.ElementosTrazado.AsNoTracking().FirstOrDefault(t => t.Id == idT && !t.Eliminado);
            }
            torreResuelta = torre is not null;
        }
        else
        {
            // Sin Torre propia (Localización en su lugar): la Torre, si la
            // hay, se deduce de a cuál está vinculada esa Localización en
            // el catálogo (ver SincronizadorCatalogoLocalizacion) — así el
            // Elemento también se puede comparar contra las patas reales.
            var textoLoc = localizacionTexto.Trim();
            var idTorreDeLocalizacion = Db.Catalogos.AsNoTracking()
                .Where(c => c.Tipo == TipoCatalogoLocalizacion && c.Nombre.ToLower() == textoLoc.ToLower())
                .Select(c => c.ElementoTrazadoId).FirstOrDefault();
            if (idTorreDeLocalizacion is int idTL)
            {
                torre = Db.ElementosTrazado.AsNoTracking().FirstOrDefault(t => t.Id == idTL && !t.Eliminado);
            }
        }

        if (torre is not null)
        {
            patasValidas = Db.Componentes.AsNoTracking()
                .Where(c => c.ElementoTrazadoId == torre.Id && c.EsPredeterminado && !c.EsHojaDeVida && !c.Eliminado)
                .Select(c => c.Nombre).ToList()
                .Select(ParserElementoEnsayo.ObtenerCodigoPata).ToList();
        }

        var parseo = ParserElementoEnsayo.Parsear(elementoTexto, patasValidas);
        previewElemento = string.IsNullOrWhiteSpace(elementoTexto) ? ""
            : parseo.SubElemento == SubElementoResultado.Otro
                ? "No se asocia a ninguna pata."
                : $"Patas: {string.Join(", ", parseo.Patas)}" + (parseo.SubElemento == SubElementoResultado.Ninguno ? "" : $" — {parseo.SubElemento}");

        esElementoEspecial = !string.IsNullOrWhiteSpace(elementoTexto) && parseo.SubElemento == SubElementoResultado.Otro;
        if (esElementoEspecial)
        {
            if (string.IsNullOrWhiteSpace(elementoEspecialNombre))
                elementoEspecialNombre = ParserElementoEnsayo.ProponerNombreElemento(elementoTexto);
            elementosEspecialesDeTorre = torre is null ? new()
                : Db.Componentes.AsNoTracking()
                    .Where(c => c.ElementoTrazadoId == torre.Id && !c.EsPredeterminado && !c.EsHojaDeVida && !c.Eliminado)
                    .Select(c => c.Nombre).ToList();
        }
        else
        {
            elementosEspecialesDeTorre = new();
        }
    }

    private void SeleccionarDisenoMezcla(InputFileChangeEventArgs e) => archivoDisenoMezcla = e.File;
    private void SeleccionarArchivosInforme(InputFileChangeEventArgs e) => archivosInforme = e.GetMultipleFiles(10);

    // Valida que el No. de Muestra y el/los No. de Cilindro que se van a
    // guardar no choquen con un registro ya existente (ni, en el caso de
    // los cilindros, entre sí dentro del mismo lote). Devuelve el mensaje
    // de error a mostrar, o null si todo está bien.
    private async Task<string?> ValidarDuplicados()
    {
        var claveMuestra = ClaveCampoMuestra;
        var claveCilindro = ClaveCampoCilindro;

        var idsPropios = editandoLote ? idsFilasCilindros
            : (esEdicion && ResultadoEnsayoId is int idPropioUnico ? new List<int> { idPropioUnico } : new List<int>());

        // ---- No. Muestra: no debe coincidir con la de otro registro ----
        if (claveMuestra is not null)
        {
            var muestraTxt = ObtenerValor(claveMuestra);
            if (!string.IsNullOrWhiteSpace(muestraTxt))
            {
                var campoMuestraId = campos.FirstOrDefault(c => c.Clave == claveMuestra)?.Id;
                if (campoMuestraId is int idCM)
                {
                    var choque = await Db.ValoresCampoEnsayo
                        .Where(v => v.CampoEnsayoId == idCM && v.Valor == muestraTxt && !idsPropios.Contains(v.ResultadoEnsayoId))
                        .Select(v => v.ResultadoEnsayoId)
                        .FirstOrDefaultAsync();
                    if (choque != 0 && await Db.ResultadosEnsayo.AnyAsync(r => r.Id == choque && r.TipoEnsayoId == TipoEnsayoId && !r.Eliminado))
                    {
                        return $"El No. de Muestra \"{muestraTxt}\" ya está en uso por otro registro. Usa un número distinto.";
                    }
                }
            }
        }

        // ---- No. Cilindro: ni repetido dentro del propio lote, ni con otro ya guardado ----
        if (claveCilindro is not null)
        {
            var valoresCilindro = new List<(string Valor, int? IdPropio)>();
            if (ModoLote)
            {
                for (var i = 0; i < filasCilindros.Count; i++)
                {
                    var v = ObtenerValorFila(filasCilindros[i], claveCilindro);
                    var idPropio = editandoLote && i < idsFilasCilindros.Count ? idsFilasCilindros[i] : (int?)null;
                    valoresCilindro.Add((v, idPropio));
                }
            }
            else
            {
                valoresCilindro.Add((ObtenerValor(claveCilindro), esEdicion ? ResultadoEnsayoId : null));
            }

            var repetidoEnLote = valoresCilindro.Where(x => !string.IsNullOrWhiteSpace(x.Valor))
                .GroupBy(x => x.Valor).FirstOrDefault(g => g.Count() > 1);
            if (repetidoEnLote is not null)
            {
                return $"El No. de Cilindro \"{repetidoEnLote.Key}\" está repetido en esta muestra.";
            }

            var campoCilindroId = campos.FirstOrDefault(c => c.Clave == claveCilindro)?.Id;
            if (campoCilindroId is int idCC)
            {
                foreach (var (valorCil, idPropio) in valoresCilindro)
                {
                    if (string.IsNullOrWhiteSpace(valorCil)) continue;
                    var choque = await Db.ValoresCampoEnsayo
                        .Where(v => v.CampoEnsayoId == idCC && v.Valor == valorCil && v.ResultadoEnsayoId != (idPropio ?? -1))
                        .Select(v => v.ResultadoEnsayoId)
                        .FirstOrDefaultAsync();
                    if (choque != 0 && await Db.ResultadosEnsayo.AnyAsync(r => r.Id == choque && r.TipoEnsayoId == TipoEnsayoId && !r.Eliminado))
                    {
                        return $"El No. de Cilindro \"{valorCil}\" ya está en uso por otro registro.";
                    }
                }
            }
        }

        return null;
    }

    private async Task<string> GuardarArchivo(IBrowserFile archivo, long maxBytes)
    {
        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "ensayos");
        Directory.CreateDirectory(carpeta);
        var nombreArchivo = $"{Guid.NewGuid()}{Path.GetExtension(archivo.Name)}";
        var rutaFisica = Path.Combine(carpeta, nombreArchivo);
        await using var stream = archivo.OpenReadStream(maxBytes);
        await using var destino = File.Create(rutaFisica);
        await stream.CopyToAsync(destino);
        return $"/uploads/ensayos/{nombreArchivo}";
    }

    // Igual que GuardarArchivo, pero deduplicando por contenido: si el
    // mismo archivo (mismo hash SHA-256) ya se guardó antes — en esta
    // misma pasada (cacheLocal) o en una subida anterior cualquiera (se
    // busca en ArchivosInforme) — no se vuelve a escribir en disco, se
    // reutiliza la misma ruta física. Así, subir el mismo PDF en 2
    // resultados distintos de un lote solo ocupa espacio una vez.
    private async Task<(string Ruta, string Hash)> GuardarArchivoConHash(IBrowserFile archivo, long maxBytes, Dictionary<string, string> cacheLocal)
    {
        using var sha256 = System.Security.Cryptography.SHA256.Create();
        using var memoria = new MemoryStream();
        await using (var origen = archivo.OpenReadStream(maxBytes))
        {
            await origen.CopyToAsync(memoria);
        }
        memoria.Position = 0;
        var hash = Convert.ToHexString(sha256.ComputeHash(memoria));

        if (cacheLocal.TryGetValue(hash, out var rutaCacheada))
        {
            return (rutaCacheada, hash);
        }

        var rutaExistente = await Db.ArchivosInforme.AsNoTracking()
            .Where(a => a.Hash == hash).Select(a => a.RutaArchivo).FirstOrDefaultAsync();
        if (rutaExistente is not null)
        {
            cacheLocal[hash] = rutaExistente;
            return (rutaExistente, hash);
        }

        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "ensayos");
        Directory.CreateDirectory(carpeta);
        var nombreArchivo = $"{Guid.NewGuid()}{Path.GetExtension(archivo.Name)}";
        var rutaFisica = Path.Combine(carpeta, nombreArchivo);
        memoria.Position = 0;
        await using (var destino = File.Create(rutaFisica))
        {
            await memoria.CopyToAsync(destino);
        }

        var ruta = $"/uploads/ensayos/{nombreArchivo}";
        cacheLocal[hash] = ruta;
        return (ruta, hash);
    }

    // Quita un PDF ya adjunto a un informe (botón "✕" junto a "Ya
    // tiene: ..."). Si ese mismo archivo físico está referenciado por
    // otro ArchivoInforme (por el deduplicado al subir el mismo PDF dos
    // veces), solo se borra esta referencia — el archivo en disco se
    // conserva mientras alguna otra fila lo siga usando.
    private async Task EliminarArchivoInformeExistente(ArchivoInforme archivo, List<ArchivoInforme> listaLocal)
    {
        var otraReferencia = await Db.ArchivosInforme.AsNoTracking()
            .AnyAsync(a => a.Id != archivo.Id && a.RutaArchivo == archivo.RutaArchivo);

        var entidad = await Db.ArchivosInforme.FirstOrDefaultAsync(a => a.Id == archivo.Id);
        if (entidad is not null)
        {
            Db.ArchivosInforme.Remove(entidad);
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
        }

        if (!otraReferencia)
        {
            try
            {
                var rutaRelativa = archivo.RutaArchivo.TrimStart('/').Replace('/', Path.DirectorySeparatorChar);
                var rutaFisica = Path.Combine(Env.WebRootPath, rutaRelativa);
                if (File.Exists(rutaFisica)) File.Delete(rutaFisica);
            }
            catch
            {
                // No bloquear la operación por un archivo que no se pudo
                // borrar físicamente (ej. permisos) — la referencia en la
                // base de datos ya se quitó, que es lo que ve el usuario.
            }
        }

        listaLocal.Remove(archivo);
    }

    // El usuario confirmó que sí quiere agregar la Localización escrita al
    // catálogo "Localización" (el mismo de Materiales, ya sincronizado con
    // las torres del trazado) — se crea y se reintenta el guardado, que
    // esta vez ya la encuentra y sigue normal.
    private async Task ConfirmarNuevaLocalizacion()
    {
        var texto = localizacionPendienteTexto.Trim();
        if (string.IsNullOrWhiteSpace(texto)) return;

        Db.Catalogos.Add(new ItemCatalogo
        {
            Tipo = TipoCatalogoLocalizacion,
            Nombre = texto,
            Descripcion = "Agregado desde Ensayos",
            Activo = true
        });
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        if (!localizacionesDisponibles.Any(l => l.Equals(texto, StringComparison.OrdinalIgnoreCase)))
        {
            localizacionesDisponibles.Add(texto);
        }

        confirmandoNuevaLocalizacion = false;
        await Guardar();
    }

    private void CancelarNuevaLocalizacion()
    {
        confirmandoNuevaLocalizacion = false;
        localizacionPendienteTexto = "";
    }

    private async Task Guardar()
    {
        mensaje = "";

        if (usaTorre)
        {
            if (string.IsNullOrWhiteSpace(torreTexto))
            {
                mensaje = "Debes indicar el No. de Torre antes de guardar.";
                return;
            }
            // En lote, cada fila trae su propio Elemento (columna de la
            // tabla); fuera de lote, es el campo de arriba.
            var faltaElemento = ModoLote
                ? filasCilindros.Any(f => string.IsNullOrWhiteSpace(ObtenerValorFila(f, ClaveElementoFila)))
                : string.IsNullOrWhiteSpace(elementoTexto);
            if (faltaElemento)
            {
                mensaje = ModoLote
                    ? "Debes indicar el Elemento (pata) de cada fila antes de guardar."
                    : "Debes indicar el Elemento (pata) antes de guardar.";
                return;
            }
        }
        else if (string.IsNullOrWhiteSpace(localizacionTexto))
        {
            mensaje = "Debes indicar la Localización antes de guardar.";
            return;
        }

        // ---- Localización: se hereda del catálogo "Localización". Si lo
        // que se escribió no existe ahí (ni con otra mayúscula/minúscula),
        // se pausa el guardado y se pregunta si se quiere agregar — una
        // vez confirmado, ConfirmarNuevaLocalizacion() la crea y vuelve a
        // llamar Guardar(), que esta vez sí la encuentra y sigue normal. ----
        if (!usaTorre && !confirmandoNuevaLocalizacion)
        {
            var textoLocCheck = localizacionTexto.Trim();
            var existeLocalizacion = await Db.Catalogos.AsNoTracking()
                .AnyAsync(c => c.Tipo == TipoCatalogoLocalizacion && c.Nombre.ToLower() == textoLocCheck.ToLower());
            if (!existeLocalizacion)
            {
                confirmandoNuevaLocalizacion = true;
                localizacionPendienteTexto = textoLocCheck;
                return;
            }
        }

        var errorDuplicado = await ValidarDuplicados();
        if (errorDuplicado is not null)
        {
            mensaje = errorDuplicado;
            return;
        }

        guardando = true;
        StateHasChanged();
        await Task.Yield();

        // ---- Torre y patas válidas: se resuelven una sola vez, son
        // iguales para todos los resultados del lote (o para el único
        // resultado normal) — lo que SÍ puede variar por fila es el
        // Elemento/pata en sí (parseoFila, más abajo, por resultado).
        //
        // Para Tipos que usan Torre, se resuelve desde el texto de Torre
        // escrito arriba. Para los que no (Localización en su lugar), se
        // resuelve desde el catálogo "Localización": si la Localización
        // escogida está vinculada a una Torre del trazado
        // (ElementoTrazadoId — ver SincronizadorCatalogoLocalizacion), el
        // resultado también queda asociado a esa Torre, igual que
        // Resistencia a la compresión — así, un ensayo de Densidades con
        // Localización "102NNN" y Elemento "A" (o "Trincho") también
        // aparece en Trazado para la torre 102NNN. Si la Localización no
        // corresponde a ninguna Torre (ej. "PR12+300"), no hay Torre que
        // asociar y el resultado queda solo con su Localización. ----
        int? elementoTrazadoId = null;
        List<string>? patasValidas = null;

        // La Localización ya existe en el catálogo a esta altura (si no
        // existía, Guardar() se detuvo antes a preguntar) — se guarda con
        // la grafía exacta tal como está en el catálogo, no la que haya
        // tecleado el usuario (evita duplicados por mayúsculas/espacios).
        string? localizacionResuelta = null;
        if (!usaTorre)
        {
            var textoLoc = localizacionTexto.Trim();
            var itemLocalizacion = await Db.Catalogos.AsNoTracking()
                .Where(c => c.Tipo == TipoCatalogoLocalizacion && c.Nombre.ToLower() == textoLoc.ToLower())
                .Select(c => new { c.Nombre, c.ElementoTrazadoId })
                .FirstOrDefaultAsync();
            localizacionResuelta = itemLocalizacion?.Nombre ?? textoLoc;
            elementoTrazadoId = itemLocalizacion?.ElementoTrazadoId;
        }

        if (usaTorre && !string.IsNullOrWhiteSpace(torreTexto))
        {
            var textoTorre = torreTexto.Trim();
            var torre = await Db.ElementosTrazado.FirstOrDefaultAsync(t => !t.Eliminado && t.Codigo.ToLower() == textoTorre.ToLower());
            elementoTrazadoId = torre?.Id;
            if (elementoTrazadoId is null)
            {
                elementoTrazadoId = await Db.AliasTorres.Where(a => a.Texto.ToLower() == textoTorre.ToLower())
                    .Select(a => (int?)a.ElementoTrazadoId).FirstOrDefaultAsync();
            }
        }

        if (elementoTrazadoId is int idTorreValida)
        {
            var nombresPatas = await Db.Componentes.Where(c => c.ElementoTrazadoId == idTorreValida && c.EsPredeterminado && !c.EsHojaDeVida && !c.Eliminado)
                .Select(c => c.Nombre).ToListAsync();
            patasValidas = nombresPatas.Select(ParserElementoEnsayo.ObtenerCodigoPata).ToList();
        }

        // ---- Informe(s): fuera de lote (o lote sin "Edad" detectada), uno
        // solo compartido (informeNumero). En lote con "Edad", uno distinto
        // por cada edad de ensayo (informesPorEdad) — se cachea por número
        // para no crear duplicados ni volver a consultar la BD de más ----
        var cacheInformes = new Dictionary<string, Informe>(StringComparer.OrdinalIgnoreCase);
        var informePorEdadResuelto = new Dictionary<string, Informe>(StringComparer.OrdinalIgnoreCase);

        // Si no se indicó No. de Informe pero sí se adjuntaron PDF(s), de
        // todos modos hay que crear un Informe (sin número) para poder
        // guardar esos archivos en algún lado — si no, se suben pero no
        // quedan asociados a ningún resultado y no se vuelven a encontrar.
        // forzarCrear hace que, en ese caso, también se cree con blanco;
        // el índice único de Informe ya no choca entre varios en blanco.
        async Task<Informe?> ResolverInforme(string numero, bool forzarCrear = false)
        {
            var limpio = (numero ?? "").Trim();
            if (string.IsNullOrWhiteSpace(limpio) && !forzarCrear) return null;
            if (cacheInformes.TryGetValue(limpio, out var yaResuelto)) return yaResuelto;

            Informe? existente = null;
            if (!string.IsNullOrWhiteSpace(limpio))
            {
                existente = await Db.Informes.FirstOrDefaultAsync(i => i.TipoEnsayoId == TipoEnsayoId && i.Numero == limpio);
            }
            if (existente is null)
            {
                existente = new Informe { TipoEnsayoId = TipoEnsayoId, Numero = limpio };
                Db.Informes.Add(existente);
                await Db.SaveChangesAsync();
            }
            cacheInformes[limpio] = existente;
            return existente;
        }

        // Variante de ResolverInforme para "informe por fila": si la fila
        // trae un número, se resuelve/comparte igual que arriba (dos filas
        // con el mismo número terminan en el mismo Informe). Si no trae
        // número pero sí archivos, se crea un Informe propio para ESA fila
        // (no se comparte el cache[""] entre filas en blanco: cada una es
        // un informe distinto, aunque todos queden con Numero = "").
        async Task<Informe?> ResolverInformeFila(string numero, bool forzarCrear)
        {
            var limpio = (numero ?? "").Trim();
            if (!string.IsNullOrWhiteSpace(limpio)) return await ResolverInforme(limpio);
            if (!forzarCrear) return null;

            var nuevo = new Informe { TipoEnsayoId = TipoEnsayoId, Numero = "" };
            Db.Informes.Add(nuevo);
            await Db.SaveChangesAsync();
            return nuevo;
        }

        // ---- Archivos (informe, diseño de mezcla): si el mismo archivo se
        // sube más de una vez en el mismo guardado (ej. el mismo PDF en 2
        // filas distintas), o ya existe en la base de datos de una subida
        // anterior, solo se guarda una copia física — las demás filas
        // quedan referenciadas a esa misma ruta (ver GuardarArchivoConHash). ----
        var hashARuta = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        // ---- Archivo de diseño de mezcla: se sube una sola vez y se
        // reutiliza su ruta en cada resultado del lote ----
        string? disenoMezclaArchivoNuevo = null;
        if (archivoDisenoMezcla is not null)
        {
            disenoMezclaArchivoNuevo = await GuardarArchivo(archivoDisenoMezcla, 20 * 1024 * 1024);
        }

        // ---- Qué juego(s) de valores guardar, con qué edad (para elegir
        // el informe correspondiente) y con qué Elemento: uno (normal o
        // edición), o uno por cada fila del lote (valores compartidos +
        // los propios de esa fila, que pisan a los compartidos si
        // coinciden; el Elemento de la fila, o el de arriba si la fila no
        // trae el suyo propio) ----
        var listaDeValores = new List<(Dictionary<string, string> Valores, string? Edad, string ElementoTexto, string? FechaTexto)>();
        if (ModoLote)
        {
            var claveEdad = ClaveCampoEdad;
            foreach (var fila in filasCilindros)
            {
                var combinados = new Dictionary<string, string>(valores, StringComparer.OrdinalIgnoreCase);
                foreach (var (k, v) in fila)
                {
                    if (k == ClaveElementoFila || k == ClaveFechaEjecucionFila) continue;
                    combinados[k] = v;
                }
                var edad = claveEdad is not null && fila.TryGetValue(claveEdad, out var ed) ? ed : null;
                var elementoFila = fila.TryGetValue(ClaveElementoFila, out var elFila) && !string.IsNullOrWhiteSpace(elFila)
                    ? elFila : elementoTexto;
                var fechaFila = fila.TryGetValue(ClaveFechaEjecucionFila, out var feFila) && !string.IsNullOrWhiteSpace(feFila)
                    ? feFila : fechaEjecucionTexto;
                listaDeValores.Add((combinados, edad, elementoFila, fechaFila));
            }
        }
        else
        {
            listaDeValores.Add((valores, null, elementoTexto, fechaEjecucionTexto));
        }

        // En edición de lote, cada fila de listaDeValores corresponde (en el
        // mismo orden) a un resultado ya existente en idsFilasCilindros.
        var esLoteDeEdicion = esEdicion && editandoLote && idsFilasCilindros.Count == listaDeValores.Count;

        var camposPorClave = campos.ToDictionary(c => c.Clave, StringComparer.OrdinalIgnoreCase);

        // Si hay PDF(s) nuevos para el cuadro único (fuera de modo lote),
        // hay que crear el Informe aunque el No. quede en blanco, para no
        // perder esos archivos (ver ResolverInforme arriba).
        var forzarInformeEnBlanco = !ModoLote && archivosInforme.Count > 0;

        var informePorFilaResuelto = new Dictionary<int, Informe>();

        // Adjuntos: los nuevos se resuelven una sola vez (mismo contenido = mismo registro);
        // los ya existentes se conservan por resultado salvo que se reemplacen o quiten.
        var adjuntoNuevoPorClave = new Dictionary<string, AdjuntoEnsayo>(StringComparer.OrdinalIgnoreCase);
        foreach (var (claveAdj, archivoAdj) in adjuntosPendientes)
            adjuntoNuevoPorClave[claveAdj] = await ResolverAdjuntoAsync(archivoAdj);
        var idsAdjPrevios = (idsFilasCilindros.Count > 0 ? idsFilasCilindros : new List<int>()).ToList();
        if (ResultadoEnsayoId is int idEdAdj) idsAdjPrevios.Add(idEdAdj);
        var adjuntosPrevios = idsAdjPrevios.Count == 0 ? new Dictionary<(int, int), int>() :
            Db.ValoresCampoEnsayo.AsNoTracking()
              .Where(v => idsAdjPrevios.Contains(v.ResultadoEnsayoId) && v.AdjuntoEnsayoId != null)
              .ToDictionary(v => (v.ResultadoEnsayoId, v.CampoEnsayoId), v => v.AdjuntoEnsayoId!.Value);
        var nombrePorAdjunto = Db.AdjuntosEnsayo.AsNoTracking().ToDictionary(a => a.Id, a => a.NombreOriginal);

        for (var indiceFila = 0; indiceFila < listaDeValores.Count; indiceFila++)
        {
            var (valoresDelResultado, edadDelResultado, elementoTextoFila, fechaTextoFila) = listaDeValores[indiceFila];
            elementoTextoFila = (elementoTextoFila ?? "").Trim();
            // Solo tiene sentido interpretar el Elemento contra patas si
            // hay una Torre resuelta a la cual compararlo (usaTorre, o
            // !usaTorre con Localización vinculada a una Torre); sin
            // Torre, se guarda el texto tal cual, sin pata asociada.
            var parseoFila = elementoTrazadoId is not null
                ? ParserElementoEnsayo.Parsear(elementoTextoFila, patasValidas)
                : new ParserElementoEnsayo.ResultadoParseo();
            DateTime? fechaEjecucionFilaValor = DateTime.TryParse(fechaTextoFila, out var feFilaVal) ? feFilaVal : (DateTime?)null;

            Informe? informe;
            if (UsaInformePorEdadLote && edadDelResultado is not null && informesPorEdad.TryGetValue(edadDelResultado, out var numeroInformeEdad))
            {
                informe = await ResolverInforme(numeroInformeEdad);
                if (informe is not null) informePorEdadResuelto[edadDelResultado] = informe;
            }
            else if (UsaInformePorFilaLote)
            {
                var numeroFila = ObtenerInformeParaFila(indiceFila);
                var hayArchivosFila = archivosPorFila.TryGetValue(indiceFila, out var archivosDeEstaFila) && archivosDeEstaFila.Count > 0;
                informe = await ResolverInformeFila(numeroFila, hayArchivosFila);
                if (informe is not null) informePorFilaResuelto[indiceFila] = informe;
            }
            else
            {
                informe = await ResolverInforme(informeNumero, forzarInformeEnBlanco);
            }

            ResultadoEnsayo resultado;
            if (esLoteDeEdicion)
            {
                resultado = await Db.ResultadosEnsayo.FirstAsync(r => r.Id == idsFilasCilindros[indiceFila]);
            }
            else if (esEdicion)
            {
                resultado = await Db.ResultadosEnsayo.FirstAsync(r => r.Id == ResultadoEnsayoId);
            }
            else
            {
                resultado = new ResultadoEnsayo { TipoEnsayoId = TipoEnsayoId, Origen = "Manual" };
                Db.ResultadosEnsayo.Add(resultado);
            }

            resultado.ElementoTrazadoId = elementoTrazadoId;
            resultado.ElementoTexto = elementoTextoFila;
            resultado.SubElemento = parseoFila.SubElemento;
            // Si se resolvió un informe (número nuevo, o PDF nuevo sin
            // número), se asocia. Si no se resolvió ninguno y es una
            // edición, se deja el que ya tenía (no perder el vínculo con
            // sus archivos solo porque esta vez no se tocó ese campo).
            if (informe is not null)
            {
                resultado.InformeId = informe.Id;
            }
            else if (!esEdicion)
            {
                resultado.InformeId = null;
            }
            if (usaTorre)
            {
                resultado.DisenoMezclaCodigo = string.IsNullOrWhiteSpace(disenoMezclaCodigo) ? null : disenoMezclaCodigo.Trim();
                if (disenoMezclaArchivoNuevo is not null) resultado.DisenoMezclaArchivo = disenoMezclaArchivoNuevo;
                resultado.Localizacion = null;
                resultado.FechaEjecucion = null;
            }
            else
            {
                resultado.Localizacion = localizacionResuelta;
                resultado.FechaEjecucion = fechaEjecucionFilaValor;
            }

            await Db.SaveChangesAsync();

            if (esEdicion)
            {
                var viejos = Db.ResultadosEnsayoComponente.Where(rc => rc.ResultadoEnsayoId == resultado.Id);
                Db.ResultadosEnsayoComponente.RemoveRange(viejos);
                var viejosValores = Db.ValoresCampoEnsayo.Where(v => v.ResultadoEnsayoId == resultado.Id);
                Db.ValoresCampoEnsayo.RemoveRange(viejosValores);
                await Db.SaveChangesAsync();
            }

            if (elementoTrazadoId is int idTorre2)
            {
                if (parseoFila.Patas.Count > 0)
                {
                    var patasDeTorre2 = await Db.Componentes
                        .Where(c => c.ElementoTrazadoId == idTorre2 && c.EsPredeterminado && !c.EsHojaDeVida && !c.Eliminado)
                        .ToListAsync();
                    var componentesPata = patasDeTorre2
                        .Where(c => parseoFila.Patas.Contains(ParserElementoEnsayo.ObtenerCodigoPata(c.Nombre), StringComparer.OrdinalIgnoreCase))
                        .ToList();
                    foreach (var comp in componentesPata)
                    {
                        Db.ResultadosEnsayoComponente.Add(new ResultadoEnsayoComponente { ResultadoEnsayoId = resultado.Id, ComponenteId = comp.Id });
                    }
                }
                else if (parseoFila.SubElemento == SubElementoResultado.Otro)
                {
                    // Fuera de lote, se usa el nombre que el usuario
                    // confirmó/editó arriba (elementoEspecialNombre). En
                    // lote, cada fila puede traer su propio elemento
                    // especial (ej. "Trincho"), así que el nombre se
                    // propone solo a partir de su propio texto.
                    var nombreFinal = (ModoLote
                        ? ParserElementoEnsayo.ProponerNombreElemento(elementoTextoFila)
                        : elementoEspecialNombre).Trim();

                    if (!string.IsNullOrWhiteSpace(nombreFinal))
                    {
                        // Igual que en la carga por Excel: si ese nombre en
                        // realidad coincide con una pata real de la torre, se
                        // asocia a la pata real en vez de crear un duplicado
                        // suelto (ej. "A" junto a "Pata A").
                        var patasDeTorreReal = await Db.Componentes
                            .Where(c => c.ElementoTrazadoId == idTorre2 && c.EsPredeterminado && !c.EsHojaDeVida && !c.Eliminado)
                            .ToListAsync();
                        var pataRealCoincidente = patasDeTorreReal.FirstOrDefault(c =>
                            string.Equals(ParserElementoEnsayo.ObtenerCodigoPata(c.Nombre), nombreFinal, StringComparison.OrdinalIgnoreCase));

                        if (pataRealCoincidente is not null)
                        {
                            Db.ResultadosEnsayoComponente.Add(new ResultadoEnsayoComponente { ResultadoEnsayoId = resultado.Id, ComponenteId = pataRealCoincidente.Id });
                        }
                        else
                        {
                            var compEspecial = await Db.Componentes.FirstOrDefaultAsync(c =>
                                c.ElementoTrazadoId == idTorre2 && !c.EsPredeterminado && !c.Eliminado && c.Nombre.ToLower() == nombreFinal.ToLower());
                            if (compEspecial is null)
                            {
                                compEspecial = new Componente { ElementoTrazadoId = idTorre2, Nombre = nombreFinal, EsPredeterminado = false, EsHojaDeVida = false };
                                Db.Componentes.Add(compEspecial);
                                await Db.SaveChangesAsync();
                            }
                            Db.ResultadosEnsayoComponente.Add(new ResultadoEnsayoComponente { ResultadoEnsayoId = resultado.Id, ComponenteId = compEspecial.Id });
                        }
                    }
                }
            }

            foreach (var (clave, valorOriginal) in valoresDelResultado)
            {
                var valor = valorOriginal;
                if (!camposPorClave.TryGetValue(clave, out var campo)) continue;
                int? adjId = null;
                if (campo.LlevaAdjunto)
                {
                    if (adjuntoNuevoPorClave.TryGetValue(clave, out var nuevoAdj)) { adjId = nuevoAdj.Id; nombrePorAdjunto[nuevoAdj.Id] = nuevoAdj.NombreOriginal; }
                    else if (!adjuntosQuitar.Contains(clave) && adjuntosPrevios.TryGetValue((resultado.Id, campo.Id), out var previoId)) adjId = previoId;
                }
                if (string.IsNullOrWhiteSpace(valor))
                {
                    if (adjId is null) continue;
                    valor = nombrePorAdjunto.GetValueOrDefault(adjId.Value, "adjunto");
                }
                Db.ValoresCampoEnsayo.Add(new ValorCampoEnsayo { ResultadoEnsayoId = resultado.Id, CampoEnsayoId = campo.Id, Valor = valor, AdjuntoEnsayoId = adjId });
            }

            // Campos con adjunto que no traían texto: el valor es el nombre del archivo.
            foreach (var campoAdj in campos.Where(c => c.LlevaAdjunto && !valoresDelResultado.Any(kv => string.Equals(kv.Key, c.Clave, StringComparison.OrdinalIgnoreCase))))
            {
                int? adjId2 = null;
                if (adjuntoNuevoPorClave.TryGetValue(campoAdj.Clave, out var nuevo2)) { adjId2 = nuevo2.Id; nombrePorAdjunto[nuevo2.Id] = nuevo2.NombreOriginal; }
                else if (!adjuntosQuitar.Contains(campoAdj.Clave) && adjuntosPrevios.TryGetValue((resultado.Id, campoAdj.Id), out var previo2)) adjId2 = previo2;
                if (adjId2 is null) continue;
                Db.ValoresCampoEnsayo.Add(new ValorCampoEnsayo { ResultadoEnsayoId = resultado.Id, CampoEnsayoId = campoAdj.Id, Valor = nombrePorAdjunto.GetValueOrDefault(adjId2.Value, "adjunto"), AdjuntoEnsayoId = adjId2 });
            }

            await Db.SaveChangesAsync();
        }

        // ---- Archivos del informe: en modo "informe por edad" cada edad
        // tiene su propio informe y sus propios archivos; en modo "informe
        // por fila" cada fila tiene el suyo; fuera de lote, los archivos
        // subidos en el cuadro único se adjuntan a cada informe distinto
        // que haya quedado resuelto en este guardado. En los tres casos,
        // si el mismo archivo (mismo contenido) ya se subió antes — en
        // esta misma operación o en una anterior — no se vuelve a guardar
        // en disco: se referencia la copia existente (ver hashARuta y
        // GuardarArchivoConHash). ----
        if (UsaInformePorEdadLote)
        {
            foreach (var (edad, archivosEdad) in archivosPorEdad)
            {
                if (archivosEdad.Count == 0) continue;
                if (!informePorEdadResuelto.TryGetValue(edad, out var informeEdad)) continue;
                foreach (var archivo in archivosEdad)
                {
                    var (ruta, hash) = await GuardarArchivoConHash(archivo, 20 * 1024 * 1024, hashARuta);
                    Db.ArchivosInforme.Add(new ArchivoInforme { InformeId = informeEdad.Id, NombreOriginal = archivo.Name, RutaArchivo = ruta, Hash = hash });
                }
            }
            await Db.SaveChangesAsync();
        }
        else if (UsaInformePorFilaLote)
        {
            foreach (var (indiceFilaArchivo, archivosFila) in archivosPorFila)
            {
                if (archivosFila.Count == 0) continue;
                if (!informePorFilaResuelto.TryGetValue(indiceFilaArchivo, out var informeFila)) continue;
                foreach (var archivo in archivosFila)
                {
                    var (ruta, hash) = await GuardarArchivoConHash(archivo, 20 * 1024 * 1024, hashARuta);
                    Db.ArchivosInforme.Add(new ArchivoInforme { InformeId = informeFila.Id, NombreOriginal = archivo.Name, RutaArchivo = ruta, Hash = hash });
                }
            }
            await Db.SaveChangesAsync();
        }
        else if (archivosInforme.Count > 0 && cacheInformes.Count > 0)
        {
            var rutasSubidas = new List<(string NombreOriginal, string Ruta, string Hash)>();
            foreach (var archivo in archivosInforme)
            {
                var (ruta, hash) = await GuardarArchivoConHash(archivo, 20 * 1024 * 1024, hashARuta);
                rutasSubidas.Add((archivo.Name, ruta, hash));
            }
            foreach (var inf in cacheInformes.Values)
            {
                foreach (var (nombre, ruta, hash) in rutasSubidas)
                {
                    Db.ArchivosInforme.Add(new ArchivoInforme { InformeId = inf.Id, NombreOriginal = nombre, RutaArchivo = ruta, Hash = hash });
                }
            }
            await Db.SaveChangesAsync();
        }

        Db.ChangeTracker.Clear();

        guardando = false;
        await OnGuardado.InvokeAsync();
        await OnCerrar.InvokeAsync();
    }

    private async Task Cerrar()
    {
        await OnCerrar.InvokeAsync();
    }
}
