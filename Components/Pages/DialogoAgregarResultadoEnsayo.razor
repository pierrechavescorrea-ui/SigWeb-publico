    // ---------- Informe por fila (modo lote sin "Edad") ----------
    // Cuando hay varios resultados en un mismo lote pero el Tipo de
    // Ensayo no tiene "Edad" (ej. Densidades: 4 patas x 2 profundidades),
    // cada FILA lleva su propio No. de Informe y sus propios PDF — en vez
    // de uno solo compartido por todo el lote (así, cada resultado puede
    // traer el informe/PDF que realmente le corresponde).
    private bool UsaInformePorFilaLote => ModoLote && !UsaInformePorEdadLote;

    private Dictionary<int, string> informesPorFila = new();
