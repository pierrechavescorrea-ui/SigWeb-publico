    private void CargarAdjuntosActuales(IEnumerable<int> idsResultado)
    {
        var ids = idsResultado.ToList();
        var porCampoId = campos.Where(c => c.LlevaAdjunto).ToDictionary(c => c.Id, c => c.Clave);
        if (porCampoId.Count == 0 || ids.Count == 0) return;
        var filas = Db.ValoresCampoEnsayo.AsNoTracking()
            .Where(v => ids.Contains(v.ResultadoEnsayoId) && v.AdjuntoEnsayoId != null).ToList();
        foreach (var v in filas)
        {
            if (!porCampoId.TryGetValue(v.CampoEnsayoId, out var clave) || adjuntosActuales.ContainsKey(clave)) continue;
            var a = Db.AdjuntosEnsayo.AsNoTracking().FirstOrDefault(x => x.Id == v.AdjuntoEnsayoId);
            if (a is not null) adjuntosActuales[clave] = (a.Id, a.NombreOriginal, a.Ruta);
        }
    }

    private async Task<AdjuntoEnsayo> ResolverAdjuntoAsync(IBrowserFile archivo)
    {
        using var memoria = new MemoryStream();
        await using (var origen = archivo.OpenReadStream(20 * 1024 * 1024)) await origen.CopyToAsync(memoria);
        memoria.Position = 0;
        var hash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(memoria));
        var existente = await Db.AdjuntosEnsayo.FirstOrDefaultAsync(a => a.Hash == hash);
        if (existente is not null) return existente;

        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "ensayos");
        Directory.CreateDirectory(carpeta);
        var nombreFisico = $"{Guid.NewGuid()}{Path.GetExtension(archivo.Name)}";
        memoria.Position = 0;
        await using (var destino = File.Create(Path.Combine(carpeta, nombreFisico))) await memoria.CopyToAsync(destino);
        var nuevo = new AdjuntoEnsayo { Hash = hash, NombreOriginal = archivo.Name, Ruta = $"/uploads/ensayos/{nombreFisico}" };
        Db.AdjuntosEnsayo.Add(nuevo);
        await Db.SaveChangesAsync();
        return nuevo;
    }
