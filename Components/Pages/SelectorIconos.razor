@* Panel reutilizable para elegir un ícono de la galería (IconoCatalogo),
   agrupados por categoría. Se usa desde Ensayos.razor (grupos y tipos de
   ensayo) y puede reutilizarse en cualquier otro módulo que necesite
   señalizar algo con un ícono de la galería. *@
@using SigWeb.Models

<div class="border rounded p-2 mb-2" style="max-height: 260px; overflow-y: auto;">
    @if (PermitirNinguno)
    {
        <button type="button" class="btn btn-sm @(IconoSeleccionadoId is null ? "btn-primary" : "btn-outline-secondary") mb-2"
                @onclick="@(() => OnSeleccionar.InvokeAsync(null))">
            @TextoNinguno
        </button>
    }
    @foreach (var categoria in Iconos.GroupBy(i => i.Categoria).OrderBy(c => c.Key))
    {
        <div class="small text-muted mb-1">@categoria.Key</div>
        <div class="d-flex flex-wrap gap-2 mb-2">
            @foreach (var icono in categoria)
            {
                <button type="button" class="btn btn-sm p-1 @(IconoSeleccionadoId == icono.Id ? "btn-primary" : "btn-outline-secondary")"
                        style="width:44px; height:44px;" title="@icono.Nombre"
                        @onclick="@(() => OnSeleccionar.InvokeAsync(icono.Id))">
                    <img src="@icono.RutaArchivo" alt="@icono.Nombre" style="width:100%; height:100%; object-fit:contain;" />
                </button>
            }
        </div>
    }
    @if (!Iconos.Any())
    {
        <p class="text-muted small mb-0">
            <em>Aún no hay íconos en la galería. Súbelos desde Catálogos → Galería de íconos.</em>
        </p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<IconoCatalogo> Iconos { get; set; } = new();

    [Parameter]
    public int? IconoSeleccionadoId { get; set; }

    [Parameter]
    public bool PermitirNinguno { get; set; } = false;

    [Parameter]
    public string TextoNinguno { get; set; } = "Sin ícono";

    [Parameter, EditorRequired]
    public EventCallback<int?> OnSeleccionar { get; set; }
}
