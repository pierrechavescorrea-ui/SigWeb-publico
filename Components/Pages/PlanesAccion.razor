    // ---------- Eliminar (a la Papelera, con aviso de impacto) ----------
    private PlanAccion? elimPlan;
    private SigWeb.Data.Planes.PlanesAccionServicio.AccionEditable? elimAccion;
    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;
    private bool BloqueadoPorImpacto => impacto is null || (impacto.RequiereEntender && !impactoOk);

    private async Task CalcularImpacto(Func<Task<SigWeb.Data.Impacto.InformeImpacto>> f)
    {
        impacto = null; impactoOk = false;
        await _dbLock.WaitAsync();
        try { impacto = await f(); }
        catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        finally { _dbLock.Release(); }
        await InvokeAsync(StateHasChanged);
    }

    private void PedirEliminarPlan()
    {
        if (form is null || form.Plan.Id == 0) return;
        elimAccion = null; elimPlan = form.Plan;
        var id = form.Plan.Id;
        _ = CalcularImpacto(() => Analizador.PlanAccion(id));
    }

    // Una acción ya guardada va a la Papelera con aviso (las nuevas las quita el editor).
    private void PedirEliminarAccion(SigWeb.Data.Planes.PlanesAccionServicio.AccionEditable a)
    {
        elimPlan = null; elimAccion = a;
        var id = a.Accion.Id;
        _ = CalcularImpacto(() => Analizador.AccionPlan(id));
    }

    private void CancelarEliminar() { elimPlan = null; elimAccion = null; impacto = null; }

    private async Task ConfirmarEliminar()
    {
        if (BloqueadoPorImpacto) return;
        await _dbLock.WaitAsync();
        try
        {
            var ahora = DateTime.Now;
            if (elimPlan is not null)
            {
                var p = await Db.PlanesAccion.FirstOrDefaultAsync(x => x.Id == elimPlan.Id);
                if (p is not null)
                {
                    p.Eliminado = true; p.FechaEliminacion = ahora;
                    // Sus acciones se van con él (misma marca de tiempo, para restaurarlas juntas).
                    foreach (var a in await Db.AccionesPlan.Where(a => a.PlanAccionId == p.Id).ToListAsync())
                    { a.Eliminado = true; a.FechaEliminacion = ahora; }
                    await Db.SaveChangesAsync();
                }
                Db.ChangeTracker.Clear();
                elimPlan = null; impacto = null;
                mensaje = "Plan enviado a la Papelera."; error = false;
                if (form is null) { selId = null; Cargar(); await CargarMotorAsync(); return; }
                if (RiesgoQ is int r) Nav.NavigateTo($"riesgos/{r}");
                else Nav.NavigateTo("planes-accion");
                return;
            }
            if (elimAccion is not null)
            {
                var idA = elimAccion.Accion.Id;
                var a = await Db.AccionesPlan.FirstOrDefaultAsync(x => x.Id == idA);
                if (a is not null) { a.Eliminado = true; a.FechaEliminacion = ahora; await Db.SaveChangesAsync(); }
                Db.ChangeTracker.Clear();
                form?.Acciones.Remove(elimAccion);
                acciones.RemoveAll(x => x.Id == idA);
                elimAccion = null; impacto = null;
                mensaje = "Acción enviada a la Papelera."; error = false;
            }
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo eliminar: inténtalo de nuevo. (" + ex.Message + ")"; error = true;
        }
        finally { _dbLock.Release(); }
    }

    // ---------- Adjuntos del plan: carpetas con nombre, cada una con sus archivos ----------
    // Columna "Adjuntos" → ícono que abre la ventanita: cada carpeta con hasta 3 archivos (editar =
    // reemplazar, eliminar → Papelera), "+" para cargar en ella, renombrar/eliminar carpeta, carpeta
    // nueva y "Ver todos" (pantalla aparte con todo).
    private List<CarpetaPlan> carpetasTodas = new();
    private Dictionary<int, List<ArchivoCarpetaPlan>> archivosPorCarpeta = new();
    private int? menuAdj, verAdjuntosDe;
    private double menuX, menuY;
    private string nuevaCarpeta = "", nombreEdicion = "", mensajeAdj = "";
    private int? carpetaRenombrar;
    private (string Tipo, int Id)? archivoReemplazar;   // "archivo" (de carpeta) | "anexo" (de acción)
    private (string Tipo, int Id, string Nombre, int Archivos)? confirmarElim;   // "carpeta" | "archivo" | "anexo"
    private const int MaxMenu = 3;

    private void CargarCarpetas()
    {
        try
        {
            carpetasTodas = Db.CarpetasPlan.AsNoTracking().OrderBy(c => c.Orden).ThenBy(c => c.Id).ToList();
            var ids = carpetasTodas.Select(c => c.Id).ToList();
            archivosPorCarpeta = Db.ArchivosCarpetaPlan.AsNoTracking().Where(a => ids.Contains(a.CarpetaPlanId)).ToList()
                .GroupBy(a => a.CarpetaPlanId).ToDictionary(g => g.Key, g => g.OrderByDescending(a => a.FechaCarga).ThenByDescending(a => a.Id).ToList());
        }
        catch { carpetasTodas = new(); archivosPorCarpeta = new(); }   // sin la migración aplicada
        anexosTodos = Db.ArchivosAccionPlan.AsNoTracking().ToList();
        productosTodos = Db.ProductosAccion.AsNoTracking().ToDictionary(p => p.Id);
    }

    private Dictionary<int, ProductoAccion> productosTodos = new();

    // Vista unificada de la ventanita: primero una carpeta automática por acción propuesta
    // ("Corrección 1", "Acción correctiva 1"… según tipo y en orden) con los anexos de sus productos;
    // luego las carpetas creadas a mano.
    private sealed record ArchivoVista(int Id, bool DeAccion, string Nombre, string Ruta, DateTime Fecha, string? Detalle);
    private sealed record CarpetaVista(string Clave, string Nombre, int? CarpetaId, int? AccionId, List<ArchivoVista> Archivos);

    private List<CarpetaVista> CarpetasVista(int planId)
    {
        var l = new List<CarpetaVista>();
        var cuenta = new Dictionary<TipoAccionPlan, int>();
        foreach (var a in acciones.Where(a => a.PlanAccionId == planId).OrderBy(a => a.Orden).ThenBy(a => a.Id))
        {
            cuenta[a.Tipo] = cuenta.TryGetValue(a.Tipo, out var n) ? n + 1 : 1;
            var archivos = anexosTodos.Where(x => x.AccionPlanId == a.Id && x.SeguimientoAccionId == null)
                .OrderByDescending(x => x.FechaRegistro).ThenByDescending(x => x.Id)
                .Select(x => new ArchivoVista(x.Id, true, x.NombreOriginal, x.RutaArchivo, x.FechaRegistro,
                    x.ProductoAccionId is int pid && productosTodos.TryGetValue(pid, out var pr) && !string.IsNullOrWhiteSpace(pr.Descripcion) ? pr.Descripcion : null))
                .ToList();
            l.Add(new CarpetaVista($"a{a.Id}", $"{EscalaAccion.Nombre(a.Tipo)} {cuenta[a.Tipo]}", null, a.Id, archivos));
        }
        foreach (var c in CarpetasDe(planId))
            l.Add(new CarpetaVista($"c{c.Id}", c.Nombre, c.Id, null, ArchivosDeCarpeta(c.Id)
                .Select(x => new ArchivoVista(x.Id, false, x.NombreOriginal, x.RutaArchivo, x.FechaCarga, null)).ToList()));
        return l;
    }

    private List<CarpetaPlan> CarpetasDe(int planId) => carpetasTodas.Where(c => c.PlanAccionId == planId).ToList();
    private List<ArchivoCarpetaPlan> ArchivosDeCarpeta(int carpetaId) => archivosPorCarpeta.TryGetValue(carpetaId, out var l) ? l : new();
    private int TotalAdjuntos(int planId) => CarpetasVista(planId).Sum(c => c.Archivos.Count);

