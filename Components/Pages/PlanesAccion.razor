    private List<AccionPlan> AccionesDe(int planId) => acciones.Where(a => a.PlanAccionId == planId).OrderBy(a => a.Orden).ThenBy(a => a.Id).ToList();
    private int AnexosDe(int accionId) => anexosTodos.Count(x => x.AccionPlanId == accionId && x.SeguimientoAccionId == null);
    private static bool Vencida(AccionPlan a) => a.Estado != EstadoAccionPlan.Cerrada && a.Fecha.Date < DateTime.Today;
    private static string ClaseEstado(EstadoAccionPlan e) => e switch { EstadoAccionPlan.Abierta => "pv-abierta", EstadoAccionPlan.EnEjecucion => "pv-ejecucion", _ => "pv-cerrada" };

    // Avance del plan: % de acciones cerradas (0 si no tiene acciones).
    private (int Cerradas, int Total, int Pct) Avance(int planId)
    {
        var l = acciones.Where(a => a.PlanAccionId == planId).ToList();
        var c = l.Count(a => a.Estado == EstadoAccionPlan.Cerrada);
        return (c, l.Count, l.Count == 0 ? 0 : (int)Math.Round(c * 100.0 / l.Count));
    }

    private AccionPlan? ProximaAccion(int planId) => acciones.Where(a => a.PlanAccionId == planId && a.Estado != EstadoAccionPlan.Cerrada)
        .OrderBy(a => a.Fecha).FirstOrDefault();

