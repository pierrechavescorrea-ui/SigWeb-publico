            new ColumnaNativa("Origen", "Origen", TipoCampoTabla.Texto, id => P(id)?.OrigenHallazgo),
            new ColumnaNativa("Tipo", "Tipo de hallazgo", TipoCampoTabla.Texto, id => P(id)?.TipoHallazgo),
            new ColumnaNativa("Descripcion", "Descripción del hallazgo", TipoCampoTabla.Texto, id => P(id)?.DescripcionHallazgo),
            new ColumnaNativa("Procesos", "Procesos", TipoCampoTabla.Texto, id => P(id)?.Proceso),
            new ColumnaNativa("Lugares", "Lugares", TipoCampoTabla.Texto, id => string.Join("\n", LugaresDe(id))),
            new ColumnaNativa("Riesgo", "Riesgos", TipoCampoTabla.Texto, id => RiesgosTexto(id)),
            new ColumnaNativa("Acciones", "Acciones", TipoCampoTabla.Texto, id => string.Join("\n", acciones.Where(a => a.PlanAccionId == id).OrderBy(a => a.Orden).Select(a => $"[{EscalaAccion.Nombre(a.Estado)}] {a.Descripcion}"))),
            new ColumnaNativa("Estado", "Estado del plan", TipoCampoTabla.Texto, id => EscalaAccion.Nombre(EstadoDe(id))),
            new ColumnaNativa("Adjuntos", "Adjuntos", TipoCampoTabla.Texto, id => string.Join("\n", CarpetasVista(id).Where(c => c.Archivos.Count > 0).Select(c => $"{c.Nombre} ({c.Archivos.Count})"))),
            new ColumnaNativa("Analisis", "Análisis de causa", TipoCampoTabla.Texto, id => P(id)?.AnalisisCausa, visiblePorDefecto: false),
            new ColumnaNativa("Reporto", "Reportó", TipoCampoTabla.Texto, id => P(id) is { } p ? string.Join(" · ", new[] { p.ReportoNombre, p.ReportoCargo, p.ReportoEmpresa }.Where(x => !string.IsNullOrWhiteSpace(x))) : null),
            new ColumnaNativa("Carga", "Carga", TipoCampoTabla.Texto, id => P(id)?.CargaPlanesAccionId is int c && nombreCarga.TryGetValue(c, out var n) ? n : null, visiblePorDefecto: false),
        };
    }

