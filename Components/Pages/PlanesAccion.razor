@page "/planes-accion"
@page "/planes-accion/nuevo"
@page "/planes-accion/{PlanId:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.Riesgos
@using SigWeb.Models
@using SigWeb.Data.Tablas
@using SigWeb.Data.Documentos
@inject IServiceScopeFactory Scopes
@inject AppDbContext Db
@inject SigWeb.Data.Impacto.AnalizadorImpacto Analizador
@inject SigWeb.Data.Planes.PlanesAccionServicio Servicio
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Planes de acción</PageTitle>

@if (verAdjuntosDe is int vaPlan && planes.FirstOrDefault(p => p.Id == vaPlan) is { } planAdj)
{
    @* ---------- Ver todos los adjuntos de un plan: todas sus carpetas con todos sus archivos ---------- *@
    <EncabezadoPagina Titulo="@planAdj.Codigo" Icono="plan-accion" Subtitulo="@($"Adjuntos · {CarpetasVista(vaPlan).Count} carpeta(s), {TotalAdjuntos(vaPlan)} archivo(s)")"
                      OnAtras="CerrarVerAdjuntos" />
    if (!string.IsNullOrEmpty(mensajeAdj)) { <div class="alert alert-warning py-1 small">@mensajeAdj</div> }
    <div class="doc-menu adj-nueva mb-2">@NuevaCarpetaFila(vaPlan)</div>
    <div class="adj-carpetas">
        @foreach (var c in CarpetasVista(vaPlan))
        {
            <div class="adj-carpeta">@SeccionCarpeta(c, false)</div>
        }
    </div>
}
else
{
<div class="@(pantallaCompleta && form is null ? "ens-pantalla" : "")">
<EncabezadoPagina Titulo="@Titulo" Icono="plan-accion" Subtitulo="@Subtitulo" OnAtras="AtrasCb">
    <Acciones>
        @if (form is null)
        {
            <button type="button" class="pg-btn @(pantallaCompleta ? "activo" : "")" title="@(pantallaCompleta ? "Salir de pantalla completa" : "Pantalla completa")" @onclick="() => pantallaCompleta = !pantallaCompleta"><Ico Nombre="pantalla-completa" /></button>
            <button type="button" class="pg-btn @(vistaPlanes == "plan" ? "activo" : "")" title="Plan por plan" disabled="@modoEdicion" @onclick='() => vistaPlanes = "plan"'><Ico Nombre="indicador" /></button>
            <button type="button" class="pg-btn @(vistaPlanes == "tablero" ? "activo" : "")" title="Tablero por estado" disabled="@modoEdicion" @onclick='() => vistaPlanes = "tablero"'><Ico Nombre="tablero" /></button>
            <button type="button" class="pg-btn @(vistaPlanes == "lista" ? "activo" : "")" title="Lista" disabled="@modoEdicion" @onclick='() => vistaPlanes = "lista"'><Ico Nombre="listado" /></button>
            <button type="button" class="pg-btn @(verCargas ? "activo" : "")" title="@($"Cargas ({cargasPlanes.Count})")" disabled="@modoEdicion" @onclick="AlternarCargas"><Ico Nombre="cargas" />@(cargasPlanes.Count > 0 ? $" {cargasPlanes.Count}" : "")</button>
            <span class="pg-sep"></span>
            <BotonCampos Activo="verCampos" Deshabilitado="motor is null || modoEdicion" OnClick="() => verCampos = true" />
            <button type="button" class="pg-btn @(mostrarImportar ? "activo" : "")" title="Importar planes (Excel)" disabled="@modoEdicion" @onclick="AlternarImportar"><Ico Nombre="cargar-excel" /></button>
            <BotonExportar Titulo="Planes de acción" Motor="motor" Filas="() => Mostrados.Select(p => p.Id)" Deshabilitado="motor is null" />
            <span class="pg-sep"></span>
            @if (!modoEdicion)
            {
                <button type="button" class="pg-btn pg-btn-peligro" title="Eliminar plan seleccionado" disabled="@(selId is null)" @onclick="PedirEliminarSeleccionado"><Ico Nombre="eliminar" /></button>
                <button type="button" class="pg-btn" title="Editar" disabled="@(motor is null)" @onclick="EntrarEdicion"><Ico Nombre="editar" /></button>
                <button type="button" class="pg-btn pg-btn-primario" title="Nuevo plan de acción" @onclick='() => Nav.NavigateTo("planes-accion/nuevo")'><Ico Nombre="agregar" /></button>
            }
            else
            {
                <button type="button" class="pg-btn" title="Descartar cambios y salir de edición" @onclick="SalirEdicion"><Ico Nombre="cancelar" /></button>
                <button type="button" class="pg-btn pg-btn-primario" title="Guardar cambios" disabled="@(cambios.Count == 0 || guardando)" @onclick="GuardarEdicion"><Ico Nombre="guardar" />@(cambios.Count > 0 ? $" {cambios.Count}" : "")</button>
            }
        }
        else
        {
            @if (form.Plan.Id > 0)
            {
                <button type="button" class="pg-btn pg-btn-peligro" title="Eliminar plan" @onclick="PedirEliminarPlan"><Ico Nombre="eliminar" /></button>
            }
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar" disabled="@guardando" @onclick="GuardarAsync"><Ico Nombre="guardar" /></button>
        }
    </Acciones>
</EncabezadoPagina>

@if (verCampos && motor is not null && form is null)
{
    <PanelCampos Motor="motor" OnCerrar="() => verCampos = false" OnCambio="StateHasChanged" />
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(error ? "alert-warning" : "alert-success") py-1 px-2 small d-flex align-items-center gap-2">
        <span class="flex-grow-1">@mensaje</span>
        <button type="button" class="btn-close btn-sm" @onclick='() => mensaje = ""'></button>
    </div>
}

@if (elimPlan is not null || elimAccion is not null)
{
    <div class="card panel-formulario mb-3 border-danger">
        <div class="card-body">
            <div class="mb-2"><Ico Nombre="eliminar" /> <strong>@(elimPlan is not null ? $"{elimPlan.Codigo} — {elimPlan.DescripcionHallazgo}" : elimAccion!.Accion.Descripcion)</strong></div>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2">
                <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="CancelarEliminar"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@BloqueadoPorImpacto" @onclick="ConfirmarEliminar"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}

@* ---------- Cargas (bases de datos Excel) ---------- *@
@if (form is null && verCargas)
{
    <div class="card panel-formulario mb-3">
        <div class="card-body">
            @if (cargasPlanes.Count == 0) { <div class="text-muted small">—</div> }
            else
            {
                <div class="tabla-scroll mb-2" style="max-height:280px;">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:32px;"><input type="checkbox" class="form-check-input" title="Todas" checked="@(cargasSel.Count == cargasPlanes.Count)" @onchange="@(e => { cargasSel = (bool)e.Value! ? cargasPlanes.Select(c => c.Id).ToHashSet() : new(); elimCargas = null; })" /></th>
                                <th>Archivo</th><th>Hoja</th><th>Fecha</th><th title="Planes de esta carga">Planes</th><th title="Acciones creadas">Acc.</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in cargasPlanes)
                            {
                                var id = c.Id;
                                <tr class="@(cargaFiltro == id ? "table-active" : "")">
                                    <td><input type="checkbox" class="form-check-input" checked="@cargasSel.Contains(id)" @onchange="@(e => { if ((bool)e.Value!) cargasSel.Add(id); else cargasSel.Remove(id); elimCargas = null; })" /></td>
                                    <td class="small">@c.NombreArchivo</td>
                                    <td class="small">@c.Hoja</td>
                                    <td class="small text-nowrap">@c.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="small text-end">@(planesPorCarga.TryGetValue(id, out var n) ? n : 0)</td>
                                    <td class="small text-end">@c.AccionesCreadas</td>
                                    <td><button type="button" class="ens-mini @(cargaFiltro == id ? "activo" : "")" title="Ver solo esta carga" @onclick="() => cargaFiltro = cargaFiltro == id ? null : id"><Ico Nombre="ubicar" /></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-danger btn-sm" title="@($"Eliminar cargas seleccionadas ({cargasSel.Count})")" disabled="@(cargasSel.Count == 0)" @onclick="PedirEliminarCargas"><Ico Nombre="eliminar" /> @cargasSel.Count</button>
                </div>
            }
            @if (elimCargas is not null)
            {
                <div class="border border-danger rounded p-2 mt-2">
                    <PanelImpacto Informe="impactoCargas" OnEntendido="@(v => impactoCargasOk = v)" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => elimCargas = null"><Ico Nombre="cancelar" /></button>
                        <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@(impactoCargas is null || (impactoCargas.RequiereEntender && !impactoCargasOk))" @onclick="ConfirmarEliminarCargas"><Ico Nombre="eliminar" /></button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (form is null && mostrarImportar)
{
    <PanelImportarExcel Destinos="DestinosImportacion" Importando="importando" OnImportar="ImportarExcel" OnCancelar="() => mostrarImportar = false" />
}

@* ======================= LISTA ======================= *@
@if (form is null)
{
    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <input class="form-control form-control-sm" style="max-width:280px;" placeholder="Buscar..." @bind="filtro" @bind:event="oninput" />
        <select class="form-select form-select-sm" style="max-width:170px;" @bind="filtroEstado">
            <option value="">Todos los estados</option>
            <option value="0">Abierta</option>
            <option value="1">En ejecución</option>
            <option value="2">Cerrada</option>
        </select>
        <select class="form-select form-select-sm" style="max-width:190px;" @bind="filtroOrigen">
            <option value="">Todos los orígenes</option>
            @foreach (var o in Opciones(SembradorCatalogosRiesgo.OrigenHallazgo, null)) { <option value="@o">@o</option> }
        </select>
        <select class="form-select form-select-sm" style="max-width:200px;" @bind="filtroTipo">
            <option value="">Todos los tipos</option>
            @foreach (var o in Opciones(SembradorCatalogosRiesgo.TipoHallazgo, null)) { <option value="@o">@o</option> }
        </select>
        <select class="form-select form-select-sm" style="max-width:220px;" @bind="filtroProceso">
            <option value="">Todos los procesos</option>
            @foreach (var p in planes.SelectMany(p => SelectorMultiple.Leer(p.Proceso)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(p => p))
            {
                <option value="@p">@p</option>
            }
        </select>
        @if (cargaFiltro is int cf && cargasPlanes.FirstOrDefault(c => c.Id == cf) is { } cg)
        {
            <span class="rg-chip"><Ico Nombre="cargas" /> @cg.NombreArchivo <button type="button" class="rg-chip-x" title="Quitar" @onclick="() => cargaFiltro = null">✕</button></span>
        }
        <div class="ms-auto d-flex gap-1 align-items-center small">
            @foreach (var e in new[] { EstadoAccionPlan.Abierta, EstadoAccionPlan.EnEjecucion, EstadoAccionPlan.Cerrada })
            {
                <span class="d-inline-flex align-items-center gap-1"><EstadoAccion Estado="e" />@planes.Count(p => EstadoDe(p.Id) == e)</span>
            }
        </div>
    </div>

    @if (vistaPlanes == "plan" && !modoEdicion)
    {
        @VistaPlan()
    }
    else if (vistaPlanes == "tablero" && !modoEdicion)
    {
        @VistaTablero()
    }
    else
    {
    <div class="tabla-scroll tabla-auto"><table class="table table-sm table-bordered @(modoEdicion ? "" : "table-hover") tabla-compacta align-middle mb-0 tabla-pin tabla-planes @(modoEdicion ? "doc-editando" : "")">
        <thead>
            <tr>
                @foreach (var c in Columnas)
                {
                    <th class="th-ordenable" style="@AnchoColumna(c)" @onclick="() => OrdenarPor(c.Clave)">@c.Nombre@(Flecha(c.Clave))</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (motor is not null)
            {
                @foreach (var p in Mostrados)
                {
                    var plan = p;
                    var id = p.Id;
                    <tr class="@(!modoEdicion && selId == id ? "table-active" : "")" @onclick="() => { if (!modoEdicion) selId = id; }" @ondblclick="() => AbrirPlan(id)">
                        @foreach (var c in Columnas)
                        {
                            var campo = c;
                            var nat = campo.Origen == OrigenCampoTabla.Nativo;
                            if (modoEdicion && EsEditable(campo))
                            {
                                <td class="small p-0 @(cambios.ContainsKey((id, ClaveCambio(campo))) ? "doc-cambio" : "")">
                                    @if (nat && campo.Clave is "Origen" or "Tipo")
                                    {
                                        var actual = ValorEdicion(plan, campo);
                                        <select class="form-select form-select-sm cc-input" value="@actual" @onchange="@(e => Cambiar(plan, campo, e.Value?.ToString()))">
                                            <option value=""></option>
                                            @foreach (var o in Opciones(campo.Clave == "Origen" ? SembradorCatalogosRiesgo.OrigenHallazgo : SembradorCatalogosRiesgo.TipoHallazgo, actual)) { <option value="@o">@o</option> }
                                        </select>
                                    }
                                    else if (nat && campo.Clave is "Descripcion" or "Analisis")
                                    {
                                        <textarea class="form-control form-control-sm cc-input" rows="2" @onchange="@(e => Cambiar(plan, campo, e.Value?.ToString()))">@ValorEdicion(plan, campo)</textarea>
                                    }
                                    else
                                    {
                                        <text>@EntradaCampo(campo, ValorEdicion(plan, campo), val => Cambiar(plan, campo, val), "cc-input")</text>
                                    }
                                </td>
                            }
                            else if (nat && campo.Clave == "Codigo")
                            {
                                <td class="fw-bold"><button type="button" class="doc-vinculo" title="Abrir plan" disabled="@modoEdicion" @onclick:stopPropagation="true" @onclick="() => AbrirPlan(id)">@plan.Codigo</button></td>
                            }
                            else if (nat && campo.Clave == "Acciones" && Motor.Estilo(id, campo) is null)
                            {
                                <td>
                                    <div class="pa-acciones">
                                        @foreach (var a in acciones.Where(a => a.PlanAccionId == id).OrderBy(a => a.Orden))
                                        {
                                            var acc = a;
                                            <button type="button" class="pa-accion pa-accion-btn" title="@($"{EscalaAccion.Nombre(acc.Tipo)} · {acc.Fecha:dd/MM/yyyy}")"
                                                    disabled="@modoEdicion" @onclick:stopPropagation="true" @onclick="() => AbrirAcciones(id, acc.Id)">
                                                <EstadoAccion Estado="acc.Estado" />
                                                <span class="pa-accion-txt">@acc.Descripcion</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            }
                            else if (nat && campo.Clave == "Adjuntos")
                            {
                                <td class="text-center">@CeldaAdjuntos(id)</td>
                            }
                            else if (nat && campo.Clave == "Estado" && Motor.Estilo(id, campo) is null)
                            {
                                <td><EstadoAccion Estado="EstadoDe(id)" /></td>
                            }
                            else
                            {
                                <CeldaCampo Motor="Motor" Campo="campo" Fila="id" SoloLectura="true" Clase="@(nat && campo.Clave is "Descripcion" or "Procesos" or "Lugares" or "Analisis" or "Riesgo" or "Adjuntos" ? "rg-multi" : null)" OnCambio="StateHasChanged" />
                            }
                        }
                    </tr>
                }
                @if (!Mostrados.Any())
                {
                    <tr><td colspan="@Math.Max(1, Columnas.Count())" class="text-muted small text-center py-2"><em>Sin planes de acción.</em></td></tr>
                }
            }
        </tbody>
    </table></div>
    }
    <text>@MenuAdjuntos()</text>
}
</div>

@* ======================= PLAN (formulario) ======================= *@
if (form is not null)
{
    <div class="card panel-formulario frm mb-2">
        <div class="card-body frm-cuerpo">
            <EditorPlanAccion Modelo="form" Origenes="Opciones(SembradorCatalogosRiesgo.OrigenHallazgo, null)" Tipos="Opciones(SembradorCatalogosRiesgo.TipoHallazgo, null)"
                              Procesos="Opciones(SembradorCatalogosRiesgo.ProcesoPlan, null)" Responsables="sugResponsables"
                              ReportoNombres="sugReportoNombres" ReportoCargos="sugReportoCargos" ReportoEmpresas="sugReportoEmpresas"
                              Torres="torres" Componentes="componentesPorId" Localizaciones="localizaciones" Tiros="tiros"
                              Origen="OrigenFichas" OnEliminarGuardada="PedirEliminarAccion" OnError="m => { mensaje = m; error = true; }"
                              SoloAcciones="soloAcciones" AccionFoco="accionFoco"
                              RiesgosOpciones="riesgosOpciones" EtiquetasRiesgo="etiquetasRiesgo" />
        </div>
    </div>
}

}

@code {
    [Parameter] public int? PlanId { get; set; }
    // ?riesgo=ID: el plan se abrió desde ese riesgo (Atrás vuelve a él) y,
    // si es nuevo, nace ligado a él. ?seguimiento=ID: nace de ese seguimiento.
    [SupplyParameterFromQuery(Name = "riesgo")] public int? RiesgoQ { get; set; }
    [SupplyParameterFromQuery(Name = "seguimiento")] public int? SeguimientoQ { get; set; }
    // ?volver=atras: se abrió desde otra pantalla (p. ej. la hoja de vida de una torre); Atrás regresa a ella.
    [SupplyParameterFromQuery(Name = "volver")] public string? VolverQ { get; set; }

    // Igual que en Riesgos: el DbContext es uno por circuito y el cálculo de
    // impacto corre sin await; el semáforo evita dos operaciones a la vez, y
    // el render nunca consulta Db (todo se precarga).
    private readonly SemaphoreSlim _dbLock = new(1, 1);

    private string mensaje = "";
    private bool error, guardando;

    private List<PlanAccion> planes = new();
    private List<AccionPlan> acciones = new();
    private List<ItemCatalogo> localizaciones = new();
    private Dictionary<int, RiesgoRef> riesgosPorId = new();
    private Dictionary<int, List<int>> riesgosDePlan = new();          // plan → riesgos asociados
    private List<(int Id, string Etiqueta)> riesgosOpciones = new();   // riesgos que se pueden asociar
    private Dictionary<int, string> etiquetasRiesgo = new();
    private List<string> sugResponsables = new();
    private List<string> sugReportoNombres = new(), sugReportoCargos = new(), sugReportoEmpresas = new();
    private Dictionary<string, List<string>> catalogos = new();

    // Opciones de un catálogo, más el valor actual si ya no está en él.
    private List<string> Opciones(string tipo, string? actual)
    {
        var l = catalogos.TryGetValue(tipo, out var v) ? v.ToList() : new();
        if (!string.IsNullOrWhiteSpace(actual) && !l.Contains(actual, StringComparer.OrdinalIgnoreCase)) l.Insert(0, actual);
        return l;
    }

    private SigWeb.Data.Planes.PlanesAccionServicio.PlanEditable? form;

    private List<ElementoTrazado> torres = new();
    private Dictionary<int, Componente> componentesPorId = new();
    private List<Tiro> tiros = new();
    private List<LugarPlan> lugaresTodos = new();
    private List<ArchivoAccionPlan> anexosTodos = new();

    private IEnumerable<string> LugaresDe(int planId) => lugaresTodos.Where(l => l.PlanAccionId == planId)
        .Select(l => SelectorLugares.Texto(l, torres, componentesPorId, localizaciones, tiros));
    private SeguimientoRiesgo? seguimientoOrigen;

    private string filtro = "", filtroEstado = "", filtroProceso = "", filtroOrigen = "", filtroTipo = "";

    private record RiesgoRef(int Id, string Codigo, string Descripcion, string Version, int VersionId, bool Eliminado)
    {
        public string Etiqueta => $"{Codigo} ({Version}) — {Descripcion}";
    }

    private string Titulo => form is null ? "Planes de acción" : (form.Plan.Id > 0 ? form.Plan.Codigo + (soloAcciones ? " · Acciones" : "") : "Nuevo plan de acción");
    private string? Subtitulo => form is null ? $"{planes.Count} plan(es)" : (string.IsNullOrWhiteSpace(form.Plan.DescripcionHallazgo) ? null : form.Plan.DescripcionHallazgo);

    // En la lista, Atrás va a la pantalla anterior (comportamiento por defecto).
    private EventCallback AtrasCb => form is null && !pantallaCompleta && RiesgoQ is null && VolverQ is null ? default : EventCallback.Factory.Create(this, Atras);
    private async Task Atras()
    {
        if (form is null && pantallaCompleta) { pantallaCompleta = false; return; }
        if (VolverQ == "atras") { await JS.InvokeVoidAsync("history.back"); return; }
        if (RiesgoQ is int r) Nav.NavigateTo($"riesgos/{r}");
        else Nav.NavigateTo("planes-accion");
    }

    protected override Task OnParametersSetAsync() => AplicarRutaAsync();

    // Entre /planes-accion, /planes-accion/nuevo y /planes-accion/{id} es el mismo componente: Blazor
    // no vuelve a pasar parámetros si no cambian (lista ↔ nuevo), así que la ruta se aplica también al
    // cambiar la dirección. La ruta se lee de la URL (los parámetros pueden ir un paso atrás).
    protected override void OnInitialized() => Nav.LocationChanged += AlCambiarDireccion;
    public void Dispose() => Nav.LocationChanged -= AlCambiarDireccion;

    private void AlCambiarDireccion(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var ruta = Nav.ToBaseRelativePath(e.Location).Split('?')[0].TrimEnd('/');
        if (!ruta.StartsWith("planes-accion", StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(async () => { await AplicarRutaAsync(); StateHasChanged(); });
    }

    private string? rutaAplicada;

    private async Task AplicarRutaAsync()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri);
        var ruta = rel.Split('?')[0].TrimEnd('/');
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(rel.Contains('?') ? rel[rel.IndexOf('?')..] : "");
        var foco = q.TryGetValue("acciones", out var fv) && int.TryParse(fv.ToString(), out var fa) ? fa : (int?)null;
        await _dbLock.WaitAsync();
        try
        {
            if (rel == rutaAplicada) return;   // OnParametersSet y LocationChanged llegan juntos
            rutaAplicada = rel;
            soloAcciones = foco is not null; accionFoco = foco; irAFoco = foco is not null;
            Cargar();
            await CargarMotorAsync();
            var partes = ruta.Split('/');
            if (partes.Length >= 2 && int.TryParse(partes[^1], out var id)) AbrirExistente(id);
            else if (ruta.EndsWith("planes-accion/nuevo", StringComparison.OrdinalIgnoreCase)) AbrirNuevo();
            else form = null;
        }
        finally { _dbLock.Release(); }
    }

    private void Cargar()
    {
        planes = Db.PlanesAccion.AsNoTracking().OrderByDescending(p => p.Fecha).ThenByDescending(p => p.Id).ToList();
        acciones = Db.AccionesPlan.AsNoTracking().ToList();
        localizaciones = Db.Catalogos.AsNoTracking().Where(c => c.Tipo == "Localización" && c.Activo).OrderBy(c => c.Nombre).ToList();
        torres = Db.ElementosTrazado.AsNoTracking().Where(t => !t.Eliminado).OrderBy(t => t.Codigo).ToList();
        componentesPorId = Db.Componentes.IgnoreQueryFilters().AsNoTracking().ToList().ToDictionary(c => c.Id);
        tiros = Db.Tiros.AsNoTracking().Where(t => !t.Eliminado).OrderBy(t => t.Nombre).ToList();
        lugaresTodos = Db.LugaresPlan.AsNoTracking().ToList();
        anexosTodos = Db.ArchivosAccionPlan.AsNoTracking().ToList();
        try { cargasPlanes = Db.CargasPlanesAccion.AsNoTracking().OrderByDescending(c => c.Fecha).ToList(); }
        catch { cargasPlanes = new(); }   // sin la migración aplicada
        planesPorCarga = planes.Where(p => p.CargaPlanesAccionId != null).GroupBy(p => p.CargaPlanesAccionId!.Value).ToDictionary(g => g.Key, g => g.Count());
        cargasSel.RemoveWhere(id => cargasPlanes.All(c => c.Id != id));
        if (cargaFiltro is int cf && cargasPlanes.All(c => c.Id != cf)) cargaFiltro = null;
        if (selId is int sid && planes.All(p => p.Id != sid)) selId = null;
        var versiones = Db.VersionesMatrizRiesgos.IgnoreQueryFilters().AsNoTracking().ToDictionary(v => v.Id);
        riesgosPorId = Db.Riesgos.IgnoreQueryFilters().AsNoTracking()
            .Select(r => new { r.Id, r.Codigo, r.Descripcion, r.VersionMatrizRiesgosId, r.Eliminado }).ToList()
            .ToDictionary(r => r.Id, r => new RiesgoRef(r.Id, r.Codigo, r.Descripcion,
                versiones.TryGetValue(r.VersionMatrizRiesgosId, out var v) ? v.Codigo : "?", r.VersionMatrizRiesgosId,
                r.Eliminado || (versiones.TryGetValue(r.VersionMatrizRiesgosId, out var v2) && v2.Eliminado)));
        try { riesgosDePlan = SigWeb.Data.Planes.PlanesAccionServicio.RiesgosDePlanes(Db, planes); }
        catch { riesgosDePlan = planes.Where(p => p.RiesgoId != null).ToDictionary(p => p.Id, p => new List<int> { p.RiesgoId!.Value }); }   // sin la migración aplicada
        etiquetasRiesgo = riesgosPorId.Values.ToDictionary(r => r.Id, r => r.Etiqueta + (r.Eliminado ? " · en Papelera" : ""));
        riesgosOpciones = riesgosPorId.Values.Where(r => !r.Eliminado).OrderBy(r => r.Codigo).ThenByDescending(r => r.VersionId)
            .Select(r => (r.Id, r.Etiqueta)).ToList();
        CargarCarpetas();
        catalogos = new[] { SembradorCatalogosRiesgo.ProcesoPlan, SembradorCatalogosRiesgo.OrigenHallazgo, SembradorCatalogosRiesgo.TipoHallazgo }
            .ToDictionary(t => t, t => SembradorCatalogosRiesgo.Valores(Db, t));
        // "Reportó": valores ya usados en otros planes.
        List<string> Usados(Func<PlanAccion, string> f) => planes.Select(f).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
        sugReportoNombres = Usados(p => p.ReportoNombre);
        sugReportoCargos = Usados(p => p.ReportoCargo);
        sugReportoEmpresas = Usados(p => p.ReportoEmpresa);
        // Responsable de una acción: los cargos del catálogo de riesgos más los nombres ya usados.
        sugResponsables = SembradorCatalogosRiesgo.Valores(Db, SembradorCatalogosRiesgo.Cargo)
            .Concat(acciones.Select(a => a.Responsable)).Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    }

    private void AbrirExistente(int id)
    {
        form = Servicio.Cargar(id);
        if (form is null) { mensaje = "El plan no existe o está en la Papelera."; error = true; return; }
        seguimientoOrigen = form.Plan.SeguimientoRiesgoId is int s ? Db.SeguimientosRiesgo.IgnoreQueryFilters().AsNoTracking().FirstOrDefault(x => x.Id == s) : null;
    }

    private void AbrirNuevo()
    {
        form = new() { Plan = new PlanAccion { Codigo = Servicio.SiguienteCodigo(), Fecha = DateTime.Today } };
        seguimientoOrigen = null;
        if (RiesgoQ is int rid && riesgosPorId.ContainsKey(rid)) { form.Plan.RiesgoId = rid; form.Riesgos.Add(rid); }
        if (SeguimientoQ is int sid && Db.SeguimientosRiesgo.AsNoTracking().FirstOrDefault(s => s.Id == sid) is { } seg)
        {
            // Nace de un seguimiento: toma su riesgo, su fecha, su observación y,
            // como lugares, los de los hallazgos que registró.
            seguimientoOrigen = seg;
            form.Plan.SeguimientoRiesgoId = seg.Id;
            form.Plan.OrigenHallazgo = Opciones(SembradorCatalogosRiesgo.OrigenHallazgo, null)
                .FirstOrDefault(o => string.Equals(o, "Seguimiento", StringComparison.OrdinalIgnoreCase)) ?? "";
            form.Plan.RiesgoId = seg.RiesgoId;
            if (!form.Riesgos.Contains(seg.RiesgoId)) form.Riesgos.Insert(0, seg.RiesgoId);
            form.Plan.Fecha = seg.Fecha;
            form.Plan.DescripcionHallazgo = seg.Observacion ?? "";
            var idsH = Db.HallazgosRiesgo.AsNoTracking().Where(x => x.SeguimientoRiesgoId == seg.Id).Select(x => x.Id).ToList();
            foreach (var l in Db.LugaresHallazgo.AsNoTracking().Where(l => idsH.Contains(l.HallazgoRiesgoId)).ToList())
                if (!form.Lugares.Any(x => x.ElementoTrazadoId == l.ElementoTrazadoId && x.ComponenteId == l.ComponenteId && x.ItemCatalogoId == l.ItemCatalogoId && x.TiroId == l.TiroId))
                    form.Lugares.Add(new LugarPlan { ElementoTrazadoId = l.ElementoTrazadoId, ComponenteId = l.ComponenteId, ItemCatalogoId = l.ItemCatalogoId, TiroId = l.TiroId });
        }
    }

    // Ficha del seguimiento de origen (se muestra, no se cambia aquí). Los riesgos se eligen en el editor.
    private RenderFragment? OrigenFichas => seguimientoOrigen is null ? null : __b =>
    {
        __b.OpenElement(0, "span"); __b.AddAttribute(1, "class", "rg-chip"); __b.AddAttribute(2, "title", "Seguimiento de origen");
        __b.AddContent(3, $"Seguimiento {seguimientoOrigen.Fecha:dd/MM/yyyy} · {string.Join(", ", SelectorMultiple.Leer(seguimientoOrigen.Responsable))}");
