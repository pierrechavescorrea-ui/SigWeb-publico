    private void AlternarImportar() { mostrarImportar = !mostrarImportar; verCargas = false; mensaje = ""; }

    private void PedirEliminarCargas()
    {
        if (cargasSel.Count == 0) return;
        elimCargas = cargasSel.ToList(); impactoCargas = null; impactoCargasOk = false;
        _ = CalcularImpactoCargas(elimCargas);
    }

    private async Task CalcularImpactoCargas(List<int> ids)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            impactoCargas = await scope.ServiceProvider.GetRequiredService<SigWeb.Data.Impacto.AnalizadorImpacto>().CargasPlanesAccion(ids);
        }
        catch { impactoCargas = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmarEliminarCargas()
    {
        if (elimCargas is null) return;
        var ids = elimCargas;
        await _dbLock.WaitAsync();
        try
        {
            // Misma marca de tiempo para la carga, sus planes y sus acciones: la Papelera los restaura juntos.
            var ahora = DateTime.Now; ahora = new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, ahora.Minute, ahora.Second);
            foreach (var c in await Db.CargasPlanesAccion.Where(c => ids.Contains(c.Id)).ToListAsync()) { c.Eliminado = true; c.FechaEliminacion = ahora; }
            var ps = await Db.PlanesAccion.Where(p => p.CargaPlanesAccionId != null && ids.Contains(p.CargaPlanesAccionId.Value)).ToListAsync();
            var idsP = ps.Select(p => p.Id).ToList();
            foreach (var p in ps) { p.Eliminado = true; p.FechaEliminacion = ahora; }
            foreach (var a in await Db.AccionesPlan.Where(a => idsP.Contains(a.PlanAccionId)).ToListAsync()) { a.Eliminado = true; a.FechaEliminacion = ahora; }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            mensaje = $"{ids.Count} carga(s) y {ps.Count} plan(es) enviados a la Papelera."; error = false;
            elimCargas = null; cargasSel.Clear();
            Cargar();
            await CargarMotorAsync();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo eliminar: " + ex.Message; error = true; }
        finally { _dbLock.Release(); }
    }

