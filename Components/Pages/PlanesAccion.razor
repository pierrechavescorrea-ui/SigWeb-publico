    // ---------- Edición de la tabla (solo con Editar; nada se guarda hasta Guardar) ----------
    private bool modoEdicion;
    private Dictionary<(int Fila, string Clave), string?> cambios = new();

    private static bool EsEditable(CampoTabla c) =>
        c.Origen == OrigenCampoTabla.Nativo ? c.Clave is "Fecha" or "Origen" or "Tipo" or "Descripcion" or "Analisis" : !c.Calculado;

    private static string ClaveCambio(CampoTabla c) => c.Origen == OrigenCampoTabla.Nativo ? c.Clave : "c:" + c.Id;

    private string? ValorActual(PlanAccion p, CampoTabla c) => c.Origen == OrigenCampoTabla.Nativo
        ? c.Clave switch
        {
            "Fecha" => p.Fecha.ToString("yyyy-MM-dd"), "Origen" => p.OrigenHallazgo, "Tipo" => p.TipoHallazgo,
            "Descripcion" => p.DescripcionHallazgo, "Analisis" => p.AnalisisCausa, _ => null
        }
        : motor?.Registro(p.Id, c)?.Valor;

    private string? ValorEdicion(PlanAccion p, CampoTabla c) => cambios.TryGetValue((p.Id, ClaveCambio(c)), out var v) ? v : ValorActual(p, c);

    private void Cambiar(PlanAccion p, CampoTabla c, string? valor)
    {
        valor = string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();
        var k = (p.Id, ClaveCambio(c));
        if ((valor ?? "") == (ValorActual(p, c) ?? "")) cambios.Remove(k); else cambios[k] = valor;
    }

    private void EntrarEdicion() { vistaPlanes = "lista"; modoEdicion = true; cambios.Clear(); verCargas = false; mostrarImportar = false; verCampos = false; mensaje = ""; }
    private void SalirEdicion() { modoEdicion = false; cambios.Clear(); }

    private async Task GuardarEdicion()
    {
        if (motor is null || cambios.Count == 0) return;
        if (cambios.Any(k => k.Key.Clave == "Descripcion" && string.IsNullOrWhiteSpace(k.Value)))
        { mensaje = "La descripción del hallazgo no puede quedar vacía."; error = true; return; }
        guardando = true;
        await _dbLock.WaitAsync();
        try
        {
            var filas = cambios.Keys.Select(k => k.Fila).Distinct().ToList();
            var ents = await Db.PlanesAccion.Where(p => filas.Contains(p.Id)).ToDictionaryAsync(p => p.Id);
            foreach (var ((fila, clave), valor) in cambios.Where(k => !k.Key.Clave.StartsWith("c:")))
            {
                if (!ents.TryGetValue(fila, out var e)) continue;
                switch (clave)
                {
                    case "Fecha": if (FechaTexto.Parsear(valor) is DateTime f) e.Fecha = f; break;
                    case "Origen": e.OrigenHallazgo = valor ?? ""; break;
                    case "Tipo": e.TipoHallazgo = valor ?? ""; break;
                    case "Descripcion": e.DescripcionHallazgo = valor ?? ""; break;
                    case "Analisis": e.AnalisisCausa = valor ?? ""; break;
                }
            }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            var porId = motor.Campos.ToDictionary(c => c.Id);
            foreach (var ((fila, clave), valor) in cambios.Where(k => k.Key.Clave.StartsWith("c:")).ToList())
                if (porId.TryGetValue(int.Parse(clave[2..]), out var campo)) await motor.GuardarValorAsync(Db, fila, campo, valor);
            mensaje = $"{cambios.Count} cambio(s) guardado(s) en {filas.Count} plan(es)."; error = false;
            modoEdicion = false; cambios.Clear();
            Cargar();
            await CargarMotorAsync();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo guardar: " + ex.Message; error = true; }
        finally { guardando = false; _dbLock.Release(); }
    }

    // Entrada según el tipo del campo (misma que Documentos/Materiales).
    private RenderFragment EntradaCampo(CampoTabla c, string? valor, Action<string?> alCambiar, string clase = "") => __builder =>
    {
        switch (c.Tipo)
        {
            case TipoCampoTabla.Numero:
                <input type="number" step="any" class="form-control form-control-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))" />
                break;
            case TipoCampoTabla.Fecha:
                <input type="date" class="form-control form-control-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))" />
                break;
            case TipoCampoTabla.Lista:
                <select class="form-select form-select-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))">
                    <option value=""></option>
                    @foreach (var o in motor!.OpcionesDe(c)) { <option value="@o">@o</option> }
                </select>
                break;
            case TipoCampoTabla.SiNo:
                <div class="text-center"><input type="checkbox" class="form-check-input" checked="@(valor == "1")" @onchange="@(e => alCambiar((bool)e.Value! ? "1" : "0"))" /></div>
                break;
            default:
                <input class="form-control form-control-sm @clase" value="@valor" @onchange="@(e => alCambiar(e.Value?.ToString()))" />
                break;
        }
    };

