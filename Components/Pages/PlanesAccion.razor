        <div class="doc-menu-fila px-1 py-1">
            <input class="form-control form-control-sm" placeholder="Nueva carpeta" @bind="nuevaCarpeta" @bind:event="oninput"
                   @onkeydown="@(async e => { if (e.Key == "Enter") await CrearCarpeta(planId); })" />
            <button type="button" class="ens-mini" title="Crear carpeta" disabled="@string.IsNullOrWhiteSpace(nuevaCarpeta)" @onclick="() => CrearCarpeta(planId)"><Ico Nombre="agregar" /></button>
        </div>
    };

    // Una carpeta: título (cargar; renombrar y eliminar solo las hechas a mano) y sus archivos
    // (en la ventanita, máximo 3). Los anexos de una acción se reemplazan o eliminan igual que los demás.
    private RenderFragment SeccionCarpeta(CarpetaVista c, bool enMenu) => __builder =>
    {
        var archivos = c.Archivos;
        var mostrar = enMenu ? archivos.Take(MaxMenu).ToList() : archivos;
        if (c.CarpetaId is int cid && carpetaRenombrar == cid)
        {
            <div class="doc-menu-fila px-1 pt-1">
                <input class="form-control form-control-sm" @bind="nombreEdicion" @bind:event="oninput"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await RenombrarCarpeta(cid); })" />
                <button type="button" class="ens-mini" title="Guardar" disabled="@string.IsNullOrWhiteSpace(nombreEdicion)" @onclick="() => RenombrarCarpeta(cid)"><Ico Nombre="guardar" /></button>
                <button type="button" class="ens-mini" title="Cancelar" @onclick="() => carpetaRenombrar = null"><Ico Nombre="cancelar" /></button>
            </div>
        }
        else
        {
            <div class="doc-menu-sec d-flex align-items-center gap-1 @(c.AccionId is not null ? "adj-auto" : "")">
                <Ico Nombre="@(c.AccionId is not null ? "plan-accion" : "carpeta")" /> <span class="text-truncate">@c.Nombre@(enMenu && archivos.Count > MaxMenu ? $" ({MaxMenu} de {archivos.Count})" : archivos.Count > 0 ? $" ({archivos.Count})" : "")</span>
                <label class="ens-mini ms-auto mb-0" title="@($"Cargar en {c.Nombre}")"><Ico Nombre="agregar" /><InputFile class="d-none" multiple OnChange="@(e => SubirACarpeta(c, e))" /></label>
                @if (c.CarpetaId is int idc)
                {
                    <button type="button" class="ens-mini" title="Renombrar carpeta" @onclick="() => { carpetaRenombrar = idc; nombreEdicion = c.Nombre; }"><Ico Nombre="editar" /></button>
                    <button type="button" class="ens-mini" title="Eliminar carpeta" @onclick="() => PedirElimCarpeta(idc, c.Nombre, archivos.Count)"><Ico Nombre="eliminar" /></button>
                }
            </div>
        }
        if (c.CarpetaId is int idConf) { <text>@ConfirmacionEliminar("carpeta", idConf)</text> }
        if (archivos.Count == 0) { <span class="doc-menu-op doc-menu-off"><Ico Nombre="documento" /> <span>—</span></span> }
        foreach (var a in mostrar)
        {
            var arch = a;
            var tipo = arch.DeAccion ? "anexo" : "archivo";
            <div class="doc-menu-fila">
                <a class="doc-menu-op" href="@arch.Ruta" target="_blank" rel="noopener" title="@($"{arch.Nombre} · {arch.Fecha:dd/MM/yyyy}" + (arch.Detalle is null ? "" : $" · Producto: {arch.Detalle}"))">
                    <Ico Nombre="documento" /> <span class="text-truncate">@arch.Nombre</span>
                </a>
                @if (archivoReemplazar == (tipo, arch.Id))
                {
                    <label class="ens-mini mb-0 activo" title="Elegir el archivo nuevo"><Ico Nombre="adjuntar" /><InputFile class="d-none" OnChange="@(e => ReemplazarArchivo(arch, e))" /></label>
                    <button type="button" class="ens-mini" title="Cancelar" @onclick="() => archivoReemplazar = null"><Ico Nombre="cancelar" /></button>
                }
                else
                {
                    <button type="button" class="ens-mini" title="Editar (reemplazar archivo)" @onclick="() => archivoReemplazar = (tipo, arch.Id)"><Ico Nombre="editar" /></button>
                    <button type="button" class="ens-mini" title="Eliminar archivo" @onclick="() => PedirElimArchivo(arch)"><Ico Nombre="eliminar" /></button>
                }
            </div>
            <text>@ConfirmacionEliminar(tipo, arch.Id)</text>
        }
    };

    // Aviso antes de eliminar: la carpeta se lleva sus archivos; todo va a la Papelera.
    private RenderFragment ConfirmacionEliminar(string tipo, int id) => __builder =>
    {
        if (confirmarElim is not { } ce || ce.Tipo != tipo || ce.Id != id) return;
        <div class="doc-menu-confirma">
            <div class="small mb-1">
                <Ico Nombre="eliminar" /> <strong>@ce.Nombre</strong>
                @if (tipo == "carpeta" && ce.Archivos > 0) { <span> · se van con ella @ce.Archivos archivo(s)</span> }
            </div>
            <div class="d-flex gap-1 justify-content-end">
                <button type="button" class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => confirmarElim = null"><Ico Nombre="cancelar" /></button>
                <button type="button" class="btn btn-danger btn-sm" title="Eliminar (va a la Papelera)" @onclick="ConfirmarEliminarAdj"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    };

    private void CerrarVerAdjuntos() { verAdjuntosDe = null; LimpiarAdj(); }

    private void PedirElimCarpeta(int id, string nombre, int archivos) => confirmarElim = ("carpeta", id, nombre, archivos);
    private void PedirElimArchivo(ArchivoVista a) => confirmarElim = (a.DeAccion ? "anexo" : "archivo", a.Id, a.Nombre, 0);

    private async Task CrearCarpeta(int planId)
    {
        var nombre = nuevaCarpeta.Trim();
        if (nombre.Length == 0) return;
        if (CarpetasVista(planId).Any(c => string.Equals(c.Nombre, nombre, StringComparison.OrdinalIgnoreCase))) { mensajeAdj = $"Ya existe la carpeta \"{nombre}\"."; return; }
        await _dbLock.WaitAsync();
        try
        {
            Db.CarpetasPlan.Add(new CarpetaPlan { PlanAccionId = planId, Nombre = nombre, Orden = CarpetasDe(planId).Select(c => c.Orden).DefaultIfEmpty(0).Max() + 1 });
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            nuevaCarpeta = ""; mensajeAdj = "";
            CargarCarpetas();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeAdj = "No se pudo crear: " + ex.Message; }
        finally { _dbLock.Release(); }
    }

    private async Task RenombrarCarpeta(int carpetaId)
    {
        var nombre = nombreEdicion.Trim();
        var c0 = carpetasTodas.FirstOrDefault(c => c.Id == carpetaId);
        if (nombre.Length == 0 || c0 is null) return;
        if (CarpetasVista(c0.PlanAccionId).Any(c => c.CarpetaId != carpetaId && string.Equals(c.Nombre, nombre, StringComparison.OrdinalIgnoreCase))) { mensajeAdj = $"Ya existe la carpeta \"{nombre}\"."; return; }
        await _dbLock.WaitAsync();
        try
        {
            var ent = await Db.CarpetasPlan.FirstOrDefaultAsync(c => c.Id == carpetaId);
            if (ent is not null) { ent.Nombre = nombre; await Db.SaveChangesAsync(); }
            Db.ChangeTracker.Clear();
            carpetaRenombrar = null; mensajeAdj = "";
            CargarCarpetas();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeAdj = "No se pudo renombrar: " + ex.Message; }
        finally { _dbLock.Release(); }
    }

    // En una carpeta de acción, el archivo entra como anexo de la acción (en su primer producto).
    private async Task SubirACarpeta(CarpetaVista c, InputFileChangeEventArgs e)
    {
        mensajeAdj = "";
        var fallos = new List<string>();
        await _dbLock.WaitAsync();
        try
        {
            foreach (var f in e.GetMultipleFiles(50))
            {
                try
                {
                    if (c.AccionId is int accId)
                    {
                        var (nombre, ruta) = await SigWeb.Data.Planes.AlmacenAnexos.GuardarAsync(f, Env.WebRootPath, "planes-accion");
                        var prod = productosTodos.Values.Where(p => p.AccionPlanId == accId).OrderBy(p => p.Orden).ThenBy(p => p.Id).FirstOrDefault();
                        Db.ArchivosAccionPlan.Add(new ArchivoAccionPlan { AccionPlanId = accId, ProductoAccionId = prod?.Id, NombreOriginal = nombre, RutaArchivo = ruta });
                    }
                    else if (c.CarpetaId is int carpetaId)
                    {
                        var (nombre, ruta) = await SigWeb.Data.Planes.AlmacenAnexos.GuardarAsync(f, Env.WebRootPath, "planes-accion/carpetas");
                        Db.ArchivosCarpetaPlan.Add(new ArchivoCarpetaPlan { CarpetaPlanId = carpetaId, NombreOriginal = nombre, RutaArchivo = ruta });
                    }
                }
                catch (Exception ex) { fallos.Add(ex.Message); }
            }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            CargarCarpetas();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); fallos.Add(ex.Message); }
        finally { _dbLock.Release(); }
        if (fallos.Count > 0) mensajeAdj = "No se cargaron: " + string.Join("; ", fallos);
    }

    // Mismo registro, archivo nuevo; el anterior se borra del disco.
    private async Task ReemplazarArchivo(ArchivoVista arch, InputFileChangeEventArgs e)
    {
        mensajeAdj = "";
        await _dbLock.WaitAsync();
        try
        {
            string? anterior = null;
            if (arch.DeAccion)
            {
                var (nombre, ruta) = await SigWeb.Data.Planes.AlmacenAnexos.GuardarAsync(e.File, Env.WebRootPath, "planes-accion");
                if (await Db.ArchivosAccionPlan.FirstOrDefaultAsync(a => a.Id == arch.Id) is { } ent)
                { anterior = ent.RutaArchivo; ent.NombreOriginal = nombre; ent.RutaArchivo = ruta; ent.FechaRegistro = DateTime.Now; }
            }
            else
            {
                var (nombre, ruta) = await SigWeb.Data.Planes.AlmacenAnexos.GuardarAsync(e.File, Env.WebRootPath, "planes-accion/carpetas");
                if (await Db.ArchivosCarpetaPlan.FirstOrDefaultAsync(a => a.Id == arch.Id) is { } ent)
                { anterior = ent.RutaArchivo; ent.NombreOriginal = nombre; ent.RutaArchivo = ruta; ent.FechaCarga = DateTime.Now; }
            }
            await Db.SaveChangesAsync();
            if (anterior is not null) SigWeb.Data.Papelera.ProveedorPapeleraAdjuntosMaterial.BorrarFisico(Env, anterior);
            Db.ChangeTracker.Clear();
            archivoReemplazar = null;
            CargarCarpetas();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeAdj = "No se pudo reemplazar: " + ex.Message; }
        finally { _dbLock.Release(); }
    }

    private async Task ConfirmarEliminarAdj()
    {
        if (confirmarElim is not { } ce) return;
        await _dbLock.WaitAsync();
        try
        {
            // Misma marca de tiempo para la carpeta y sus archivos: la Papelera los restaura juntos.
            var ahora = DateTime.Now; ahora = new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, ahora.Minute, ahora.Second);
            if (ce.Tipo == "carpeta")
            {
                var c = await Db.CarpetasPlan.FirstOrDefaultAsync(x => x.Id == ce.Id);
                if (c is not null)
                {
                    c.Eliminado = true; c.FechaEliminacion = ahora;
                    foreach (var a in await Db.ArchivosCarpetaPlan.Where(a => a.CarpetaPlanId == ce.Id).ToListAsync()) { a.Eliminado = true; a.FechaEliminacion = ahora; }
                }
            }
            else if (ce.Tipo == "anexo")
            {
                if (await Db.ArchivosAccionPlan.FirstOrDefaultAsync(x => x.Id == ce.Id) is { } ax) { ax.Eliminado = true; ax.FechaEliminacion = ahora; }
            }
            else if (await Db.ArchivosCarpetaPlan.FirstOrDefaultAsync(x => x.Id == ce.Id) is { } a) { a.Eliminado = true; a.FechaEliminacion = ahora; }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            confirmarElim = null;
            CargarCarpetas();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeAdj = "No se pudo eliminar: " + ex.Message; }
        finally { _dbLock.Release(); }
    }
}
