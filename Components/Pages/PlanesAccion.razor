    // ---------- Lista ----------
    private EstadoAccionPlan EstadoDe(int planId) => EscalaAccion.EstadoPlan(acciones.Where(a => a.PlanAccionId == planId));

    private string NombreRiesgo(int? id) =>
        id is int i && riesgosPorId.TryGetValue(i, out var r) ? $"{r.Codigo} ({r.Version})" + (r.Eliminado ? " · en Papelera" : "") : "";

    private string RiesgosTexto(int planId) =>
        riesgosDePlan.TryGetValue(planId, out var l) ? string.Join("\n", l.Select(r => NombreRiesgo(r)).Where(x => x.Length > 0)) : "";

    private IEnumerable<PlanAccion> Mostrados => Ordenar(planes.Where(p =>
        (cargaFiltro is null || p.CargaPlanesAccionId == cargaFiltro) &&
        (filtroEstado == "" || ((int)EstadoDe(p.Id)).ToString() == filtroEstado) &&
        (filtroProceso == "" || SelectorMultiple.Leer(p.Proceso).Contains(filtroProceso, StringComparer.OrdinalIgnoreCase)) &&
        (filtroOrigen == "" || string.Equals(p.OrigenHallazgo, filtroOrigen, StringComparison.OrdinalIgnoreCase)) &&
        (filtroTipo == "" || string.Equals(p.TipoHallazgo, filtroTipo, StringComparison.OrdinalIgnoreCase)) &&
        (filtro.Length == 0 ||
         (p.Codigo + " " + p.DescripcionHallazgo + " " + p.OrigenHallazgo + " " + p.TipoHallazgo + " " + p.Proceso + " " + p.AnalisisCausa + " " + string.Join(" ", LugaresDe(p.Id)) + " " + RiesgosTexto(p.Id))
            .Contains(filtro, StringComparison.OrdinalIgnoreCase)
         || (motor is not null && motor.TextoBusqueda(p.Id).Contains(filtro, StringComparison.OrdinalIgnoreCase)))));

    private static int? Int(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var n) && n > 0 ? n : null;

    // ---------- Formulario ----------
    private async Task GuardarAsync()
    {
        if (form is null) return;
        guardando = true;
        await _dbLock.WaitAsync();
        try
        {
            var nuevo = form.Plan.Id == 0;
            var id = await Servicio.GuardarAsync(form);
            mensaje = "Plan guardado."; error = false;
            if (nuevo)
                // Queda abierto con su dirección propia (conserva el riesgo de origen para Atrás).
                Nav.NavigateTo($"planes-accion/{id}" + (RiesgoQ is int r ? $"?riesgo={r}" : ""), replace: true);
            else
            {
                Cargar();
                AbrirExistente(id);
            }
        }
        catch (InvalidOperationException ex) { Db.ChangeTracker.Clear(); mensaje = ex.Message; error = true; }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo guardar el plan: inténtalo de nuevo. (" + ex.Message + ")"; error = true;
        }
        finally { guardando = false; _dbLock.Release(); }
    }

