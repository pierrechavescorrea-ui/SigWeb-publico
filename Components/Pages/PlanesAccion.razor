    // Tablero: una columna por estado del plan (como un tablero Kanban), tarjetas con avance y próxima acción.
    private RenderFragment VistaTablero() => __builder =>
    {
        var lista = Mostrados.ToList();
        <div class="pv-tablero">
            @foreach (var e in new[] { EstadoAccionPlan.Abierta, EstadoAccionPlan.EnEjecucion, EstadoAccionPlan.Cerrada })
            {
                var col = lista.Where(p => EstadoDe(p.Id) == e).ToList();
