@page "/ensayos/{TipoEnsayoId:int}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.Ensayos
@using SigWeb.Models
@using SigWeb.Data.Tablas
@inject AppDbContext Db
@inject SigWeb.Data.Impacto.AnalizadorImpacto Analizador
@inject IJSRuntime JS

@if (tipo is null)
{
    <p class="text-muted">Tipo de ensayo no encontrado. <a href="ensayos">Volver a Ensayos</a></p>
}
else
{
    <div class="no-imprimir @(PantallaCompleta ? "ens-pantalla" : "")">
    <EncabezadoPagina Titulo="@tipo.Nombre" IconoUrl="@rutaIconoTipo" Atras="ensayos" OnAtras="AtrasDatos"
                      Subtitulo="@($"{resultados.Count} resultado{(resultados.Count == 1 ? "" : "s")}")">
        <Acciones>
            <button class="pg-btn @(vistaExcel ? "activo" : "")" title="Vista de hoja de cálculo" @onclick='() => CambiarVista(vistaExcel ? "tabla" : "excel")'>📊</button>
            <button class="pg-btn @(mostrarGrafico ? "activo" : "")" title="Gráficos" @onclick='() => CambiarVista("grafico")'>📈</button>
            @if (!mostrarGrafico && !vistaExcel)
            {
                <button class="pg-btn @(tablaCompleta ? "activo" : "")" title="@(tablaCompleta ? "Salir de pantalla completa" : "Pantalla completa")" @onclick="() => tablaCompleta = !tablaCompleta"><Ico Nombre="pantalla-completa" /></button>
            }
            <span class="pg-sep"></span>
            <BotonCampos Activo="verCampos" Deshabilitado="motor is null" OnClick="() => verCampos = true" />
            <button class="pg-btn" title="Importar desde Excel" @onclick="() => mostrarImportar = true"><Ico Nombre="importar" /></button>
            <BotonExportar Titulo="@tipo.Nombre" OnExportar="Exportar" />
            <span class="pg-sep"></span>
            <button class="pg-btn pg-btn-peligro" title="Eliminar una carga" @onclick="AbrirEliminarLote" disabled="@(resultados.Count == 0)"><Ico Nombre="eliminar" /></button>
            @if (!mostrarGrafico)
            {
                <button class="pg-btn" title="Editar muestra (fila seleccionada)" @onclick="EditarMuestraActiva"><Ico Nombre="editar" /></button>
            }
            <button class="pg-btn pg-btn-primario" title="Agregar resultado" @onclick="() => AbrirAgregar(null)"><Ico Nombre="agregar" /></button>
        </Acciones>
    </EncabezadoPagina>

    @if (verCampos && motor is not null)
    {
        <PanelCampos Motor="motor" OnCerrar="() => verCampos = false" OnCambio="StateHasChanged">
            <Acciones>
                <button type="button" class="pg-btn" title="Campos de la plantilla del ensayo (tipo, unidad, fórmula, adjunto, importación)" @onclick="() => { verCampos = false; mostrarConfigCampos = true; }"><Ico Nombre="listado" /></button>
            </Acciones>
        </PanelCampos>
    }

    @if (!mostrarGrafico)
    {
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
        <input class="form-control form-control-sm" style="max-width:320px;"
               placeholder="@(tipo.UsaTorre ? "Buscar por torre..." : "Buscar por localización...")" @bind="filtro" @bind:event="oninput" />
        <div class="d-flex align-items-center gap-2">
            @if (!vistaExcel)
            {
                @* La Vista Excel (Univer) trae su propio control de zoom abajo a la
                   derecha de la hoja — este slider de la app solo aplica a la Vista
                   tabla (HTML simple), que no tiene uno propio. *@
                <span class="small text-muted">🔍 Alejar</span>
                <input type="range" min="40" max="100" step="5" class="form-range" style="width:140px;" value="@escalaTabla"
                       @oninput="@(e => escalaTabla = int.TryParse(e.Value?.ToString(), out var n) ? n : escalaTabla)" />
                <span class="small text-muted" style="width:38px;">@(escalaTabla)%</span>
                @if (escalaTabla != 100)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Restablecer zoom" @onclick="@(() => escalaTabla = 100)">↺</button>
                }
            }
        </div>
    </div>
    }

    @if (mostrarGrafico)
    {
        <GraficoEnsayos Titulo="@tipo.Nombre" Columnas="ColumnasExcel()" Filas="FilasExcel(resultados)" Tipos="TiposCampoGrafico()" />
    }
    else if (vistaExcel)
    {
        <div class="hoja-wrap">
        @if (!string.IsNullOrEmpty(mensajeFilaActiva))
        {
            <div class="text-muted small mb-1">@mensajeFilaActiva</div>
        }
        <div id="hoja-ensayos" style="height:74vh;"></div>
        @if (mostrarAgregar)
        {
            <DialogoAgregarResultadoEnsayo TipoEnsayoId="TipoEnsayoId" ResultadoEnsayoId="resultadoEditandoId"
                                        OnCerrar="@(() => mostrarAgregar = false)" OnGuardado="CargarTodo" />
        }
        </div>
    }
    else
    {
    @if (!string.IsNullOrEmpty(mensajeFilaActiva))
    {
        <div class="text-muted small mb-1">@mensajeFilaActiva</div>
    }
    <div class="table-responsive ens-tabla-marco" style="max-height:74vh; overflow-y:auto; zoom:@(escalaTabla)%;">
        <table id="tabla-ensayos" class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0">
            <thead>
                <tr>
                    @foreach (var c in Columnas)
                    {
                        <th class="@(c.Clave == "DisenoMezcla" ? "" : "th-ordenable") @ClaseCelda(c.Clave)" data-col="@c.Clave" @onclick="() => OrdenarPor(c.Clave)">
                            @c.Nombre@(Flecha(c.Clave))
                            <button type="button" class="btn-fijar-col @(columnasFijas.Contains(c.Clave) ? "activo" : "")"
                                    title="@(columnasFijas.Contains(c.Clave) ? "Soltar columna" : "Fijar columna")"
                                    @onclick="() => TogglePin(c.Clave)" @onclick:stopPropagation="true">📌</button>
                        </th>
                    }
                    <th style="width:130px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (r, gris) in FilasMostradas)
                {
                    <tr class="@(gris ? "fila-gris" : "") @(filaSeleccionadaId == r.Id ? "table-active" : "")" @onclick="() => { filaSeleccionadaId = r.Id; mensajeFilaActiva = string.Empty; }">
                        @foreach (var c in Columnas)
                        {
                            var nat = c.Origen == OrigenCampoTabla.Nativo && Motor.Estilo(r.Id, c) is null;
                            if (nat && c.Clave == "Torre")
                            {
                                <td class="@ClaseCelda("Torre")" data-col="Torre" style="@FondoCelda("Torre", gris)">@(string.IsNullOrEmpty(TorreOLocalizacion(r)) ? "—" : TorreOLocalizacion(r))</td>
                            }
                            else if (nat && c.Clave == "Elemento")
                            {
                                <td class="@ClaseCelda("Elemento")" data-col="Elemento" style="@FondoCelda("Elemento", gris)">
                            @r.ElementoTexto
                            @if (r.SubElemento != SubElementoResultado.Ninguno)
                            {
                                <span class="text-muted small">(@EtiquetaSubElemento(r.SubElemento))</span>
                            }
                        </td>
                            }
                            else if (nat && c.Clave == "Informe")
                            {
                                <td class="@ClaseCelda("Informe")" data-col="Informe" style="@FondoCelda("Informe", gris)">
                            @if (r.InformeId is int idInformeFila)
                            {
                                var numeroInforme = informeNumeroPorResultado.TryGetValue(r.Id, out var inf) ? inf : "—";
                                if (archivosPorInforme.TryGetValue(idInformeFila, out var cant) && cant > 0)
                                {
                                    <BotonArchivos Archivos="ArchivosVistaInforme(idInformeFila)" Texto="@numeroInforme" Titulo="@($"Informe {numeroInforme}")" />
                                    <button class="ens-mini" title="Gestionar documentos del informe" @onclick="() => AbrirArchivosInforme(idInformeFila)"><Ico Nombre="adjuntar" /></button>
                                }
                                else
                                {
                                    <button class="btn btn-link p-0 border-0 text-decoration-none align-baseline text-secondary" title="Subir documentos del informe"
                                            @onclick="() => AbrirArchivosInforme(idInformeFila)">@numeroInforme</button>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                            }
                            else if (nat && c.Clave == "DisenoMezcla")
                            {
                                <td class="@ClaseCelda("DisenoMezcla")" data-col="DisenoMezcla" style="@FondoCelda("DisenoMezcla", gris)">
                                @if (!string.IsNullOrWhiteSpace(r.DisenoMezclaArchivo))
                                {
                                    var nomDm = string.IsNullOrWhiteSpace(r.DisenoMezclaCodigo) ? "Diseño de mezcla" : r.DisenoMezclaCodigo;
                                    <BotonArchivos Archivos="@(new[] { new BotonArchivos.Archivo(nomDm, r.DisenoMezclaArchivo) })" Texto="@nomDm" Titulo="Diseño de mezcla" />
                                }
                                else
                                {
                                    @(r.DisenoMezclaCodigo ?? "—")
                                }
                            </td>
                            }
                            else if (nat && c.Clave == "FechaEjecucion")
                            {
                                <td class="@ClaseCelda("FechaEjecucion")" data-col="FechaEjecucion" style="@FondoCelda("FechaEjecucion", gris)">
                                @(r.FechaEjecucion?.ToString("dd/MM/yyyy") ?? "—")
                            </td>
                            }
                            else if (nat && CampoViejo(c.Clave) is not null)
                            {
                                <td class="@ClaseCelda(c.Clave)" data-col="@c.Clave" style="@FondoCelda(c.Clave, gris)">
                                @if (CampoViejo(c.Clave)?.LlevaAdjunto == true && RutaAdjunto(r.Id, c.Clave) is string rutaAdj)
                                {
                                    var valAdj = ObtenerValor(r.Id, c.Clave);
                                    <BotonArchivos Archivos="@(new[] { new BotonArchivos.Archivo(string.IsNullOrWhiteSpace(valAdj) ? c.Nombre : valAdj, rutaAdj) })" Texto="@valAdj" Titulo="@c.Nombre" />
                                }
                                else
                                {
                                    @ObtenerValor(r.Id, c.Clave)
                                }
                            </td>
                            }
                            else
                            {
                                <CeldaCampo Motor="Motor" Campo="c" Fila="r.Id" Clase="@ClaseCelda(c.Clave)" Col="@c.Clave" Estilo="@FondoCelda(c.Clave, gris)" OnCambio="StateHasChanged" />
                            }
                        }
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary py-0" title="Editar" @onclick="() => AbrirAgregar(r.Id)"><Ico Nombre="editar" /></button>
                            <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => PedirEliminarResultado(r.Id)"><Ico Nombre="eliminar" /></button>
                        </td>
                    </tr>
                }
                @if (!ResultadosMostrados.Any())
                {
                    <tr><td colspan="@(Columnas.Count() + 1)" class="text-muted small text-center py-3">
                        <em>Sin resultados. Carga un Excel o agrega uno manualmente.</em>
                    </td></tr>
                }
            </tbody>
        </table>
    </div>
    }

    @if (mostrarConfigCampos)
    {
        <DialogoConfigurarCamposEnsayo TipoEnsayoId="TipoEnsayoId" OnCerrar="@(() => { mostrarConfigCampos = false; CargarTodo(); })" />
    }
    @if (mostrarImportar)
    {
        <DialogoImportarEnsayo TipoEnsayoId="TipoEnsayoId" OnCerrar="@(() => mostrarImportar = false)" OnImportado="CargarTodo" />
    }
    @if (mostrarAgregar && !(vistaExcel && !mostrarGrafico))
    {
        <DialogoAgregarResultadoEnsayo TipoEnsayoId="TipoEnsayoId" ResultadoEnsayoId="resultadoEditandoId"
                                        OnCerrar="@(() => mostrarAgregar = false)" OnGuardado="CargarTodo" />
    }
    @if (informeIdParaArchivos is int idInformeAbierto)
    {
        <DialogoArchivosInforme InformeId="idInformeAbierto"
                                 OnCerrar="@(() => informeIdParaArchivos = null)" OnCambiado="CargarTodo" />
    }
    @if (mostrarEliminarLote)
    {
        <div class="modal-backdrop-custom">
            <div class="modal-box-custom" style="max-width: 560px;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Eliminar una carga completa</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarEliminarLote"></button>
                </div>

                @if (loteConfirmando is null)
                {
                    <div class="modal-area-flexible">
                        @foreach (var lote in lotesDisponibles)
                        {
                            <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2">
                                <div class="small">
                                    <div>@lote.Origen</div>
                                    <div class="text-muted">@lote.Cantidad resultado@(lote.Cantidad == 1 ? "" : "s")</div>
                                </div>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirEliminarLote(lote.Origen)">Eliminar</button>
                            </div>
                        }
                        @if (lotesDisponibles.Count == 0)
                        {
                            <p class="text-muted small">No hay cargas para eliminar.</p>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 small">
                        ¿Eliminar toda la carga <strong>"@loteConfirmando"</strong>
                        (@(lotesDisponibles.FirstOrDefault(l => l.Origen == loteConfirmando).Cantidad) resultado(s))?
                        Se irán a la Papelera.
                    </div>
                    <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-secondary btn-sm" @onclick="() => loteConfirmando = null" title="Cancelar"><Ico Nombre="cancelar" /></button>
                        <button class="btn btn-danger btn-sm" disabled="@BloqueadoPorImpacto" @onclick="EliminarLoteConfirmado">Sí, eliminar carga</button>
                    </div>
                }
            </div>
        </div>
    }
    </div>

    <div class="solo-imprimir">
        <h4>@tipo.Nombre — Resultados de ensayo</h4>
        <p>Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        <table class="table table-bordered table-sm" style="font-size:0.7rem">
            <thead>
                <tr>
                    @foreach (var col in columnasParaImprimir)
                    {
                        <th>@col["title"]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in datosParaImprimir)
                {
                    <tr>
                        @foreach (var col in columnasParaImprimir)
                        {
                            var campoClave = col["field"].ToString() ?? "";
                            <td>@(fila.TryGetValue(campoClave, out var v) ? v : "")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (idPendienteEliminar is not null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-box-custom" style="max-width: 560px;">
            <h5>¿Eliminar este resultado?</h5>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-secondary btn-sm" @onclick="() => idPendienteEliminar = null" title="Cancelar"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" disabled="@BloqueadoPorImpacto" @onclick="() => ConfirmarEliminar(idPendienteEliminar.Value)">Sí, eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int TipoEnsayoId { get; set; }

    private TipoEnsayo? tipo;
    private string rutaIconoTipo = "images/iconos/documento.svg";
    private List<CampoEnsayo> campos = new();
    private List<ResultadoEnsayo> resultados = new();
    private Dictionary<int, Dictionary<string, string>> valoresPorResultado = new();
    private Dictionary<int, Dictionary<string, string>> adjuntoPorResultado = new();
    private string? RutaAdjunto(int resultadoId, string clave) =>
        adjuntoPorResultado.TryGetValue(resultadoId, out var d) && d.TryGetValue(clave, out var r) ? r : null;
    private Dictionary<int, string> torreCodigoPorResultado = new();
    private Dictionary<int, string> informeNumeroPorResultado = new();

    // Texto a mostrar en la columna "Torre"/"Localización": si el resultado
    // ya tiene una Torre resuelta (ElementoTrazadoId — ver CargarTodo), se
    // muestra siempre, sin importar si el Tipo de Ensayo usa Torre o
    // Localización en este momento. Esto evita "perder" referencias de
    // torre ya guardadas en resultados antiguos si alguien cambia la
    // casilla "Se asocia a Torres del trazado" del Tipo de Ensayo después
    // de que esos resultados ya se cargaron con Torre (ver Ensayos.razor).
    // Si no hay Torre resuelta, se cae a la Localización (si el tipo no usa
    // Torre) o a vacío.
    private string TorreOLocalizacion(ResultadoEnsayo r)
    {
        if (torreCodigoPorResultado.TryGetValue(r.Id, out var torreCod)) return torreCod;
        return tipo?.UsaTorre == false ? (r.Localizacion ?? "") : "";
    }
    private Dictionary<int, int> archivosPorInforme = new(); // InformeId -> cantidad de PDF adjuntos
    private Dictionary<int, IReadOnlyList<BotonArchivos.Archivo>> archivosListaPorInforme = new();
    private IReadOnlyList<BotonArchivos.Archivo> ArchivosVistaInforme(int informeId) =>
        archivosListaPorInforme.TryGetValue(informeId, out var l) ? l : Array.Empty<BotonArchivos.Archivo>();
    private int? informeIdParaArchivos;

    private bool mostrarConfigCampos = false;
    private bool mostrarImportar = false;
    private bool mostrarAgregar = false;
    private int? resultadoEditandoId;
    private int? idPendienteEliminar;

    private bool mostrarEliminarLote = false;
    private List<(string Origen, int Cantidad)> lotesDisponibles = new();
    private string? loteConfirmando;

    private string filtro = "";
    private string columnaOrden = "";
    private bool ordenAscendente = true;

    // Vista Excel (hoja real con Univer, ver wwwroot/js/hojaExcel.js) es la
    // vista por defecto y la única editable. La vieja Vista tabla (HTML
    // simple) ya no tiene botón propio — se deja el código y la ruta
    // "tabla" de CambiarVista sin usar, por si hiciera falta reactivarla,
    // pero no se llega a ella desde la interfaz. El Gráfico (ver abajo) NO
    // depende de esta vista: lee directamente de ColumnasExcel()/FilasExcel(),
    // así que ocultar la Vista tabla no le afecta en nada.
    private bool vistaExcel = false;

    // Panel de gráficos dinámicos ("📈 Gráfico") — tercera vista, excluyente
    // con las otras dos.
    private bool mostrarGrafico = false;

    // Zoom de la tabla (100% = normal). Deja ver más filas/columnas sin
    // necesidad de hacer scroll, encogiendo visualmente la tabla. Aplica
    // tanto a la Vista tabla como a la Vista Excel.
    private int escalaTabla = 100;

    // Columnas que el usuario eligió "inmovilizar" (fijar a la izquierda al
    // hacer scroll horizontal). "Torre" fija por defecto, como antes; el
    // usuario puede fijar o soltar cualquier otra desde el botón 📌 del
    // header. js/tablaFijar.js es quien calcula el offset real de cada una.
    private HashSet<string> columnasFijas = new() { "Torre" };

    private int? tipoIdAnterior;

    protected override async Task OnParametersSetAsync()
    {
        // Al pasar de un tipo de ensayo a otro se reutiliza este mismo componente: la hoja de Univer del tipo anterior
        // se destruye para que la nueva se cree limpia (si no, queda sin estilos).
        if (tipoIdAnterior is int previo && previo != TipoEnsayoId && vistaExcel)
        {
            try { await JS.InvokeVoidAsync("sigwebHojaExcelDestruir", "hoja-ensayos"); }
            catch (JSDisconnectedException) { }
            firmaDatosExcelAplicada = null;
        }
        tipoIdAnterior = TipoEnsayoId;
        CargarTodo();
    }

    private void CargarTodo()
    {
        tipo = Db.TiposEnsayo.AsNoTracking().FirstOrDefault(t => t.Id == TipoEnsayoId);
        if (tipo is null) return;

        var grupo = Db.GruposEnsayo.AsNoTracking().FirstOrDefault(g => g.Id == tipo.GrupoEnsayoId);
        var iconoId = tipo.IconoCatalogoId ?? grupo?.IconoCatalogoId;
        rutaIconoTipo = iconoId is null ? "images/iconos/documento.svg"
            : (Db.IconosCatalogo.AsNoTracking().FirstOrDefault(i => i.Id == iconoId)?.RutaArchivo ?? "images/iconos/documento.svg");

        campos = Db.CamposEnsayo.AsNoTracking()
            .Where(c => c.TipoEnsayoId == TipoEnsayoId && c.Activo)
            .OrderBy(c => c.Orden).ThenBy(c => c.Etiqueta)
            .ToList();

        resultados = Db.ResultadosEnsayo.AsNoTracking()
            .Where(r => r.TipoEnsayoId == TipoEnsayoId && !r.Eliminado)
            .OrderByDescending(r => r.Id)
            .ToList();

        resultadosPorId = resultados.ToDictionary(r => r.Id);
        motorPendiente = true;
        var idsResultado = resultados.Select(r => r.Id).ToList();

        var todosCampos = Db.CamposEnsayo.AsNoTracking()
            .Where(c => c.TipoEnsayoId == TipoEnsayoId)
            .ToDictionary(c => c.Id, c => c.Clave);

        valoresPorResultado = new();
        foreach (var v in Db.ValoresCampoEnsayo.AsNoTracking().Where(v => idsResultado.Contains(v.ResultadoEnsayoId)))
        {
            if (!todosCampos.TryGetValue(v.CampoEnsayoId, out var clave)) continue;
            if (!valoresPorResultado.TryGetValue(v.ResultadoEnsayoId, out var dict))
            {
                dict = new();
                valoresPorResultado[v.ResultadoEnsayoId] = dict;
            }
            dict[clave] = v.Valor;
        }

        adjuntoPorResultado = new();
        var conAdj = Db.ValoresCampoEnsayo.AsNoTracking()
            .Where(v => idsResultado.Contains(v.ResultadoEnsayoId) && v.AdjuntoEnsayoId != null).ToList();
        if (conAdj.Count > 0)
        {
            var rutas = Db.AdjuntosEnsayo.AsNoTracking().ToDictionary(a => a.Id, a => a.Ruta);
            foreach (var v in conAdj)
            {
                if (!todosCampos.TryGetValue(v.CampoEnsayoId, out var cl) || !rutas.TryGetValue(v.AdjuntoEnsayoId!.Value, out var ruta)) continue;
                if (!adjuntoPorResultado.TryGetValue(v.ResultadoEnsayoId, out var d2)) adjuntoPorResultado[v.ResultadoEnsayoId] = d2 = new();
                d2[cl] = ruta;
            }
        }

        var torreIds = resultados.Where(r => r.ElementoTrazadoId != null).Select(r => r.ElementoTrazadoId!.Value).Distinct().ToList();
        var torres = Db.ElementosTrazado.AsNoTracking().Where(t => torreIds.Contains(t.Id)).ToDictionary(t => t.Id, t => t.Codigo);
        torreCodigoPorResultado = resultados.Where(r => r.ElementoTrazadoId != null)
            .ToDictionary(r => r.Id, r => torres.TryGetValue(r.ElementoTrazadoId!.Value, out var c) ? c : "?");

        var informeIds = resultados.Where(r => r.InformeId != null).Select(r => r.InformeId!.Value).Distinct().ToList();
        var informes = Db.Informes.AsNoTracking().Where(i => informeIds.Contains(i.Id)).ToDictionary(i => i.Id, i => i.Numero);
        informeNumeroPorResultado = resultados.Where(r => r.InformeId != null)
            .ToDictionary(r => r.Id, r => informes.TryGetValue(r.InformeId!.Value, out var n) ? n : "?");

        archivosListaPorInforme = Db.ArchivosInforme.AsNoTracking().Where(a => informeIds.Contains(a.InformeId)).ToList()
            .GroupBy(a => a.InformeId)
            .ToDictionary(g => g.Key, g => (IReadOnlyList<BotonArchivos.Archivo>)g.OrderBy(a => a.NombreOriginal).Select(a => new BotonArchivos.Archivo(a.NombreOriginal, a.RutaArchivo)).ToList());
        archivosPorInforme = archivosListaPorInforme.ToDictionary(kv => kv.Key, kv => kv.Value.Count);
    }

