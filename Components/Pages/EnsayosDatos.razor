    }

    private async Task EliminarLoteConfirmado()
    {
        if (loteConfirmando is null) return;
        var origen = loteConfirmando;

        var afectados = await Db.ResultadosEnsayo
            .Where(r => r.TipoEnsayoId == TipoEnsayoId && r.Origen == origen && !r.Eliminado)
            .ToListAsync();

        var ahora = DateTime.UtcNow;
        foreach (var r in afectados)
        {
            r.Eliminado = true;
            r.FechaEliminacion = ahora;
        }
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        mostrarEliminarLote = false;
        loteConfirmando = null;
        CargarTodo();
    }

    // ---------- Búsqueda y orden ----------
    private IEnumerable<ResultadoEnsayo> ResultadosMostrados
    {
        get
        {
            var query = resultados.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(filtro))
            {
                query = query.Where(CoincideFiltro);
            }
            if (!string.IsNullOrEmpty(columnaOrden))
            {
                var propia = columnaOrden is "Torre" or "Elemento" or "Informe" or "FechaEjecucion" || CampoViejo(columnaOrden) is not null;
                if (!propia && motor is not null) query = motor.Ordenar(query, r => r.Id, columnaOrden, ordenAscendente);
                else query = ordenAscendente ? query.OrderBy(r => ValorOrden(r, columnaOrden)) : query.OrderByDescending(r => ValorOrden(r, columnaOrden));
            }
            return query;
        }
    }

    private bool CoincideFiltro(ResultadoEnsayo r) =>
        TorreOLocalizacion(r).Contains(filtro, StringComparison.OrdinalIgnoreCase)
        || (motor is not null && motor.TextoBusqueda(r.Id).Contains(filtro, StringComparison.OrdinalIgnoreCase));

    // ---------- Campos (columnas visibles, campos creados, fórmulas y formatos) ----------
    private MotorTabla? motor;
    private MotorTabla Motor => motor!;
    private bool verCampos, motorPendiente = true;
    private Dictionary<int, ResultadoEnsayo> resultadosPorId = new();

    private IEnumerable<CampoTabla> Columnas => motor?.Visibles ?? Enumerable.Empty<CampoTabla>();

    private CampoEnsayo? CampoViejo(string clave) => campos.FirstOrDefault(c => c.Clave == clave);

    private static TipoCampoTabla TipoDe(TipoDatoCampoEnsayo t) => t switch
    {
        TipoDatoCampoEnsayo.Numero => TipoCampoTabla.Numero,
        TipoDatoCampoEnsayo.Formula => TipoCampoTabla.Auto,   // una fórmula puede devolver número o texto ("OK", "No cumple"…)
        TipoDatoCampoEnsayo.Fecha => TipoCampoTabla.Fecha,
        _ => TipoCampoTabla.Texto
    };

    // Columnas propias del ensayo + los campos de su plantilla (CampoEnsayo), que siguen administrándose en su diálogo.
    private IEnumerable<ColumnaNativa> ColumnasNativas()
    {
        var l = new List<ColumnaNativa>
        {
            new("Torre", tipo?.UsaTorre == true ? "Torre" : "Localización", TipoCampoTabla.Texto, id => resultadosPorId.TryGetValue(id, out var r) ? TorreOLocalizacion(r) : null),
            new("Elemento", "Elemento", TipoCampoTabla.Texto, id => resultadosPorId.TryGetValue(id, out var r) ? r.ElementoTexto : null),
        };
        foreach (var c in campos)
        {
            var cc = c;
            var nombre = cc.Etiqueta + (string.IsNullOrEmpty(cc.Unidad) ? "" : $" ({cc.Unidad})");
            l.Add(new ColumnaNativa(cc.Clave, nombre, TipoDe(cc.TipoDato),
                id => MotorTabla.Tipar(new CampoTabla { Tipo = TipoDe(cc.TipoDato) }, ObtenerValor(id, cc.Clave)), true, "Excel"));
        }
        l.Add(new("Informe", "Informe", TipoCampoTabla.Texto, id => informeNumeroPorResultado.TryGetValue(id, out var i) ? i : null));
        if (tipo?.UsaTorre == true)
            l.Add(new("DisenoMezcla", "Diseño mezcla", TipoCampoTabla.Texto, id => resultadosPorId.TryGetValue(id, out var r) ? r.DisenoMezclaCodigo : null));
        else
            l.Add(new("FechaEjecucion", "Fecha ejecución", TipoCampoTabla.Fecha, id => resultadosPorId.TryGetValue(id, out var r) ? r.FechaEjecucion : null));
        return l;
    }

    private IEnumerable<(int Id, string Etiqueta)> FilasMotor() =>
        resultados.Select(r => (r.Id, $"{TorreOLocalizacion(r)} · {r.ElementoTexto} · #{r.Id}"));

    // ---------- Franjas de color por muestra ----------
    // Detecta genéricamente cuál es la clave del campo "No. Muestra" (u
    // otro campo cuya etiqueta contenga "muestra"), en vez de asumir una
    // clave fija — distintos Tipos de Ensayo pueden tener campos distintos.
    private string? ClaveCampoMuestra =>
        campos.FirstOrDefault(c => c.Etiqueta.Contains("muestra", StringComparison.OrdinalIgnoreCase))?.Clave;

    // Materializa las filas a mostrar junto con si les toca franja gris,
    // alternando cada vez que cambia el valor de la muestra (no fila por
    // fila) — así todas las filas de la muestra 177 quedan del mismo color.
    private List<(ResultadoEnsayo Resultado, bool Gris)> FilasMostradas
    {
        get
        {
            var lista = new List<(ResultadoEnsayo, bool)>();
            var claveMuestra = ClaveCampoMuestra;
            string? valorAnterior = null;
            var gris = false;
            var primero = true;

            foreach (var r in ResultadosMostrados)
            {
                var valorActual = claveMuestra is not null ? ObtenerValor(r.Id, claveMuestra) : "";
                if (primero)
                {
                    primero = false;
                }
                else if (!string.Equals(valorActual, valorAnterior, StringComparison.OrdinalIgnoreCase))
                {
                    gris = !gris;
                }
                valorAnterior = valorActual;
                lista.Add((r, gris));
            }
            return lista;
        }
    }

    // ---------- Columnas fijas (inmovilizar/movilizar) ----------
    private void TogglePin(string clave)
    {
        if (!columnasFijas.Remove(clave))
            columnasFijas.Add(clave);
    }

    private string ClaseCelda(string clave) => columnasFijas.Contains(clave) ? "col-fija" : "";

    // Las celdas fijas ("sticky") necesitan fondo opaco explícito — si no,
    // se ven transparentes al pasar otras celdas por debajo durante el
    // scroll horizontal. Las celdas normales no lo necesitan: su color lo
    // da la clase "fila-gris" de la fila.
    private string? FondoCelda(string clave, bool gris) =>
        columnasFijas.Contains(clave) ? $"background:{(gris ? "#f1f3f5" : "#ffffff")}" : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // CargarTodo() es síncrono y se llama en muchos lugares: el motor de Campos se (re)arma después de dibujar.
        if (motorPendiente && tipo is not null)
        {
            motorPendiente = false;
            try { motor = await MotorTabla.CargarAsync(Db, $"ensayos:{TipoEnsayoId}", ColumnasNativas(), FilasMotor()); StateHasChanged(); }
            catch (Exception) { motor = null; }
        }
        try
        {
            if (vistaExcel)
            {
                // Solo se reenvían todas las filas a la hoja (Univer) cuando
                // los datos realmente cambiaron (filtro, orden, importación,
                // etc.) — la hoja ya actualiza sus datos en el lugar sin
                // perder el scroll ni las fórmulas sueltas que el usuario
                // haya escrito en el área de trabajo (ver hojaExcel.js).
                var firmaActual = $"{resultados.Count}|{filtro}|{campos.Count}|{columnaOrden}|{ordenAscendente}";
                if (firmaActual != firmaDatosExcelAplicada)
                {
                    dotNetRef ??= DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("sigwebHojaExcel", "hoja-ensayos", ColumnasExcel(), FilasParaMostrar(FilasExcel()), dotNetRef);
                    firmaDatosExcelAplicada = firmaActual;
                }
            }
            else if (!mostrarGrafico)
            {
                await JS.InvokeVoidAsync("sigwebFijarColumnas", "tabla-ensayos", columnasFijas.ToArray());
            }
        }
        catch (JSDisconnectedException)
        {
            // El circuito se cerró (navegación, recarga, etc.) — nada que hacer.
        }
    }

    // ---------- Vista Excel (Univer — wwwroot/js/hojaExcel.js) ----------
    private string? firmaDatosExcelAplicada;
    private DotNetObjectReference<EnsayosDatos>? dotNetRef;

    // ---------- Cambiar entre Vista tabla / Vista Excel / Gráfico ----------
    // Las tres son excluyentes: salir de la Vista Excel destruye la hoja de
    // Univer (si no, queda una instancia "fantasma" en el DOM).
    private async Task CambiarVista(string modo)
    {
        if (modo == "grafico")
        {
            if (vistaExcel)
            {
                try { await JS.InvokeVoidAsync("sigwebHojaExcelDestruir", "hoja-ensayos"); }
                catch (JSDisconnectedException) { }
                vistaExcel = false;
            }
            mostrarGrafico = true;
        }
        else if (modo == "excel")
        {
            mostrarGrafico = false;
            if (!vistaExcel)
            {
                // Al volver a entrar a la Vista Excel hay que forzar que se
                // vuelva a crear la hoja (la instancia anterior en JS ya se
                // destruyó al salir), sin eso se quedaría "pegada" vacía.
                firmaDatosExcelAplicada = null;
                vistaExcel = true;
            }
        }
        else // "tabla"
        {
            mostrarGrafico = false;
            if (vistaExcel)
            {
                try { await JS.InvokeVoidAsync("sigwebHojaExcelDestruir", "hoja-ensayos"); }
                catch (JSDisconnectedException) { }
                vistaExcel = false;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (vistaExcel)
        {
            try { await JS.InvokeVoidAsync("sigwebHojaExcelDestruir", "hoja-ensayos"); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
        dotNetRef?.Dispose();
    }

    // ---------- Exportar (Excel/PDF, igual que en Materiales) ----------
    private bool mostrarMenuExportar = false;
    private List<Dictionary<string, object>> columnasParaImprimir = new();
    private List<Dictionary<string, object>> datosParaImprimir = new();

    private async Task Exportar(string formato)
    {
        mostrarMenuExportar = false;
        var columnas = ColumnasExcel();
        var filas = FilasParaMostrar(FilasExcel());

        if (formato == "excel")
        {
            await DescargarExcelEnsayos(columnas, filas);
        }
        else
        {
            columnasParaImprimir = columnas;
            datosParaImprimir = filas;
            StateHasChanged();
            await Task.Delay(200);
            await JS.InvokeVoidAsync("window.print");
        }
    }

    private async Task DescargarExcelEnsayos(List<Dictionary<string, object>> columnas, List<Dictionary<string, object>> filas)
    {
        using var wb = new ClosedXML.Excel.XLWorkbook();
        var ws = wb.Worksheets.Add(tipo?.Nombre ?? "Ensayos");

        for (var c = 0; c < columnas.Count; c++)
        {
            ws.Cell(1, c + 1).Value = columnas[c]["title"].ToString();
        }
        ws.Row(1).Style.Font.Bold = true;

        for (var f = 0; f < filas.Count; f++)
        {
            for (var c = 0; c < columnas.Count; c++)
            {
                var clave = columnas[c]["field"].ToString() ?? "";
                ws.Cell(f + 2, c + 1).Value = filas[f].TryGetValue(clave, out var v) ? v?.ToString() ?? "" : "";
            }
        }
        ws.Columns().AdjustToContents();

        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        var nombreArchivo = $"ensayos-{(tipo?.Nombre ?? "datos")}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
        await JS.InvokeVoidAsync("descargarArchivo", nombreArchivo,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
    }

    private List<Dictionary<string, object>> ColumnasExcel()
    {
        // Torre, Elemento e Informe no son editables aquí: cambiarlos implica
        // resolver la torre/pata o crear un Informe, lo mismo que hace el
        // diálogo "Agregar/Editar" — se dejan solo para ese diálogo.
        var cols = new List<Dictionary<string, object>>
        {
            new() { ["title"] = tipo?.UsaTorre == false ? "Localización" : "Torre", ["field"] = "Torre", ["headerFilter"] = "input", ["frozen"] = true },
        };
        if (tipo?.MostrarElemento != false)
        {
            cols.Add(new() { ["title"] = "Elemento", ["field"] = "Elemento", ["headerFilter"] = "input" });
        }
        foreach (var campo in campos)
        {
            var col = new Dictionary<string, object>
            {
                ["title"] = campo.Etiqueta + (string.IsNullOrEmpty(campo.Unidad) ? "" : $" ({campo.Unidad})"),
                ["field"] = campo.Clave,
                ["headerFilter"] = "input"
            };
            // Los campos de tipo Fórmula (Área, Cumplimiento, Seguimiento...)
            // se calculan solos; no tiene sentido editarlos a mano. Los demás
            // siguen lo que el usuario eligió en ⚙ Campos (por defecto,
            // editables) — ver CampoEnsayo.EditableEnVistaExcel.
            if (campo.TipoDato != TipoDatoCampoEnsayo.Formula && campo.EditableEnVistaExcel)
            {
                col["editor"] = "input";
            }
            cols.Add(col);
        }
        if (tipo?.MostrarInforme != false)
        {
            cols.Add(new() { ["title"] = "Informe", ["field"] = "Informe", ["headerFilter"] = "input" });
        }
        if (tipo?.UsaTorre == false)
        {
            if (tipo?.MostrarFechaEjecucion != false)
            {
                cols.Add(new() { ["title"] = "Fecha ejecución", ["field"] = "FechaEjecucion", ["headerFilter"] = "input", ["editor"] = "input" });
            }
        }
        else if (tipo?.MostrarDisenoMezcla != false)
        {
            cols.Add(new() { ["title"] = "Diseño mezcla", ["field"] = "DisenoMezcla", ["headerFilter"] = "input", ["editor"] = "input" });
        }
        return cols;
    }

    private List<Dictionary<string, object>> FilasExcel(IEnumerable<ResultadoEnsayo>? origen = null)
    {
        var filas = new List<Dictionary<string, object>>();
        foreach (var r in origen ?? ResultadosMostrados)
        {
            var fila = new Dictionary<string, object>
            {
                ["__Id"] = r.Id,
                ["Torre"] = TorreOLocalizacion(r),
                ["Elemento"] = r.ElementoTexto + (r.SubElemento != SubElementoResultado.Ninguno ? $" ({EtiquetaSubElemento(r.SubElemento)})" : ""),
                ["Informe"] = r.InformeId is not null && informeNumeroPorResultado.TryGetValue(r.Id, out var inf) ? inf : "",
            };
            if (tipo?.UsaTorre == false)
            {
                fila["FechaEjecucion"] = r.FechaEjecucion?.ToString("yyyy-MM-dd") ?? "";
            }
            else
            {
                fila["DisenoMezcla"] = r.DisenoMezclaCodigo ?? "";
            }
            foreach (var campo in campos)
            {
                fila[campo.Clave] = ObtenerValor(r.Id, campo.Clave);
            }
            filas.Add(fila);
        }
        return filas;
    }

    // Vista Excel y exportación muestran las fechas día/mes/año; FilasExcel() queda con yyyy-MM-dd
    // porque el gráfico dinámico filtra y ordena con ese texto.
    private List<Dictionary<string, object>> FilasParaMostrar(List<Dictionary<string, object>> filas)
    {
        var fechas = TiposCampoGrafico().Where(kv => kv.Value == TipoDatoCampoEnsayo.Fecha).Select(kv => kv.Key).ToList();
        if (fechas.Count == 0) return filas;
        return filas.Select(f =>
        {
            var c = new Dictionary<string, object>(f);
            foreach (var k in fechas)
                if (c.TryGetValue(k, out var v) && v is string s && DateTime.TryParseExact(s, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d))
                    c[k] = d.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
            return c;
        }).ToList();
    }

    // ---------- Gráfico dinámico ----------
    // Mismo "mapa de campos" que ColumnasExcel/FilasExcel (Torre, Elemento,
    // Informe, Diseño mezcla + cada campo de la plantilla), para que el
    // panel sepa cuáles tratar como fecha (filtro por rango), cuáles como
    // número (disponibles para graficar en el eje Y) y el resto como texto
    // (filtro por "slicers" de botones).
    private Dictionary<string, TipoDatoCampoEnsayo?> TiposCampoGrafico()
    {
        var tipos = new Dictionary<string, TipoDatoCampoEnsayo?>
        {
            ["Torre"] = null,
            ["Elemento"] = null,
            ["Informe"] = null,
        };
        if (tipo?.UsaTorre == false) tipos["FechaEjecucion"] = TipoDatoCampoEnsayo.Fecha;
        else tipos["DisenoMezcla"] = null;
        foreach (var campo in campos) tipos[campo.Clave] = campo.TipoDato;
        return tipos;
    }

    // Se llama desde la Vista Excel (js/hojaExcel.js, motor Univer) cuando el usuario edita una
    // celda directamente en la Vista Excel. Guarda el valor y, si hay
    // fórmulas (Área, Cumplimiento, Seguimiento...), las recalcula y las
    // devuelve para actualizar esa fila en la grilla sin recargar todo.
    [JSInvokable]
    public async Task<Dictionary<string, string>> CeldaEditada(int resultadoId, string clave, string valor)
    {
        var actualizacion = new Dictionary<string, string>();
        try
        {
            if (clave == "DisenoMezcla")
            {
                var r = await Db.ResultadosEnsayo.FirstOrDefaultAsync(x => x.Id == resultadoId);
                if (r is not null)
                {
                    r.DisenoMezclaCodigo = string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();
                    await Db.SaveChangesAsync();
                }
                Db.ChangeTracker.Clear();
                return actualizacion;
            }

            if (clave == "FechaEjecucion")
            {
                var r = await Db.ResultadosEnsayo.FirstOrDefaultAsync(x => x.Id == resultadoId);
                if (r is not null)
                {
                    r.FechaEjecucion = SigWeb.Data.Documentos.FechaTexto.Parsear(valor);
                    await Db.SaveChangesAsync();
                }
                Db.ChangeTracker.Clear();
                return actualizacion;
            }

            var campo = campos.FirstOrDefault(c => c.Clave == clave);
            if (campo is null || campo.TipoDato == TipoDatoCampoEnsayo.Formula || !campo.EditableEnVistaExcel) return actualizacion;
            // Fechas: se escriben día/mes/año y se guardan como siempre (yyyy-MM-dd).
            if (campo.TipoDato == TipoDatoCampoEnsayo.Fecha && SigWeb.Data.Documentos.FechaTexto.Parsear(valor) is DateTime fv)
                valor = fv.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

            var existente = await Db.ValoresCampoEnsayo.FirstOrDefaultAsync(v => v.ResultadoEnsayoId == resultadoId && v.CampoEnsayoId == campo.Id);
            if (string.IsNullOrWhiteSpace(valor))
            {
                if (existente is not null) Db.ValoresCampoEnsayo.Remove(existente);
            }
            else if (existente is not null)
            {
                existente.Valor = valor;
            }
            else
            {
                Db.ValoresCampoEnsayo.Add(new ValorCampoEnsayo { ResultadoEnsayoId = resultadoId, CampoEnsayoId = campo.Id, Valor = valor });
            }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();

            // Recalcula las fórmulas de este resultado con los valores que
            // tiene ahora guardados, para devolverlas y refrescar esa fila.
            var camposPorId = campos.ToDictionary(c => c.Id, c => c.Clave);
            var valoresActuales = new Dictionary<string, string>();
            foreach (var v in await Db.ValoresCampoEnsayo.AsNoTracking().Where(v => v.ResultadoEnsayoId == resultadoId).ToListAsync())
            {
                if (camposPorId.TryGetValue(v.CampoEnsayoId, out var cl)) valoresActuales[cl] = v.Valor;
            }

            foreach (var f in campos.Where(c => c.TipoDato == TipoDatoCampoEnsayo.Formula && !string.IsNullOrWhiteSpace(c.Formula)))
            {
                string calculado;
                try { calculado = EvaluadorFormulas.Evaluar(f.Formula!, valoresActuales!); }
                catch { calculado = ""; }
                valoresActuales[f.Clave] = calculado;
                actualizacion[f.Clave] = calculado;
            }

            CargarTodo(); // mantiene al día el estado en memoria del resto de la página
        }
        catch (JSDisconnectedException)
        {
            // El circuito se cerró — nada que hacer.
        }
        return actualizacion;
    }

    private string ValorOrden(ResultadoEnsayo r, string columna)
    {
        if (columna == "Torre") return Relleno(TorreOLocalizacion(r));
        if (columna == "Elemento") return r.ElementoTexto;
        if (columna == "Informe") return Relleno(informeNumeroPorResultado.TryGetValue(r.Id, out var i) ? i : "");
        if (columna == "FechaEjecucion") return Relleno(r.FechaEjecucion?.ToString("yyyy-MM-dd") ?? "");
        if (valoresPorResultado.TryGetValue(r.Id, out var vals) && vals.TryGetValue(columna, out var v)) return Relleno(v);
        return "";
    }

    // Si el texto es un número, lo rellena con ceros a la izquierda para
    // que la comparación alfabética también ordene bien los números
    // (sin esto, "10" quedaría antes que "2").
    private static string Relleno(string texto)
    {
        if (double.TryParse(texto, NumberStyles.Any, CultureInfo.InvariantCulture, out var numero))
            return (numero < 0 ? "-" : "") + Math.Abs(numero).ToString("000000000000.000000");
        return texto;
    }

    private void OrdenarPor(string columna)
    {
        if (columnaOrden == columna) ordenAscendente = !ordenAscendente;
        else { columnaOrden = columna; ordenAscendente = true; }
    }

    private string Flecha(string columna) => columnaOrden != columna ? "" : (ordenAscendente ? " ▲" : " ▼");

    // Desde la vista Excel o los gráficos, «volver» regresa a la tabla; desde la tabla, a Ensayos.
    private EventCallback AtrasDatos => PantallaCompleta ? EventCallback.Factory.Create(this, () => tablaCompleta = false)
        : (vistaExcel || mostrarGrafico) ? EventCallback.Factory.Create(this, () => CambiarVista("tabla")) : default;

    // Pantalla completa de la vista de lista (no aplica a la hoja de cálculo ni a los gráficos).
    private bool tablaCompleta;
    private bool PantallaCompleta => tablaCompleta && !vistaExcel && !mostrarGrafico;
}
