            return;
        }
        AbrirAgregar(id);
    }

    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;
    private bool BloqueadoPorImpacto => impacto is null || (impacto.RequiereEntender && !impactoOk);

    private async Task CalcularImpacto(Func<Task<SigWeb.Data.Impacto.InformeImpacto>> f)
    {
        impacto = null; impactoOk = false;
        try { impacto = await f(); } catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private void PedirEliminarResultado(int id)
    {
        idPendienteEliminar = id;
        _ = CalcularImpacto(() => Analizador.ResultadoEnsayo(id));
    }

    private async Task ConfirmarEliminar(int id)
    {
        var item = await Db.ResultadosEnsayo.FindAsync(id);
        if (item is not null)
        {
            item.Eliminado = true;
            item.FechaEliminacion = DateTime.UtcNow;
