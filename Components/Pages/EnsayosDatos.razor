    // edita escribiendo directo en la celda (ver hojaExcel.js), así que se
    // lee cuál fila tiene la celda activa en la hoja (Univer) y se abre el
    // mismo diálogo Agregar/Editar de siempre, con los datos de esa
    // muestra ya cargados (Torre, Elemento, Informe y todos los campos).
    private string mensajeFilaActiva = "";

    // En la vista de lista, la fila seleccionada es la última en la que se hizo clic.
    private int? filaSeleccionadaId;

    private async Task EditarMuestraActiva()
    {
        mensajeFilaActiva = "";
        int? id = null;
        if (!vistaExcel)
        {
            if (filaSeleccionadaId is int sel && resultados.Any(x => x.Id == sel)) { AbrirAgregar(sel); return; }
            mensajeFilaActiva = "Haz clic primero en la fila que quieres editar.";
            return;
        }
        try
        {
            id = await JS.InvokeAsync<int?>("sigwebHojaExcelFilaActiva", "hoja-ensayos");
        }
        catch (JSDisconnectedException) { return; }
        if (id is null)
        {
