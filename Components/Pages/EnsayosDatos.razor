    // ---------- Eliminar una carga completa (todos los resultados con el
    // mismo "Origen", ej. una importación de Excel que salió mal) ----------
    private void PedirEliminarLote(string origen)
    {
        loteConfirmando = origen;
        _ = CalcularImpacto(() => Analizador.LoteEnsayos(TipoEnsayoId, origen));
    }

    private void AbrirEliminarLote()
    {
        lotesDisponibles = resultados
            .GroupBy(r => r.Origen)
            .Select(g => (Origen: g.Key, Cantidad: g.Count()))
            .OrderByDescending(l => l.Cantidad)
            .ToList();
        loteConfirmando = null;
        mostrarEliminarLote = true;
    }

    private void CerrarEliminarLote()
    {
