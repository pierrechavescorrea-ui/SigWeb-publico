@code {
    // ---------- Estado general ----------
    private string vista = "matriz";
    private string mensaje = "";
    private bool error;

    // El DbContext inyectado (Db) vive mientras dure el circuito de Blazor y
    // se comparte entre todas las operaciones de esta página, incluida la
    // que calcula el impacto en segundo plano al pedir una eliminación
    // (CalcularImpacto, lanzada sin "await" para no congelar el diálogo).
    // EF Core no admite dos operaciones a la vez sobre el mismo DbContext:
    // si esa tarea en segundo plano todavía está consultando cuando se
    // guarda un riesgo, sale "A second operation was started on this
    // context instance...". Este semáforo serializa todo el acceso a Db
    // en la página para que eso no pueda pasar. Los métodos internos que
    // ya se llaman siempre desde dentro de un bloque con el semáforo
    // tomado (CargarAsync, CargarMotorAsync, CargarDetalle,
    // EncadenarRiesgosAsync) NO lo vuelven a tomar, para no bloquearse
    // a sí mismos.
    private readonly SemaphoreSlim _dbLock = new(1, 1);

    private List<VersionMatrizRiesgos> versiones = new();
    private VersionMatrizRiesgos? version;
    private int filtroVersion;
    private List<Riesgo> riesgos = new();
    private Riesgo? riesgo;
    private List<Riesgo> historial = new();

    private List<SeguimientoRiesgo> seguimientos = new();
    private List<HallazgoRiesgo> hallazgos = new();
    private List<AlcanceRiesgo> alcances = new();
    private List<ElementoRiesgo> elementos = new();
    private Dictionary<int, List<ElementoRiesgo>> elementosVersion = new();
    private List<PlanAccion> planesRiesgo = new();
    private List<AccionPlan> accionesPlanes = new();

    [Parameter] public int? RiesgoId { get; set; }

    private void IrNuevoPlan(int riesgoId, int? seguimientoId) =>
        Nav.NavigateTo($"planes-accion/nuevo?riesgo={riesgoId}" + (seguimientoId is int s ? $"&seguimiento={s}" : ""));

    private void IrPlan(int planId) => Nav.NavigateTo($"planes-accion/{planId}?riesgo={riesgo?.Id}");

    private Dictionary<int, int> conteoRiesgos = new(), conteoSeguimientos = new();
    private Dictionary<int, DateTime> ultimoSeguimiento = new();
    private Dictionary<int, ResultadoSeguimiento> ultimoResultado = new();
    private Dictionary<int, int> hallazgosAbiertos = new();

    private List<ElementoTrazado> torres = new();
    private List<Componente> componentes = new();
    private List<ItemCatalogo> localizaciones = new();
    private List<Tiro> tiros = new();

    private MotorTabla? motor;
    private bool verCampos;
    private string filtro = "", filtroNivel = "";
    private string col = "codigo";
    private bool asc = true;

    private string Titulo => vista switch
    {
        "versiones" => "Revisiones de la matriz",
        "detalle" => riesgo is null ? "Riesgo" : riesgo.Codigo,
        "ronda" => "Ronda de seguimiento",
        "importar" => "Importar matriz de riesgos",
        _ => "Matriz de riesgos"
    };

    private string? Subtitulo => vista switch
    {
        "detalle" => riesgo?.Descripcion,
        "matriz" => version is null ? null : $"{version.Codigo} · {version.Fecha:dd/MM/yyyy} · {riesgos.Count} riesgo(s)",
        "ronda" => version?.Codigo,
        _ => null
    };

    private EventCallback AtrasCb => vista == "matriz" ? default : EventCallback.Factory.Create(this, Atras);

    private void Atras()
    {
        if (vista == "detalle") { vista = "matriz"; riesgo = null; formSeguimiento = null; formRiesgo = null; return; }
        vista = "matriz"; formVersion = null; libro = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await _dbLock.WaitAsync();
        try
        {
            // /riesgos/{id}: vuelve al detalle (p. ej. desde un plan de acción),
            // mostrando la revisión a la que pertenece ese riesgo.
            if (RiesgoId is int rid && Db.Riesgos.AsNoTracking().FirstOrDefault(r => r.Id == rid) is { } r0)
                filtroVersion = r0.VersionMatrizRiesgosId;
            await CargarAsync();
            if (RiesgoId is int id) { vista = "detalle"; CargarDetalle(id); }
        }
        finally { _dbLock.Release(); }
    }

    private async Task CargarAsync()
    {
        versiones = Servicio.Versiones();
        if (filtroVersion == 0 || !versiones.Any(v => v.Id == filtroVersion))
            filtroVersion = (versiones.FirstOrDefault(v => v.Estado == EstadoVersionMatriz.Vigente) ?? versiones.FirstOrDefault())?.Id ?? 0;
        version = versiones.FirstOrDefault(v => v.Id == filtroVersion);

        riesgos = version is null ? new() : Db.Riesgos.AsNoTracking()
            .Where(r => r.VersionMatrizRiesgosId == version.Id).OrderBy(r => r.Orden).ThenBy(r => r.Codigo).ToList();

        var ids = riesgos.Select(r => r.Id).ToList();
        elementosVersion = Db.ElementosRiesgo.AsNoTracking().Where(e => ids.Contains(e.RiesgoId)).ToList()
            .GroupBy(e => e.RiesgoId).ToDictionary(g => g.Key, g => g.ToList());
        var segs = Db.SeguimientosRiesgo.AsNoTracking().Where(s => ids.Contains(s.RiesgoId)).ToList();
        ultimoSeguimiento = segs.GroupBy(s => s.RiesgoId).ToDictionary(g => g.Key, g => g.Max(x => x.Fecha));
        ultimoResultado = segs.GroupBy(s => s.RiesgoId)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.Fecha).ThenByDescending(x => x.Id).First().Resultado);
        var idsSeg = segs.Select(s => s.Id).ToList();
        hallazgosAbiertos = Db.HallazgosRiesgo.AsNoTracking()
            .Where(h => idsSeg.Contains(h.SeguimientoRiesgoId) && h.Estado != EstadoHallazgo.Cerrado)
            .ToList()
            .GroupBy(h => segs.First(s => s.Id == h.SeguimientoRiesgoId).RiesgoId)
            .ToDictionary(g => g.Key, g => g.Count());

        // Conteos por versión para la pantalla de revisiones.
        var todosRiesgos = Db.Riesgos.AsNoTracking().Select(r => new { r.Id, r.VersionMatrizRiesgosId }).ToList();
        conteoRiesgos = todosRiesgos.GroupBy(r => r.VersionMatrizRiesgosId).ToDictionary(g => g.Key, g => g.Count());
        var porRiesgo = todosRiesgos.ToDictionary(r => r.Id, r => r.VersionMatrizRiesgosId);
        conteoSeguimientos = Db.SeguimientosRiesgo.AsNoTracking().Select(s => s.RiesgoId).ToList()
            .Where(porRiesgo.ContainsKey).GroupBy(id => porRiesgo[id]).ToDictionary(g => g.Key, g => g.Count());

        torres = Db.ElementosTrazado.AsNoTracking().Where(t => !t.Eliminado).OrderBy(t => t.Codigo).ToList();
        localizaciones = Db.Catalogos.AsNoTracking().Where(c => c.Tipo == "Localización" && c.Activo).OrderBy(c => c.Nombre).ToList();
        tiros = Db.Tiros.AsNoTracking().Where(t => !t.Eliminado).OrderBy(t => t.Nombre).ToList();

        // Todo lo que el render necesita se carga aquí: Blazor vuelve a
        // renderizar en medio del await de un manejador (p. ej. al guardar),
        // y una consulta a Db desde el render en ese momento choca con la
        // operación en curso ("A second operation was started...").
        componentesPorId = Db.Componentes.IgnoreQueryFilters().AsNoTracking().ToList().ToDictionary(c => c.Id);
        // Listas desplegables: salen de Catálogos (se amplían desde allí).
        catalogos = new()
        {
            [SembradorCatalogosRiesgo.EstadoActual] = SembradorCatalogosRiesgo.Valores(Db, SembradorCatalogosRiesgo.EstadoActual),
            [SembradorCatalogosRiesgo.Categoria] = SembradorCatalogosRiesgo.Valores(Db, SembradorCatalogosRiesgo.Categoria),
            [SembradorCatalogosRiesgo.Area] = SembradorCatalogosRiesgo.Valores(Db, SembradorCatalogosRiesgo.Area),
            [SembradorCatalogosRiesgo.Estrategia] = SembradorCatalogosRiesgo.Valores(Db, SembradorCatalogosRiesgo.Estrategia),
            [SembradorCatalogosRiesgo.Cargo] = SembradorCatalogosRiesgo.Valores(Db, SembradorCatalogosRiesgo.Cargo),
            // Para el editor de planes de acción dentro del seguimiento.
            [SembradorCatalogosRiesgo.OrigenHallazgo] = SembradorCatalogosRiesgo.Valores(Db, SembradorCatalogosRiesgo.OrigenHallazgo),
            [SembradorCatalogosRiesgo.TipoHallazgo] = SembradorCatalogosRiesgo.Valores(Db, SembradorCatalogosRiesgo.TipoHallazgo),
            [SembradorCatalogosRiesgo.ProcesoPlan] = SembradorCatalogosRiesgo.Valores(Db, SembradorCatalogosRiesgo.ProcesoPlan),
        };

        // "Estado del plan" de cada riesgo = sus planes de acción. Se agrupan
        // por código de riesgo para ver también los de revisiones anteriores.
        var codigoDe = Db.Riesgos.IgnoreQueryFilters().AsNoTracking().Select(r => new { r.Id, r.Codigo }).ToDictionary(r => r.Id, r => r.Codigo);
        // Un plan puede estar asociado a varios riesgos (RiesgoPlan): aparece en cada uno.
        var idsConRel = Db.RiesgosPlan.AsNoTracking().Select(r => r.PlanAccionId).Distinct().ToList();
        var todosPlanes = Db.PlanesAccion.AsNoTracking().Where(p => p.RiesgoId != null || idsConRel.Contains(p.Id)).ToList();
        var riesgosDe = SigWeb.Data.Planes.PlanesAccionServicio.RiesgosDePlanes(Db, todosPlanes);
        var idsTodos = todosPlanes.Select(p => p.Id).ToList();
        var accionesTodas = Db.AccionesPlan.AsNoTracking().Where(a => idsTodos.Contains(a.PlanAccionId)).ToList();
        planesPorCodigo = todosPlanes
            .SelectMany(p => (riesgosDe.TryGetValue(p.Id, out var lr) ? lr : new List<int>()).Where(codigoDe.ContainsKey)
                .Select(r => codigoDe[r]).Distinct(StringComparer.OrdinalIgnoreCase).Select(c => (Codigo: c, Plan: p)))
            .GroupBy(x => x.Codigo, x => x.Plan, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.OrderBy(p => p.Fecha).ThenBy(p => p.Id)
                .Select(p => new ResumenPlan(p.Id, p.Codigo, EscalaAccion.EstadoPlan(accionesTodas.Where(a => a.PlanAccionId == p.Id)), p.DescripcionHallazgo)).ToList(),
                StringComparer.OrdinalIgnoreCase);

        await CargarMotorAsync();
        if (riesgo is not null) CargarDetalle(riesgo.Id);
    }

    private async Task CargarMotorAsync()
    {
        if (version is null) { motor = null; return; }
        try
        {
            motor = await MotorTabla.CargarAsync(Db, "riesgos", Nativas(),
                riesgos.Select(r => (r.Id, r.Codigo + " — " + r.Descripcion)));
        }
        catch { motor = null; }
    }

    private Riesgo? R(int id) => riesgos.FirstOrDefault(x => x.Id == id);

