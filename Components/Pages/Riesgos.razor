                            <button type="button" class="ens-mini" title="Editar seguimiento" @onclick="() => EditarSeguimiento(s)"><Ico Nombre="editar" /></button>
                            <button type="button" class="ens-mini" title="Eliminar seguimiento" @onclick="() => PedirEliminarSeguimiento(s)"><Ico Nombre="eliminar" /></button>
                        </td>
                    </tr>
                }
                @if (seguimientos.Count == 0)
                {
                    <tr><td colspan="8" class="text-muted small text-center py-2"><em>Sin seguimientos registrados.</em></td></tr>
                }
            </tbody>
        </table></div>
    </div>

    @if (historial.Count > 1)
    {
        <div class="rg-bloque mt-2">
            <div class="rg-bloque-tit"><span>Este riesgo en otras revisiones</span></div>
            <div class="d-flex flex-wrap gap-1">
