                        <button type="button" class="rg-chip" title="Abrir plan" @onclick="() => IrPlan(p.Id)">@p.Codigo</button>
                    }
                }
                </Extra>
                <ChildContent>
            @foreach (var pb in planesBorrador)
            {
                <div class="rg-plan-borrador" @key="pb">
                    <button type="button" class="ens-mini rg-plan-borrador-x" title="Quitar" @onclick="() => planesBorrador.Remove(pb)">✕</button>
                    <EditorPlanAccion Modelo="pb" Origenes="Opciones(SembradorCatalogosRiesgo.OrigenHallazgo, null)" Tipos="Opciones(SembradorCatalogosRiesgo.TipoHallazgo, null)"
                                      Procesos="Opciones(SembradorCatalogosRiesgo.ProcesoPlan, null)" Responsables="Opciones(SembradorCatalogosRiesgo.Cargo, null)"
                                      Torres="torres" Componentes="componentesPorId" Localizaciones="localizaciones" Tiros="tiros"
                                      OnError="m => { mensaje = m; error = true; }"
                                      EtiquetasRiesgo="@(riesgo is null ? new() : new Dictionary<int, string> { [riesgo.Id] = $"{riesgo.Codigo} — {riesgo.Descripcion}" })" />
                </div>
            }

                </ChildContent>
            </SeccionFormulario>
        </ChildContent>
        <Acciones>
            <button class="btn btn-secondary btn-sm" title="Cancelar" @onclick="() => { formSeguimiento = null; planesBorrador = new(); }"><Ico Nombre="cancelar" /></button>
            <button class="btn btn-primary btn-sm" title="Guardar" @onclick="GuardarSeguimiento"><Ico Nombre="guardar" /></button>
        </Acciones>
    </FormularioSig>;

    private List<Componente> TodosComponentes => componentesPorId.Values.Where(c => !c.Eliminado)
        .OrderBy(c => c.ElementoTrazadoId).ThenBy(c => c.Orden).ToList();
    private Dictionary<int, Componente> componentesPorId = new();

    private static int? Int(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var n) ? n : 0;

    // Lugares de cada fila de hallazgo del formulario (vacío = todo el proyecto).
    private Dictionary<HallazgoRiesgo, List<LugarPlan>> lugaresForm = new();
    private List<LugarPlan> LugaresForm(HallazgoRiesgo h) => lugaresForm.TryGetValue(h, out var l) ? l : lugaresForm[h] = new();
    private List<LugarHallazgo> lugaresHallazgos = new();

    // Planes de acción nuevos que nacen de este seguimiento (se guardan con él).
    private List<SigWeb.Data.Planes.PlanesAccionServicio.PlanEditable> planesBorrador = new();

    private void AgregarPlanBorrador()
    {
        if (formSeguimiento is null) return;
        var origen = Opciones(SembradorCatalogosRiesgo.OrigenHallazgo, null)
            .FirstOrDefault(o => string.Equals(o, "Seguimiento", StringComparison.OrdinalIgnoreCase)) ?? "";
        var pb = new SigWeb.Data.Planes.PlanesAccionServicio.PlanEditable
        {
            Plan = new PlanAccion
            {
                Codigo = ServicioPlanes.SiguienteCodigo(planesBorrador.Select(p => p.Plan.Codigo)),
                Fecha = formSeguimiento.Fecha, OrigenHallazgo = origen,
                DescripcionHallazgo = formSeguimiento.Observacion ?? ""
            }
        };
        if (riesgo is not null) pb.Riesgos.Add(riesgo.Id);
        // Lugares sugeridos: los de los hallazgos del formulario.
        foreach (var l in formHallazgos.SelectMany(LugaresForm))
            if (!pb.Lugares.Any(x => x.ElementoTrazadoId == l.ElementoTrazadoId && x.ComponenteId == l.ComponenteId && x.ItemCatalogoId == l.ItemCatalogoId && x.TiroId == l.TiroId))
                pb.Lugares.Add(new LugarPlan { ElementoTrazadoId = l.ElementoTrazadoId, ComponenteId = l.ComponenteId, ItemCatalogoId = l.ItemCatalogoId, TiroId = l.TiroId });
        planesBorrador.Add(pb);
    }

    private static string TipoDe(HallazgoRiesgo h) =>
        h.ElementoTrazadoId is not null ? "torre"
        : h.ComponenteId is not null ? "componente"
        : h.ItemCatalogoId is not null ? "localizacion"
        : h.TiroId is not null ? "tiro" : "proyecto";

    private void CambiarTipoHallazgo(HallazgoRiesgo h, string tipo)
    {
        h.ElementoTrazadoId = null; h.ComponenteId = null; h.ItemCatalogoId = null; h.TiroId = null;
        // Se deja en 0/null hasta que el usuario elija: el select de al lado se redibuja.
        if (tipo == "torre") h.ElementoTrazadoId = 0;
        else if (tipo == "componente") h.ComponenteId = 0;
        else if (tipo == "localizacion") h.ItemCatalogoId = 0;
        else if (tipo == "tiro") h.TiroId = 0;
    }

    private void AgregarFilaHallazgo()
    {
        formHallazgos.Add(new HallazgoRiesgo());
        if (formSeguimiento is not null) formSeguimiento.Resultado = ResultadoSeguimiento.Materializado;
    }

    private async Task GuardarSeguimiento()
    {
        if (formSeguimiento is null || riesgo is null) return;
        if (formSegResp.Count == 0) { mensaje = "Indica quién hace el seguimiento."; error = true; return; }
        formSeguimiento.Responsable = SelectorMultiple.Unir(formSegResp);

        await _dbLock.WaitAsync();
        try
        {
            SeguimientoRiesgo ent;
            if (formSeguimientoEsNuevo)
            {
                ent = new SeguimientoRiesgo
                {
                    RiesgoId = formSeguimiento.RiesgoId, Fecha = formSeguimiento.Fecha,
                    Responsable = formSeguimiento.Responsable, Resultado = formSeguimiento.Resultado,
                    Observacion = formSeguimiento.Observacion ?? "",
                    Probabilidad = riesgo.Probabilidad, Impacto = riesgo.Impacto
                };
                Db.SeguimientosRiesgo.Add(ent);
            }
            else
            {
                var e2 = await Db.SeguimientosRiesgo.FirstOrDefaultAsync(s => s.Id == formSeguimiento.Id);
                if (e2 is null) return;
                e2.Fecha = formSeguimiento.Fecha; e2.Responsable = formSeguimiento.Responsable;
                e2.Resultado = formSeguimiento.Resultado; e2.Observacion = formSeguimiento.Observacion ?? "";
                ent = e2;
            }
            await Db.SaveChangesAsync();

            // Hallazgos: se reescriben los de este seguimiento (los quitados van a la Papelera).
            var previos = await Db.HallazgosRiesgo.Where(h => h.SeguimientoRiesgoId == ent.Id).ToListAsync();
            var conservados = formHallazgos.Where(h => h.Id > 0).Select(h => h.Id).ToHashSet();
            foreach (var p in previos.Where(p => !conservados.Contains(p.Id)))
            { p.Eliminado = true; p.FechaEliminacion = DateTime.Now; }

            var destinosH = new List<(HallazgoRiesgo Form, HallazgoRiesgo Dest)>();
            foreach (var h in formHallazgos)
            {
                var dest = h.Id > 0 ? previos.FirstOrDefault(p => p.Id == h.Id) : null;
                if (dest is null)
                {
                    dest = new HallazgoRiesgo { SeguimientoRiesgoId = ent.Id };
                    Db.HallazgosRiesgo.Add(dest);
                }
                // Los lugares van en LugarHallazgo (varios); los campos únicos quedan vacíos.
                dest.ElementoTrazadoId = null; dest.ComponenteId = null; dest.ItemCatalogoId = null; dest.TiroId = null;
                dest.Descripcion = h.Descripcion ?? ""; dest.Accion = h.Accion ?? ""; dest.Estado = h.Estado;
                dest.FechaCierre = h.Estado == EstadoHallazgo.Cerrado ? (h.FechaCierre ?? DateTime.Today) : null;
                destinosH.Add((h, dest));
            }
            await Db.SaveChangesAsync();
            var idsH = destinosH.Select(d => d.Dest.Id).ToList();
            Db.LugaresHallazgo.RemoveRange(await Db.LugaresHallazgo.Where(l => idsH.Contains(l.HallazgoRiesgoId)).ToListAsync());
            foreach (var (h, dest) in destinosH)
                foreach (var l in LugaresForm(h))
                    Db.LugaresHallazgo.Add(new LugarHallazgo { HallazgoRiesgoId = dest.Id, ElementoTrazadoId = l.ElementoTrazadoId, ComponenteId = l.ComponenteId, ItemCatalogoId = l.ItemCatalogoId, TiroId = l.TiroId });
            // Soportes: los nuevos se registran; los quitados van a la Papelera.
            foreach (var x in formSoportes.Where(x => x.Id == 0))
                Db.ArchivosRiesgo.Add(new ArchivoRiesgo { SeguimientoRiesgoId = ent.Id, NombreOriginal = x.NombreOriginal, RutaArchivo = x.RutaArchivo });
            var idsQuitar = soportesQuitados.Select(x => x.Id).ToList();
            foreach (var x in await Db.ArchivosRiesgo.Where(x => idsQuitar.Contains(x.Id)).ToListAsync())
            { x.Eliminado = true; x.FechaEliminacion = DateTime.Now; }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();

            // Planes de acción nuevos de este seguimiento: ligados al riesgo y al seguimiento.
            var creados = new List<string>();
            foreach (var pb in planesBorrador)
            {
                pb.Plan.RiesgoId = riesgo.Id;
                pb.Plan.SeguimientoRiesgoId = ent.Id;
                if (string.IsNullOrWhiteSpace(pb.Plan.DescripcionHallazgo)) pb.Plan.DescripcionHallazgo = ent.Observacion ?? "";
                await ServicioPlanes.GuardarAsync(pb);
                creados.Add(pb.Plan.Codigo);
            }

            formSeguimiento = null; formHallazgos = new(); formSoportes = new(); soportesQuitados = new();
            lugaresForm = new(); planesBorrador = new();
            mensaje = "Seguimiento guardado." + (creados.Count > 0 ? $" Planes de acción creados: {string.Join(", ", creados)}." : ""); error = false;
            await CargarAsync();
            CargarDetalle(riesgo.Id);
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo guardar el seguimiento: inténtalo de nuevo. (" + ex.Message + ")"; error = true;
        }
        finally { _dbLock.Release(); }
    }

    // ---------- Ronda de seguimiento ----------
    private DateTime rondaFecha = DateTime.Today;
    private List<string> rondaResp = new();
    private List<FilaRonda> rondaFilas = new();

    private class FilaRonda
    {
        public Riesgo Riesgo { get; set; } = default!;
        public bool Marcado { get; set; }
        public ResultadoSeguimiento Resultado { get; set; } = ResultadoSeguimiento.NoMaterializado;
        public string Observacion { get; set; } = "";
        public DateTime? UltimoSeguimiento { get; set; }
    }

    private void AbrirRonda()
    {
        vista = "ronda";
        rondaFecha = DateTime.Today;
        rondaFilas = riesgos
            .Where(r => !string.Equals(r.EstadoActual, "Cerrado", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(r => r.Nivel).ThenBy(r => r.Codigo)
            .Select(r => new FilaRonda
            {
                Riesgo = r,
                UltimoSeguimiento = ultimoSeguimiento.TryGetValue(r.Id, out var f) ? f : null
            }).ToList();
    }

    private void MarcarTodosNoMaterializado()
    {
        foreach (var f in rondaFilas) { f.Marcado = true; f.Resultado = ResultadoSeguimiento.NoMaterializado; }
    }

    private async Task GuardarRonda()
    {
        var marcados = rondaFilas.Where(f => f.Marcado).ToList();
        if (marcados.Count == 0 || rondaResp.Count == 0) return;
        await _dbLock.WaitAsync();
        try
        {
            var fechas = Db.SeguimientosRiesgo.AsNoTracking()
                .Where(x => x.Fecha == rondaFecha).Select(x => x.RiesgoId).ToHashSet();
            var repetidos = marcados.Count(f => fechas.Contains(f.Riesgo.Id));
            foreach (var f in marcados.Where(f => !fechas.Contains(f.Riesgo.Id)))
            {
                Db.SeguimientosRiesgo.Add(new SeguimientoRiesgo
                {
                    RiesgoId = f.Riesgo.Id,
                    Fecha = rondaFecha,
                    Responsable = SelectorMultiple.Unir(rondaResp),
                    Resultado = f.Resultado,
                    Observacion = f.Observacion ?? "",
                    Probabilidad = f.Riesgo.Probabilidad,
                    Impacto = f.Riesgo.Impacto
                });
            }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            var nuevos = marcados.Count - repetidos;
            var materializados = marcados.Count(f => !fechas.Contains(f.Riesgo.Id) && f.Resultado == ResultadoSeguimiento.Materializado);
            mensaje = $"Ronda del {rondaFecha:dd/MM/yyyy}: {nuevos} seguimiento(s) registrados" +
                      (repetidos > 0 ? $"; {repetidos} ya tenían seguimiento en esa fecha y se omitieron" : "") +
                      (materializados > 0 ? $"; {materializados} materializado(s) — registra sus hallazgos desde el detalle del riesgo." : ".");
            error = false;
            vista = "matriz";
            await CargarAsync();
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo guardar la ronda: inténtalo de nuevo. (" + ex.Message + ")"; error = true;
        }
        finally { _dbLock.Release(); }
    }

    // ---------- Versiones ----------
    private VersionMatrizRiesgos? formVersion;
    private bool formVersionEsNueva, copiarRiesgos = true;

    private void NuevaVersion()
    {
        vista = "versiones";
        formVersion = new VersionMatrizRiesgos { Fecha = DateTime.Today, Codigo = SiguienteCodigoVersion() };
        formVersionEsNueva = true;
        copiarRiesgos = versiones.Count > 0;
    }

    private string SiguienteCodigoVersion()
    {
        for (var n = versiones.Count + 1; n < 200; n++)
        {
            var c = "Rev. " + n.ToString("00");
            if (!versiones.Any(v => string.Equals(v.Codigo, c, StringComparison.OrdinalIgnoreCase))) return c;
        }
        return "Rev. " + DateTime.Today.Year;
    }

    private void EditarVersion(VersionMatrizRiesgos v)
    {
        formVersion = new VersionMatrizRiesgos
        {
            Id = v.Id, Codigo = v.Codigo, Fecha = v.Fecha, Etapa = v.Etapa,
            ElaboradoPor = v.ElaboradoPor, RevisadoPor = v.RevisadoPor, AprobadoPor = v.AprobadoPor,
            EstadoDocumento = v.EstadoDocumento, HojaOrigen = v.HojaOrigen,
            DescripcionCambios = v.DescripcionCambios, Estado = v.Estado, VersionAnteriorId = v.VersionAnteriorId
        };
        formVersionEsNueva = false;
    }

    private async Task GuardarVersion()
    {
        if (formVersion is null) return;
        if (string.IsNullOrWhiteSpace(formVersion.Codigo)) { mensaje = "La revisión necesita un código."; error = true; return; }
        if (versiones.Any(v => v.Id != formVersion.Id && string.Equals(v.Codigo.Trim(), formVersion.Codigo.Trim(), StringComparison.OrdinalIgnoreCase)))
        { mensaje = $"Ya existe una revisión con el código \"{formVersion.Codigo}\"."; error = true; return; }

        await _dbLock.WaitAsync();
        try
        {
            if (formVersionEsNueva)
            {
                var origen = copiarRiesgos ? (versiones.FirstOrDefault(v => v.Estado == EstadoVersionMatriz.Vigente) ?? versiones.FirstOrDefault())?.Id : null;
                var nueva = await Servicio.CrearVersionAsync(formVersion, origen);
                if (versiones.Count == 0) await Servicio.MarcarVigenteAsync(nueva.Id);
                filtroVersion = nueva.Id;
                mensaje = $"Revisión {nueva.Codigo} creada" + (origen is null ? "." : " con copia de los riesgos de la revisión anterior.");
            }
            else
            {
                var ent = await Db.VersionesMatrizRiesgos.FirstOrDefaultAsync(v => v.Id == formVersion.Id);
                if (ent is not null)
                {
                    ent.Codigo = formVersion.Codigo.Trim(); ent.Fecha = formVersion.Fecha;
                    ent.Etapa = formVersion.Etapa ?? ""; ent.ElaboradoPor = formVersion.ElaboradoPor ?? "";
                    ent.RevisadoPor = formVersion.RevisadoPor ?? ""; ent.AprobadoPor = formVersion.AprobadoPor ?? "";
                    ent.EstadoDocumento = formVersion.EstadoDocumento ?? "";
                    ent.DescripcionCambios = formVersion.DescripcionCambios ?? "";
                    await Db.SaveChangesAsync();
                }
                mensaje = "Revisión guardada.";
            }
            error = false;
            Db.ChangeTracker.Clear();
            formVersion = null;
            await CargarAsync();
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo guardar la revisión: inténtalo de nuevo. (" + ex.Message + ")"; error = true;
        }
        finally { _dbLock.Release(); }
    }

    private async Task MarcarVigente(VersionMatrizRiesgos v)
    {
        await _dbLock.WaitAsync();
        try
        {
            await Servicio.MarcarVigenteAsync(v.Id);
            mensaje = $"{v.Codigo} es ahora la revisión vigente."; error = false;
            filtroVersion = v.Id;
            await CargarAsync();
        }
        finally { _dbLock.Release(); }
    }

    private async Task VerVersion(VersionMatrizRiesgos v)
    {
        filtroVersion = v.Id;
        vista = "matriz";
        await _dbLock.WaitAsync();
        try { await CargarAsync(); }
        finally { _dbLock.Release(); }
    }

    // ---------- Importar el libro de la matriz ----------
    private LibroMatrizRiesgos? libro;
    private HashSet<string> yaImportadas = new(StringComparer.OrdinalIgnoreCase);
    private bool importando;

    private async Task LeerExcel(InputFileChangeEventArgs e)
    {
        libro = null; mensaje = "";
        try
        {
            await using var ms = new MemoryStream();
            await e.File.OpenReadStream(30 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            libro = LectorLibroMatrizRiesgos.Leer(ms);
            yaImportadas = versiones.Select(v => v.Codigo).ToHashSet(StringComparer.OrdinalIgnoreCase);
            foreach (var rv in libro.Revisiones)
                if (yaImportadas.Contains(rv.Codigo) || rv.Filas.Count == 0) rv.Importar = false;
        }
        catch (Exception ex)
        {
            mensaje = "No se pudo leer el libro: " + ex.Message; error = true;
        }
    }

    private async Task ConfirmarImportar()
    {
        if (libro is null) return;
        var aImportar = libro.Revisiones.Where(rv => rv.Importar && !yaImportadas.Contains(rv.Codigo)).ToList();
        if (aImportar.Count == 0) return;
        importando = true;
        await _dbLock.WaitAsync();
        try
        {
            VersionMatrizRiesgos? ultima = null;
            var totalRiesgos = 0;
            // En orden de versión, encadenando cada una con la anterior.
            foreach (var rv in aImportar.OrderBy(x => x.Numero ?? int.MaxValue).ThenBy(x => x.Fecha))
            {
                var nueva = await Servicio.CrearVersionAsync(new VersionMatrizRiesgos
                {
                    Codigo = rv.Codigo,
                    Fecha = rv.Fecha,
                    Etapa = rv.Etapa,
                    ElaboradoPor = rv.ElaboradoPor,
                    RevisadoPor = rv.RevisadoPor,
                    AprobadoPor = rv.AprobadoPor,
                    EstadoDocumento = rv.EstadoDocumento,
                    HojaOrigen = rv.Hoja,
                    DescripcionCambios = ""
                }, ultima?.Id);

                var orden = 0;
                var usados = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                var nuevosRiesgos = new List<Riesgo>();
                foreach (var f in rv.Filas)
                {
                    orden++;
                    var codigo = int.TryParse(f.Item, out var n) ? "R-" + n.ToString("00")
                        : (string.IsNullOrWhiteSpace(f.Item) ? "R-" + orden.ToString("00") : f.Item.Trim());
                    // Items repetidos en el Excel: se conserva el número y se
                    // distingue con una letra (R-22, R-22b) en vez de renumerar.
                    if (!usados.Add(codigo))
                    {
                        var sufijo = 'b';
                        while (!usados.Add(codigo + sufijo) && sufijo < 'z') sufijo++;
                        codigo += sufijo;
                    }
                    var nr = new Riesgo
                    {
                        VersionMatrizRiesgosId = nueva.Id,
                        Codigo = codigo,
                        Orden = orden,
                        Tipo = f.Tipo,
                        EstadoActual = f.EstadoActual,
                        Categoria = f.Categoria,
                        Area = f.Area,
                        Causa = f.Causa,
                        Descripcion = f.Descripcion,
                        Consecuencia = f.Consecuencia,
                        Probabilidad = f.Probabilidad ?? ProbabilidadRiesgo.Moderada,
                        Impacto = f.Impacto ?? ImpactoRiesgo.Importante,
                        Disparadores = f.Disparadores,
                        Estrategia = f.Estrategia,
                        PlanRespuesta = f.PlanRespuesta,
                        ResponsablePlan = f.ResponsablePlan,
                        EstadoPlan = f.EstadoPlan,
                        ComoSeHaceSeguimiento = f.ComoSeHaceSeguimiento
                    };
                    Db.Riesgos.Add(nr);
                    nuevosRiesgos.Add(nr);
                    totalRiesgos++;
                }
                await Db.SaveChangesAsync();
                // Las celdas numeradas del Excel se separan en elementos.
                foreach (var nr in nuevosRiesgos)
                {
                    var els = ElementosRiesgo.DesdeTextos(nr);
                    Db.ElementosRiesgo.AddRange(els);
                    ElementosRiesgo.Sincronizar(nr, els);
                }
                await Db.SaveChangesAsync();
                Db.ChangeTracker.Clear();
                ultima = nueva;
            }

            // Los riesgos de una revisión se encadenan con los de la anterior por código.
            await EncadenarRiesgosAsync();

            // Listas de la hoja "Datos" + las áreas que aparecieron en las matrices.
            var areas = aImportar.SelectMany(rv => rv.Filas).Select(f => f.Area);
            var nuevosCat = await SembradorCatalogosRiesgo.VolcarAsync(Db, libro.Catalogos, areas);
            SembradorCatalogosRiesgo.SincronizarConRiesgos(Db);

            // La revisión más nueva importada queda vigente.
            if (ultima is not null) { await Servicio.MarcarVigenteAsync(ultima.Id); filtroVersion = ultima.Id; }

            mensaje = $"Se importaron {aImportar.Count} revisión(es) y {totalRiesgos} riesgos" +
                      (nuevosCat > 0 ? $", y {nuevosCat} valores nuevos a Catálogos." : ".") +
                      (ultima is not null ? $" {ultima.Codigo} queda como revisión vigente." : "");
            error = false;
            libro = null;
            vista = "matriz";
            await CargarAsync();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensaje = "No se pudo importar: " + ex.Message; error = true; }
        finally { importando = false; _dbLock.Release(); }
    }

    // Enlaza cada riesgo con el del mismo código en la revisión anterior, para
    // poder ver su evolución entre revisiones.
    private async Task EncadenarRiesgosAsync()
    {
        var vs = await Db.VersionesMatrizRiesgos.AsNoTracking().OrderBy(v => v.Fecha).ThenBy(v => v.Id).ToListAsync();
        VersionMatrizRiesgos? previa = null;
        foreach (var v in vs)
        {
            if (previa is not null)
            {
                var anteriores = await Db.Riesgos.AsNoTracking().Where(r => r.VersionMatrizRiesgosId == previa.Id)
                    .ToDictionaryAsync(r => r.Codigo, r => r.Id);
                var actuales = await Db.Riesgos.Where(r => r.VersionMatrizRiesgosId == v.Id && r.RiesgoAnteriorId == null).ToListAsync();
                foreach (var r in actuales)
                    if (anteriores.TryGetValue(r.Codigo, out var idPrev)) r.RiesgoAnteriorId = idPrev;
                if (actuales.Count > 0) await Db.SaveChangesAsync();
            }
            previa = v;
        }
        Db.ChangeTracker.Clear();
    }

    // ---------- Eliminar (con impacto) ----------
    private Riesgo? elimRiesgo;
    private VersionMatrizRiesgos? elimVersion;
    private SeguimientoRiesgo? elimSeguimiento;
    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;
    private bool BloqueadoPorImpacto => impacto is null || (impacto.RequiereEntender && !impactoOk);

    private async Task CalcularImpacto(Func<Task<SigWeb.Data.Impacto.InformeImpacto>> f)
    {
        impacto = null; impactoOk = false;
        // Se lanza sin "await" desde Pedir* para no congelar el diálogo de
        // confirmación; por eso toma el semáforo: si el usuario guarda algo
        // mientras esto sigue consultando, debe esperar su turno en vez de
        // chocar con la misma conexión de Db.
        await _dbLock.WaitAsync();
        try { impacto = await f(); }
        catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        finally { _dbLock.Release(); }
        await InvokeAsync(StateHasChanged);
    }

    private void PedirEliminarRiesgo(Riesgo r) { elimVersion = null; elimSeguimiento = null; elimRiesgo = r; _ = CalcularImpacto(() => Analizador.Riesgo(r.Id)); }
    private void PedirEliminarVersion(VersionMatrizRiesgos v) { elimRiesgo = null; elimSeguimiento = null; elimVersion = v; _ = CalcularImpacto(() => Analizador.VersionMatrizRiesgos(v.Id)); }
    private void PedirEliminarSeguimiento(SeguimientoRiesgo s) { elimRiesgo = null; elimVersion = null; elimSeguimiento = s; _ = CalcularImpacto(() => Analizador.SeguimientoRiesgo(s.Id)); }

    // Reemplazar una carga: desde la pantalla de importar, cuando el código ya
    // existe, se pide eliminar esa revisión (con su propio aviso de impacto) y,
    // al confirmarla, se deja la fila del libro lista para volver a importarla.
    private string? reemplazarCodigoTrasEliminar;
    private void PedirReemplazarCarga(string codigo)
    {
        var v = versiones.FirstOrDefault(x => string.Equals(x.Codigo, codigo, StringComparison.OrdinalIgnoreCase));
        if (v is null) return;
        reemplazarCodigoTrasEliminar = codigo;
        PedirEliminarVersion(v);
    }

    private async Task ConfirmarEliminarRiesgo()
    {
        if (elimRiesgo is null || BloqueadoPorImpacto) return;
        await _dbLock.WaitAsync();
        try
        {
            var ent = await Db.Riesgos.FirstOrDefaultAsync(r => r.Id == elimRiesgo.Id);
            if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
            Db.ChangeTracker.Clear();
            if (riesgo?.Id == elimRiesgo.Id) { riesgo = null; vista = "matriz"; }
            elimRiesgo = null; impacto = null;
            mensaje = "Riesgo enviado a la Papelera."; error = false;
            await CargarAsync();
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo eliminar el riesgo: inténtalo de nuevo. (" + ex.Message + ")"; error = true;
        }
        finally { _dbLock.Release(); }
    }

    private async Task ConfirmarEliminarVersion()
    {
        if (elimVersion is null || BloqueadoPorImpacto) return;
        await _dbLock.WaitAsync();
        try
        {
            var ent = await Db.VersionesMatrizRiesgos.FirstOrDefaultAsync(v => v.Id == elimVersion.Id);
            if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
            Db.ChangeTracker.Clear();
            if (filtroVersion == elimVersion.Id) filtroVersion = 0;
            var codigo = elimVersion.Codigo;
            elimVersion = null; impacto = null;
            await CargarAsync();

            if (reemplazarCodigoTrasEliminar is not null && string.Equals(reemplazarCodigoTrasEliminar, codigo, StringComparison.OrdinalIgnoreCase))
            {
                // Viene de "reemplazar" en la pantalla de importar: se deja el
                // mismo libro cargado con esa revisión lista para importarse.
                reemplazarCodigoTrasEliminar = null;
                yaImportadas.Remove(codigo);
                var rv = libro?.Revisiones.FirstOrDefault(x => string.Equals(x.Codigo, codigo, StringComparison.OrdinalIgnoreCase));
                if (rv is not null) rv.Importar = true;
                vista = "importar";
                mensaje = $"Revisión {codigo} enviada a la Papelera. Ya puedes importar la nueva.";
            }
            else
            {
                mensaje = "Revisión enviada a la Papelera.";
            }
            error = false;
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo eliminar la revisión: inténtalo de nuevo. (" + ex.Message + ")"; error = true;
        }
        finally { _dbLock.Release(); }
    }

    private async Task ConfirmarEliminarSeguimiento()
    {
        if (elimSeguimiento is null || BloqueadoPorImpacto) return;
        await _dbLock.WaitAsync();
        try
        {
            var ent = await Db.SeguimientosRiesgo.FirstOrDefaultAsync(s => s.Id == elimSeguimiento.Id);
            if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
            Db.ChangeTracker.Clear();
            elimSeguimiento = null; impacto = null;
            mensaje = "Seguimiento enviado a la Papelera."; error = false;
            await CargarAsync();
            if (riesgo is not null) CargarDetalle(riesgo.Id);
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo eliminar el seguimiento: inténtalo de nuevo. (" + ex.Message + ")"; error = true;
        }
        finally { _dbLock.Release(); }
    }
}
