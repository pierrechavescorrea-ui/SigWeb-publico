    // Valores ya usados en la matriz, para ofrecerlos sin forzar un catálogo
    // cerrado. Salen de lo precargado en CargarAsync: el render nunca consulta Db.
    private Dictionary<string, List<string>> catalogos = new();

    // Opciones de un catálogo, más el valor actual si ya no está en él (para no perderlo al editar).
    private List<string> Opciones(string tipo, string? actual)
    {
        var l = catalogos.TryGetValue(tipo, out var v) ? v.ToList() : new();
        if (!string.IsNullOrWhiteSpace(actual) && !l.Contains(actual, StringComparer.OrdinalIgnoreCase)) l.Insert(0, actual);
        return l;
    }

    private record ResumenPlan(int Id, string Codigo, EstadoAccionPlan Estado, string Hallazgo);

    // ======================= Mapa de calor probabilidad × impacto (solo presentación) =======================
    private string vistaR = "mapa";   // mapa | lista
    private (ProbabilidadRiesgo P, ImpactoRiesgo I)? celdaR;

    // ?p={probabilidad 1–5}&i={impacto 1–5} (tablero de inicio): abre el mapa con esa celda elegida.
    [SupplyParameterFromQuery(Name = "p")] public int? ProbQ { get; set; }
    [SupplyParameterFromQuery(Name = "i")] public int? ImpQ { get; set; }
    private string? celdaAplicada;
    protected override void OnParametersSet()
    {
        var c = $"{ProbQ}|{ImpQ}";
        if (c == celdaAplicada) return;
        celdaAplicada = c;
        if (ProbQ is >= 1 and <= 5 && ImpQ is >= 1 and <= 5)
        {
            celdaR = ((ProbabilidadRiesgo)ProbQ.Value, (ImpactoRiesgo)ImpQ.Value);
            vistaR = "mapa";
        }
    }

    private static readonly ProbabilidadRiesgo[] ProbsMapa = { ProbabilidadRiesgo.MuyAlta, ProbabilidadRiesgo.Alta, ProbabilidadRiesgo.Moderada, ProbabilidadRiesgo.Baja, ProbabilidadRiesgo.MuyBaja };
    private static readonly ImpactoRiesgo[] ImpactosMapa = { ImpactoRiesgo.Inferior, ImpactoRiesgo.Menor, ImpactoRiesgo.Importante, ImpactoRiesgo.Mayor, ImpactoRiesgo.Superior };

    private string ordenMapa = "severidad";   // severidad | numero

    // "R-2" < "R-10" < "R-26b": por el número del código y luego por el texto.
    private static (int, string) OrdenCodigo(string? codigo)
    {
        var c = codigo ?? "";
        var m = System.Text.RegularExpressions.Regex.Match(c, @"\d+");
        return (m.Success && int.TryParse(m.Value, out var n) ? n : int.MaxValue, c);
    }

    private void ElegirCelda(ProbabilidadRiesgo p, ImpactoRiesgo i) => celdaR = celdaR == (p, i) ? null : (p, i);

    private RenderFragment MapaRiesgos() => __builder =>
    {
        var todos = Mostrados.ToList();
        var porCelda = todos.GroupBy(r => (r.Probabilidad, r.Impacto)).ToDictionary(g => g.Key, g => g.ToList());
        var filtrados = celdaR is (ProbabilidadRiesgo cp, ImpactoRiesgo ci) ? todos.Where(r => r.Probabilidad == cp && r.Impacto == ci) : todos;
        var enLista = ordenMapa == "numero"
            ? filtrados.OrderBy(r => OrdenCodigo(r.Codigo)).ToList()
            : filtrados.OrderByDescending(r => EscalaRiesgo.Puntuacion(r.Probabilidad, r.Impacto)).ThenBy(r => OrdenCodigo(r.Codigo)).ToList();
        <div class="rm-marco">
            <div class="rm-mapa-caja">
                <div class="rm-mapa">
                    <div class="rm-eje-y"><span>Probabilidad</span></div>
                    <div class="rm-rejilla">
                        @foreach (var pr in ProbsMapa)
                        {
                            var p = pr;
                            <div class="rm-etq-y">@EscalaRiesgo.Nombre(p)</div>
                            @foreach (var im in ImpactosMapa)
                            {
                                var i = im;
                                var nivel = EscalaRiesgo.Nivel(p, i);
