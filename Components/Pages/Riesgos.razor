@page "/riesgos"
@page "/riesgos/{RiesgoId:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.Riesgos
@using SigWeb.Data.Tablas
@using SigWeb.Models
@inject AppDbContext Db
@inject MatrizRiesgosServicio Servicio
@inject SigWeb.Data.Impacto.AnalizadorImpacto Analizador
@inject IWebHostEnvironment Env
@inject NavigationManager Nav
@inject SigWeb.Data.Planes.PlanesAccionServicio ServicioPlanes

<PageTitle>Riesgos</PageTitle>

<EncabezadoPagina Titulo="@Titulo" Icono="riesgos" Subtitulo="@Subtitulo" OnAtras="AtrasCb">
    <Acciones>
        @if (vista == "matriz")
        {
            <button type="button" class="pg-btn @(vistaR == "mapa" ? "activo" : "")" title="Mapa de calor (probabilidad × impacto)" @onclick='() => vistaR = "mapa"'><Ico Nombre="tablero" /></button>
            <button type="button" class="pg-btn @(vistaR == "lista" ? "activo" : "")" title="Lista" @onclick='() => vistaR = "lista"'><Ico Nombre="listado" /></button>
            <button type="button" class="pg-btn" title="Ronda de seguimiento" disabled="@(version is null || riesgos.Count == 0)" @onclick="AbrirRonda"><Ico Nombre="seguimiento" /></button>
            <button type="button" class="pg-btn" title="Revisiones de la matriz" @onclick='() => vista = "versiones"'><Ico Nombre="versiones" /></button>
            <span class="pg-sep"></span>
            <BotonCampos Activo="verCampos" Deshabilitado="motor is null" OnClick="() => verCampos = true" />
            <button type="button" class="pg-btn" title="Importar el libro Excel de la matriz" @onclick='() => { vista = "importar"; mensaje = ""; }'><Ico Nombre="importar" /></button>
            @if (vistaR == "lista")
            {
                <BotonExportar Titulo="@($"Matriz de riesgos {version?.Codigo}")" />
            }
            <span class="pg-sep"></span>
            <button type="button" class="pg-btn pg-btn-primario" title="Nuevo riesgo" disabled="@(version is null)" @onclick="NuevoRiesgo"><Ico Nombre="agregar" /></button>
        }
        else if (vista == "versiones")
        {
            <BotonExportar Titulo="Revisiones de la matriz de riesgos" />
            <span class="pg-sep"></span>
            <button type="button" class="pg-btn pg-btn-primario" title="Nueva revisión" @onclick="NuevaVersion"><Ico Nombre="agregar" /></button>
        }
        else if (vista == "detalle" && riesgo is not null)
        {
            <BotonExportar Titulo="@($"Seguimientos {riesgo.Codigo}")" Selector="table.tabla-seguimientos" />
            <span class="pg-sep"></span>
            <button type="button" class="pg-btn pg-btn-peligro" title="Eliminar riesgo" @onclick="() => PedirEliminarRiesgo(riesgo)"><Ico Nombre="eliminar" /></button>
            <button type="button" class="pg-btn" title="Editar riesgo" @onclick="() => EditarRiesgo(riesgo)"><Ico Nombre="editar" /></button>
            <button type="button" class="pg-btn pg-btn-primario" title="Nuevo seguimiento" @onclick="() => NuevoSeguimiento(riesgo)"><Ico Nombre="seguimiento" /></button>
        }
    </Acciones>
</EncabezadoPagina>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(error ? "alert-warning" : "alert-success") py-1 px-2 small d-flex align-items-center gap-2">
        <span class="flex-grow-1">@mensaje</span>
        <button type="button" class="btn-close btn-sm" @onclick='() => mensaje = ""'></button>
    </div>
}

@if (verCampos && motor is not null)
{
    <PanelCampos Motor="motor" OnCerrar="() => verCampos = false" OnCambio="StateHasChanged" />
}

@* ============ Confirmaciones de eliminación ============ *@
@if (elimRiesgo is not null)
{
    <div class="card panel-formulario mb-3 border-danger">
        <div class="card-body">
            <div class="mb-2"><Ico Nombre="eliminar" /> <strong>@elimRiesgo.Codigo — @elimRiesgo.Descripcion</strong></div>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2">
                <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => { elimRiesgo = null; impacto = null; }"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@BloqueadoPorImpacto" @onclick="ConfirmarEliminarRiesgo"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}
@if (elimVersion is not null)
{
    <div class="card panel-formulario mb-3 border-danger">
        <div class="card-body">
            <div class="mb-2"><Ico Nombre="eliminar" /> <strong>@elimVersion.Codigo</strong></div>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2">
                <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => { elimVersion = null; impacto = null; reemplazarCodigoTrasEliminar = null; }"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" type="button" title="@(reemplazarCodigoTrasEliminar is null ? "Eliminar (va a la Papelera)" : "Eliminar y dejar lista la nueva para importar")" disabled="@BloqueadoPorImpacto" @onclick="ConfirmarEliminarVersion"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}
@if (elimSeguimiento is not null)
{
    <div class="card panel-formulario mb-3 border-danger">
        <div class="card-body">
            <div class="mb-2"><Ico Nombre="eliminar" /> <strong>Seguimiento del @elimSeguimiento.Fecha.ToString("dd/MM/yyyy")</strong></div>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2">
                <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="() => { elimSeguimiento = null; impacto = null; }"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@BloqueadoPorImpacto" @onclick="ConfirmarEliminarSeguimiento"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}

@* ======================= MATRIZ (lista) ======================= *@
@if (vista == "matriz")
{
    @if (version is null)
    {
        <div class="card panel-formulario">
            <div class="card-body">
                <p class="mb-2">Todavía no hay ninguna revisión de la matriz.</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" title="Importar el libro Excel de la matriz" @onclick='() => vista = "importar"'><Ico Nombre="importar" /></button>
                    <button class="btn btn-outline-secondary btn-sm" title="Crear revisión en blanco" @onclick="NuevaVersion"><Ico Nombre="agregar" /></button>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (formRiesgo is not null)
        {
            @FormularioRiesgo()
        }

        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <input class="form-control form-control-sm" style="max-width:280px;" placeholder="Buscar riesgo..." @bind="filtro" @bind:event="oninput" />
            <select class="form-select form-select-sm" style="max-width:190px;" @bind="filtroVersion" @bind:after="CargarAsync">
                @foreach (var v in versiones)
                {
                    <option value="@v.Id">@v.Codigo — @v.Fecha.ToString("dd/MM/yyyy") @(v.Estado == EstadoVersionMatriz.Vigente ? "(vigente)" : "")</option>
                }
            </select>
            <select class="form-select form-select-sm" style="max-width:150px;" @bind="filtroNivel">
                <option value="">Todos los niveles</option>
                <option value="Extremo">Extremo</option>
                <option value="Alto">Alto</option>
                <option value="Moderado">Moderado</option>
                <option value="Bajo">Bajo</option>
            </select>
            <div class="ms-auto d-flex gap-1 align-items-center small">
                @foreach (var n in new[] { NivelRiesgo.Extremo, NivelRiesgo.Alto, NivelRiesgo.Moderado, NivelRiesgo.Bajo })
                {
                    var cuenta = riesgos.Count(r => r.Nivel == n);
                    <span class="rg-pill" style="background:@EscalaRiesgo.Color(n);color:@EscalaRiesgo.ColorTexto(n)" title="@EscalaRiesgo.Nombre(n)">@EscalaRiesgo.Nombre(n): @cuenta</span>
                }
            </div>
        </div>

        @if (vistaR == "mapa")
        {
            @MapaRiesgos()
        }
        else
        {
        <div class="tabla-scroll tabla-llena"><table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin">
            <thead>
                <tr>
                    @foreach (var c in Columnas)
                    {
                        <th class="th-ordenable" @onclick="() => Ordenar(c.Clave)">@c.Nombre@(col == c.Clave ? (asc ? " ▲" : " ▼") : "")</th>
                    }
                    <th style="width:70px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Mostrados)
                {
                    <tr class="@(riesgo?.Id == r.Id ? "table-active" : "")" role="button" @onclick="() => AbrirRiesgo(r)">
                        @foreach (var c in Columnas)
                        {
                            @if (c.Origen == OrigenCampoTabla.Nativo && c.Clave == "nivel")
                            {
                                <td class="text-center"><span class="rg-pill" style="background:@EscalaRiesgo.Color(r.Nivel);color:@EscalaRiesgo.ColorTexto(r.Nivel)">@EscalaRiesgo.Nombre(r.Nivel)</span></td>
                            }
                            else if (c.Origen == OrigenCampoTabla.Nativo && c.Clave == "estadoplan")
                            {
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var p in PlanesDe(r))
                                        {
                                            <span class="d-flex gap-1 align-items-center small"><strong>@p.Codigo</strong><EstadoAccion Estado="p.Estado" /></span>
                                        }
                                    </div>
                                </td>
                            }
                            else if (c.Origen == OrigenCampoTabla.Nativo && CatalogoDeColumna(c.Clave) is string tipoCat && motor!.Estilo(r.Id, c) is null)
                            {
                                <td class="small"><ValorCatalogo Tipo="@tipoCat" Valor="@(motor!.Texto(r.Id, c, out _))" /></td>
                            }
                            else if (c.Origen == OrigenCampoTabla.Nativo && ColumnasMultilinea.Contains(c.Clave))
                            {
                                <CeldaCampo Motor="motor!" Campo="c" Fila="r.Id" Clase="rg-multi rg-celda-lista" OnCambio="StateHasChanged" />
                            }
                            else
                            {
                                <CeldaCampo Motor="motor!" Campo="c" Fila="r.Id" Clase="@(c.Clave == "codigo" ? "fw-bold" : null)" OnCambio="StateHasChanged" />
                            }
                        }
                        <td class="text-center celda-acciones" @onclick:stopPropagation="true">
                            <button type="button" class="ens-mini" title="Nuevo seguimiento" @onclick="() => NuevoSeguimiento(r)"><Ico Nombre="seguimiento" /></button>
                            <button type="button" class="ens-mini" title="Editar" @onclick="() => EditarRiesgo(r)"><Ico Nombre="editar" /></button>
                        </td>
                    </tr>
                }
                @if (!Mostrados.Any())
                {
                    <tr><td colspan="@(Columnas.Count() + 1)" class="text-muted small text-center py-2"><em>Sin riesgos en esta revisión.</em></td></tr>
                }
            </tbody>
        </table></div>
        }
    }
}

@* ======================= DETALLE DE UN RIESGO ======================= *@
else if (vista == "detalle" && riesgo is not null)
{
    @if (formSeguimiento is not null)
    {
        @FormularioSeguimiento()
    }
    @if (formRiesgo is not null)
    {
        @FormularioRiesgo()
    }

    <div class="rg-detalle">
        <div class="rg-col">
            <div class="rg-bloque">
                <div class="rg-bloque-tit">
                    <span class="rg-pill" style="background:@EscalaRiesgo.Color(riesgo.Nivel);color:@EscalaRiesgo.ColorTexto(riesgo.Nivel)">@EscalaRiesgo.Nombre(riesgo.Nivel)</span>
                    <span>@riesgo.Codigo · @(riesgo.Tipo == TipoRiesgo.Oportunidad ? "Oportunidad" : "Riesgo")</span>
                    <span class="ms-auto small"><ValorCatalogo Tipo="@SembradorCatalogosRiesgo.EstadoActual" Valor="@riesgo.EstadoActual" ClaseSinFormato="text-muted" /></span>
                </div>
                <div class="rg-desc">@riesgo.Descripcion</div>
                <div class="rg-meta">
                    <div><span>Categoría</span><div><ValorCatalogo Tipo="@SembradorCatalogosRiesgo.Categoria" Valor="@riesgo.Categoria" /></div></div>
                    <div><span>Área</span><div><ValorCatalogo Tipo="@SembradorCatalogosRiesgo.Area" Valor="@riesgo.Area" /></div></div>
                    <div><span>Estrategia</span><div><ValorCatalogo Tipo="@SembradorCatalogosRiesgo.Estrategia" Valor="@riesgo.Estrategia" /></div></div>
                    <div class="rg-meta-ancho"><span>Responsable del plan</span>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var c in CargosDe(riesgo.ResponsablePlan)) { <ValorCatalogo Tipo="@SembradorCatalogosRiesgo.Cargo" Valor="@c" ClaseSinFormato="rg-chip" /> }
                            @if (string.IsNullOrWhiteSpace(riesgo.ResponsablePlan)) { <span class="text-muted">—</span> }
                        </div>
                    </div>
                </div>
            </div>
            <div class="rg-listas">
                @foreach (var t in ElementosRiesgo.Tipos)
                {
                    var items = elementos.Where(e => e.Tipo == t).OrderBy(e => e.Orden).ToList();
                    <div class="rg-bloque rg-lista">
                        <div class="rg-bloque-tit"><span>@ElementosRiesgo.Nombre(t)</span><span class="rg-cuenta">@items.Count</span></div>
                        @if (items.Count == 0)
                        {
                            <div class="small text-muted">—</div>
                        }
                        else
                        {
                            <ul class="rg-items">
                                @foreach (var e in items) { <li>@e.Texto</li> }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="rg-col">
            <div class="rg-bloque">
                <div class="rg-bloque-tit"><span>Análisis cualitativo</span></div>
                @MatrizCalor(riesgo.Probabilidad, riesgo.Impacto)
                <div class="small text-muted mt-1">
                    Probabilidad: <strong>@EscalaRiesgo.Nombre(riesgo.Probabilidad)</strong> ·
                    Impacto: <strong>@EscalaRiesgo.Nombre(riesgo.Impacto)</strong>
                </div>
            </div>

            <div class="rg-bloque">
                <div class="rg-bloque-tit">
                    <span>Alcance</span>
                    <button type="button" class="ens-mini ms-auto" title="Asociar torre, pata o localización" @onclick="() => mostrarAlcance = !mostrarAlcance"><Ico Nombre="agregar" /></button>
                </div>
                @if (alcances.Count == 0)
                {
                    <div class="small text-muted">Aplica a todo el proyecto.</div>
                }
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var a in alcances)
                    {
                        <span class="rg-chip">@TextoAlcance(a)
                            <button type="button" class="rg-chip-x" title="Quitar" @onclick="() => QuitarAlcance(a)">✕</button>
                        </span>
                    }
                </div>
                @if (mostrarAlcance)
                {
                    <div class="border rounded p-2 mt-2 small d-flex flex-column gap-1">
                        <select class="form-select form-select-sm" @bind="tipoAlcance">
                            <option value="torre">Torre</option>
                            <option value="componente">Pata o elemento de una torre</option>
                            <option value="localizacion">Localización (catálogo)</option>
                            <option value="tiro">Tiro</option>
                        </select>
                        @if (tipoAlcance == "torre")
                        {
                            <select class="form-select form-select-sm" @bind="idAlcance">
                                <option value="0">— elegir torre —</option>
                                @foreach (var t in torres) { <option value="@t.Id">@t.Codigo</option> }
                            </select>
                        }
                        else if (tipoAlcance == "componente")
                        {
                            <select class="form-select form-select-sm" @bind="torreDeComponente" @bind:after="CargarComponentes">
                                <option value="0">— elegir torre —</option>
                                @foreach (var t in torres) { <option value="@t.Id">@t.Codigo</option> }
                            </select>
                            <select class="form-select form-select-sm" @bind="idAlcance">
                                <option value="0">— elegir elemento —</option>
                                @foreach (var c in componentes) { <option value="@c.Id">@c.Nombre</option> }
                            </select>
                        }
                        else if (tipoAlcance == "localizacion")
                        {
                            <select class="form-select form-select-sm" @bind="idAlcance">
                                <option value="0">— elegir localización —</option>
                                @foreach (var l in localizaciones) { <option value="@l.Id">@l.Nombre</option> }
                            </select>
                        }
                        else
                        {
                            <select class="form-select form-select-sm" @bind="idAlcance">
                                <option value="0">— elegir tiro —</option>
                                @foreach (var t in tiros) { <option value="@t.Id">@t.Nombre</option> }
                            </select>
                        }
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-primary" title="Agregar" disabled="@(idAlcance == 0)" @onclick="AgregarAlcance"><Ico Nombre="agregar" /></button>
                            <button class="btn btn-sm btn-secondary" title="Cancelar" @onclick="() => mostrarAlcance = false"><Ico Nombre="cancelar" /></button>
                        </div>
                    </div>
                }
            </div>

            <div class="rg-bloque">
                <div class="rg-bloque-tit">
                    <span>Planes de acción</span><span class="rg-cuenta">@planesRiesgo.Count</span>
                    <button type="button" class="ens-mini ms-auto" title="Nuevo plan de acción" @onclick="() => IrNuevoPlan(riesgo.Id, null)"><Ico Nombre="agregar" /></button>
                </div>
                @if (planesRiesgo.Count == 0)
                {
                    <div class="small text-muted">—</div>
                }
                <div class="d-flex flex-column gap-1">
                    @foreach (var p in planesRiesgo)
                    {
                        var ep = EscalaAccion.EstadoPlan(accionesPlanes.Where(a => a.PlanAccionId == p.Id));
                        <button type="button" class="rg-plan-res" title="Abrir plan" @onclick="() => IrPlan(p.Id)">
                            <strong>@p.Codigo</strong>
                            <span class="rg-plan-res-txt">@p.DescripcionHallazgo</span>
                            <EstadoAccion Estado="ep" />
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="rg-bloque mt-2">
        <div class="rg-bloque-tit"><span>Acciones de los planes (@accionesPlanes.Count)</span></div>
        <div class="tabla-scroll"><table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin tabla-acciones">
            <thead>
                <tr>
                    <th style="width:90px;">Plan</th>
                    <th style="width:150px;">Tipo de hallazgo</th>
                    <th style="width:140px;">Tipo de acción</th>
                    <th>Acción</th>
                    <th style="width:160px;">Producto</th>
                    <th style="width:170px;">Responsable</th>
                    <th style="width:95px;">Fecha</th>
                    <th style="width:110px;">Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in planesRiesgo)
                {
                    var acs = accionesPlanes.Where(a => a.PlanAccionId == p.Id).OrderBy(a => a.Orden).ToList();
                    @if (acs.Count == 0)
                    {
                        <tr role="button" title="Abrir plan" @onclick="() => IrPlan(p.Id)">
                            <td class="fw-bold">@p.Codigo</td>
                            <td class="small">@p.TipoHallazgo</td>
                            <td></td>
                            <td class="text-muted small"><em>Sin acciones.</em></td>
                            <td></td><td></td><td></td>
                            <td><EstadoAccion Estado="EstadoAccionPlan.Abierta" /></td>
                        </tr>
                    }
                    @foreach (var a in acs)
                    {
                        <tr role="button" title="Abrir plan" @onclick="() => IrPlan(p.Id)">
                            <td class="fw-bold">@p.Codigo</td>
                            <td class="small">@p.TipoHallazgo</td>
                            <td class="small">@EscalaAccion.Nombre(a.Tipo)</td>
                            <td class="rg-multi">@a.Descripcion</td>
                            <td class="small rg-multi">@a.Producto</td>
                            <td class="small rg-multi">@a.Responsable</td>
                            <td class="small">@a.Fecha.ToString("dd/MM/yyyy")</td>
                            <td><EstadoAccion Estado="a.Estado" /></td>
                        </tr>
                    }
                }
                @if (planesRiesgo.Count == 0)
                {
                    <tr><td colspan="8" class="text-muted small text-center py-2"><em>Sin planes de acción.</em></td></tr>
                }
            </tbody>
        </table></div>
    </div>

    <div class="rg-bloque mt-2">
        <div class="rg-bloque-tit"><span>Seguimientos (@seguimientos.Count)</span></div>
        <div class="tabla-scroll"><table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin tabla-seguimientos">
            <thead>
                <tr>
                    <th style="width:100px;">Fecha</th>
                    <th style="width:130px;">Resultado</th>
                    <th style="width:180px;">Responsables</th>
                    <th>Observación</th>
                    <th style="width:220px;">Hallazgos</th>
                    <th style="width:200px;">Soportes</th>
                    <th style="width:110px;">Planes</th>
                    <th style="width:100px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in seguimientos)
                {
                    var hs = hallazgos.Where(h => h.SeguimientoRiesgoId == s.Id).ToList();
                    <tr>
                        <td class="fw-bold">@s.Fecha.ToString("dd/MM/yyyy")</td>
                        <td><ValorCatalogo Tipo="@SembradorCatalogosRiesgo.ResultadoSeguimiento" Valor="@NombreResultado(s.Resultado)" FondoDef="@ColorResultado(s.Resultado)" TextoDef="#fff" /></td>
                        <td class="small rg-multi">@s.Responsable</td>
                        <td class="rg-multi">@s.Observacion</td>
                        <td>
                            @if (hs.Count == 0)
                            {
                                <span class="text-muted small">—</span>
                            }
                            @foreach (var h in hs)
                            {
                                <div class="small">
                                    @foreach (var t in TextosHallazgo(h)) { <span class="rg-chip me-1">@t</span> }
                                    @h.Descripcion
                                </div>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var x in soportes.Where(x => x.SeguimientoRiesgoId == s.Id))
                                {
                                    <a class="rg-chip" href="@x.RutaArchivo" target="_blank" rel="noopener" title="@x.NombreOriginal">
                                        @if (SigWeb.Data.Planes.AlmacenAnexos.EsImagen(x.RutaArchivo)) { <img src="@x.RutaArchivo" alt="" class="rg-mini" /> }
                                        else { <Ico Nombre="adjuntar" /> }
                                        <span class="pa-accion-txt" style="max-width:120px">@x.NombreOriginal</span>
                                    </a>
                                }
                            </div>
                        </td>
                        <td>
                            @foreach (var p in planesRiesgo.Where(p => p.SeguimientoRiesgoId == s.Id))
                            {
                                <button type="button" class="rg-chip" title="Abrir plan" @onclick="() => IrPlan(p.Id)">@p.Codigo</button>
