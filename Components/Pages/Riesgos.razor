    private IEnumerable<CampoTabla> Columnas => motor?.Visibles ?? Enumerable.Empty<CampoTabla>();

    private IEnumerable<Riesgo> Mostrados
    {
        get
        {
            IEnumerable<Riesgo> q = riesgos;
            var f = filtro.Trim();
            if (f.Length > 0)
                q = q.Where(r => (r.Codigo + " " + r.Descripcion + " " + r.Area + " " + r.Categoria + " " + r.Causa + " " + r.Consecuencia)
                        .Contains(f, StringComparison.OrdinalIgnoreCase)
                    || (motor is not null && motor.TextoBusqueda(r.Id).Contains(f, StringComparison.OrdinalIgnoreCase)));
            if (filtroNivel.Length > 0) q = q.Where(r => EscalaRiesgo.Nombre(r.Nivel) == filtroNivel);
            if (motor is not null) q = motor.Ordenar(q, r => r.Id, col, asc);
            return q.ToList();
        }
    }

    private void Ordenar(string clave) { if (col == clave) asc = !asc; else { col = clave; asc = true; } }

