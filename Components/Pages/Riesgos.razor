                    }
                </div>
            </div>

            <div class="rm-lista">
                <div class="rm-lista-cab">
                    @if (celdaR is (ProbabilidadRiesgo sp, ImpactoRiesgo si))
                    {
                        var nv = EscalaRiesgo.Nivel(sp, si);
                        <span class="rg-pill" style="background:@EscalaRiesgo.Color(nv);color:@EscalaRiesgo.ColorTexto(nv)">@EscalaRiesgo.Nombre(nv)</span>
                        <span class="rm-lista-tit">@EscalaRiesgo.Nombre(sp) × @EscalaRiesgo.Nombre(si)</span>
                        <button type="button" class="gf-x" title="Ver todos" @onclick="() => celdaR = null">✕</button>
                    }
                    else
                    {
                        <span class="rm-lista-tit">Todos los riesgos</span>
                    }
                    <select class="form-select form-select-sm rm-orden" title="Ordenar" @bind="ordenMapa">
                        <option value="severidad">Severidad</option>
                        <option value="numero">N.º de riesgo</option>
                    </select>
                    <span class="rm-lista-n">@enLista.Count</span>
                </div>
                <div class="rm-lista-cuerpo">
                    @foreach (var rr in enLista)
                    {
                        var r = rr;
                        <div class="rm-tarjeta" style="--rm:@EscalaRiesgo.Color(r.Nivel);" @onclick="() => AbrirRiesgo(r)">
                            <div class="rm-tarjeta-cab">
                                <span class="pv-cod">@r.Codigo</span>
                                <span class="rg-pill" style="background:@EscalaRiesgo.Color(r.Nivel);color:@EscalaRiesgo.ColorTexto(r.Nivel)">@EscalaRiesgo.Nombre(r.Nivel)</span>
                                @if (r.Tipo == TipoRiesgo.Oportunidad) { <span class="ind-chip">Oportunidad</span> }
                                <span class="rm-acciones" @onclick:stopPropagation="true">
                                    <button type="button" class="ens-mini" title="Nuevo seguimiento" @onclick="() => NuevoSeguimiento(r)"><Ico Nombre="seguimiento" /></button>
                                    <button type="button" class="ens-mini" title="Editar" @onclick="() => EditarRiesgo(r)"><Ico Nombre="editar" /></button>
                                </span>
                            </div>
                            <div class="rm-tarjeta-desc">@r.Descripcion</div>
                            <div class="rm-tarjeta-pie">
                                @if (!string.IsNullOrWhiteSpace(r.Categoria)) { <ValorCatalogo Tipo="@SembradorCatalogosRiesgo.Categoria" Valor="@r.Categoria" /> }
                                @if (!string.IsNullOrWhiteSpace(r.Area)) { <ValorCatalogo Tipo="@SembradorCatalogosRiesgo.Area" Valor="@r.Area" /> }
                                @if (!string.IsNullOrWhiteSpace(r.EstadoActual)) { <ValorCatalogo Tipo="@SembradorCatalogosRiesgo.EstadoActual" Valor="@r.EstadoActual" /> }
                                @foreach (var pl in PlanesDe(r)) { <span class="d-inline-flex gap-1 align-items-center small"><strong>@pl.Codigo</strong><EstadoAccion Estado="pl.Estado" /></span> }
                                @if (ultimoSeguimiento.TryGetValue(r.Id, out var us)) { <span class="rm-seg" title="Último seguimiento">⟳ @us.ToString("dd/MM/yyyy")</span> }
                            </div>
