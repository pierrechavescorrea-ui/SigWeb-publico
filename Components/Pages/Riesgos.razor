                                <button type="button" class="rm-celda rm-n@((int)nivel) @(lista.Count == 0 ? "rm-vacia" : "") @(celdaR == (p, i) ? "sel" : "")"
                                        style="--rm:@EscalaRiesgo.Color(nivel);" title="@($"{EscalaRiesgo.Nombre(p)} × {EscalaRiesgo.Nombre(i)} · {EscalaRiesgo.Nombre(nivel)}: {lista.Count}")"
                                        @onclick="() => ElegirCelda(p, i)">
                                    <span class="rm-cuenta">@(lista.Count == 0 ? "" : lista.Count.ToString())</span>
                                    <span class="rm-codigos">
                                        @foreach (var r in lista.Take(4)) { <span>@r.Codigo</span> }
                                        @if (lista.Count > 4) { <span>+@(lista.Count - 4)</span> }
                                    </span>
                                </button>
                            }
                        }
                        <div></div>
                        @foreach (var im in ImpactosMapa)
                        {
                            <div class="rm-etq-x">@EscalaRiesgo.Nombre(im)</div>
                        }
                    </div>
                    <div class="rm-eje-x">Impacto</div>
                </div>
                <div class="rm-niveles">
                    @foreach (var n in new[] { NivelRiesgo.Extremo, NivelRiesgo.Alto, NivelRiesgo.Moderado, NivelRiesgo.Bajo })
                    {
                        var cuenta = todos.Count(r => r.Nivel == n);
