    // ---------- Detalle ----------
    private void AbrirRiesgo(Riesgo r)
    {
        vista = "detalle";
        CargarDetalle(r.Id);
    }

    private void CargarDetalle(int riesgoId)
    {
        riesgo = Db.Riesgos.AsNoTracking().FirstOrDefault(r => r.Id == riesgoId);
        if (riesgo is null) { vista = "matriz"; return; }
        seguimientos = Db.SeguimientosRiesgo.AsNoTracking().Where(s => s.RiesgoId == riesgoId)
            .OrderByDescending(s => s.Fecha).ThenByDescending(s => s.Id).ToList();
        var idsSeg = seguimientos.Select(s => s.Id).ToList();
        hallazgos = Db.HallazgosRiesgo.AsNoTracking().Where(h => idsSeg.Contains(h.SeguimientoRiesgoId)).ToList();
        var idsHall = hallazgos.Select(h => h.Id).ToList();
        lugaresHallazgos = Db.LugaresHallazgo.AsNoTracking().Where(l => idsHall.Contains(l.HallazgoRiesgoId)).ToList();
        soportes = Db.ArchivosRiesgo.AsNoTracking().Where(x => x.SeguimientoRiesgoId != null && idsSeg.Contains(x.SeguimientoRiesgoId.Value)).OrderBy(x => x.Id).ToList();
        alcances = Db.AlcancesRiesgo.AsNoTracking().Where(a => a.RiesgoId == riesgoId).ToList();
        historial = Servicio.Historial(riesgo.Codigo);
        elementos = Db.ElementosRiesgo.AsNoTracking().Where(e => e.RiesgoId == riesgoId).ToList();
        // Trazabilidad entre revisiones: los planes de este riesgo en cualquier versión.
        var idsHist = historial.Select(h => h.Id).Append(riesgoId).ToList();
        var idsPorRel = Db.RiesgosPlan.AsNoTracking().Where(r => idsHist.Contains(r.RiesgoId)).Select(r => r.PlanAccionId).ToList();
        planesRiesgo = Db.PlanesAccion.AsNoTracking().Where(p => (p.RiesgoId != null && idsHist.Contains(p.RiesgoId.Value)) || idsPorRel.Contains(p.Id))
            .OrderByDescending(p => p.Fecha).ThenByDescending(p => p.Id).ToList();
        var idsPlan = planesRiesgo.Select(p => p.Id).ToList();
        accionesPlanes = Db.AccionesPlan.AsNoTracking().Where(a => idsPlan.Contains(a.PlanAccionId)).ToList();
        mostrarAlcance = false;
    }

    private string TextoAlcance(AlcanceRiesgo a)
    {
        if (a.ElementoTrazadoId is int t) return torres.FirstOrDefault(x => x.Id == t)?.Codigo ?? $"Torre {t}";
        if (a.ComponenteId is int c) return NombreComponente(c);
        if (a.ItemCatalogoId is int l) return localizaciones.FirstOrDefault(x => x.Id == l)?.Nombre ?? $"Localización {l}";
        if (a.TiroId is int ti) return tiros.FirstOrDefault(x => x.Id == ti)?.Nombre ?? $"Tiro {ti}";
        return "—";
    }

    private IEnumerable<string> TextosHallazgo(HallazgoRiesgo h)
    {
        var ls = lugaresHallazgos.Where(l => l.HallazgoRiesgoId == h.Id).ToList();
        if (ls.Count == 0) return new[] { TextoHallazgo(h) };
        return ls.Select(l => SelectorLugares.Texto(l is null ? new LugarPlan() : new LugarPlan { ElementoTrazadoId = l.ElementoTrazadoId, ComponenteId = l.ComponenteId, ItemCatalogoId = l.ItemCatalogoId, TiroId = l.TiroId },
            torres, componentesPorId, localizaciones, tiros));
    }

    private string TextoHallazgo(HallazgoRiesgo h)
    {
        if (h.ElementoTrazadoId is int t) return torres.FirstOrDefault(x => x.Id == t)?.Codigo ?? $"Torre {t}";
        if (h.ComponenteId is int c) return NombreComponente(c);
        if (h.ItemCatalogoId is int l) return localizaciones.FirstOrDefault(x => x.Id == l)?.Nombre ?? $"Localización {l}";
        if (h.TiroId is int ti) return tiros.FirstOrDefault(x => x.Id == ti)?.Nombre ?? $"Tiro {ti}";
        return "Proyecto";
    }

    private string NombreComponente(int id)
    {
        if (!componentesPorId.TryGetValue(id, out var c)) return $"Elemento {id}";
        var t = torres.FirstOrDefault(x => x.Id == c.ElementoTrazadoId);
        return t is null ? c.Nombre : $"{t.Codigo} · {c.Nombre}";
    }

    // ---------- Alcance ----------
    private bool mostrarAlcance;
    private string tipoAlcance = "torre";
    private int idAlcance, torreDeComponente;

    private void CargarComponentes()
    {
        componentes = torreDeComponente == 0 ? new()
            : componentesPorId.Values.Where(c => c.ElementoTrazadoId == torreDeComponente && !c.Eliminado)
                .OrderBy(c => c.Orden).ThenBy(c => c.Nombre).ToList();
        idAlcance = 0;
    }

    private async Task AgregarAlcance()
    {
        if (riesgo is null || idAlcance == 0) return;
        await _dbLock.WaitAsync();
        try
        {
            var a = new AlcanceRiesgo { RiesgoId = riesgo.Id };
            switch (tipoAlcance)
            {
                case "torre": a.ElementoTrazadoId = idAlcance; break;
                case "componente": a.ComponenteId = idAlcance; break;
                case "localizacion": a.ItemCatalogoId = idAlcance; break;
                default: a.TiroId = idAlcance; break;
            }
            Db.AlcancesRiesgo.Add(a);
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            idAlcance = 0; mostrarAlcance = false;
            CargarDetalle(riesgo.Id);
        }
        finally { _dbLock.Release(); }
    }

    private async Task QuitarAlcance(AlcanceRiesgo a)
    {
        await _dbLock.WaitAsync();
        try
        {
            var ent = await Db.AlcancesRiesgo.FirstOrDefaultAsync(x => x.Id == a.Id);
            if (ent is not null) { Db.AlcancesRiesgo.Remove(ent); await Db.SaveChangesAsync(); }
            Db.ChangeTracker.Clear();
            if (riesgo is not null) CargarDetalle(riesgo.Id);
        }
        finally { _dbLock.Release(); }
    }

    // ---------- Formulario de riesgo ----------
    private Riesgo? formRiesgo;
    private bool formRiesgoEsNuevo;

    private void NuevoRiesgo()
    {
        if (version is null) return;
        formRiesgo = new Riesgo
        {
            VersionMatrizRiesgosId = version.Id,
            Codigo = Servicio.SiguienteCodigo(version.Id),
            Orden = riesgos.Count == 0 ? 1 : riesgos.Max(r => r.Orden) + 1,
            EstadoActual = "Activo"
        };
        formItems = NuevosItems();
        formCargos = new();
        formRiesgoEsNuevo = true;
    }

    // Editor de las listas del riesgo (causas, consecuencias…): un texto por elemento.
    private class ItemTexto { public string Texto { get; set; } = ""; }
    private Dictionary<TipoElementoRiesgo, List<ItemTexto>> formItems = NuevosItems();
    private static Dictionary<TipoElementoRiesgo, List<ItemTexto>> NuevosItems() =>
        ElementosRiesgo.Tipos.ToDictionary(t => t, _ => new List<ItemTexto>());

    private void CargarItems(IEnumerable<ElementoRiesgo> els)
    {
        formItems = NuevosItems();
        foreach (var e in els.OrderBy(e => e.Orden)) formItems[e.Tipo].Add(new ItemTexto { Texto = e.Texto });
    }

    // Si se pega una lista numerada en un elemento, se separa sola y sin números.
    private void CambiarItem(TipoElementoRiesgo t, int k, string? valor)
    {
        var lista = formItems[t];
        if (k >= lista.Count) return;
        var partes = ElementosRiesgo.Partir(valor);
        if (partes.Count <= 1) { lista[k].Texto = partes.FirstOrDefault() ?? (valor ?? "").Trim(); return; }
        lista[k].Texto = partes[0];
        lista.InsertRange(k + 1, partes.Skip(1).Select(x => new ItemTexto { Texto = x }));
    }

    private void MoverItem(TipoElementoRiesgo t, int k, int d)
    {
        var lista = formItems[t];
        var j = k + d;
        if (j < 0 || j >= lista.Count) return;
        (lista[k], lista[j]) = (lista[j], lista[k]);
    }

    private List<ElementoRiesgo> ElementosDelFormulario(int riesgoId)
    {
        var res = new List<ElementoRiesgo>();
        foreach (var (t, lista) in formItems)
        {
            var o = 0;
            foreach (var it in lista.Where(x => !string.IsNullOrWhiteSpace(x.Texto)))
                res.Add(new ElementoRiesgo { RiesgoId = riesgoId, Tipo = t, Orden = ++o, Texto = it.Texto.Trim() });
        }
        return res;
    }

    private List<ElementoRiesgo> ElementosDe(int riesgoId) =>
        riesgo?.Id == riesgoId ? elementos
        : elementosVersion.TryGetValue(riesgoId, out var l) ? l
        : Db.ElementosRiesgo.AsNoTracking().Where(e => e.RiesgoId == riesgoId).ToList();

    private List<string> formCargos = new();

    private void EditarRiesgo(Riesgo r)
    {
        CargarItems(ElementosDe(r.Id));
        formCargos = CargosDe(r.ResponsablePlan);
        formRiesgo = new Riesgo
        {
            Id = r.Id, VersionMatrizRiesgosId = r.VersionMatrizRiesgosId, Codigo = r.Codigo, Orden = r.Orden,
            Tipo = r.Tipo, EstadoActual = r.EstadoActual, Categoria = r.Categoria, Area = r.Area,
            Causa = r.Causa, Descripcion = r.Descripcion, Consecuencia = r.Consecuencia,
            Probabilidad = r.Probabilidad, Impacto = r.Impacto, Disparadores = r.Disparadores,
            Estrategia = r.Estrategia, PlanRespuesta = r.PlanRespuesta, ResponsablePlan = r.ResponsablePlan,
            EstadoPlan = r.EstadoPlan, ComoSeHaceSeguimiento = r.ComoSeHaceSeguimiento, RiesgoAnteriorId = r.RiesgoAnteriorId
        };
        formRiesgoEsNuevo = false;
    }

