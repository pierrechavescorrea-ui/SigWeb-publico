                    }
                </div>
            </div>
        </div>
    };
    private Dictionary<string, List<ResumenPlan>> planesPorCodigo = new(StringComparer.OrdinalIgnoreCase);
    private List<ResumenPlan> PlanesDe(Riesgo r) => planesPorCodigo.TryGetValue(r.Codigo, out var l) ? l : new();

    private static List<string> CargosDe(string? texto) => SembradorCatalogosRiesgo.Cargos(texto);

    private async Task GuardarRiesgo()
    {
        if (formRiesgo is null) return;
        if (string.IsNullOrWhiteSpace(formRiesgo.Descripcion)) { mensaje = "El riesgo necesita una descripción."; error = true; return; }
        if (string.IsNullOrWhiteSpace(formRiesgo.Codigo)) { mensaje = "El riesgo necesita un código."; error = true; return; }
        var codigoNuevo = formRiesgo.Codigo.Trim();
        // El código debe ser único dentro de la misma versión (hay un índice único
        // en la base de datos); se valida antes para no reventar con una excepción
        // de SQL sin aviso. Con "R-22" y "R-22b" del importador, es fácil chocar
        // al editar el código a mano.
        if (riesgos.Any(r => r.Id != formRiesgo.Id && string.Equals(r.Codigo, codigoNuevo, StringComparison.OrdinalIgnoreCase)))
        { mensaje = $"Ya existe un riesgo con el código \"{codigoNuevo}\" en esta revisión."; error = true; return; }

        await _dbLock.WaitAsync();
        try
        {
            if (formRiesgoEsNuevo)
            {
                formRiesgo.Codigo = codigoNuevo;
                formRiesgo.ResponsablePlan = string.Join("\n", formCargos);
                Db.Riesgos.Add(formRiesgo);
            }
            else
            {
                var ent = await Db.Riesgos.FirstOrDefaultAsync(r => r.Id == formRiesgo.Id);
                if (ent is null) return;
                ent.Codigo = codigoNuevo; ent.Tipo = formRiesgo.Tipo;
                ent.EstadoActual = formRiesgo.EstadoActual?.Trim() ?? ""; ent.Categoria = formRiesgo.Categoria?.Trim() ?? "";
                ent.Area = formRiesgo.Area?.Trim() ?? ""; ent.Causa = formRiesgo.Causa ?? "";
                ent.Descripcion = formRiesgo.Descripcion.Trim(); ent.Consecuencia = formRiesgo.Consecuencia ?? "";
                ent.Probabilidad = formRiesgo.Probabilidad; ent.Impacto = formRiesgo.Impacto;
                ent.Disparadores = formRiesgo.Disparadores ?? ""; ent.Estrategia = formRiesgo.Estrategia?.Trim() ?? "";
                ent.PlanRespuesta = formRiesgo.PlanRespuesta ?? ""; ent.ResponsablePlan = string.Join("\n", formCargos);
                ent.EstadoPlan = formRiesgo.EstadoPlan?.Trim() ?? ""; ent.ComoSeHaceSeguimiento = formRiesgo.ComoSeHaceSeguimiento ?? "";
            }
            await Db.SaveChangesAsync();

            // Elementos: se reemplazan por los del formulario y el riesgo
            // guarda su copia de texto sin números.
            var id = formRiesgo.Id;
            var guardado = formRiesgoEsNuevo ? formRiesgo : await Db.Riesgos.FirstAsync(r => r.Id == id);
            Db.ElementosRiesgo.RemoveRange(await Db.ElementosRiesgo.Where(e => e.RiesgoId == id).ToListAsync());
            var nuevosEls = ElementosDelFormulario(id);
            Db.ElementosRiesgo.AddRange(nuevosEls);
            ElementosRiesgo.Sincronizar(guardado, nuevosEls);
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            formRiesgo = null;
            mensaje = "Riesgo guardado."; error = false;
            await CargarAsync();
            if (vista == "detalle" && id > 0) CargarDetalle(id);
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo guardar el riesgo: " +
                      (ex is Microsoft.EntityFrameworkCore.DbUpdateException dbEx && dbEx.InnerException?.Message.Contains("IX_Riesgos", StringComparison.OrdinalIgnoreCase) == true
                          ? $"ya existe un riesgo con el código \"{codigoNuevo}\" en esta revisión."
                          : "inténtalo de nuevo. (" + ex.Message + ")");
            error = true;
        }
        finally { _dbLock.Release(); }
    }

    // ---------- Seguimiento ----------
    private SeguimientoRiesgo? formSeguimiento;
    private bool formSeguimientoEsNuevo;
    private List<HallazgoRiesgo> formHallazgos = new();

    private void NuevoSeguimiento(Riesgo r)
    {
        if (vista != "detalle") AbrirRiesgo(r);
        formSeguimiento = new SeguimientoRiesgo { RiesgoId = r.Id, Fecha = DateTime.Today };
        formSegResp = new(); formSoportes = new(); soportesQuitados = new();
        lugaresForm = new(); planesBorrador = new();
        formHallazgos = new();
        formSeguimientoEsNuevo = true;
    }

    private List<string> formSegResp = new();
    private List<ArchivoRiesgo> formSoportes = new();
    private List<ArchivoRiesgo> soportesQuitados = new();
    private List<ArchivoRiesgo> soportes = new();

    private async Task SubirSoportes(InputFileChangeEventArgs e)
    {
        try
        {
            foreach (var f in e.GetMultipleFiles(30))
            {
                var (nombre, ruta) = await SigWeb.Data.Planes.AlmacenAnexos.GuardarAsync(f, Env.WebRootPath, "riesgos");
                formSoportes.Add(new ArchivoRiesgo { NombreOriginal = nombre, RutaArchivo = ruta });
            }
        }
        catch (Exception ex) { mensaje = "No se pudo adjuntar: " + ex.Message; error = true; }
    }

    private void EditarSeguimiento(SeguimientoRiesgo s)
    {
        formSegResp = SelectorMultiple.Leer(s.Responsable);
        formSoportes = soportes.Where(x => x.SeguimientoRiesgoId == s.Id).ToList();
        soportesQuitados = new();
        formSeguimiento = new SeguimientoRiesgo
        {
            Id = s.Id, RiesgoId = s.RiesgoId, Fecha = s.Fecha, Responsable = s.Responsable,
            Resultado = s.Resultado, Observacion = s.Observacion
        };
        formHallazgos = hallazgos.Where(h => h.SeguimientoRiesgoId == s.Id)
            .Select(h => new HallazgoRiesgo
            {
                Id = h.Id, SeguimientoRiesgoId = h.SeguimientoRiesgoId, ElementoTrazadoId = h.ElementoTrazadoId,
                ComponenteId = h.ComponenteId, ItemCatalogoId = h.ItemCatalogoId, TiroId = h.TiroId,
                Descripcion = h.Descripcion, Accion = h.Accion, Estado = h.Estado, FechaCierre = h.FechaCierre
            }).ToList();
        lugaresForm = formHallazgos.ToDictionary(h => h, h => lugaresHallazgos.Where(l => l.HallazgoRiesgoId == h.Id)
            .Select(l => new LugarPlan { ElementoTrazadoId = l.ElementoTrazadoId, ComponenteId = l.ComponenteId, ItemCatalogoId = l.ItemCatalogoId, TiroId = l.TiroId }).ToList());
        planesBorrador = new();
        formSeguimientoEsNuevo = false;
    }

