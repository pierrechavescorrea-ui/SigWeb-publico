    // ---------- Torre por torre: editar los valores de una actividad y su documentación ----------
    private int? actEdit;
    private int? torreEdit;
    private string mensajeAct = "";
    private bool guardandoAct;

    private sealed class FilaAct
    {
        public Ent E;
        public string Etiqueta = "";
        public ParametroActividad P = null!;
        public bool Aplica;
        public int? Estado;
        public DateTime? Fecha, Facturado;
        public string? Obs;
    }
    private List<FilaAct> filasAct = new();

    private void EditarActividad(ItemCatalogo f, Actividad a)
    {
        if (actEdit == a.Id) { actEdit = null; return; }
        actEdit = a.Id; torreEdit = f.Id; mensajeAct = "";
        ArmarFilasAct(f, a);
    }

    private void ArmarFilasAct(ItemCatalogo f, Actividad a)
    {
        filasAct = new();
        foreach (var (e, etq) in EntidadesTorre(f, a))
            foreach (var p in ParametrosDe(a.Id))
            {
                var fila = new FilaAct { E = e, Etiqueta = etq, P = p };
                if (e.T == 'T' && registrosTiro.TryGetValue((e.Id, p.Id), out var rt))
                { fila.Aplica = rt.Completado; fila.Estado = rt.EstadoParametroId; fila.Fecha = rt.Fecha; fila.Facturado = rt.FechaFacturado; fila.Obs = rt.Observaciones; }
                else if (e.T == 'C' && registros.TryGetValue((e.Id, p.Id), out var r))
                { fila.Aplica = r.Completado; fila.Estado = r.EstadoParametroId; fila.Fecha = r.Fecha; fila.Facturado = r.FechaFacturado; fila.Obs = r.Observaciones; }
                filasAct.Add(fila);
            }
    }

    private async Task GuardarActividad(Actividad a)
    {
        guardandoAct = true; mensajeAct = "";
        try
        {
            foreach (var x in filasAct)
            {
                var vacio = !x.Aplica && x.Fecha is null && x.Facturado is null && string.IsNullOrWhiteSpace(x.Obs);
                var obs = string.IsNullOrWhiteSpace(x.Obs) ? null : x.Obs.Trim();
                if (x.E.T == 'T')
                {
                    var rt = await Db.RegistrosParametroTiro.FirstOrDefaultAsync(r => r.TiroId == x.E.Id && r.ParametroActividadId == x.P.Id);
                    if (rt is null) { if (vacio) continue; rt = new RegistroParametroTiro { TiroId = x.E.Id, ParametroActividadId = x.P.Id }; Db.RegistrosParametroTiro.Add(rt); }
                    rt.Completado = x.Aplica; rt.EstadoParametroId = x.Aplica ? x.Estado : null; rt.Fecha = x.Fecha; rt.FechaFacturado = x.Facturado; rt.Observaciones = obs;
                }
                else
                {
                    var r = await Db.RegistrosParametro.FirstOrDefaultAsync(r => r.ComponenteId == x.E.Id && r.ParametroActividadId == x.P.Id);
                    if (r is null) { if (vacio) continue; r = new RegistroParametro { ComponenteId = x.E.Id, ParametroActividadId = x.P.Id }; Db.RegistrosParametro.Add(r); }
                    r.Completado = x.Aplica; r.EstadoParametroId = x.Aplica ? x.Estado : null; r.Fecha = x.Fecha; r.FechaFacturado = x.Facturado; r.Observaciones = obs;
                }
            }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            CargarSync();
            if (filas.FirstOrDefault(t => t.Id == torreEdit) is { } f) ArmarFilasAct(f, a);
            mensajeAct = "Guardado ✓";
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeAct = "No se pudo guardar: " + ex.Message; }
        finally { guardandoAct = false; }
    }

    // Documentación de un parámetro de torre/pata: se guarda de una vez (crea el registro si no existe).
    private async Task SubirAdjuntosAct(InputFileChangeEventArgs e, FilaAct x, Actividad a)
    {
        const long maxBytes = 10 * 1024 * 1024;
        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "trazado");
        Directory.CreateDirectory(carpeta);
        var fallos = new List<string>();
        try
        {
            var reg = await Db.RegistrosParametro.FirstOrDefaultAsync(r => r.ComponenteId == x.E.Id && r.ParametroActividadId == x.P.Id);
            if (reg is null)
            {
                reg = new RegistroParametro { ComponenteId = x.E.Id, ParametroActividadId = x.P.Id, Completado = x.Aplica, EstadoParametroId = x.Aplica ? x.Estado : null, Fecha = x.Fecha, FechaFacturado = x.Facturado, Observaciones = x.Obs };
                Db.RegistrosParametro.Add(reg);
                await Db.SaveChangesAsync();
            }
            foreach (var archivo in e.GetMultipleFiles(10))
            {
                if (archivo.Size > maxBytes) { fallos.Add($"{archivo.Name} (supera 10 MB)"); continue; }
                var nombre = $"{Guid.NewGuid()}{Path.GetExtension(archivo.Name)}";
                await using (var stream = archivo.OpenReadStream(maxBytes))
                await using (var destino = File.Create(Path.Combine(carpeta, nombre)))
                    await stream.CopyToAsync(destino);
                Db.ArchivosRegistroParametro.Add(new ArchivoRegistroParametro { RegistroParametroId = reg.Id, NombreOriginal = archivo.Name, RutaArchivo = $"/uploads/trazado/{nombre}" });
            }
            await Db.SaveChangesAsync();
        }
        catch (Exception ex) { fallos.Add(ex.Message); }
        Db.ChangeTracker.Clear();
        // Conserva lo digitado en la tarjeta (aún sin guardar) al recargar.
        var digitado = filasAct.ToDictionary(y => (y.E, y.P.Id));
        CargarSync();
        if (filas.FirstOrDefault(t => t.Id == torreEdit) is { } f)
        {
            ArmarFilasAct(f, a);
            foreach (var y in filasAct)
                if (digitado.TryGetValue((y.E, y.P.Id), out var d)) { y.Aplica = d.Aplica; y.Estado = d.Estado; y.Fecha = d.Fecha; y.Facturado = d.Facturado; y.Obs = d.Obs; }
        }
        mensajeAct = fallos.Count > 0 ? "No se cargaron: " + string.Join("; ", fallos) : "";
    }

