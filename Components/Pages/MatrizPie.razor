    };

    private int? CompDe(ItemCatalogo f) =>
        f.ElementoTrazadoId is not null && ComponentePorElemento.TryGetValue(f.ElementoTrazadoId.Value, out var c) ? c : null;

    private void AlternarEdicion()
    {
        if (!editando) { vistaPie = "matriz"; verGraficos = false; editando = true; return; }
        if (Pendientes > 0) { confirmarDescartar = true; return; }
        editando = false;
    }

    private void Descartar()
    {
        foreach (var s in subidasPend) BorrarFisico(s.Arch.RutaArchivo);
        cambios.Clear(); subidasPend.Clear(); quitarPend.Clear();
        confirmarDescartar = false; editando = false;
    }

    private void BorrarFisico(string ruta)
    {
        try { var f = Path.Combine(Env.WebRootPath, ruta.TrimStart('/').Replace('/', Path.DirectorySeparatorChar)); if (File.Exists(f)) File.Delete(f); } catch { }
    }

    private async Task SubirAdjuntos(InputFileChangeEventArgs e, int comp, ParametroActividad p)
    {
        const long maxBytes = 10 * 1024 * 1024;
        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "trazado");
        Directory.CreateDirectory(carpeta);
        foreach (var archivo in e.GetMultipleFiles(10))
        {
            if (archivo.Size > maxBytes) continue;
            var nombre = $"{Guid.NewGuid()}{Path.GetExtension(archivo.Name)}";
            await using (var stream = archivo.OpenReadStream(maxBytes))
            await using (var destino = File.Create(Path.Combine(carpeta, nombre)))
                await stream.CopyToAsync(destino);
            subidasPend.Add((comp, p.Id, new ArchivoRegistroParametro { NombreOriginal = archivo.Name, RutaArchivo = $"/uploads/trazado/{nombre}" }));
        }
    }

    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;
    private bool BloqueadoPorImpacto => impacto is null || (impacto.RequiereEntender && !impactoOk);

    private async Task CalcularImpacto(Func<Task<SigWeb.Data.Impacto.InformeImpacto>> f)
    {
        impacto = null; impactoOk = false;
        try { impacto = await f(); } catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private void PedirQuitar(ArchivoRegistroParametro a)
    {
        adjuntoPorQuitar = a;
        if (a.Id == 0) impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = $"Adjunto \"{a.NombreOriginal}\" (aún sin guardar)" };
        else _ = CalcularImpacto(() => Analizador.AdjuntoRegistro(a.Id));
    }

    private async Task ConfirmarQuitar()
    {
        if (adjuntoPorQuitar is null) return;
        var a = adjuntoPorQuitar;
        if (a.Id == 0)
        {
            var i = subidasPend.FindIndex(x => ReferenceEquals(x.Arch, a));
            if (i >= 0) { BorrarFisico(a.RutaArchivo); subidasPend.RemoveAt(i); }
        }
        else if (editando) quitarPend.Add(a.Id);
        else
        {
            // Fuera del modo edición (tarjeta de actividad en "torre por torre"): a la Papelera de una vez.
            var ent = await Db.ArchivosRegistroParametro.FindAsync(a.Id);
            if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
            Db.ChangeTracker.Clear();
            CargarSync();
        }
        adjuntoPorQuitar = null;
    }

    private async Task GuardarTodo()
    {
        if (Pendientes == 0) return;
        // Estados
        foreach (var ((ent, paramId), valor) in cambios)
        {
            var aplica = valor != "na";
            int? estado = !aplica || valor == "0" ? null : int.Parse(valor);
            if (ent.T == 'T')
            {
                var rt = Db.RegistrosParametroTiro.FirstOrDefault(r => r.TiroId == ent.Id && r.ParametroActividadId == paramId);
                if (rt is null)
                {
                    if (!aplica) continue;
                    rt = new RegistroParametroTiro { TiroId = ent.Id, ParametroActividadId = paramId };
                    Db.RegistrosParametroTiro.Add(rt);
                }
                rt.Completado = aplica; rt.EstadoParametroId = estado;
            }
            else
            {
                var reg = Db.RegistrosParametro.FirstOrDefault(r => r.ComponenteId == ent.Id && r.ParametroActividadId == paramId);
                if (reg is null)
                {
                    if (!aplica) continue;
                    reg = new RegistroParametro { ComponenteId = ent.Id, ParametroActividadId = paramId };
                    Db.RegistrosParametro.Add(reg);
                }
                reg.Completado = aplica; reg.EstadoParametroId = estado;
            }
        }
        await Db.SaveChangesAsync();

        // Adjuntos nuevos (el registro se crea si no existía)
        foreach (var (comp, paramId, arch) in subidasPend)
        {
            var reg = Db.RegistrosParametro.FirstOrDefault(r => r.ComponenteId == comp && r.ParametroActividadId == paramId);
            if (reg is null)
            {
                reg = new RegistroParametro { ComponenteId = comp, ParametroActividadId = paramId };
                Db.RegistrosParametro.Add(reg);
                await Db.SaveChangesAsync();
            }
            Db.ArchivosRegistroParametro.Add(new ArchivoRegistroParametro { RegistroParametroId = reg.Id, NombreOriginal = arch.NombreOriginal, RutaArchivo = arch.RutaArchivo });
        }
        // Adjuntos quitados → Papelera
        foreach (var id in quitarPend)
        {
            var ent = await Db.ArchivosRegistroParametro.FindAsync(id);
            if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; }
        }
        await Db.SaveChangesAsync();
        cambios.Clear(); subidasPend.Clear(); quitarPend.Clear();
        editando = false;
        CargarSync();
    }

    // Estado elegido en el select: queda pendiente hasta guardar.
    private void CambiarCelda(Ent e, ParametroActividad p, string valor)
    {
        var original = Valor(Guardado(e, p.Id));
        if (valor == original) cambios.Remove((e, p.Id)); else cambios[(e, p.Id)] = valor;
    }

    // ---------- Estados ----------
    private async Task AgregarEstado()
    {
        Db.EstadosParametro.Add(new EstadoParametro { Nombre = "Nuevo estado", Orden = estados.Count + 1 });
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        CargarSync();
    }

    private async Task CambiarEstado(EstadoParametro e, string campo, string? valor)
    {
        var db = Db.EstadosParametro.First(x => x.Id == e.Id);
        if (campo == "nombre" && !string.IsNullOrWhiteSpace(valor)) db.Nombre = valor.Trim();
        if (campo == "color" && !string.IsNullOrWhiteSpace(valor)) db.Color = valor;
        if (campo == "pct" && decimal.TryParse(valor, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n))
            db.Porcentaje = Math.Clamp(n, 0, 100);
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        CargarSync();
    }

    private async Task EliminarEstado(EstadoParametro e)
    {
        var db = Db.EstadosParametro.First(x => x.Id == e.Id);
        Db.EstadosParametro.Remove(db);
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        CargarSync();
    }

    // Desde los gráficos, «volver» regresa a la matriz; en la matriz, a la página anterior.
    private EventCallback AtrasMatriz => verGraficos ? EventCallback.Factory.Create(this, () => { verGraficos = false; }) : default;
}
