                    </div>

                    <div class="ind-kpis">
                        <div class="ind-kpi pv-kpi-anillo">
                            <span class="pv-anillo" style="--pct:@Pct0(pt ?? 0);"><span>@FormatoPct(pt)</span></span>
                            <span class="pv-anillo-txt"><span class="ind-kpi-tit">Cumplimiento</span><span class="ind-kpi-sub">PIE de la torre</span></span>
                        </div>
                        <div class="ind-kpi">
                            <span class="ind-kpi-tit">Registros que aplican</span>
                            <span class="ind-kpi-val">@celdas.Count(x => x != null)<small> / @celdas.Count</small></span>
                            <span class="ind-kpi-sub">@celdas.Count(x => x == null) N/A</span>
