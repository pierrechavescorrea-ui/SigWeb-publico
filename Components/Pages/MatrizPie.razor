                {
                    var x = fx;
                    <div class="pm-editor-fila @(varias ? "con-elem" : "") @(x.Aplica ? "" : "pm-editor-na")">
                        @if (varias) { <span class="pm-editor-elem">@x.Etiqueta</span> }
                        <span class="pm-editor-param" title="@x.P.Nombre">@(string.IsNullOrEmpty(x.P.Codigo) ? "" : x.P.Codigo + " — ")@x.P.Nombre</span>
                        <span><input type="checkbox" class="form-check-input" checked="@x.Aplica" @onchange="@(e => { x.Aplica = e.Value is true; if (!x.Aplica) x.Estado = null; })" /></span>
                        <span>
                            <select class="form-select form-select-sm" disabled="@(!x.Aplica)" value="@(x.Estado?.ToString() ?? "")" @onchange="@(e => x.Estado = int.TryParse(e.Value?.ToString(), out var v) ? v : null)">
                                <option value="">Sin estado</option>
                                @foreach (var es in estados)
                                {
                                    <option value="@es.Id">@es.Nombre</option>
                                }
                            </select>
                        </span>
                        <span><input type="date" class="form-control form-control-sm" @bind="x.Fecha" /></span>
                        <span><input type="date" class="form-control form-control-sm" @bind="x.Facturado" /></span>
                        <span><input class="form-control form-control-sm" @bind="x.Obs" /></span>
                        <span class="pm-editor-docs">
                            @if (x.E.T == 'C')
                            {
                                @foreach (var ad in AdjuntosDe(x.E.Id, x.P.Id))
                                {
                                    var adj = ad;
                                    <span class="pm-doc">
                                        <a href="@adj.RutaArchivo" target="_blank" rel="noopener" title="@adj.NombreOriginal">@adj.NombreOriginal</a>
                                        <button type="button" class="gf-x" title="Quitar (va a la Papelera)" @onclick="() => PedirQuitar(adj)">✕</button>
                                    </span>
                                }
                                <label class="ens-mini mb-0" title="Cargar documentación"><Ico Nombre="adjuntar" /><InputFile class="d-none" multiple accept=".pdf,image/*" OnChange="@(ev => SubirAdjuntosAct(ev, x, a))" /></label>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </span>
                    </div>
                }
            </div>
            <div class="pm-editor-pie">
                <span class="small @(mensajeAct.StartsWith("No") ? "text-danger" : "text-success")">@mensajeAct</span>
                <button type="button" class="btn btn-sm btn-secondary" title="Cerrar sin guardar" @onclick="() => actEdit = null"><Ico Nombre="cancelar" /></button>
                <button type="button" class="btn btn-sm btn-primary" title="Guardar" disabled="@guardandoAct" @onclick="() => GuardarActividad(a)"><Ico Nombre="guardar" /></button>
            </div>
        </div>
    };

    // Torres de los filtros (una vez cada una, en el orden de la matriz).
    private List<ItemCatalogo> TorresMostradas() => FilasMostradas.Select(r => r.Torre).DistinctBy(t => t.Id).ToList();

    // Entidades (torre, patas o tiro) de una torre para una actividad, con su nombre.
    private List<(Ent E, string Etiqueta)> EntidadesTorre(ItemCatalogo f, Actividad a)
    {
        var r = new List<(Ent, string)>();
        switch (a.Ambito)
        {
            case AmbitoActividad.Torre:
                if (CompDe(f) is int c) r.Add((new Ent('C', c), f.Nombre));
                break;
            case AmbitoActividad.Pata:
                if (f.ElementoTrazadoId is int el && patasPorElemento.TryGetValue(el, out var ps))
                    foreach (var pa in ps.Where(pa => Aplica(pa.Id, a.Id))) r.Add((new Ent('C', pa.Id), pa.Nombre));
                break;
            default:
                if (TiroDe(f) is { } t) r.Add((new Ent('T', t.Id), t.Nombre));
                break;
        }
        return r;
    }

    private decimal? PctTorreAct(ItemCatalogo f, Actividad a) =>
        PromedioDe(EntidadesTorre(f, a).SelectMany(x => ParamsVis(a).Select(p => PctCelda(x.E, p.Id))));

    // Color del mapa: rojo (0 %) → ámbar → verde (100 %); sin dato = sin color.
    private static string EstiloPct(decimal? v)
    {
        if (v is not decimal x) return "";
        var h = (int)Math.Round(Math.Clamp(x, 0, 100) * 1.2m);
        return $"background:hsl({h} 62% 46%);color:#fff;";
    }

    private static string Pct0(decimal? v) => v is decimal x ? x.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "";

    private RenderFragment VistaMapa() => __builder =>
    {
        var torres = TorresMostradas();
        var acts = actividades.Where(a => ParamsVis(a).Count > 0).ToList();
        <div class="pm-mapa-marco">
            <table class="pm-mapa">
                <thead>
                    <tr>
                        <th class="pm-esq">Torre</th>
                        <th class="pm-tot-th" title="Cumplimiento de la torre">%</th>
                        @foreach (var a in acts)
                        {
                            <th class="pm-act" title="@($"{a.Nombre} · {NombreAmbito(a.Ambito)}")"><span class="pm-act-txt"><img src="@RutaIconoActividad(a)" alt="" width="13" height="13" />@a.Nombre</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in torres)
                    {
                        var f = t;
                        var pt = PctTorre(f);
                        <tr>
                            <th class="pm-torre" @onclick="() => EnfocarTorre(f)" title="Ver torre">
                                <span class="pm-torre-nom">@f.Nombre</span>
                                @if (TiroDe(f) is { } ti) { <span class="pm-torre-tiro">@ti.Nombre</span> }
                            </th>
                            <td class="pm-tot" title="@DetalleTorre(f)">
                                <span class="pm-tot-barra"><span style="width:@Pct0(pt ?? 0)%;@EstiloPct(pt)"></span></span>
                                <span class="pm-tot-num">@FormatoPct(pt)</span>
                            </td>
                            @foreach (var ac in acts)
                            {
                                var a = ac;
                                var v = PctTorreAct(f, a);
                                <td class="pm-cel @(v is null ? "pm-sin" : "")" style="@EstiloPct(v)" title="@($"{f.Nombre} · {a.Nombre}: {FormatoPct(v)}")" @onclick="() => EnfocarTorre(f)">@Pct0(v)</td>
                            }
                        </tr>
                    }
                    @if (torres.Count == 0)
                    {
                        <tr><td colspan="@(acts.Count + 2)" class="text-muted small text-center py-3">Sin torres.</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th class="pm-esq">PIE</th>
                        <td class="pm-tot"><span class="pm-tot-num fw-bold">@FormatoPct(TotalGeneral())</span></td>
                        @foreach (var a in acts)
                        {
                            var v = PctGrupo(a);
                            <td class="pm-cel pm-pie @(v is null ? "pm-sin" : "")" style="@EstiloPct(v)" title="@($"{a.Nombre}: {FormatoPct(v)}")">@Pct0(v)</td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="pm-escala"><span>0 %</span><span class="pm-escala-barra"></span><span>100 %</span><span class="pm-escala-sin"></span><span>No aplica</span></div>
    };

    private RenderFragment VistaTorre() => __builder =>
    {
        var torres = TorresMostradas();
        var foco = torres.FirstOrDefault(t => t.Id == torreFoco) ?? torres.FirstOrDefault();
        <div class="ind-foco">
            <nav class="ind-rail">
                @foreach (var t in torres)
                {
                    var f = t;
                    var pt = PctTorre(f);
                    <button type="button" class="ind-rail-item @(foco?.Id == f.Id ? "activo" : "")" @onclick="() => { torreFoco = f.Id; actEdit = null; }">
                        <span class="pv-rail-cab">
                            <span class="pv-cod">@f.Nombre</span>
                            @if (TiroDe(f) is { } ti) { <span class="pv-fecha">@ti.Nombre</span> }
                            <span class="pm-rail-pct" style="@EstiloPct(pt)">@FormatoPct(pt)</span>
                        </span>
                        <span class="pv-avance"><span style="width:@Pct0(pt ?? 0)%;@EstiloPct(pt)"></span></span>
                    </button>
                }
                @if (torres.Count == 0)
                {
                    <span class="text-muted small p-2">Sin torres.</span>
                }
            </nav>
            @if (foco is not null)
            {
                var f = foco;
                var pos = torres.FindIndex(x => x.Id == f.Id);
                var celdas = CeldasTorre(f).ToList();
                var pt = PctTorre(f);
                var acts = actividades.Where(a => ParamsVis(a).Count > 0).ToList();
                var completas = acts.Count(a => PctTorreAct(f, a) is decimal x && x >= 100);
                <section class="ind-det">
                    <div class="ind-det-cab">
                        <button type="button" class="ind-nav" title="Anterior" disabled="@(pos <= 0)" @onclick="() => { torreFoco = torres[pos - 1].Id; actEdit = null; }">‹</button>
