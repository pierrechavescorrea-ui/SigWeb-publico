@page "/matriz-pie"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Models
@inject AppDbContext Db
@inject SigWeb.Data.Iconos.IconosApp IconosApp
@inject IWebHostEnvironment Env
@inject SigWeb.Data.Impacto.AnalizadorImpacto Analizador

<EncabezadoPagina Titulo="Matriz PIE" Icono="matriz" OnAtras="AtrasMatriz">
    <Acciones>
        <span class="pg-btn" title="Cumplimiento total del PIE" style="cursor:default;">@FormatoPct(TotalGeneral())</span>
        <a href="tiros" class="pg-btn" title="Tiros"><img src="@RutaIconoAmbito(AmbitoActividad.Tiro)" alt="" width="16" height="16" style="object-fit:contain;" /></a>
        <button type="button" class="pg-btn @(!verGraficos && vistaPie == "mapa" ? "activo" : "")" title="Mapa de calor (torres × actividades)" disabled="@editando" @onclick='() => VerVista("mapa")'><Ico Nombre="tablero" /></button>
        <button type="button" class="pg-btn @(!verGraficos && vistaPie == "torre" ? "activo" : "")" title="Torre por torre" disabled="@editando" @onclick='() => VerVista("torre")'><Ico Nombre="indicador" /></button>
        <button type="button" class="pg-btn @(!verGraficos && vistaPie == "matriz" ? "activo" : "")" title="Matriz (detalle y edición)" @onclick='() => VerVista("matriz")'><Ico Nombre="listado" /></button>
        <button type="button" class="pg-btn @(verGraficos ? "activo" : "")" title="@(verGraficos ? "Volver a la matriz" : "Gráficos")" disabled="@editando" @onclick="() => verGraficos = !verGraficos">📈</button>
        <button type="button" class="pg-btn @(mostrarEstados ? "activo" : "")" title="Estados y pesos (%)" @onclick="() => mostrarEstados = !mostrarEstados">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="8" cy="6" r="2" fill="currentColor"/><circle cx="15" cy="12" r="2" fill="currentColor"/><circle cx="10" cy="18" r="2" fill="currentColor"/></svg>
        </button>
        <button type="button" class="pg-btn" title="Recargar" @onclick="Cargar">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5"/></svg>
        </button>
        <span class="pg-sep"></span>
        @if (!verGraficos)
        {
            <BotonExportar Titulo="Matriz PIE" Selector="@(vistaPie == "mapa" && !editando ? "table.pm-mapa" : "table.mpie")" />
            <span class="pg-sep"></span>
            <button type="button" class="pg-btn @(editando ? "activo" : "")" title="@(editando ? "Salir de edición" : "Editar")" @onclick="AlternarEdicion"><Ico Nombre="@(editando ? "cancelar" : "editar")" /></button>
            @if (editando)
            {
                <button type="button" class="pg-btn pg-btn-primario" title="Guardar cambios" disabled="@(Pendientes == 0)" @onclick="GuardarTodo"><Ico Nombre="guardar" />@(Pendientes > 0 ? $" {Pendientes}" : "")</button>
            }
        }
    </Acciones>
</EncabezadoPagina>

@if (!verGraficos && (mostrarEstados || estados.Count == 0))
{
    <div class="card panel-formulario mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Estados y peso (%)</span>
            <button type="button" class="btn btn-sm btn-primary" title="Agregar estado" @onclick="AgregarEstado"><Ico Nombre="agregar" /></button>
        </div>
        <div class="card-body p-2">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th style="width:60px;">Color</th><th>Nombre</th><th style="width:110px;">Peso %</th><th style="width:70px;"></th></tr></thead>
                <tbody>
                @foreach (var e in estados)
                {
                    <tr>
                        <td><input type="color" class="form-control form-control-color form-control-sm" value="@e.Color" @onchange="@(ev => CambiarEstado(e, "color", ev.Value?.ToString()))" /></td>
                        <td><input class="form-control form-control-sm" value="@e.Nombre" @onchange="@(ev => CambiarEstado(e, "nombre", ev.Value?.ToString()))" /></td>
                        <td><input type="number" min="0" max="100" step="any" class="form-control form-control-sm" value="@e.Porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="@(ev => CambiarEstado(e, "pct", ev.Value?.ToString()))" /></td>
                        <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar estado" @onclick="() => EliminarEstado(e)"><Ico Nombre="eliminar" /></button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!verGraficos)
{
<div class="mpie-barra mb-2">
    <input class="form-control form-control-sm" style="max-width:240px;" placeholder="Buscar torre..." @bind="filtro" @bind:event="oninput" />

    <div class="mpie-filtro">
        <button type="button" class="btn btn-sm @(torresSel.Count > 0 ? "btn-dark" : "btn-outline-secondary")" title="Elegir torres" @onclick='() => Abrir("torres")'>
            Torres@(torresSel.Count > 0 ? $" ({torresSel.Count})" : "") ▾
        </button>
        @if (abierto == "torres")
        {
            <div class="mpie-back" @onclick="() => abierto = null"></div>
            <div class="mpie-pop">
                <div class="d-flex gap-1 mb-1">
                    <input class="form-control form-control-sm" placeholder="Filtrar lista..." @bind="busquedaTorre" @bind:event="oninput" />
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Quitar selección" @onclick="() => torresSel.Clear()">✕</button>
                </div>
                <div class="mpie-lista">
                    @foreach (var t in filas.Where(x => string.IsNullOrWhiteSpace(busquedaTorre) || x.Nombre.Contains(busquedaTorre, StringComparison.OrdinalIgnoreCase)))
                    {
                        <label class="mpie-op"><input type="checkbox" checked="@torresSel.Contains(t.Id)" @onchange="@(e => Alternar(torresSel, t.Id, (bool)e.Value!))" /> @t.Nombre</label>
                    }
                </div>
            </div>
        }
    </div>

    <div class="mpie-filtro">
        <button type="button" class="btn btn-sm @(actividadesSel.Count + paramsSel.Count > 0 ? "btn-dark" : "btn-outline-secondary")" title="Elegir actividades y parámetros" @onclick='() => Abrir("actividades")'>
            Actividades@(actividadesSel.Count > 0 ? $" ({actividadesSel.Count})" : "") ▾
        </button>
        @if (abierto == "actividades")
        {
            <div class="mpie-back" @onclick="() => abierto = null"></div>
            <div class="mpie-pop mpie-pop-ancho">
                <div class="d-flex justify-content-end mb-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Quitar selección" @onclick="() => { actividadesSel.Clear(); paramsSel.Clear(); }">✕</button>
                </div>
                <div class="mpie-lista">
                    @foreach (var a in actividades.Where(x => ParametrosDe(x.Id).Count > 0))
                    {
                        <label class="mpie-op fw-bold"><input type="checkbox" checked="@actividadesSel.Contains(a.Id)" @onchange="@(e => AlternarActividad(a.Id, (bool)e.Value!))" /> <img src="@RutaIconoActividad(a)" alt="" title="@NombreAmbito(a.Ambito)" width="14" height="14" style="object-fit:contain;" /> @a.Nombre</label>
                        @foreach (var p in ParametrosDe(a.Id))
                        {
                            <label class="mpie-op mpie-sub"><input type="checkbox" checked="@paramsSel.Contains(p.Id)" @onchange="@(e => AlternarParametro(a.Id, p.Id, (bool)e.Value!))" /> @p.Nombre</label>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <div class="mpie-filtro">
        <button type="button" class="btn btn-sm @(estadosSel.Count > 0 ? "btn-dark" : "btn-outline-secondary")" title="Mostrar solo torres con estos estados" @onclick='() => Abrir("estados")'>
            Estados@(estadosSel.Count > 0 ? $" ({estadosSel.Count})" : "") ▾
        </button>
        @if (abierto == "estados")
        {
            <div class="mpie-back" @onclick="() => abierto = null"></div>
            <div class="mpie-pop">
                <div class="d-flex justify-content-end mb-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Quitar selección" @onclick="() => estadosSel.Clear()">✕</button>
                </div>
                <div class="mpie-lista">
                    <label class="mpie-op"><input type="checkbox" checked="@estadosSel.Contains("na")" @onchange='@(e => Alternar(estadosSel, "na", (bool)e.Value!))' /> N/A</label>
                    <label class="mpie-op"><input type="checkbox" checked="@estadosSel.Contains("0")" @onchange='@(e => Alternar(estadosSel, "0", (bool)e.Value!))' /> Sin estado</label>
                    @foreach (var es in estados)
                    {
                        <label class="mpie-op"><input type="checkbox" checked="@estadosSel.Contains(es.Id.ToString())" @onchange="@(e => Alternar(estadosSel, es.Id.ToString(), (bool)e.Value!))" /> <span class="mpie-punto" style="background:@es.Color"></span> @es.Nombre</label>
                    }
                </div>
            </div>
        }
    </div>

    @if (HayFiltros)
    {
        <button type="button" class="btn btn-sm btn-link text-decoration-none" title="Quitar todos los filtros" @onclick="LimpiarFiltros">Limpiar filtros</button>
    }
    <span class="text-muted small ms-auto">@FilasMostradas.Select(r => r.Torre.Id).Distinct().Count() torres</span>
</div>
}

@if (adjuntoPorQuitar is not null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-box-custom">
            <h5>¿Quitar este adjunto?</h5>
            <p><strong>@adjuntoPorQuitar.NombreOriginal</strong> se irá a la Papelera@(editando ? " al guardar" : "").</p>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-secondary btn-sm" @onclick="() => adjuntoPorQuitar = null" title="Cancelar"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-danger btn-sm" disabled="@BloqueadoPorImpacto" @onclick="ConfirmarQuitar">Sí, quitar</button>
            </div>
        </div>
    </div>
}

@if (confirmarDescartar)
{
    <div class="modal-backdrop-custom">
        <div class="modal-box-custom">
            <h5>¿Descartar los cambios sin guardar?</h5>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-secondary btn-sm" @onclick="() => confirmarDescartar = false">Seguir editando</button>
                <button class="btn btn-danger btn-sm" @onclick="Descartar">Descartar</button>
            </div>
        </div>
    </div>
}

@if (verGraficos)
{
    <GraficoEnsayos Titulo="Matriz PIE" Columnas="ColumnasGrafico()" Filas="FilasGrafico()" Tipos="TiposGrafico()"
                    CampoEjeXInicial="Estado" CampoColores="Estado" ColoresValores="ColoresEstados()" />
}
else if (vistaPie == "mapa" && !editando)
{
    @VistaMapa()
}
else if (vistaPie == "torre" && !editando)
{
    @VistaTorre()
}
else
{
    var vis = FilasMostradas;
    var conTiro = HayTiroVis;
    var conPata = HayPataVis;
    var actsVis = actividades.Where(a => ParamsVis(a).Count > 0).ToList();
<div class="tabla-scroll">
    <table class="table table-sm mb-0 align-middle mpie">
        <thead>
            <tr>
                @if (conTiro) { <th rowspan="2" class="mpie-fija mpie-th mpie-col-tiro">Tiro</th> }
                <th rowspan="2" class="mpie-fija mpie-th @(conTiro ? "mpie-fija2" : "")">Torre</th>
                @if (conPata) { <th rowspan="2" class="mpie-th">Pata</th> }
                <th rowspan="2" class="mpie-th text-center" title="Cumplimiento de la torre">%</th>
                @foreach (var a in actsVis)
                {
                    <th colspan="@(ParamsVis(a).Count + 1)" class="mpie-th text-center mpie-grupo" title="@NombreAmbito(a.Ambito)"><img src="@RutaIconoActividad(a)" alt="" width="14" height="14" style="object-fit:contain;" /> @a.Nombre</th>
                }
            </tr>
            <tr>
                @foreach (var a in actsVis)
                {
                    foreach (var p in ParamsVis(a))
                    {
                        <th class="mpie-th mpie-param" title="@p.Nombre"><div>@p.Nombre</div></th>
                    }
                    <th class="mpie-th text-center" title="Cumplimiento de @a.Nombre">%</th>
                }
            </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < vis.Count; i++)
        {
            var r = vis[i];
            var spTorre = Span(vis, i, x => x.Torre.Id);
            var spTiro = conTiro ? Span(vis, i, x => x.Tiro?.Id ?? 0) : 0;
            <tr>
                @if (spTiro > 0) { <td rowspan="@spTiro" class="mpie-fija fw-bold mpie-col-tiro">@(r.Tiro?.Nombre ?? "—")</td> }
                @if (spTorre > 0) { <td rowspan="@spTorre" class="mpie-fija fw-bold @(conTiro ? "mpie-fija2" : "")">@r.Torre.Nombre</td> }
                @if (conPata) { <td class="small text-nowrap">@(r.Pata?.Nombre ?? "—")</td> }
                @if (spTorre > 0) { <td rowspan="@spTorre" class="mpie-pct" title="@DetalleTorre(r.Torre)">@FormatoPct(PctTorre(r.Torre))</td> }
                @foreach (var a in actsVis)
                {
                    var span = a.Ambito switch { AmbitoActividad.Tiro => spTiro, AmbitoActividad.Torre => spTorre, _ => 1 };
                    if (span == 0) { continue; }
                    var ent = EntDe(r, a);
                    foreach (var p in ParamsVis(a))
                    {
                        if (ent is Ent ce)
                        {
                            <td rowspan="@span" class="mpie-c" style="background:@ColorCelda(ce, p.Id);">
                                <div class="mpie-celda">
                                <select class="mpie-sel" disabled="@(!editando)" value="@ValorCelda(ce, p.Id)" @onchange="@(ev => CambiarCelda(ce, p, ev.Value?.ToString() ?? "na"))">
                                    <option value="na">N/A</option>
                                    <option value="0">Sin estado</option>
                                    @foreach (var es in estados)
                                    {
                                        <option value="@es.Id" title="@FormatoNum(es.Porcentaje)%">@es.Nombre</option>
                                    }
                                </select>
                                @if (ce.T == 'C')
                                {
                                    var adjs = AdjuntosDe(ce.Id, p.Id);
                                    if (!editando)
                                    {
                                        if (adjs.Count > 0)
                                        {
                                            <BotonArchivos Clase="mpie-adj" Titulo="@($"{r.Torre.Nombre} · {p.Nombre}")"
                                                           Archivos="@(adjs.Select(ar => new BotonArchivos.Archivo(ar.NombreOriginal, ar.RutaArchivo)).ToList())" />
                                        }
                                    }
                                    else
                                    {
                                        foreach (var ar in adjs)
                                        {
                                            <a href="@ar.RutaArchivo" target="_blank" rel="noopener" class="mpie-adj text-decoration-none" title="@ar.NombreOriginal"><Ico Nombre="documento" /></a>
                                            <button type="button" class="mpie-x" title="Quitar adjunto" @onclick="() => PedirQuitar(ar)">✕</button>
                                        }
                                        <label class="mpie-mas" title="Cargar adjunto"><Ico Nombre="agregar" /><InputFile multiple accept=".pdf,image/*" OnChange="@(ev => SubirAdjuntos(ev, ce.Id, p))" /></label>
                                    }
                                }
                                </div>
                            </td>
                        }
                        else
                        {
                            <td rowspan="@span" class="mpie-c" style="background:#f7f7f7;"><span class="text-muted px-2" title="@MotivoSinCelda(r, a)">—</span></td>
                        }
                    }
                    <td rowspan="@span" class="mpie-pct">@FormatoPct(PctAct(ent, a))</td>
                }
            </tr>
        }
        </tbody>
        <tfoot>
            <tr class="mpie-pie">
                @if (conTiro) { <td class="mpie-fija fw-bold mpie-col-tiro">PIE</td> }
                <td class="mpie-fija fw-bold @(conTiro ? "mpie-fija2" : "")">@(conTiro ? "" : "PIE")</td>
                @if (conPata) { <td></td> }
                <td class="mpie-pct">@FormatoPct(TotalGeneral())</td>
                @foreach (var a in actsVis)
                {
                    foreach (var p in ParamsVis(a))
                    {
                        <td class="mpie-pct">@FormatoPct(PctColumna(a, p.Id))</td>
                    }
                    <td class="mpie-pct">@FormatoPct(PctGrupo(a))</td>
                }
            </tr>
        </tfoot>
    </table>
</div>
}

@code {
    private bool verGraficos = false;

    // Celda de la matriz: 'C' = componente (hoja de vida de torre o pata), 'T' = tiro.
    private readonly record struct Ent(char T, int Id);

    // Una fila de la matriz: una torre, o una pata de la torre si hay
    // actividades de ámbito Pata visibles. Las celdas de torre y de tiro se
    // combinan (rowspan) sobre sus filas.
    private sealed class FilaPie
    {
        public ItemCatalogo Torre = null!;
        public int? CompTorre;
        public Componente? Pata;
        public Tiro? Tiro;
    }

    private List<Actividad> actividades = new();          // Tiro → Torre → Pata, luego Orden
    private List<ParametroActividad> parametros = new();
    private List<ItemCatalogo> filas = new();             // torres (catálogo Localización)
    private List<EstadoParametro> estados = new();
    private Dictionary<int, int> ComponentePorElemento = new();           // elementoTrazadoId -> componente hoja de vida
    private Dictionary<int, List<Componente>> patasPorElemento = new();   // elementoTrazadoId -> patas/elementos
    private Dictionary<int, HashSet<int>> actsPorComp = new();            // restricción ComponenteActividad
    private Dictionary<int, Tiro> tirosPorId = new();
    private Dictionary<int, Tiro> tiroPorElemento = new();
    private Dictionary<(int Comp, int Param), RegistroParametro> registros = new();
    private Dictionary<(int Tiro, int Param), RegistroParametroTiro> registrosTiro = new();
    private Dictionary<int, List<ArchivoRegistroParametro>> adjuntosPorRegistro = new();   // registroId -> archivos vigentes
    private bool mostrarEstados = false;
    private string filtro = "";

    // ---------- Filtros (vacío = sin filtrar) ----------
    private string? abierto;
    private string busquedaTorre = "";
    private HashSet<int> torresSel = new();
    private HashSet<int> actividadesSel = new();
    private HashSet<int> paramsSel = new();
    private HashSet<string> estadosSel = new();

    private bool HayFiltros => torresSel.Count + actividadesSel.Count + paramsSel.Count + estadosSel.Count > 0 || !string.IsNullOrWhiteSpace(filtro);

    private void Abrir(string panel) => abierto = abierto == panel ? null : panel;

    private static void Alternar<T>(HashSet<T> conjunto, T valor, bool marcado)
    {
        if (marcado) conjunto.Add(valor); else conjunto.Remove(valor);
    }

    private void AlternarActividad(int actividadId, bool marcado)
    {
        Alternar(actividadesSel, actividadId, marcado);
        if (!marcado) { foreach (var p in ParametrosDe(actividadId)) paramsSel.Remove(p.Id); }
    }

    private void AlternarParametro(int actividadId, int paramId, bool marcado)
    {
        Alternar(paramsSel, paramId, marcado);
        // Elegir un parámetro implica elegir su actividad.
        if (marcado) actividadesSel.Add(actividadId);
    }

    private void LimpiarFiltros()
    {
        torresSel.Clear(); actividadesSel.Clear(); paramsSel.Clear(); estadosSel.Clear(); filtro = ""; abierto = null;
    }

    // Parámetros visibles de una actividad (columnas).
    private List<ParametroActividad> ParamsVis(Actividad a)
    {
        if (actividadesSel.Count > 0 && !actividadesSel.Contains(a.Id)) return new();
        var todos = ParametrosDe(a.Id);
        var elegidos = todos.Where(p => paramsSel.Contains(p.Id)).ToList();
        return elegidos.Count > 0 ? elegidos : todos;
    }

    private bool HayTiroVis => actividades.Any(a => a.Ambito == AmbitoActividad.Tiro && ParamsVis(a).Count > 0);
    private bool HayPataVis => actividades.Any(a => a.Ambito == AmbitoActividad.Pata && ParamsVis(a).Count > 0);

    private List<FilaPie> FilasMostradas
    {
        get
        {
            var q = filas.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(filtro))
                q = q.Where(f => f.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase)
                              || (TiroDe(f)?.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase) ?? false));
            if (torresSel.Count > 0) q = q.Where(f => torresSel.Contains(f.Id));
            if (HayTiroVis)
            {
                // Agrupadas por tiro (los sin tiro al final), conservando el orden natural de torres.
                q = q.OrderBy(f => TiroDe(f) is null ? 1 : 0)
                     .ThenBy(f => TiroDe(f)?.Orden ?? 0)
                     .ThenBy(f => TiroDe(f)?.Nombre ?? "")
                     .ThenBy(f => OrdenNatural(f.Nombre));
            }
            var conPata = HayPataVis;
            var rows = new List<FilaPie>();
            foreach (var f in q)
            {
                var comp = CompDe(f);
                var t = TiroDe(f);
                var patas = conPata && f.ElementoTrazadoId is int el && patasPorElemento.TryGetValue(el, out var ps) ? ps : new List<Componente>();
                if (patas.Count == 0) rows.Add(new FilaPie { Torre = f, CompTorre = comp, Tiro = t });
                else foreach (var pa in patas) rows.Add(new FilaPie { Torre = f, CompTorre = comp, Tiro = t, Pata = pa });
            }
            if (estadosSel.Count > 0)
            {
                var acts = actividades.Select(a => (a, ps: ParamsVis(a))).Where(x => x.ps.Count > 0).ToList();
                rows = rows.Where(r => acts.Any(x => EntDe(r, x.a) is Ent e && x.ps.Any(p => estadosSel.Contains(ValorCelda(e, p.Id))))).ToList();
            }
            return rows;
        }
    }

    // Cuántas filas seguidas comparten la misma clave (0 si no es la primera del grupo).
    private static int Span(List<FilaPie> v, int i, Func<FilaPie, int> clave)
    {
        if (i > 0 && clave(v[i - 1]) == clave(v[i])) return 0;
        var n = 1;
        while (i + n < v.Count && clave(v[i + n]) == clave(v[i])) n++;
        return n;
    }

    protected override void OnInitialized() => CargarSync();

    // ?torre={id del ítem de Localización} (tablero de inicio): abre esa torre en la vista torre por torre.
    [SupplyParameterFromQuery(Name = "torre")] public int? TorreQ { get; set; }
    private int? torreAplicada;
    protected override void OnParametersSet()
    {
        if (TorreQ == torreAplicada) return;
        torreAplicada = TorreQ;
        if (TorreQ is int t && filas.FirstOrDefault(f => f.Id == t) is { } f) EnfocarTorre(f);
    }

    private Task Cargar() { CargarSync(); return Task.CompletedTask; }

    private static int Rango(AmbitoActividad a) => a switch { AmbitoActividad.Tiro => 0, AmbitoActividad.Torre => 1, _ => 2 };

    private void CargarSync()
    {
        Db.ChangeTracker.Clear();
        actividades = Db.Actividades.AsNoTracking()
            .Where(a => a.Activo && a.EnMatrizPie).ToList()
            .OrderBy(a => Rango(a.Ambito)).ThenBy(a => a.Orden).ThenBy(a => a.Id).ToList();
        var idsAct = actividades.Select(a => a.Id).ToList();
        parametros = Db.ParametrosActividad.AsNoTracking()
            .Where(p => p.Activo && idsAct.Contains(p.ActividadId)).OrderBy(p => p.Orden).ThenBy(p => p.Id).ToList();
        estados = Db.EstadosParametro.AsNoTracking().Where(e => e.Activo).OrderBy(e => e.Orden).ThenBy(e => e.Id).ToList();

        filas = Db.Catalogos.AsNoTracking()
            .Where(c => c.Tipo == "Localización" && c.Activo).ToList()
            .OrderBy(c => OrdenNatural(c.Nombre)).ToList();

        var idsElem = filas.Where(f => f.ElementoTrazadoId != null).Select(f => f.ElementoTrazadoId!.Value).ToList();
        var comps = Db.Componentes.AsNoTracking()
            .Where(c => !c.Eliminado && idsElem.Contains(c.ElementoTrazadoId)).ToList();
        ComponentePorElemento = comps.Where(c => c.EsHojaDeVida).GroupBy(c => c.ElementoTrazadoId).ToDictionary(g => g.Key, g => g.First().Id);

        // Patas/elementos: solo los que tienen al menos una actividad de ámbito Pata de la matriz.
        var otros = comps.Where(c => !c.EsHojaDeVida).ToList();
        var idsOtros = otros.Select(c => c.Id).ToList();
        actsPorComp = Db.ComponenteActividades.AsNoTracking().Where(x => idsOtros.Contains(x.ComponenteId)).ToList()
            .GroupBy(x => x.ComponenteId).ToDictionary(g => g.Key, g => g.Select(x => x.ActividadId).ToHashSet());
        var actsPata = actividades.Where(a => a.Ambito == AmbitoActividad.Pata).Select(a => a.Id).ToList();
        patasPorElemento = otros.Where(c => actsPata.Any(a => Aplica(c.Id, a)))
            .GroupBy(c => c.ElementoTrazadoId)
            .ToDictionary(g => g.Key, g => g.OrderBy(c => c.Orden).ThenBy(c => c.Nombre).ToList());

        tirosPorId = Db.Tiros.AsNoTracking().Where(t => !t.Eliminado).ToDictionary(t => t.Id);
        tiroPorElemento = Db.ElementosTrazado.AsNoTracking().Where(e => e.TiroId != null && idsElem.Contains(e.Id)).ToList()
            .Where(e => tirosPorId.ContainsKey(e.TiroId!.Value)).ToDictionary(e => e.Id, e => tirosPorId[e.TiroId!.Value]);

        var idsComp = ComponentePorElemento.Values.Concat(patasPorElemento.Values.SelectMany(l => l.Select(c => c.Id))).ToList();
        registros = Db.RegistrosParametro.AsNoTracking()
            .Where(r => idsComp.Contains(r.ComponenteId)).ToList()
            .GroupBy(r => (r.ComponenteId, r.ParametroActividadId)).ToDictionary(g => g.Key, g => g.First());

        var idsTiro = tirosPorId.Keys.ToList();
        registrosTiro = Db.RegistrosParametroTiro.AsNoTracking()
            .Where(r => idsTiro.Contains(r.TiroId)).ToList()
            .GroupBy(r => (r.TiroId, r.ParametroActividadId)).ToDictionary(g => g.Key, g => g.First());

        var idsReg = registros.Values.Select(r => r.Id).ToList();
        adjuntosPorRegistro = Db.ArchivosRegistroParametro.AsNoTracking()
            .Where(a => idsReg.Contains(a.RegistroParametroId) && !a.Eliminado).ToList()
            .GroupBy(a => a.RegistroParametroId).ToDictionary(g => g.Key, g => g.OrderBy(a => a.Id).ToList());
    }

    // Sin filas en ComponenteActividad = todas las actividades aplican (misma regla que Trazado).
    private bool Aplica(int compId, int actividadId) =>
        !actsPorComp.TryGetValue(compId, out var s) || s.Count == 0 || s.Contains(actividadId);

    private Tiro? TiroDe(ItemCatalogo f) =>
        f.ElementoTrazadoId is int el && tiroPorElemento.TryGetValue(el, out var t) ? t : null;

    private Ent? EntDe(FilaPie r, Actividad a) => a.Ambito switch
    {
        AmbitoActividad.Torre => r.CompTorre is int c ? (Ent?)new Ent('C', c) : null,
        AmbitoActividad.Pata => r.Pata is { } pa && Aplica(pa.Id, a.Id) ? (Ent?)new Ent('C', pa.Id) : null,
        _ => r.Tiro is { } t ? (Ent?)new Ent('T', t.Id) : null
    };

    private static string MotivoSinCelda(FilaPie r, Actividad a) => a.Ambito switch
    {
        AmbitoActividad.Torre => "Esta localización no tiene hoja de vida de torre",
        AmbitoActividad.Pata => r.Pata is null ? "Sin patas con esta actividad" : "La actividad no aplica a este elemento",
        _ => "Torre sin tiro asignado"
    };

    private List<ArchivoRegistroParametro> AdjuntosDe(int comp, int paramId)
    {
        var l = registros.TryGetValue((comp, paramId), out var r) && adjuntosPorRegistro.TryGetValue(r.Id, out var x)
            ? x.Where(a => !quitarPend.Contains(a.Id)).ToList() : new List<ArchivoRegistroParametro>();
        l.AddRange(subidasPend.Where(s => s.Comp == comp && s.Param == paramId).Select(s => s.Arch));
        return l;
    }

    // "3", "5N", "15A", "100N" → ordena por el número y luego por el sufijo.
    private static (int, string) OrdenNatural(string n)
    {
        var d = new string(n.TakeWhile(char.IsDigit).ToArray());
        return (int.TryParse(d, out var v) ? v : int.MaxValue, n);
    }

    private static string NombreAmbito(AmbitoActividad a) => a switch
    {
        AmbitoActividad.Torre => "Torre",
        AmbitoActividad.Pata => "Pata",
        _ => "Tiro (Tendido)"
    };

