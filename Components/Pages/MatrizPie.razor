        return d;
    }

    private List<Dictionary<string, object>> FilasGrafico()
    {
        // Etiquetas de cada componente (torre y pata) para el gráfico.
        var etiqueta = new Dictionary<int, (string Tiro, string Torre, string Pata)>();
        foreach (var f in filas)
        {
            var tiro = TiroDe(f)?.Nombre ?? "";
            if (CompDe(f) is int c) etiqueta[c] = (tiro, f.Nombre, "");
            if (f.ElementoTrazadoId is int el && patasPorElemento.TryGetValue(el, out var ps))
                foreach (var pa in ps) etiqueta[pa.Id] = (tiro, f.Nombre, pa.Nombre);
        }

        var lista = new List<Dictionary<string, object>>();
        foreach (var a in actividades)
        {
            foreach (var e in EntidadesDe(a))
            {
                var (tiro, torre, pata) = e.T == 'T'
                    ? (tirosPorId.TryGetValue(e.Id, out var t) ? t.Nombre : "", "", "")
                    : (etiqueta.TryGetValue(e.Id, out var et) ? et : ("", "", ""));
                foreach (var p in ParametrosDe(a.Id))
                {
                    var g = Guardado(e, p.Id);
                    if (!g.Aplica) continue;
                    var es = estados.FirstOrDefault(x => x.Id == g.Estado);
                    var fila = new Dictionary<string, object>
                    {
                        ["Tiro"] = tiro,
                        ["Torre"] = torre,
                        ["Pata"] = pata,
                        ["Actividad"] = a.Nombre,
                        ["Parametro"] = p.Nombre,
                        ["Estado"] = es?.Nombre ?? "Sin estado",
                        ["Peso"] = (es?.Porcentaje ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture),
                    };
                    if (es is not null && es.Porcentaje >= 100 && g.Fecha is DateTime fecha)
                    {
                        fila["Fecha"] = fecha.ToString("yyyy-MM-dd");
                        fila["Mes"] = $"{fecha.Year}-{fecha.Month:00} {Meses[fecha.Month - 1]}";
                        fila["Anio"] = fecha.Year.ToString();
                    }
                    if (FacturadoDe(e, p.Id) is DateTime fac)
                    {
                        fila["Facturado"] = fac.ToString("yyyy-MM-dd");
                        fila["MesFacturado"] = $"{fac.Year}-{fac.Month:00} {Meses[fac.Month - 1]}";
                    }
                    lista.Add(fila);
                }
            }
        }
        return lista;
    }

