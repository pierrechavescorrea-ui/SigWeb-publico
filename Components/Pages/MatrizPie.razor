                                {
                                    <a class="ind-chip pv-riesgo" href="@($"trazado?torre={el}")" title="Abrir la hoja de vida en Trazado">Hoja de vida ›</a>
                                }
                            </div>
                        </div>
                        <span class="ind-det-pos">@(pos + 1) / @torres.Count</span>
