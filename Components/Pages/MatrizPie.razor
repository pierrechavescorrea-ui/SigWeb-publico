                                {
                                @if (ents.Count == 0)
                                {
                                    <span class="small text-muted">@(a.Ambito == AmbitoActividad.Tiro ? "Torre sin tiro asignado" : a.Ambito == AmbitoActividad.Torre ? "Sin hoja de vida" : "Sin patas con esta actividad")</span>
