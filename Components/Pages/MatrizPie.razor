    };

    private List<ParametroActividad> ParametrosDe(int actividadId) => parametros.Where(p => p.ActividadId == actividadId).ToList();

    // Estado guardado: (aplica, estadoId). No aplica = N/A.
    private (bool Aplica, int? Estado, DateTime? Fecha) Guardado(Ent e, int paramId)
    {
        if (e.T == 'T')
            return registrosTiro.TryGetValue((e.Id, paramId), out var rt) && rt.Completado ? (true, rt.EstadoParametroId, rt.Fecha) : (false, null, null);
        return registros.TryGetValue((e.Id, paramId), out var r) && r.Completado ? (true, r.EstadoParametroId, r.Fecha) : (false, null, null);
    }

    private DateTime? FacturadoDe(Ent e, int paramId) => e.T == 'T'
        ? (registrosTiro.TryGetValue((e.Id, paramId), out var rt) ? rt.FechaFacturado : null)
        : (registros.TryGetValue((e.Id, paramId), out var r) ? r.FechaFacturado : null);

    private static string Valor((bool Aplica, int? Estado, DateTime? Fecha) g) => !g.Aplica ? "na" : (g.Estado?.ToString() ?? "0");

    private string ValorCelda(Ent e, int paramId) =>
        cambios.TryGetValue((e, paramId), out var pend) ? pend : Valor(Guardado(e, paramId));

    // % de una celda; null = N/A (no entra en ningún promedio).
    private decimal? PctCelda(Ent e, int paramId)
    {
        var g = Guardado(e, paramId);
        if (!g.Aplica) return null;
        return estados.FirstOrDefault(x => x.Id == g.Estado)?.Porcentaje ?? 0;
    }

    private string ColorCelda(Ent e, int paramId)
    {
        var v = ValorCelda(e, paramId);
        if (v == "na") return "#eeeeee";
        var es = estados.FirstOrDefault(x => x.Id.ToString() == v);
        return es is null ? "#ffffff" : es.Color + "40";
    }

    private decimal? PromedioDe(IEnumerable<decimal?> valores)
    {
        var v = valores.Where(x => x.HasValue).Select(x => x!.Value).ToList();
        return v.Count == 0 ? null : v.Average();
    }

    // Todas las celdas (de las actividades de la matriz) que cuelgan de una torre: su tiro, la torre y sus patas.
    private IEnumerable<decimal?> CeldasTorre(ItemCatalogo f)
    {
        var comp = CompDe(f);
        var tiro = TiroDe(f);
        var patas = f.ElementoTrazadoId is int el && patasPorElemento.TryGetValue(el, out var ps) ? ps : new List<Componente>();
        foreach (var a in actividades)
        {
            var ents = a.Ambito switch
            {
                AmbitoActividad.Torre => comp is int c ? new List<Ent> { new('C', c) } : new(),
                AmbitoActividad.Pata => patas.Where(pa => Aplica(pa.Id, a.Id)).Select(pa => new Ent('C', pa.Id)).ToList(),
                _ => tiro is not null ? new List<Ent> { new('T', tiro.Id) } : new()
            };
            foreach (var e in ents)
                foreach (var p in ParametrosDe(a.Id))
                    yield return PctCelda(e, p.Id);
        }
    }

    private decimal? PctTorre(ItemCatalogo f) => PromedioDe(CeldasTorre(f));

    private string DetalleTorre(ItemCatalogo f)
    {
        var l = CeldasTorre(f).ToList();
        return $"{l.Count(x => x != null)} de {l.Count} aplican";
    }

    private decimal? PctAct(Ent? e, Actividad a) =>
        e is Ent x ? PromedioDe(ParametrosDe(a.Id).Select(p => PctCelda(x, p.Id))) : null;

    // Entidades (torres, patas o tiros) sobre las que se mide una actividad en el pie de la matriz.
    private IEnumerable<Ent> EntidadesDe(Actividad a) => a.Ambito switch
    {
        AmbitoActividad.Torre => filas.Select(CompDe).Where(c => c != null).Select(c => new Ent('C', c!.Value)),
        AmbitoActividad.Pata => filas.Where(f => f.ElementoTrazadoId != null)
            .SelectMany(f => patasPorElemento.TryGetValue(f.ElementoTrazadoId!.Value, out var ps) ? ps : new List<Componente>())
            .Where(pa => Aplica(pa.Id, a.Id)).Select(pa => new Ent('C', pa.Id)),
        _ => tirosPorId.Keys.Select(id => new Ent('T', id))
    };

    private decimal? PctColumna(Actividad a, int paramId) => PromedioDe(EntidadesDe(a).Select(e => PctCelda(e, paramId)));

    private decimal? PctGrupo(Actividad a) =>
        PromedioDe(EntidadesDe(a).SelectMany(e => ParametrosDe(a.Id).Select(p => PctCelda(e, p.Id))));

    private decimal? TotalGeneral() =>
        PromedioDe(actividades.SelectMany(a => EntidadesDe(a).SelectMany(e => ParametrosDe(a.Id).Select(p => PctCelda(e, p.Id)))));

    private static string FormatoPct(decimal? v) => v is null ? "—" : $"{v.Value:0.#}%";
    private static string FormatoNum(decimal v) => v.ToString("0.##");

