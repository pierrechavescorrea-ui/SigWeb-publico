    // ================= Ajustes: actividades, pesos y cotas =================
    private List<ActividadObra> actsEdit = new();
    private ConfigCotasAvance cotasEdit = new();
    private Dictionary<int, int> regsPorAct = new();
    private int? actElim;
    private string nuevaAct = "", nuevoGrupo = "";
    private AmbitoAvance nuevoAmbito = AmbitoAvance.Pata;

    private void PrepararAjustes()
    {
        actsEdit = Db.ActividadesObra.AsNoTracking().OrderBy(a => a.Orden).ThenBy(a => a.Id).ToList();
        cotasEdit = ConfigCotasAvance.Leer(Db.Configuracion.AsNoTracking().Select(c => c.AvanceObraCotas).FirstOrDefault());
        regsPorAct = Db.RegistrosAvance.AsNoTracking().GroupBy(r => r.ActividadObraId).Select(g => new { g.Key, N = g.Count() }).ToDictionary(x => x.Key, x => x.N);
        actElim = null;
    }

    private void AgregarActividad()
    {
        if (string.IsNullOrWhiteSpace(nuevaAct)) return;
        var grupo = string.IsNullOrWhiteSpace(nuevoGrupo) ? "Otras" : nuevoGrupo.Trim();
        actsEdit.Add(new ActividadObra { Nombre = nuevaAct.Trim(), Grupo = grupo, Ambito = nuevoAmbito, Orden = (actsEdit.Count == 0 ? 0 : actsEdit.Max(a => a.Orden)) + 1 });
        nuevaAct = "";
    }

    private async Task GuardarAjustes()
    {
        if (guardando) return;
        error = null; guardando = true;
        try
        {
            if (actsEdit.Any(a => string.IsNullOrWhiteSpace(a.Nombre))) { error = "Toda actividad necesita nombre."; return; }
            if (actsEdit.Any(a => a.Peso < 0 || a.Peso > 1)) { error = "El peso va de 0 % a 100 %."; return; }
            var ids = actsEdit.Where(a => a.Id > 0).Select(a => a.Id).ToList();
            var bd = Db.ActividadesObra.Where(a => ids.Contains(a.Id)).ToDictionary(a => a.Id);
            foreach (var a in actsEdit)
            {
                var e = a.Id > 0 && bd.TryGetValue(a.Id, out var x) ? x : null;
                if (e is null) { e = new ActividadObra(); Db.ActividadesObra.Add(e); }
                e.Nombre = a.Nombre.Trim(); e.Grupo = (a.Grupo ?? "").Trim(); e.Ambito = a.Ambito; e.Peso = a.Peso; e.Unidad = a.Unidad;
                e.ItemContrato = a.ItemContrato; e.Efecto = a.Efecto; e.Orden = a.Orden; e.Activo = a.Activo;
            }
            var cfg = Db.Configuracion.FirstOrDefault();
            if (cfg is null) { cfg = new ConfiguracionEmpresa { Id = 1 }; Db.Configuracion.Add(cfg); }
            cfg.AvanceObraCotas = cotasEdit.Escribir();
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            Cargar();
            visorTorre = null;
            aviso = "Ajustes guardados.";
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo guardar: " + (ex.InnerException?.Message ?? ex.Message); }
        finally { guardando = false; }
    }

    private void EliminarActividad(ActividadObra a)
    {
        if (a.Id == 0) { actsEdit.Remove(a); actElim = null; return; }
        try
        {
            var ahora = DateTime.Now;
            var e = Db.ActividadesObra.First(x => x.Id == a.Id);
            e.Eliminado = true; e.FechaEliminacion = ahora;
            foreach (var r in Db.RegistrosAvance.Where(r => r.ActividadObraId == a.Id)) { r.Eliminado = true; r.FechaEliminacion = ahora; }
            Db.SaveChanges();
            Db.ChangeTracker.Clear();
            actsEdit.Remove(a); actElim = null;
            aviso = $"«{a.Nombre}» enviada a la Papelera.";
            s = ServicioAvanceObra.Cargar(Db, Env.WebRootPath);
            CargarInformes();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo eliminar: " + ex.Message; }
    }

