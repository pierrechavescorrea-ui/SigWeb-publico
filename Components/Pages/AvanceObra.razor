    private RenderFragment VistaAjustes() => __builder =>
    {
        var total = actsEdit.Where(a => a.Activo).Sum(a => a.Peso);
        <div class="av-ajustes">
            <div class="frm-linea av-linea mb-2">
                <input class="form-control form-control-sm" placeholder="Nueva actividad" title="Nombre" @bind="nuevaAct" />
                <input class="form-control form-control-sm" list="dl-av-grupos" placeholder="Grupo" title="Grupo" @bind="nuevoGrupo" />
                <select class="form-select form-select-sm" style="width:auto" title="Se registra por" @bind="nuevoAmbito">
                    <option value="@AmbitoAvance.Pata">Por pata</option>
                    <option value="@AmbitoAvance.Torre">Por torre</option>
                </select>
                <button type="button" class="frm-icono-btn" title="Agregar actividad" disabled="@string.IsNullOrWhiteSpace(nuevaAct)" @onclick="AgregarActividad"><Ico Nombre="agregar" /></button>
                <span class="av-suma ms-auto" title="Suma de pesos de las actividades activas (el avance de cada torre se divide por la suma de lo que aplica)">Σ pesos @((total * 100).ToString("0.#", Es)) %</span>
            </div>
            <datalist id="dl-av-grupos">@foreach (var g in actsEdit.Select(a => a.Grupo).Distinct()) { <option value="@g"></option> }</datalist>
            <div class="av-grupos">
                @foreach (var g in actsEdit.GroupBy(a => a.Grupo).ToList())
                {
                    <div class="av-grupo">
                        <div class="av-grupo-cab"><span>@g.Key</span><span class="av-grupo-peso">@((g.Where(a => a.Activo).Sum(a => a.Peso) * 100).ToString("0.#", Es)) %</span></div>
                        @foreach (var a0 in g)
                        {
                            var a = a0;
                            <div class="av-act @(a.Activo ? "" : "av-na")">
                                <input class="form-control form-control-sm av-act-nom" title="Nombre" @bind="a.Nombre" />
                                <div class="av-act-campos">
                                    <label title="Peso en el avance de la torre (%)"><span>Peso %</span><input type="number" step="0.1" min="0" max="100" class="form-control form-control-sm" value="@((a.Peso * 100).ToString("0.###", CultureInfo.InvariantCulture))" @onchange="@(e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v)) a.Peso = Math.Round(v / 100m, 5); })" /></label>
                                    <label title="Se registra por"><span>Por</span>
                                        <select class="form-select form-select-sm" @bind="a.Ambito"><option value="@AmbitoAvance.Pata">Pata</option><option value="@AmbitoAvance.Torre">Torre</option></select>
                                    </label>
                                    <label title="Unidad"><span>Unidad</span><input class="form-control form-control-sm" @bind="a.Unidad" /></label>
                                    <label title="Ítem de la lista de cantidades"><span>Ítem</span><input class="form-control form-control-sm" @bind="a.ItemContrato" /></label>
                                    <label title="Qué dibuja en el visor 3D"><span>3D</span>
                                        <select class="form-select form-select-sm" @bind="a.Efecto">
                                            @foreach (var ef in Enum.GetValues<EfectoAvance3D>()) { <option value="@ef">@NombreEfecto(ef)</option> }
                                        </select>
                                    </label>
                                    <label class="av-act-chk" title="Activa"><input type="checkbox" @bind="a.Activo" /></label>
                                    @if (actElim == a.GetHashCode())
                                    {
                                        var n = regsPorAct.TryGetValue(a.Id, out var k) ? k : 0;
                                        <span class="av-act-elim">
                                            @(n > 0 ? $"{n} registro(s) de avance van con ella a la Papelera." : "Sin registros.")
                                            <button type="button" class="btn btn-sm btn-danger" title="Enviar a la Papelera" @onclick="() => EliminarActividad(a)"><Ico Nombre="eliminar" /></button>
                                            <button type="button" class="btn btn-sm btn-secondary" title="Cancelar" @onclick="() => actElim = null"><Ico Nombre="cancelar" /></button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="ens-mini" title="Eliminar" @onclick="() => actElim = a.GetHashCode()"><Ico Nombre="eliminar" /></button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="av-grupo">
                    <div class="av-grupo-cab"><span>Cotas del visor 3D</span></div>
                    @{ var dg = Diagnostico(); }
                    <div class="av-sub">Tipo de torre: @(s.ClaveTipoUsada ?? "sin columna") · @dg.Exactos con modelo · @dg.Siluetas paramétricas (@dg.SinTipo sin tipo) · Cimentación: @dg.Cim</div>
                    <div class="av-cotas">
                        <label title="Columna de la tabla de torres con el tipo de torre"><span>Tipo de torre</span>
                            <select class="form-select form-select-sm" value="@(cotasEdit.ClaveTipoTorre ?? "")" @onchange="@(e => cotasEdit.ClaveTipoTorre = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString())">
                                <option value="">(como Línea 3D@(s.ClaveTipoUsada is null ? ": no encontrada" : ": " + s.ClaveTipoUsada))</option>
                                @foreach (var c in s!.ClavesTabla) { <option value="@c">@c</option> }
                            </select>
                        </label>
                        <label title="Columna con el tipo de cimentación (un valor con «parrilla» = pata con parrilla)"><span>Tipo de cimentación</span>
                            <select class="form-select form-select-sm" value="@(cotasEdit.ClaveTipoCimentacion ?? "")" @onchange="@(e => cotasEdit.ClaveTipoCimentacion = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString())">
                                <option value="">(automático@(s.ClaveCimUsada is null ? ": no encontrada, todas zapata" : ": " + s.ClaveCimUsada))</option>
                                @foreach (var c in s.ClavesTabla) { <option value="@c">@c</option> }
                            </select>
                        </label>
                        @foreach (var (campo, nombre, gen) in ConfigCotasAvance.Cotas)
                        {
                            var cp = campo;
                            <label title="@($"Columna de la tabla de torres (o de la pata). Sin columna = {gen.ToString("0.##", Es)} m")"><span>@nombre</span>
                                <select class="form-select form-select-sm" value="@(cotasEdit.Clave(cp) ?? "")" @onchange="@(e => cotasEdit.Asignar(cp, e.Value?.ToString()))">
                                    <option value="">(genérica: @gen.ToString("0.##", Es) m)</option>
                                    @foreach (var c in s.ClavesTabla) { <option value="@c">@c</option> }
                                </select>
                            </label>
                        }
                    </div>
                </div>
            </div>
        </div>
    };

    public async ValueTask DisposeAsync()
    {
        Parar();
        await LiberarVisor();
        try { if (modulo is not null) await modulo.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
