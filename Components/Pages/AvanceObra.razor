@page "/avance-obra"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.AvanceObra
@using SigWeb.Models
@inject AppDbContext Db
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Avance de obra</PageTitle>

<EncabezadoPagina Titulo="Avance de obra" Icono="avance-obra" OnAtras="Atras">
    <Acciones>
        <span class="pg-btn" title="Avance ponderado del proyecto a la fecha de corte" style="cursor:default;">@FormatoPct(s?.PctProyecto(corte))</span>
        <button type="button" class="pg-btn @(vista == "mapa" ? "activo" : "")" title="Mapa de calor (torres × actividades)" @onclick='() => VerVista("mapa")'><Ico Nombre="tablero" /></button>
        <button type="button" class="pg-btn @(vista == "torre" ? "activo" : "")" title="Torre por torre (visor 3D)" @onclick='() => VerVista("torre")'><Ico Nombre="torre" /></button>
        <button type="button" class="pg-btn @(vista == "matriz" ? "activo" : "")" title="Avance acumulado (matriz)" @onclick='() => VerVista("matriz")'><Ico Nombre="listado" /></button>
        <button type="button" class="pg-btn @(vista == "informe" ? "activo" : "")" title="Informes diarios" @onclick='() => VerVista("informe")'><Ico Nombre="documento" /></button>
        <button type="button" class="pg-btn @(vista == "ajustes" ? "activo" : "")" title="Actividades, pesos y cotas" @onclick='() => VerVista("ajustes")'><Ico Nombre="catalogos" /></button>
        <button type="button" class="pg-btn" title="Recargar" @onclick="Recargar">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5"/></svg>
        </button>
        <span class="pg-sep"></span>
        <button type="button" class="pg-btn @(verImportar ? "activo" : "")" title="Importar informe diario GEB F-054 (Excel)" @onclick="() => { verImportar = !verImportar; importe = null; }"><Ico Nombre="cargar-excel" /></button>
        @if (vista is "mapa" or "matriz")
        {
            <BotonExportar Titulo="Avance de obra" Selector="@(vista == "mapa" ? "table.pm-mapa" : "table.av-matriz")" />
        }
        <span class="pg-sep"></span>
        @if (vista == "informe" && inf is not null)
        {
            @if (inf.Id > 0)
            {
                <button type="button" class="pg-btn" title="Eliminar informe" @onclick="() => confirmarInforme = true"><Ico Nombre="eliminar" /></button>
            }
            <button type="button" class="pg-btn" title="Cerrar sin guardar" @onclick="CerrarInforme"><Ico Nombre="cancelar" /></button>
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar informe" disabled="@guardando" @onclick="GuardarInforme"><Ico Nombre="guardar" /></button>
        }
        else if (vista == "ajustes")
        {
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar ajustes" disabled="@guardando" @onclick="GuardarAjustes"><Ico Nombre="guardar" /></button>
        }
        else
        {
            <button type="button" class="pg-btn pg-btn-primario" title="Nuevo informe del día" @onclick="() => AbrirInforme(DateTime.Today)"><Ico Nombre="agregar" /></button>
        }
    </Acciones>
</EncabezadoPagina>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-warning py-1 small">@error <button type="button" class="btn-close btn-sm float-end" @onclick="() => error = null"></button></div>
}
@if (!string.IsNullOrEmpty(aviso))
{
    <div class="alert alert-success py-1 small">@aviso <button type="button" class="btn-close btn-sm float-end" @onclick="() => aviso = null"></button></div>
}

@if (verImportar)
{
    <div class="panel-formulario av-importar">
        <label class="av-imp-archivo" title="Elegir el Excel del F-054">
            <Ico Nombre="cargar-excel" />
            <InputFile class="form-control form-control-sm" accept=".xlsx,.xlsm" OnChange="ImportarF054" disabled="@importando" />
        </label>
        @if (importando)
        {
            <span class="av-sub"><span class="spinner-border spinner-border-sm"></span> Leyendo el libro…</span>
        }
        @if (importe is { } r)
        {
            <div class="av-imp-res">
                <div><b>@Fecha(r.FechaReporte)</b> · @r.TorresCasadas / @r.TorresLeidas torres · @r.Nuevos nuevos · @r.Actualizados actualizados · @r.InformesCreados informes creados@(r.Encabezado ? " · encabezado y actividades complementarias del día" : "")</div>
                @if (r.TorresSinCasar.Count > 0)
                {
                    <details><summary>@r.TorresSinCasar.Count torre(s) sin casar con el Trazado</summary><div class="av-imp-lista">@string.Join(", ", r.TorresSinCasar)</div></details>
                }
                @if (r.Aproximadas.Count > 0)
                {
                    <details><summary>@r.Aproximadas.Count casada(s) sin la N final</summary><div class="av-imp-lista">@string.Join(", ", r.Aproximadas)</div></details>
                }
                @if (r.TorresSinPatas.Count > 0)
                {
                    <details><summary>@r.TorresSinPatas.Count torre(s) sin Pata A–D en el Trazado (obra civil omitida)</summary><div class="av-imp-lista">@string.Join(", ", r.TorresSinPatas)</div></details>
                }
                @if (r.ActividadesSinColumna.Count > 0)
                {
                    <div class="av-sub">Sin columna en el libro: @string.Join(", ", r.ActividadesSinColumna)</div>
                }
                @if (r.FechasInvalidas > 0)
                {
                    <div class="av-sub">@r.FechasInvalidas fecha(s) no legibles o fuera de rango (se tomó la del reporte)</div>
                }
            </div>
        }
    </div>
}

@if (s is null)
{
    <div class="text-muted small p-3">Cargando…</div>
}
else
{
    @if (vista is "mapa" or "torre" or "matriz")
    {
        <div class="av-filtros">
            <label class="av-filtro" title="Fecha de corte">
                <Ico Nombre="filtro" />
                <input type="date" class="form-control form-control-sm" value="@corte.ToString("yyyy-MM-dd")" @onchange="CambiarCorte" />
            </label>
            <input class="form-control form-control-sm av-buscar" placeholder="Torre…" title="Filtrar torres" @bind="buscar" @bind:event="oninput" />
            <span class="av-filtro-dato">@TorresMostradas().Count / @s.Torres.Count torres</span>
        </div>
    }
    @switch (vista)
    {
        case "torre": @VistaTorre() break;
        case "matriz": @VistaMatriz() break;
        case "informe": @VistaInforme() break;
        case "ajustes": @VistaAjustes() break;
        default: @VistaMapa() break;
    }
}

@code {
    private InstantaneaAvance? s;
    private string vista = "mapa";   // mapa | torre | matriz | informe | ajustes
    private DateTime corte = DateTime.Today;
    private string buscar = "";
    private string? error, aviso;
    private bool guardando;

    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");
    private static string FormatoPct(decimal? v) => v is decimal x ? x.ToString("0.#", Es) + " %" : "—";
    private static string Pct0(decimal? v) => v is decimal x ? x.ToString("0", CultureInfo.InvariantCulture) : "";
    private static string Fecha(DateTime? f) => f is DateTime x ? x.ToString("dd/MM/yyyy") : "";
    private static string EstiloPct(decimal? v)
    {
        if (v is not decimal x) return "";
        var h = (int)Math.Round(Math.Clamp(x, 0, 100) * 1.2m);
        return $"background:hsl({h} 62% 46%);color:#fff;";
    }

    protected override void OnInitialized() => Cargar();

    private void Cargar()
    {
        try
        {
            s = ServicioAvanceObra.Cargar(Db, Env.WebRootPath);
            CargarInformes();
            if (vista == "ajustes") PrepararAjustes();
        }
        catch (Exception ex) { error = "No se pudo cargar el avance de obra: " + ex.Message; }
    }

    private void Recargar() { Cargar(); visorTorre = null; }

    // Importar el F-054 (hoja "Avance acumulado" + encabezado del Reporte Diario).
    private bool verImportar, importando;
    private ResultadoF054? importe;
    private async Task ImportarF054(InputFileChangeEventArgs e)
    {
        error = null; importe = null; importando = true;
        StateHasChanged();
        try
        {
            using var ms = new MemoryStream();
            await using (var st = e.File.OpenReadStream(60L * 1024 * 1024)) await st.CopyToAsync(ms);
            ms.Position = 0;
            importe = await Task.Run(() => ImportadorF054.Importar(Db, ms));
            Cargar(); visorTorre = null;
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo importar el F-054: " + (ex.InnerException?.Message ?? ex.Message); }
        finally { importando = false; }
    }

    private void VerVista(string v)
    {
        vista = v;
        if (v == "ajustes") PrepararAjustes();
        if (v != "torre") Parar();
    }

    private EventCallback Atras => EventCallback.Factory.Create(this, () =>
    {
        if (vista == "informe" && inf is not null) { inf = null; return; }
        if (vista != "mapa") { VerVista("mapa"); return; }
        Nav.NavigateTo("");
    });

    private void CambiarCorte(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var f)) corte = f.Date;
        idxT = null;
    }

    private List<TorreAvance> TorresMostradas()
    {
        if (s is null) return new();
        var q = buscar.Trim();
        return q.Length == 0 ? s.Torres : s.Torres.Where(t => t.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase) || (t.TipoTexto ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private List<IGrouping<string, ActividadObra>> Grupos() => s!.Actividades.GroupBy(a => a.Grupo).ToList();

    // ================= Mapa de calor =================
    private RenderFragment VistaMapa() => __builder =>
    {
        var torres = TorresMostradas();
        var grupos = Grupos();
        <div class="pm-mapa-marco">
            <table class="pm-mapa av-mapa">
                <thead>
                    <tr>
                        <th class="pm-esq" rowspan="2">Torre</th>
                        <th class="pm-tot-th" rowspan="2" title="Avance ponderado de la torre">%</th>
                        @foreach (var g in grupos)
                        {
                            <th class="av-grupo-th" colspan="@g.Count()">@g.Key</th>
                        }
                    </tr>
                    <tr>
                        @foreach (var a in s!.Actividades)
                        {
                            <th class="pm-act" title="@($"{a.Nombre} · {a.Grupo} · peso {a.Peso * 100:0.#} %")"><span class="pm-act-txt">@a.Nombre</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t0 in torres)
                    {
                        var t = t0;
                        var pt = s.PctTorre(t, corte);
                        <tr>
                            <th class="pm-torre" @onclick="() => EnfocarTorre(t)" title="Ver torre">
                                <span class="pm-torre-nom">@t.Nombre</span>
                                @if (!string.IsNullOrEmpty(t.TipoTexto)) { <span class="pm-torre-tiro">@t.TipoTexto</span> }
                            </th>
                            <td class="pm-tot">
                                <span class="pm-tot-barra"><span style="width:@Pct0(pt ?? 0)%;@EstiloPct(pt)"></span></span>
                                <span class="pm-tot-num">@FormatoPct(pt)</span>
                            </td>
                            @foreach (var a0 in s.Actividades)
                            {
                                var a = a0;
                                var v = s.PctActividad(t, a, corte);
                                <td class="pm-cel @(v is null ? "pm-sin" : "")" style="@EstiloPct(v)" title="@($"{t.Nombre} · {a.Nombre}: {FormatoPct(v)}")" @onclick="() => EnfocarTorre(t)">@Pct0(v)</td>
                            }
                        </tr>
                    }
                    @if (torres.Count == 0)
                    {
                        <tr><td colspan="@(s.Actividades.Count + 2)" class="text-muted small text-center py-3">Sin torres.</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th class="pm-esq">Proyecto</th>
                        <td class="pm-tot"><span class="pm-tot-num fw-bold">@FormatoPct(s.PctProyecto(corte))</span></td>
                        @foreach (var a in s.Actividades)
                        {
                            var vals = torres.Select(t => s.PctActividad(t, a, corte)).Where(v => v is not null).Select(v => v!.Value).ToList();
                            decimal? v = vals.Count == 0 ? null : vals.Average();
                            <td class="pm-cel pm-pie @(v is null ? "pm-sin" : "")" style="@EstiloPct(v)" title="@($"{a.Nombre}: {FormatoPct(v)}")">@Pct0(v)</td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="pm-escala"><span>0 %</span><span class="pm-escala-barra"></span><span>100 %</span><span class="pm-escala-sin"></span><span>No aplica</span></div>
    };

    // ================= Torre por torre =================
    private int? torreFoco;
    private int? idxT;                 // posición en la línea de tiempo de la torre (null = la fecha de corte)
    private bool transparente, girando, reproduciendo;
    private CancellationTokenSource? ctsPlay;

    private void EnfocarTorre(TorreAvance t) { torreFoco = t.Id; idxT = null; vista = "torre"; }

    private TorreAvance? Foco()
    {
        var l = TorresMostradas();
        return l.FirstOrDefault(t => t.Id == torreFoco) ?? l.FirstOrDefault();
    }

    // Fechas de la línea de tiempo de la torre (las de sus registros hasta la fecha de corte).
    private List<DateTime> FechasTorre(TorreAvance t)
    {
        var l = s!.FechasDe(t).Where(d => d <= corte).ToList();
        return l;
    }

    private DateTime HastaDe(TorreAvance t, List<DateTime> fechas)
    {
        if (fechas.Count == 0) return corte;
        var i = Math.Clamp(idxT ?? fechas.Count - 1, 0, fechas.Count - 1);
        return idxT is null ? corte : fechas[i];
    }

    private DateTime PreviaDe(List<DateTime> fechas, DateTime hasta)
    {
        var ant = fechas.Where(d => d < hasta.Date).ToList();
        return ant.Count > 0 ? ant[^1] : hasta.Date.AddDays(-1);
    }

    private void IrA(TorreAvance t, int pos) { torreFoco = t.Id; idxT = pos; }

    private RenderFragment VistaTorre() => __builder =>
    {
        var torres = TorresMostradas();
        var foco = Foco();
        <div class="ind-foco">
            <nav class="ind-rail">
                @foreach (var t0 in torres)
                {
                    var t = t0;
                    var pt = s!.PctTorre(t, corte);
                    <button type="button" class="ind-rail-item @(foco?.Id == t.Id ? "activo" : "")" @onclick="() => { torreFoco = t.Id; idxT = null; Parar(); }">
                        <span class="pv-rail-cab">
                            <span class="pv-cod">@t.Nombre</span>
                            @if (!string.IsNullOrEmpty(t.TipoTexto)) { <span class="pv-fecha">@t.TipoTexto</span> }
                            <span class="pm-rail-pct" style="@EstiloPct(pt)">@FormatoPct(pt)</span>
                        </span>
                        <span class="pv-avance"><span style="width:@Pct0(pt ?? 0)%;@EstiloPct(pt)"></span></span>
                    </button>
                }
                @if (torres.Count == 0) { <span class="text-muted small p-2">Sin torres.</span> }
            </nav>
            @if (foco is not null)
            {
                var t = foco;
                var pos = torres.FindIndex(x => x.Id == t.Id);
                var fechas = FechasTorre(t);
                var hasta = HastaDe(t, fechas);
                var previa = PreviaDe(fechas, hasta);
                var pt = s!.PctTorre(t, hasta);
                var idx = fechas.Count == 0 ? 0 : Math.Clamp(idxT ?? fechas.Count - 1, 0, fechas.Count - 1);
                var genericas = (t.Patas.Count > 0 ? t.Patas.SelectMany(p => p.Cotas.Genericas) : t.Cotas.Genericas).Distinct().ToList();
                <section class="ind-det">
                    <div class="ind-det-cab">
                        <button type="button" class="ind-nav" title="Anterior" disabled="@(pos <= 0)" @onclick="() => { torreFoco = torres[pos - 1].Id; idxT = null; Parar(); }">‹</button>
                        <div class="ind-det-tits">
                            <h2 class="ind-det-nom">Torre @t.Nombre</h2>
                            <div class="ind-chips">
                                @if (!string.IsNullOrEmpty(t.TipoTexto)) { <span class="ind-chip">@t.TipoTexto</span> }
                                <span class="ind-chip" title="@(t.ModeloUrl is null ? "Sin modelo vinculado en Modelos 3D: geometría por familia y cuerpo, igual que en Línea 3D." : "Modelo de planos (Modelos 3D), el mismo de Línea 3D")">@(t.ModeloCodigo is null ? (string.IsNullOrEmpty(t.Familia) ? "Sin tipo" : $"Paramétrica {t.Familia}{(t.Cuerpo > 0 ? t.Cuerpo.ToString() : "")}") : "Modelo " + t.ModeloCodigo)</span>
                                @foreach (var g in CimentacionesDe(t))
                                {
                                    <span class="ind-chip @(g.Aviso ? "av-chip-aviso" : "")" title="@g.Titulo">@g.Texto</span>
                                }
                                @if (genericas.Count > 0) { <span class="ind-chip av-chip-aviso" title="@("Sin dato en la tabla de torres (se usa la cota genérica): " + string.Join(", ", genericas))">Cotas genéricas</span> }
                                <a class="ind-chip pv-riesgo" href="@($"trazado?torre={t.Id}")" title="Abrir la hoja de vida en Trazado">Hoja de vida ›</a>
                            </div>
                        </div>
                        <span class="ind-det-pos">@(pos + 1) / @torres.Count</span>
                        <button type="button" class="ind-nav" title="Siguiente" disabled="@(pos >= torres.Count - 1)" @onclick="() => { torreFoco = torres[pos + 1].Id; idxT = null; Parar(); }">›</button>
                    </div>

                    <div class="av3d" @ref="marco">
                        <div class="av3d-lienzo" @ref="lienzo"></div>
                        <div class="av3d-herr">
                            <button type="button" class="av3d-btn @(!mano ? "activo" : "")" title="Girar con el mouse (clic derecho: mover)" aria-pressed="@(!mano)" @onclick="() => Modo(false)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="12" rx="9" ry="4"/><path d="M12 3v18"/><path d="M18.5 9.5 21 12l-2.5 2.5"/></svg>
                            </button>
                            <button type="button" class="av3d-btn @(mano ? "activo" : "")" title="Mano: mover la vista (clic derecho: girar)" aria-pressed="@mano" @onclick="() => Modo(true)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12"/><path d="M11 11.5v-7a1.5 1.5 0 0 1 3 0V12"/><path d="M14 11.5V6.5a1.5 1.5 0 0 1 3 0V13"/><path d="M17 9.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1.5a6 6 0 0 1-4.6-2.2L4.3 15a1.6 1.6 0 0 1 2.4-2.1L8 14.5"/></svg>
                            </button>
                            <button type="button" class="av3d-btn" title="Recentrar la vista" @onclick='() => Llamar("recentrar")'>
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/></svg>
                            </button>
                            <span class="av3d-sep"></span>
                            <button type="button" class="av3d-btn" title="Ver cimentación" @onclick='() => Llamar("vista", "cimentacion")'><Ico Nombre="pata" /></button>
                            <button type="button" class="av3d-btn" title="Ver torre completa" @onclick='() => Llamar("vista", "torre")'><Ico Nombre="torre" /></button>
                            <button type="button" class="av3d-btn @(transparente ? "activo" : "")" title="Suelo transparente" aria-pressed="@transparente" @onclick="AlternarTransparente">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18"/><path d="M3 10v9h18v-9" stroke-dasharray="2 2.5"/><path d="M9 14h6v5H9z"/></svg>
                            </button>
                            <button type="button" class="av3d-btn @(girando ? "activo" : "")" title="Girar" aria-pressed="@girando" @onclick="AlternarGiro">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5"/></svg>
                            </button>
                            <span class="av3d-sep"></span>
                            <button type="button" class="av3d-btn" title="Pantalla completa" @onclick="PantallaCompleta"><Ico Nombre="pantalla-completa" /></button>
                        </div>

                        @* Solo en pantalla completa (CSS): navegación entre torres, buscador y avance por actividad. *@
                        <div class="av3d-pc av3d-pc-nav">
                            <button type="button" class="av3d-pc-flecha" title="Torre anterior" disabled="@(pos <= 0)" @onclick="() => { torreFoco = torres[pos - 1].Id; idxT = null; Parar(); }">‹</button>
                            <div class="av3d-pc-tit">
                                <span class="av3d-pc-nom">Torre @t.Nombre</span>
                                <span class="av3d-pc-sub">@(pos + 1) / @torres.Count@(string.IsNullOrEmpty(t.TipoTexto) ? "" : " · " + t.TipoTexto) · @Fecha(hasta)</span>
                            </div>
                            <button type="button" class="av3d-pc-flecha" title="Torre siguiente" disabled="@(pos >= torres.Count - 1)" @onclick="() => { torreFoco = torres[pos + 1].Id; idxT = null; Parar(); }">›</button>
                            <input class="av3d-pc-buscar" list="av3d-torres" placeholder="Ir a torre…" title="Ir a torre" value="@irA" @onchange="IrATorre" />
                            <datalist id="av3d-torres">
                                @foreach (var x in s.Torres) { <option value="@x.Nombre"></option> }
                            </datalist>
                        </div>
                        <div class="av3d-pc av3d-pc-acts">
                            <div class="av3d-pc-card av3d-pc-total">
                                <span>Avance</span><b>@FormatoPct(pt)</b>
                                <span class="av3d-pc-barra"><span style="width:@Pct0(pt ?? 0)%;@EstiloPct(pt)"></span></span>
                            </div>
                            @foreach (var a in s.Actividades)
                            {
                                var v = s.PctActividad(t, a, hasta);
