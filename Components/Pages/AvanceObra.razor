    // ================= Informes diarios =================
    private record FilaInforme(int Id, DateTime Fecha, int Registros, int Fotos);
    private List<FilaInforme> informes = new();
    private InformeDiario? inf;                  // copia en edición (nada se guarda hasta Guardar)
    private List<FilaReg> filas = new();
    private List<NotaInformeArea> notas = new();
    private List<FotoAvance> fotos = new();
    private FilaReg nueva = new();
    private string nuevaTorre = "";
    private bool confirmarInforme;
    private int? fotoElim;
    private List<(int Torre, int Act, DateTime Fecha, decimal Cantidad, int Informe)> cantidades = new();
    private const long MaxFoto = 25 * 1024 * 1024;

    private static readonly string[] Areas = ServicioAvanceObra.AreasInforme;

    private class FilaReg
    {
        public int Id { get; set; }
        public int TorreId { get; set; }
        public int? ComponenteId { get; set; }
        public int ActividadId { get; set; }
        public decimal? Cantidad { get; set; }
        public decimal? Avance { get; set; }
        public bool NoAplica { get; set; }
        public bool Programado { get; set; }
        public string? Observaciones { get; set; }
        public bool Quitar { get; set; }
    }

    private void CargarInformes()
    {
        var regs = Db.RegistrosAvance.AsNoTracking().GroupBy(r => r.InformeDiarioId).Select(g => new { g.Key, N = g.Count() }).ToDictionary(x => x.Key, x => x.N);
        var fts = Db.FotosAvance.AsNoTracking().GroupBy(r => r.InformeDiarioId).Select(g => new { g.Key, N = g.Count() }).ToDictionary(x => x.Key, x => x.N);
        informes = Db.InformesDiarios.AsNoTracking().OrderByDescending(i => i.Fecha).ToList()
            .Select(i => new FilaInforme(i.Id, i.Fecha, regs.TryGetValue(i.Id, out var n) ? n : 0, fts.TryGetValue(i.Id, out var f) ? f : 0)).ToList();
        cantidades = Db.RegistrosAvance.AsNoTracking().Where(r => !r.Programado && r.Cantidad != null)
            .Select(r => new { r.ElementoTrazadoId, r.ActividadObraId, r.Fecha, r.Cantidad, r.InformeDiarioId }).ToList()
            .Select(r => (r.ElementoTrazadoId, r.ActividadObraId, r.Fecha, r.Cantidad!.Value, r.InformeDiarioId)).ToList();
    }

    private void AbrirInforme(DateTime fecha)
    {
        Parar();
        vista = "informe"; confirmarInforme = false; fotoElim = null;
        var existente = informes.FirstOrDefault(i => i.Fecha.Date == fecha.Date);
        if (existente is not null) { AbrirInformeId(existente.Id); return; }
        inf = new InformeDiario { Fecha = fecha.Date };
        filas = new(); fotos = new();
        notas = Areas.Select((a, k) => new NotaInformeArea { Area = a, Orden = k }).ToList();
        nueva = new(); nuevaTorre = "";
    }

    private void AbrirInformeId(int id)
    {
        Parar();
        vista = "informe"; confirmarInforme = false; fotoElim = null;
        inf = Db.InformesDiarios.AsNoTracking().FirstOrDefault(i => i.Id == id);
        if (inf is null) return;
        filas = Db.RegistrosAvance.AsNoTracking().Where(r => r.InformeDiarioId == id).OrderBy(r => r.Id).ToList()
            .Select(r => new FilaReg
            {
                Id = r.Id, TorreId = r.ElementoTrazadoId, ComponenteId = r.ComponenteId, ActividadId = r.ActividadObraId,
                Cantidad = r.Cantidad, Avance = r.AvanceAcumulado, NoAplica = r.NoAplica, Programado = r.Programado, Observaciones = r.Observaciones
            }).ToList();
        var guardadas = Db.NotasInformeArea.AsNoTracking().Where(n => n.InformeDiarioId == id).OrderBy(n => n.Orden).ToList();
        notas = Areas.Select((a, k) => guardadas.FirstOrDefault(n => n.Area == a) ?? new NotaInformeArea { Area = a, Orden = k })
            .Concat(guardadas.Where(n => !Areas.Contains(n.Area))).ToList();
        fotos = Db.FotosAvance.AsNoTracking().Where(f => f.InformeDiarioId == id).OrderBy(f => f.Id).ToList();
        nueva = new(); nuevaTorre = "";
    }

    private void CerrarInforme() { inf = null; confirmarInforme = false; }

    private TorreAvance? TorrePorNombre(string? n) =>
        string.IsNullOrWhiteSpace(n) ? null : s!.Torres.FirstOrDefault(t => string.Equals(t.Nombre, n.Trim(), StringComparison.OrdinalIgnoreCase));

    private ActividadObra? Act(int id) => s!.Actividades.FirstOrDefault(a => a.Id == id);
    private TorreAvance? Torre(int id) => s!.Torres.FirstOrDefault(t => t.Id == id);

    // % acumulado antes del día del informe (lo que ya estaba guardado).
    private decimal? Anterior(int torreId, int? compId, int actId)
    {
        if (inf is null || Torre(torreId) is not { } t || Act(actId) is not { } a) return null;
        var dia = inf.Fecha.Date.AddDays(-1);
        if (compId is int c && t.Patas.FirstOrDefault(p => p.ComponenteId == c) is { } p) return s!.PctPata(t, p, a, dia);
        return s!.PctActividad(t, a, dia);
    }

    // Montaje por peso: t acumuladas antes del día + las del día / peso del modelo.
    private decimal? PorPeso(int torreId, int actId, decimal cantidadDia)
    {
        if (inf is null || Torre(torreId) is not { PesoModeloKg: double kg } || Act(actId) is not { } a) return null;
        if (a.Efecto is not (EfectoAvance3D.Montaje or EfectoAvance3D.Prearmado) || !string.Equals(a.Unidad, "t", StringComparison.OrdinalIgnoreCase)) return null;
        var antes = cantidades.Where(c => c.Torre == torreId && c.Act == actId && c.Fecha.Date < inf.Fecha.Date && c.Informe != inf.Id).Sum(c => c.Cantidad);
        return Math.Clamp((antes + cantidadDia) * 1000m / (decimal)kg * 100m, 0, 100);
    }

    private void AgregarFila()
    {
        error = null;
        var t = TorrePorNombre(nuevaTorre);
        if (t is null) { error = "Elige una torre de la lista."; return; }
        if (Act(nueva.ActividadId) is not { } a) { error = "Elige la actividad."; return; }
        if (a.Ambito == AmbitoAvance.Torre) nueva.ComponenteId = null;
        if (nueva.Avance is null && !nueva.NoAplica && nueva.Cantidad is decimal q) nueva.Avance = PorPeso(t.Id, a.Id, q);
        if (nueva.Avance is null && !nueva.NoAplica && !nueva.Programado) { error = "Digita el % acumulado (o marca N/A)."; return; }
        nueva.Avance = Math.Clamp(nueva.Avance ?? 0, 0, 100);
        nueva.TorreId = t.Id;
        filas.Add(nueva);
        nueva = new FilaReg { ActividadId = a.Id };
    }

    private async Task GuardarInforme()
    {
        if (inf is null || guardando) return;
        error = null; guardando = true;
        try
        {
            var fecha = inf.Fecha.Date;
            if (Db.InformesDiarios.AsNoTracking().Any(i => i.Fecha.Date == fecha && i.Id != inf.Id)) { error = $"Ya existe un informe del {fecha:dd/MM/yyyy}."; return; }
            InformeDiario e;
            if (inf.Id == 0) { e = new InformeDiario(); Db.InformesDiarios.Add(e); }
            else e = Db.InformesDiarios.First(i => i.Id == inf.Id);
            e.Fecha = fecha; e.ClimaManana = inf.ClimaManana; e.ClimaTarde = inf.ClimaTarde; e.HorasLluvia = inf.HorasLluvia;
            e.ElaboradoPor = inf.ElaboradoPor; e.RevisadoPor = inf.RevisadoPor; e.AprobadoPor = inf.AprobadoPor; e.Observaciones = inf.Observaciones;
            await Db.SaveChangesAsync();

            // Notas por área: se reemplazan.
            Db.NotasInformeArea.RemoveRange(Db.NotasInformeArea.Where(n => n.InformeDiarioId == e.Id));
            foreach (var n in notas.Where(n => !string.IsNullOrWhiteSpace(n.Realizadas) || !string.IsNullOrWhiteSpace(n.Programadas)))
                Db.NotasInformeArea.Add(new NotaInformeArea { InformeDiarioId = e.Id, Area = n.Area, Realizadas = n.Realizadas, Programadas = n.Programadas, Orden = n.Orden });

            var ahora = DateTime.Now;
            var ids = filas.Where(f => f.Id > 0).Select(f => f.Id).ToList();
            var guardados = Db.RegistrosAvance.Where(r => ids.Contains(r.Id)).ToDictionary(r => r.Id);
            foreach (var f in filas)
            {
                if (f.Id == 0)
                {
                    if (f.Quitar) continue;
                    Db.RegistrosAvance.Add(new RegistroAvance
                    {
                        InformeDiarioId = e.Id, Fecha = fecha, ElementoTrazadoId = f.TorreId, ComponenteId = f.ComponenteId, ActividadObraId = f.ActividadId,
                        Cantidad = f.Cantidad, AvanceAcumulado = Math.Clamp(f.Avance ?? 0, 0, 100), NoAplica = f.NoAplica, Programado = f.Programado, Observaciones = f.Observaciones
                    });
                }
                else if (guardados.TryGetValue(f.Id, out var r))
                {
                    if (f.Quitar) { r.Eliminado = true; r.FechaEliminacion = ahora; continue; }   // → Papelera
                    r.Fecha = fecha; r.Cantidad = f.Cantidad; r.AvanceAcumulado = Math.Clamp(f.Avance ?? 0, 0, 100);
                    r.NoAplica = f.NoAplica; r.Programado = f.Programado; r.Observaciones = f.Observaciones;
                }
            }
            foreach (var f in fotos)
                if (Db.FotosAvance.FirstOrDefault(x => x.Id == f.Id) is { } fe) fe.Observacion = f.Observacion;
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            var id = e.Id;
            Cargar();
            AbrirInformeId(id);
            aviso = $"Informe del {fecha:dd/MM/yyyy} guardado.";
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo guardar: " + (ex.InnerException?.Message ?? ex.Message); }
        finally { guardando = false; }
    }

    private void EliminarInforme()
    {
        if (inf is null || inf.Id == 0) return;
        try
        {
            var ahora = DateTime.Now;
            var e = Db.InformesDiarios.First(i => i.Id == inf.Id);
            e.Eliminado = true; e.FechaEliminacion = ahora;
            foreach (var r in Db.RegistrosAvance.Where(r => r.InformeDiarioId == e.Id)) { r.Eliminado = true; r.FechaEliminacion = ahora; }
            foreach (var f in Db.FotosAvance.Where(f => f.InformeDiarioId == e.Id)) { f.Eliminado = true; f.FechaEliminacion = ahora; }
            Db.SaveChanges();
            Db.ChangeTracker.Clear();
            aviso = $"Informe del {e.Fecha:dd/MM/yyyy} enviado a la Papelera.";
            inf = null; confirmarInforme = false;
            Cargar();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo eliminar: " + ex.Message; }
    }

    private async Task CargarFotos(InputFileChangeEventArgs e)
    {
        if (inf is null) return;
        error = null;
        try
        {
            if (inf.Id == 0) { await GuardarInforme(); if (inf is null || inf.Id == 0) return; }
            var carpeta = Path.Combine(Env.WebRootPath, "uploads", "avance-obra");
            Directory.CreateDirectory(carpeta);
            foreach (var a in e.GetMultipleFiles(50))
            {
                var nombre = $"{Guid.NewGuid():N}{Path.GetExtension(a.Name)}";
                await using (var st = a.OpenReadStream(MaxFoto))
                await using (var destino = File.Create(Path.Combine(carpeta, nombre)))
                    await st.CopyToAsync(destino);
                Db.FotosAvance.Add(new FotoAvance { InformeDiarioId = inf.Id, Ruta = $"/uploads/avance-obra/{nombre}", Nombre = a.Name });
            }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            fotos = Db.FotosAvance.AsNoTracking().Where(f => f.InformeDiarioId == inf.Id).OrderBy(f => f.Id).ToList();
            CargarInformes();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudieron cargar las fotos: " + ex.Message; }
    }

    private void EliminarFoto(int id)
    {
        try
        {
            var f = Db.FotosAvance.FirstOrDefault(x => x.Id == id);
            if (f is not null) { f.Eliminado = true; f.FechaEliminacion = DateTime.Now; Db.SaveChanges(); }
            Db.ChangeTracker.Clear();
            fotos.RemoveAll(x => x.Id == id); fotoElim = null;
            CargarInformes();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo eliminar la foto: " + ex.Message; }
    }

