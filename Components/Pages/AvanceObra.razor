    // ---------- Visor 3D (JS) ----------
    private ElementReference lienzo;
    private IJSObjectReference? modulo, visor;
    private int? visorTorre;
    private string? visorClave;
    private bool iniciando;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (vista != "torre" || s is null || Foco() is not { } t)
        {
            if (visor is not null) await LiberarVisor();
            return;
        }
        if (iniciando) return;
        try
        {
            iniciando = true;
            if (visor is null)
            {
                modulo ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/avance3d.js");
                visor = await modulo.InvokeAsync<IJSObjectReference>("crear", lienzo);
                visorTorre = null;
                if (transparente) await visor.InvokeVoidAsync("transparente", true);
                if (girando) await visor.InvokeVoidAsync("girar", true);
                if (mano) await visor.InvokeVoidAsync("modo", "mano");
            }
            var fechas = FechasTorre(t);
            var hasta = HastaDe(t, fechas);
            var previa = PreviaDe(fechas, hasta);
            var clave = $"{t.Id}|{hasta:yyyyMMdd}";
            if (visorTorre != t.Id)
            {
                visorTorre = t.Id; visorClave = clave;
                var datos = new
                {
                    nombre = t.Nombre, modeloUrl = t.ModeloUrl, familia = t.Familia, cuerpo = t.Cuerpo,
                    patas = t.Patas.Select(p => new { letra = p.Letra, cotas = p.Cotas }), cotas = t.Cotas
                };
                await visor.InvokeVoidAsync("cargarTorre", datos, s.Cuadro(t, hasta), s.Cuadro(t, previa));
            }
            else if (visorClave != clave)
            {
                visorClave = clave;
                await visor.InvokeVoidAsync("actualizar", s.Cuadro(t, hasta), s.Cuadro(t, previa));
            }
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { error = "No se pudo iniciar el visor 3D: " + ex.Message; StateHasChanged(); }
        finally { iniciando = false; }
    }

    private async Task LiberarVisor()
    {
        var v = visor; visor = null; visorTorre = null; visorClave = null;
        try { if (v is not null) { await v.InvokeVoidAsync("liberar"); await v.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private async Task Llamar(string metodo, params object[] args)
    {
        if (visor is null) return;
        try { await visor.InvokeVoidAsync(metodo, args); } catch (JSException) { } catch (JSDisconnectedException) { }
    }

    // Tipos de cimentación de una torre agrupados por patas (chips del visor).
    private record ChipCim(string Texto, string Titulo, bool Aviso);
    private static List<ChipCim> CimentacionesDe(TorreAvance t)
    {
        static string Nombre(CotasPata c) => c.Pesada ? "Parrilla pesada" : c.Parrilla ? "Parrilla" : c.Pila ? "Pila" : c.CimentacionSinDetalle ? "Mixta (sin tipo por pata)"
            : string.IsNullOrEmpty(c.Cimentacion) || c.Cimentacion.Contains("zapata", StringComparison.OrdinalIgnoreCase) ? "Zapata" : c.Cimentacion + " (dibujada como zapata)";
        if (t.Patas.Count == 0)
            return new() { new ChipCim(Nombre(t.Cotas), string.IsNullOrEmpty(t.Cotas.Cimentacion) ? "Sin tipo de cimentación en la tabla de torres: se dibuja zapata." : "Tabla de torres: " + t.Cotas.Cimentacion, string.IsNullOrEmpty(t.Cotas.Cimentacion) || t.Cotas.CimentacionSinDetalle) };
        return t.Patas.GroupBy(p => Nombre(p.Cotas)).Select(g =>
        {
            var letras = string.Join(", ", g.Select(p => p.Letra));
            var sinDato = g.All(p => string.IsNullOrEmpty(p.Cotas.Cimentacion));
            var aviso = sinDato || g.Key.Contains("(");
            var txt = t.Patas.Count == g.Count() ? g.Key : $"{g.Key}: {letras}";
            var tit = sinDato ? "Sin tipo de cimentación en la tabla de torres: se dibuja zapata." : "Tabla de torres: " + string.Join(" · ", g.Select(p => $"{p.Letra} = {p.Cotas.Cimentacion}"));
            return new ChipCim(txt, tit, aviso);
        }).ToList();
    }

    private (int Exactos, int Siluetas, int SinTipo, string Cim) Diagnostico()
    {
        var ts = s!.Torres;
        var cim = ts.SelectMany(t => t.Patas.Count > 0 ? t.Patas.Select(p => p.Cotas) : new[] { t.Cotas })
            .GroupBy(c => c.Pesada ? "parrilla pesada" : c.Parrilla ? "parrilla" : c.Pila ? "pila" : c.CimentacionSinDetalle ? "mixta sin detalle" : string.IsNullOrEmpty(c.Cimentacion) ? "sin dato" : "zapata")
            .OrderByDescending(g => g.Count()).Select(g => $"{g.Count()} patas {g.Key}");
        return (ts.Count(t => t.ModeloUrl is not null), ts.Count(t => t.ModeloUrl is null),
            ts.Count(t => string.IsNullOrEmpty(t.TipoTexto)), string.Join(", ", cim));
    }

    private ElementReference marco;
    private bool mano;
    private string irA = "";
    private async Task Modo(bool m) { mano = m; await Llamar("modo", m ? "mano" : "girar"); }
    private async Task PantallaCompleta()
    {
        if (modulo is null) return;
        try { await modulo.InvokeAsync<bool>("pantallaCompleta", marco); } catch (JSException) { } catch (JSDisconnectedException) { }
    }
    private void IrATorre(ChangeEventArgs e)
    {
        var txt = e.Value?.ToString()?.Trim() ?? "";
        irA = "";
        if (txt.Length == 0 || s is null) return;
        var t = s.Torres.FirstOrDefault(x => string.Equals(x.Nombre, txt, StringComparison.OrdinalIgnoreCase))
            ?? s.Torres.FirstOrDefault(x => x.Nombre.Contains(txt, StringComparison.OrdinalIgnoreCase));
        if (t is null) { irA = txt; return; }
        if (!TorresMostradas().Any(x => x.Id == t.Id)) buscar = "";
        torreFoco = t.Id; idxT = null; Parar();
    }

    private async Task AlternarTransparente() { transparente = !transparente; await Llamar("transparente", transparente); }
    private async Task AlternarGiro() { girando = !girando; await Llamar("girar", girando); }

    private void Parar()
    {
        reproduciendo = false;
        ctsPlay?.Cancel(); ctsPlay = null;
    }

    private async Task AlternarPlay(TorreAvance t)
    {
        if (reproduciendo) { Parar(); return; }
        var fechas = FechasTorre(t);
        if (fechas.Count < 2) return;
        reproduciendo = true;
        var cts = ctsPlay = new CancellationTokenSource();
        var i = idxT ?? fechas.Count - 1;
        if (i >= fechas.Count - 1) i = -1;
        try
        {
            while (!cts.IsCancellationRequested && i < fechas.Count - 1)
            {
                i++;
                idxT = i;
                StateHasChanged();
                await Task.Delay(1100, cts.Token);
            }
        }
        catch (TaskCanceledException) { }
        if (ctsPlay == cts) { reproduciendo = false; ctsPlay = null; StateHasChanged(); }
    }

