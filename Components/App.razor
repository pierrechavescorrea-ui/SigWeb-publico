    <link rel="stylesheet" href="@Assets["css/avance-obra.css"]" />
    @* Aplica el tema guardado antes de pintar la página (evita el parpadeo del tema original). *@
    <script>(function(){var c=true;try{var v=localStorage.getItem('sigweb.menu.contraido');if(v!==null)c=JSON.parse(v);}catch(e){}if(c)document.documentElement.setAttribute('data-menu','contraido');})();</script>
    <script>(function(){try{var t=localStorage.getItem('sigweb.tema');if(t&&t!=='institucional'){var h=document.documentElement;h.setAttribute('data-tema',t);if(t==='oscuro')h.setAttribute('data-bs-theme','dark');}}catch(e){}})();</script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/chart.js@4/dist/chart.umd.js"></script>
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/temas.js"></script>
    <script src="js/menu.js"></script>
    <script src="js/navegacion.js"></script>
    <script src="js/inicio.js"></script>
    <script src="js/downloadFile.js"></script>
    <script src="js/exportarTabla.js"></script>
    <script src="js/mapaTrazado.js"></script>
    <script src="js/tablaFijar.js"></script>
    <script src="js/tablaPin.js"></script>
    <script src="js/tablaAlto.js"></script>
    <script src="js/arrastre.js"></script>
    <script src="js/formulaCampoEnsayo.js"></script>
    @* hojaExcel.js es liviano: solo carga lib/univer/univer.bundle.min.js
       (el motor de hoja de cálculo real, con fórmulas — varios MB) la
       primera vez que el usuario abre la Vista Excel en Ensayos, no en
       cada carga de página. *@
    <script src="js/hojaExcel.js"></script>
    <script src="js/graficoEnsayos.js"></script>
</body>

</html>