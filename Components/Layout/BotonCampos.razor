@* Botón «Campos» del encabezado de cualquier pantalla con tabla (abre PanelCampos). *@
<button type="button" class="pg-btn @(Activo ? "activo" : "")" title="Campos" disabled="@Deshabilitado" @onclick="OnClick">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4z"/><path d="M9.3 5v14M14.7 5v14"/></svg>
</button>

@code {
    [Parameter] public bool Activo { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
