@* Etiqueta flotante de los íconos cuando el menú está en modo barra (la posiciona js/menu.js). *@
<div class="nav-tip" aria-hidden="true"></div>

@code {
    private string? logoUrl;

    protected override void OnInitialized()
    {
        var config = Db.Configuracion.AsNoTracking().FirstOrDefault(c => c.Id == 1);
        logoUrl = config?.LogoUrl;
    }

}
