@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@inject AppDbContext Db

<div class="top-row nav-marca">
    <a class="navbar-brand" href="" title="Inicio">
        @if (!string.IsNullOrEmpty(logoUrl))
        {
            <img src="@logoUrl" alt="Logo de la empresa" class="logo-empresa" />
        }
        else
        {
            <span class="marca-texto">SigWeb</span>
        }
        @* En la barra: el logo de la empresa recortado a su parte izquierda (el emblema). *@
        <img src="@(string.IsNullOrEmpty(logoUrl) ? "favicon.png" : logoUrl)" alt="" class="logo-compacto @(string.IsNullOrEmpty(logoUrl) ? "" : "logo-recorte")" />
    </a>
</div>

@* Buscador rápido (Ctrl + K): lo abre js/navegacion.js. *@
<div class="nav-buscar-caja">
    <button type="button" class="nav-buscar" data-nav="buscar" title="Buscar (Ctrl + K)" aria-label="Buscar">
        <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
        <span class="nav-texto">Buscar…</span>
        <kbd class="nav-texto nav-kbd">Ctrl K</kbd>
    </button>
</div>

