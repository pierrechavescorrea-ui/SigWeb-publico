@* Marco común de los formularios de creación/edición: tarjeta con franja de acento,
   encabezado (ícono + título), cuerpo y pie de acciones. Estilos en css/formularios.css. *@
<div class="card panel-formulario frm @Clase">
    @if (!string.IsNullOrWhiteSpace(Titulo))
    {
        <div class="frm-cab">
            @if (!string.IsNullOrWhiteSpace(Icono))
            {
                <span class="frm-cab-ico"><Ico Nombre="@Icono" /></span>
            }
            <div class="frm-cab-tit">@Titulo</div>
            @if (Subtitulo is not null)
            {
                <div class="frm-cab-sub">@Subtitulo</div>
            }
            @if (OnCerrar.HasDelegate)
            {
                <button type="button" class="frm-cerrar" title="Cancelar" aria-label="Cancelar" @onclick="OnCerrar"><Ico Nombre="cancelar" /></button>
            }
        </div>
    }
    <div class="card-body frm-cuerpo">
        @ChildContent
    </div>
    @if (Acciones is not null)
    {
        <div class="frm-pie">@Acciones</div>
    }
</div>

@code {
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public RenderFragment? Subtitulo { get; set; }
    [Parameter] public string? Icono { get; set; }
    [Parameter] public string? Clase { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Acciones { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }
}
